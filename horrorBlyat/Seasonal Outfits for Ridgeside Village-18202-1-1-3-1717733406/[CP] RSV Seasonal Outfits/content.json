{
	"Format": "2.0",
	"ConfigSchema":
	{
		// Механика мода
		"Festival Dialogue Edits":
		{
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "Заменяет диалоги персонажей на фестивале Дня Всех Духов из основного мода диалогами, отсылающими к их костюмам. (Требует RSV's Expanded Festival Maps.)",
			"AllowBlank": false,
			"Section": "Mod Mechanics",
		},

		// Characters With Other Seasonal Mods
		"Alissa":
		{
			"AllowValues": "enabled, disabled, festivals always",
			"Default": "enabled",
			"Description": "Позволяет этому моду изменить внешний вид Алиссы. Когда будет установлен мод ZoeDoll Alissa Seasonals от ZoeDoll, \"enabled\" рандомизирует внешний вид между нарядами этого мода и нарядами ZoeDoll, а также \"festivals always\" делает то же самое, но всегда выбирает наряды этого мода для фестивалей. \"Disabled\" отключает все эти изменения.",
			"AllowBlank": false,
			"Section": "Characters With Other Seasonal Mods",
		},
		"Corine":
		{
			"AllowValues": "enabled, disabled, festivals always",
			"Default": "enabled",
			"Description": "Позволяет этому моду изменить внешний вид Корин. Когда установлен мод Corine Seasonals от x3n3as, \"enabled\" рандомизирует внешний вид между нарядами этого мода и нарядами x3n3as, а также \"festivals always\" делает то же самое, но всегда выбирает наряды этого мода для фестивалей. \"Disabled\" отключает все эти изменения.",
			"AllowBlank": false,
			"Section": "Characters With Other Seasonal Mods",
		},
		"Ian":
		{
			"AllowValues": "enabled, disabled, festivals always",
			"Default": "enabled",
			"Description": "Позволяет этому моду изменить внешний вид Йена. Когда будет установлен мод Ian Seasonals от x3n3as, \"enabled\" рандомизирует внешний вид между нарядами этого мода и нарядами x3n3as, и \"festivals always\" делает то же самое, но всегда выбирает наряды этого мода для фестивалей. \"Disabled\" отключает все эти изменения.",
			"AllowBlank": false,
			"Section": "Characters With Other Seasonal Mods",
		},

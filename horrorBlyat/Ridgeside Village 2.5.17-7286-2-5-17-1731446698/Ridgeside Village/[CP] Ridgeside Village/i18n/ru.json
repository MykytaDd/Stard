//Festival Dialogue - RSV Characters

//Egg Festival

	//Non-Dateables
"Festivals.EggFest.Aguar": "Я продолжаю предупреждать Ленни и Льюиса, но они никогда не слушают...$s#$e#Что такое?#$e#Чего тебе?#$e#Хватит тут уши греть!$a",
"Festivals.EggFest.Bert": "М-м-м, яркое солнце, прохладный ветерок и хорошие яйца!$h#$e#Что может быть лучше?$h",
"Festivals.EggFest.Ezekiel": "Если кто-то не найдёт хоть одно яйцо, тогда вся долина, где выращивают дыни, провоняет тухлятиной.$a",
"Festivals.EggFest.Freddie": "М-м-м, эти яйца с начинкой становятся лучше с каждым годом.$h",
"Festivals.EggFest.Jio": "Яркие яйца сложнее скрыть, и их всё равно разукрасили...",
"Festivals.EggFest.Keahi": "Хочешь яйцо? Сейчас будет!$h#$b#Эй! Как думаешь, ты сможешь прикрыть меня, пока я разведаю, где они спрятали яйца для игры?$4#$b#Ну же! Мхе-хе-хе-хе!$4",
"Festivals.EggFest.Kiwi": "Яйцо?$u#$e#Яйцо.$h",
"Festivals.EggFest.Lenny": "Знаешь, я понимаю, что Льюис имел в виду, когда сказал «веди себя на свой возраст»...$s#$e#Я всё ещё могла бы выиграть охоту за яйцами, если бы захотела.$h",
"Festivals.EggFest.Lola": "Счастливого Яичного фестиваля!$h#$b#Будешь участвовать в охоте в этом году?#$e#Если так, то удачи!$h",
"Festivals.EggFest.Olga": "Берта пучит от яиц.$s#$b#Если он продолжит так на них налегать, то будет спать на диване.",
"Festivals.EggFest.Pika": "Ты пробовал Локо Моко?#$b#Это традиционное самаовайское блюдо с белым тушёным с фаршем рисом, слегка поджаренным яйцом и домашним соусом!#$e#Это блюдо - любимый завтрак Кеяхи.$h",
"Festivals.EggFest.Richard": "Мне нравится, что яйца можно готовить по-разному.$h#$b#Но какое бы блюдо не было, желток я не ем.#$b#Нужно следить за холестерином в таком возрасте!$4",
"Festivals.EggFest.Trinnie": "Мы с Кеяхи проводим рестор-рества-ресто...$h#$b#Агх! Как же это трудно выговорить!$a#$b#Но это всё яйца! Ура! Яйца!$h",
"Festivals.EggFest.Yuuma": "Я уже заметил парочку яиц, но...#$b#Я... не очень-то и хочу участвовать...$s#$e#Всё хорошо.$h",

	//Dateables
"Festivals.EggFest.Alissa": "У меня кружится голова!$h#$b#Жду не дождусь главного события этого фестиваля!$h#$b#О! Хоть ещё ничего не началось, но я уже приметила несколько спрятанных яиц.$h",
"Festivals.EggFest.Alissa_spouse": "Привет, солнышко! Я рада, что ты смог прийти!$h^Привет, солнышко! Я рада, что ты смогла прийти!$h#$b#Смотри! Я даже покрасила несколько наших яиц!$h",
"Festivals.EggFest.Corine": "Иза такая милая!$h#$b#Она пришла к нам домой с утра пораньше, чтобы вместе со мной подготовиться к фестивалю. Было очень весело!$h",
"Festivals.EggFest.Corine_spouse": "Милый, смотри! Что думаешь о моём наряде?$h^Милая, смотри! Что думаешь о моём наряде?$h#$e#Мне кажется я выгляжу чудесно!$h",
"Festivals.EggFest.Flor": "Заметил, что на охоту за яйцами не ставят возрастных ограничений?^Ты заметила, что на охоту за яйцами не ставят возрастных ограничений?#$b#Хоть и это мероприятие рассчитано на детей, однако никто не против участия более взрослых людей, как той же Абигейл.",
"Festivals.EggFest.Flor_spouse": "Интересно, Абигейл когда-нибудь надоест участвовать в охоте?#$b#Я не говорю о том, что ей уже пора!$u#$b#Мне просто интересно!$h",
"Festivals.EggFest.Ian": "Яйца, приготовленные Мисс Эвелин, очень вкусные.$h#$b#Она сказала мне, что вместо молотого чили посыпает их паприкой! Однако, это секрет она узнала от Гаса.",
"Festivals.EggFest.Ian_spouse": "Пробовал яичный тарт, приготовленный Джоди? Держи вот мой кусочек.$h^Ты пробовала яичный тарт, приготовленный Джоди? Держи вот мой кусочек.$h#$b#Скажи «а»!#$e#Прости... Я, эм, упустил момент.$l",
"Festivals.EggFest.Jeric": "Будешь участвовать в охоте за яйцами, @?#$e#Осторожнее с Кеяхи, он очень быстрый!#$b#Ему приходится быть таким, чтобы его шалости сходили с рук.$h",
"Festivals.EggFest.Jeric_spouse": "Удачи, если ты участвуешь в охоте за яйцами, детка!",
"Festivals.EggFest.Kenneth": "Ну вот...$s#$b#Я не успел попробовать яичный тарт! Я опоздал.",
"Festivals.EggFest.Kenneth_spouse": "Хм, проводка на фонарях выглядит не очень надёжной, может мне стоит пойти и...$s#$e#Ладно, просто шучу. Я лучше постою здесь с тобой.$h",
"Festivals.EggFest.Maddie": "Кхх!$a#$b#Я должна быть в исследовательском центре, работать над более важными вещами, а не торчать здесь.$s",
"Festivals.EggFest.Maddie_spouse": "Привет, @!#$b#Хочешь разделить со мной фаршированные яйца?",
"Festivals.EggFest.Philip": "Я видел, как Кеяхи принёс небольшую коробку с яйцами.#$b#Хотя на той коробке было написано «Не для готовки»!$u#$b#Я думаю, это страшно...$s",
"Festivals.EggFest.Philip_spouse": "Сегодня никаких разговоров про потребление белков, обещаю.$h",
"Festivals.EggFest.Shiro": "Как приятно видеть, как веселятся дети. Они так любят эту охоту.$h#$b#Иногда мне хочется поохотиться вместе с ними, но... это было бы странно, да?",
"Festivals.EggFest.Shiro_spouse": "Я обожаю Яичный фестиваль.#$b#Он весёлый сам по себе, но ещё веселее смотреть, как все вокруг радуются.$h",
"Festivals.EggFest.Ysabelle": "Итак, что ты думаешь о моём платье?$h#$b#Выглядит шикарно, правда?",
"Festivals.EggFest.Ysabelle_spouse": "Тебе нравится моё платье, любимый?^Тебе нравится моё платье, любимая?#$b#Только честно, хорошо?$h",


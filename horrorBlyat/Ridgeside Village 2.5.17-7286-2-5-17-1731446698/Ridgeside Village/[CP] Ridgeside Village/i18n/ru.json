//Blair Marriage Dialogue
///Spring
"Blair.MarriageDialogue.spring_1": "О, милашка!#$b#Тебе нужна помощь с весенней уборкой?",
"Blair.MarriageDialogue.spring_12": "Завтра будет куча яиц!$h#$b#Что думаешь о том, чтобы устроить яичный бой после охоты за яйцами?$h",
"Blair.MarriageDialogue.spring_23": "Ита-а-ак, что скажешь насчёт того, чтобы пригласить завтра на танец самую красивую девушку?$6#$b#Должно быть, сейчас ты благодаришь горного духа, да?$h",

///Summer
"Blair.MarriageDialogue.summer_1": "С сегодняшнего дня я горячая летняя девчонка! Юх-хууу!$h#$b#Давай строить планы насчёт похода на пляж, милашка.#$b#Если я буду делится своей энергией только с тобой, то это будет жестоко по отношению к остальным жителям долины.$h",
"Blair.MarriageDialogue.summer_10": "Обрати завтра на мой наряд, милашка.#$b#Я заставлю твою челюсть отвалиться.$4#$b#Возможно, я даже покажу тебе и свои движения... какими бы плохими они не были, хи-хи.$6",
"Blair.MarriageDialogue.summer_27": "Эй, милашка? А давай завтра возьмём на пляж одеяло.#$b#В ожидании прибытия медуз мы будем лежать и смотреть на звёзды. Классно я придумала, правда?$4",

///Fall
"Blair.MarriageDialogue.fall_1": "Эх, вот и осень.$u#$b#В это время года почти ежедневно нужно подметать улицу.$u#$e#Единственное, что сейчас хорошо, так это то, что погода более ветреная, чем летом.$h#$b#А это значит... будем больше обниматься!$h",
"Blair.MarriageDialogue.fall_15": "Итак, слушай внимательно. Надо нам на завтра составить план действий.#$b#Как насчёт разделиться и охватить больше территории по типу «разделяй и властвуй»? Или следует объединиться и выступить против них вместе?$7",
"Blair.MarriageDialogue.fall_19": "Ты в предвкушении завтрашнего дня, да, милашка?#$b#Люди будут спрашивать нас о многих вещах. Особенно потому, что мы молодожёны... Если ты понимаешь, о чём я.$9",
"Blair.MarriageDialogue.fall_26": "Во что ты собираешься одеться завтра, солнышко?#$b#Мы можем одеться как «Бобби и Клайв»! Флор рассказала об этой паре, что она настолько культовая, что о них написали книгу!$h#$b#Представь, об нас бы заговорил весь город!$4",

///Winter
"Blair.MarriageDialogue.winter_1": "Зима - лучшее время года для горячего шоколада!$h#$b#И множества обнимашек!$4#$b#И последнее, но не менее важное: ИГРА СНЕЖКАМИ!$h",
"Blair.MarriageDialogue.winter_7": "Я думала о том, какие наживки лучше использовать для завтрашнего праздника.$7#$b#Конкуренция меня заводит!$h#$b#Милашка, мы должны показать всем, где на самом деле зимуют раки!$4",
"Blair.MarriageDialogue.winter_24": "Я знаю, что это такая традиция - загадывать желание на Новый год.#$b#Но, честно говоря... Чего ещё я могу желать?$6#$b#Я уже так счастлива с тобой и чувствую удовлетворение от всего, что сейчас есть в нашей жизни.$4",

///Room
"Blair.MarriageDialogue.spouseRoom_Blair.1": "Я хорошо украсила комнату, правда?#$b#Думаю, я могла бы помогать Киарре и Антону, когда у них будет выступление.$h#$e#Да, думаю, я настолько хороша, милашка!$7#$b#Почему? Ты не согласен?$h^Почему? Ты не согласна?$h",
"Blair.MarriageDialogue.spouseRoom_Blair.2": "Я с детства мечтала о собственном маленьком уголке.#$b#Мне нравится то, что я сделала с этой комнатой, ведь она не выглядит слишком «рыбной», понимаешь?$h#$e#Ну а если говорить серьёзно, то мне нравится, что я могу делать что-то самостоятельно.$h#$b#А также с тобой, конечно!$4",
"Blair.MarriageDialogue.spouseRoom_Blair.3": "Солнышко, нам надо купить настольные игры.$h#$b#О-о-о, а ещё наборы открыток!$h#$b#Таким образом, мы могли бы делать ставки на то, у кого больше рисунков на лицевой стороне.$4#$b#Я готова поспорить прямо сейчас, что больше всего достанется именно тебе.$h",
"Blair.MarriageDialogue.spouseRoom_Blair.4": "Хм, милашка, тебе не кажется, что комната слишком фиолетово-розовая?$u#$b#Я только что поняла, что другие люди могут подумать, что я похожа на чику.$h#$b#Мне будет трудно сохранить спокойную репутацию, если они так подумают...$h#$e#Ну а вообще, я всегда классная, независимо какого бы цвета ни была моя комната!$7",
"Blair.MarriageDialogue.spouseRoom_Blair.5": "Знаешь что, милашка?#$b#Одна вещь, которую я ценю в наших отношениях, это то, что наши разговоры иногда могут быть весьма случайными, но для нас это кажется нормальным.$7#$e#Я думаю, это очень мило.$h#$b#Какая же мы с тобой милая пара!$4",


///Patio
"Blair.MarriageDialogue.patio_Blair.1": "Я так и не могу насмотреться на твоё личико, милашка!$4#$b#В этом есть что-то такое, что заставляет меня хотеть пожмакать тебя!$h",
"Blair.MarriageDialogue.patio_Blair.2": "Хм, эта сеть...$7#$b#Может попросить Фэй сделать на заказ рыболовные сети с более мелкими дырочками. Думаю, с такой сетью можно будет наловить рыбы гораздо больше. Ты тоже так считаешь, солнышко?",
"Blair.MarriageDialogue.patio_Blair.3": "Ах, свежий воздух!$h#$b#Хм, удастся ли мне уговорить Корин и Изабель присоединиться ко мне, когда я впервые попробую заняться йогой...#$e#Если, конечно, мисс розовая-милашка Изи согласится быть рядом с рыбками.$h",
"Blair.MarriageDialogue.patio_Blair.4": "%Блэр вдыхает большой объём воздуха.#$b#Фу-ух.$u#$b#Солнышко, ты что, пукнул?$u^Солнышко, ты что, пукнула?$u#$e#Ха-ха, шучу! Я просто дурачусь!$h#$b#Я люблю тебя!$h",
"Blair.MarriageDialogue.patio_Blair.5": "Ай диос мио! (от исп. - О Боже!)$u#$b#Я чуть не упала лицом в ведро воды!$u#$e#Хи-хи, наверное, я немного неуклюжая.$4#$b#Прости, милашка. В следующий раз я буду смотреть под ноги.$4",


///Rainy Day
"Blair.MarriageDialogue.Rainy_Day_0": "Дождик, дождик, уходи!$h#$b#Шучу, мне нравится дождь.$h#$e#Хотя для меня странно наслаждаться такой погодой, ведь ловить рыб гораздо труднее во время дождя.#$b#Но я всё равно получаю от этого удовольствие.$h",
"Blair.MarriageDialogue.Rainy_Day_1": "Блин, ну и погодка сегодня.$7#$b#Надеюсь, рыбки не будут сильно прятаться.$s",
"Blair.MarriageDialogue.Rainy_Day_2": "Ая-яй-яй, сыро-сыро-сыро.$u#$b#Бешеный дождь, что ты творишь, ая-яй.$h",
"Blair.MarriageDialogue.Rainy_Day_3": "Милашка, я хочу принять душ под дождём.$6#$b#Что скажешь? Выйдем и примем душ на нашем дворике?$4",
"Blair.MarriageDialogue.Rainy_Day_4": "Дождливые деньки хороши тем, что они совсем не жаркие.$h#$b#В такие дни солнце кажется таким злым.$u",
"Blair.MarriageDialogue.Rainy_Day_Blair": "Сахарный пучо-о-о-о-ок!$6#$b#Хи-хи! Ничего, милашка! Мне просто захотелось позвать тебя!$4#$b#Кажется, дождь делает меня более сумасшедшей, чем обычно.$h",

///Rainy Night
"Blair.MarriageDialogue.Rainy_Night_0": "Оу, ты выглядишь ужасно хорошо, пока мокрый, милашка.$7^Оу, ты выглядишь ужасно хорошо, пока мокрая, милашка.$7#$b#Хочешь заняться тем, чем мы обычно занимаемся дома по вечерам?$6",
"Blair.MarriageDialogue.Rainy_Night_1": "Блин!$4#$b#Обливать тебя водой - это целое преступление!$h#$b#Ты выглядишь ужасно хорошо.$6",
"Blair.MarriageDialogue.Rainy_Night_2": "Ух, хватит с меня этого дождя.$s#$b#Я уже хочу чистого неба, солнышко!$u",
"Blair.MarriageDialogue.Rainy_Night_3": "Я думала о разных вещах, которые можно делать в дождь...$6#$e#И...$6#$b#У меня появилась идея, которая требует, чтобы мы оба были в спальне.$4^У меня появилась идея, которая требует, чтобы мы обе были в спальне.$4",
"Blair.MarriageDialogue.Rainy_Night_4": "Разве тебе не нравится, как дождь утоляет жажду земли?$h#$b#Надеюсь, рыбки там не утонут!$7#$b#Ха-ха! Шучу я!$h",
"Blair.MarriageDialogue.Rainy_Night_5": "Хм-м, милашка?#$b#Почему бы нам сейчас не вернуться домой. А выйти на улицу мы всегда успеем.$6#$b#Я уверена, что мы могли бы занять себя до этого момента кое-чем.$4#$e#Или, быть может, займёмся этим здесь, под дождём?$6",
"Blair.MarriageDialogue.Rainy_Night_Blair": "Глянь, сегодня идёт дождь из кошек и собак.#$e#Хи-хи, представь, если бы это была правда!$h",

///Indoor Day
"Blair.MarriageDialogue.Indoor_Day_0": "Милашка-а-а!$h#$e#Хи-хи, ничего! Мне просто нравится звать тебя.$4",
"Blair.MarriageDialogue.Indoor_Day_1": "О, мой Иоба! МИЛАШКА! Я только что узнала, что ты что-то украл!$u^О, мой Иоба! МИЛАШКА! Я только что узнала, что ты что-то украла!$u#$b#Ты украл моё сердце!$4^Ты украла моё сердце!$4#$e#Хи-хи! Я просто дурачусь.$h",
"Blair.MarriageDialogue.Indoor_Day_2": "Эй, милашка?#$b#Я хочу спросить, как думаешь, рыбы говорят с набитым ртом?#$b#Я имею в виду, что их рот всегда полон воды.$6#$e#Ха-ха! Я даже не знаю, почему эта мысль пришла мне в голову.$h",
"Blair.MarriageDialogue.Indoor_Day_3": "В последнее время в мою голову приходят случайные мысли.$7#$b#Например, невероятно случайные мысли, не относящиеся к этому миру. Как рыбы, которые ползают вместо того, чтобы плавать.$u#$e#Наверное, это хорошо, что ты так сильно меня любишь, да, солнце?$4#$b#Иначе ты можешь подумать, что я сошла с ума!$h",
"Blair.MarriageDialogue.Indoor_Day_4": "Чем ты сегодня занимаешься, солнышко?#$b#Тебе нужен поцелуй удачи от самой лучшей жены на свете?$h",
"Blair.MarriageDialogue.Indoor_Day_Blair": "Ты, должно быть, сделал что-то хорошее в своей прошлой жизни, милашка.^Ты, должно быть, сделала что-то хорошее в своей прошлой жизни, милашка.#$b#Чтобы ты был благословлён такой удивительной женой, как я, думаю, что в прошлом ты должен был быть по меньшей мере божеством.$h^Чтобы ты была благословлена такой удивительной женой, как я, думаю, что в прошлом ты должна была быть по меньшей мере божеством.$h",

//Indoor Night
"Blair.MarriageDialogue.Indoor_Night_0": "О, Иоба, что за день!$u#$b#Какой он был утомительный.$s#$b#Но как же я рада тебя видеть, милашка!$h",
"Blair.MarriageDialogue.Indoor_Night_1": "Ферма выглядит изобильно, милашка!$h#$b#С гордостью могу сказать, что я лучший талисман удачи, который у тебя есть.$h#$e#Ха-ха, шучу!$h#$b#Ты отлично справляешься с работой на ферме.#$b#Ты молодец!$h",
"Blair.MarriageDialogue.Indoor_Night_2": "Что-то сегодня тихо.#$b#Почему бы нам самим не пошуметь?..$6",
"Blair.MarriageDialogue.Indoor_Night_3": "Ух, я чувствую себя такой уставшей, солнышко.$s#$b#Мы ведь можем просто обнять друг друга на кровати?$s",
"Blair.MarriageDialogue.Indoor_Night_4": "Все задания на сегодня выполнены, милашка?#$e#Если чувствуешь усталость, я могу сделать массаж «каратэ-удар»!$h#$b#Шучу-шучу.$h#$b#Обещаю, я буду нежной.$4",
"Blair.MarriageDialogue.Indoor_Night_Blair": "Поздравляю, милашка!$h#$b#Ты будешь спать рядом с самой удивительной женщиной в долине - со мной!$h#$b#Ха-ха, разве это не подарок - быть рядом со мной каждый день и ночь?$h#$e#Шутки в сторону, милашка... Мне повезло, что я могу каждый день приходить домой к своему лучшему мужу.$4^Шутки в сторону, милашка... Мне повезло, что я могу каждый день приходить домой к своей лучшей жене.$4#$b#Я люблю тебя, @.$4",

///Outdoors
"Blair.MarriageDialogue.Outdoor_0": "Что мы будем делать сегодня, солнышко?$h#$b#Может нам пойти на Хребет, если у тебя будет свободное время?$h",
"Blair.MarriageDialogue.Outdoor_1": "Пчёлки, резвящиеся вокруг цветов, напоминают мне о тебе, милашка.#$b#Ты - пчела, резвящаяся вокруг меня, маленького красивого цветка.$h",
"Blair.MarriageDialogue.Outdoor_2": "Принесёшь мне что-нибудь подкрепиться как будет время, милашка?#$b#Я бы с удовольствием выпила - в твоей компании, разумеется.$h#$b#Это был бы отличный отдых от всей работы, которая у меня сегодня есть.$h",
"Blair.MarriageDialogue.Outdoor_3": "Я вся в поту, дорогой.$7^Я вся в поту, дорогая.$7#$b#Но даже в таком случае я выгляжу ещё сексуальнее. Правда, детка?$h",
"Blair.MarriageDialogue.Outdoor_4": "Эй, милашка.$h#$b#Если ты случайно заглянешь к Вилли, можешь захватить для меня крючок? Кажется, я свой потеряла.$s",

//Leaving
"Blair.MarriageDialogue.funLeave_Blair.1": "Пока-пока, солнце!#$b#Увидимся позже! Чмок!$h",
"Blair.MarriageDialogue.funLeave_Blair.2": "Я думаю сегодня порыбачить на Хребте.#$b#Я слышала, там есть магические сущности, что помогают тебе. Быть может, там я найду свой талисман.#$e#О, не расстраивайся. Ты по-прежнему лучший талисман, который у меня есть. Мне просто нужно найти такой, который предназначен для рыбалки, и только для рыбалки.$h",
"Blair.MarriageDialogue.funLeave_Blair.3": "Пока, милашка!#$b#Не скучай по мне сильно, хорошо?$h",
"Blair.MarriageDialogue.funLeave_Blair.4": "Я схожу в деревню, солнышко.#$b#Мама будет в ужасе, если я не буду навещать её время от времени.$h",
"Blair.MarriageDialogue.funLeave_Blair.5": "Ай-яй-яй, как бы я не хотела покидать тебя... Но я боюсь, что рыбки будут скучать по мне.$s#$b#Так что держись, милашка. Я скоро вернусь, не скучай, хорошо?$h",

//Returning
"Blair.MarriageDialogue.funReturn_Blair.1": "Что такое, милашка?#$b#Соскучился по мне, да?$h^Соскучилась по мне, да?$h#$e#Надеюсь, что да, ведь я буду обнимать тебя очень сильно, когда мы ляжем спать!$h#$b#То есть, после того, как я освежусь.$6",
"Blair.MarriageDialogue.funReturn_Blair.2": "Добро пожаловать домой, милашка!#$b#Скучал?$4^Скучала?$4#$e#У меня сегодня был самый сумасшедший день!$s#$b#Мне очень нужны обнимашки.$s",
"Blair.MarriageDialogue.funReturn_Blair.3": "Как прошёл твой день?#$b#Я скучала по тебе!#$e#Кстати, Тринни и Кеяхи сказали, что ферма выглядит прекрасно.$h#$b#А ещё они хотят посетить нас в ближайшее время. Давай в следующий раз проведём с ними день и устроим им экскурсию по городу?",
"Blair.MarriageDialogue.funReturn_Blair.4": "Ай-яй-яй, какой день!$7#$b#Самое лучшее в возвращении домой - это то, что я могу видеть твоё личико, милашка!$h#$b#Ха-ха, я люблю тебя!$4",
"Blair.MarriageDialogue.funReturn_Blair.5": "Солнце, я дома!$h#$b#Фу, что это за запах?$u#$b#Милашка, ты пахнешь как...#$b#Как влюблённый человек.$4#$e#Ха-ха, я тебя подловила, верно?$h",

//One kid
"Blair.MarriageDialogue.OneKid_0": "Ай-яй-яй, я боюсь, что наш малыш может взять с меня пример.$u#$b#Если это будет так, то, возможно, нам придётся несладко.$7",
"Blair.MarriageDialogue.OneKid_1": "Рождение ребёнка - это то, чего я раньше не представляла себе.^Воспитание ребёнка - это то, чего я раньше не представляла себе.#$b#Учитывая всё то, что случилось со мной раньше, я просто подумала, что появление ребёнка на свет - это было бы здорово.#$b#Но благодаря тебе, милашка, я искренне наслаждаюсь материнством.$4#$b#Спасибо, что вошёл в мою жизнь, дорогой.$4^Спасибо, что вошла в мою жизнь, дорогая.$4",
"Blair.MarriageDialogue.OneKid_2": "Посмотри на нашего малыша, @!$h#Наш ребёнок выглядит таким милым, правда?$h",
"Blair.MarriageDialogue.OneKid_3": "Эй, милашка, не хочешь разыграть нашу маленькую кроху?$h#$b#Мы можем спрятаться, когда %kid1 не видит, и ждать, пока у %kid1 на глазах появятся слёзы, а потом выскочить!$h#$e#Ой, да, это слишком жестоко?$u",

//Two kids
"Blair.MarriageDialogue.TwoKids_0": "Ай диос мио, я очень надеюсь, что эти двое не будут брать с меня пример.$u#$b#Если это случится, то мы в беде.$6",
"Blair.MarriageDialogue.TwoKids_1": "Они оба такие милые!$h#$b#Мы производим неплохое потомство.$4#$b#Как будто выиграли в генетическую лотерею!$h",
"Blair.MarriageDialogue.TwoKids_2": "Эй, милашка? Кого ты любишь больше, меня или детей?#$b#Ха-ха! Шучу, я просто хотела посмотреть, как ты начнёшь потеть из-за этого вопроса.$h",
"Blair.MarriageDialogue.TwoKids_3": "Оу, дети выглядят такими счастливыми.$h#$b#Было бы неплохо устроить посиделки с Шоном, Кеяхи и Тринни!$h#$b#Как будто вся банда снова вместе!$h",

//Relationship-dependent
///Good
"Blair.MarriageDialogue.Good_0": "Как жизнь, мой маленький пузырёк счастья?$h#$b#Сегодня я чувствую себя довольно бодро, давай станцуем счастливый танец?$4",
"Blair.MarriageDialogue.Good_1": "Я не знаю, что делала в своей прошлой жизни, но я очень рада, что сделала что-то достаточно, чтобы заслужить тебя, милашка.$6",
"Blair.MarriageDialogue.Good_2": "Просто есть вещи, которые являются особенными и заслуживают того, чтобы поделиться ими со всем миром.#$b#Одна из них, это ты, @.$6#$b#Хи-хи.$6",
"Blair.MarriageDialogue.Good_3": "Знаешь что, милашка? Я подумываю о том, чтобы сделать домик на дереве.#$b#Дети были бы рады, если бы он у нас был, открытый для всех!$h#$b#Мы даже могли бы вместе играть в прятки!$h",
"Blair.MarriageDialogue.Good_4": "Милашка, что ты думаешь о том, чтобы сделать форт?$h#$b#Вчера я увидела видео о конкурсе по изготовлению фортов и с тех пор думаю об этом!$h",
"Blair.MarriageDialogue.Good_5": "Ха-ха! Солнце, я не могу перестать смеяться!$h#$b#Кеяхи разыграл Шона самым смешным образом!$h#$b#Он разрезал брюки Шона сзади так, что казалось, будто у него две задницы!$h",
"Blair.MarriageDialogue.Good_6": "Я думала о топоте маленьких ножек, милашка.$6#$b#Что скажешь о пристройке к дому?$4",
"Blair.MarriageDialogue.Good_7": "Солнце!$u#$b#Я тут кое-что потеряла!$u#$b#И вот я тебя нашла. Хи-хи!$6",
"Blair.MarriageDialogue.Good_8": "Эй, солнце!#$b#Было больно?$7#$b#Было ли тебе больно, когда ты упал с небес, чтобы спасти меня?$6^Было ли тебе больно, когда ты упала с небес, чтобы спасти меня?$6",
"Blair.MarriageDialogue.Good_9": "Милашка, можешь остановиться?$u#$b#Ты не выходишь у меня из головы с того дня, как мы познакомились! Разве ты не устал?$6^Ты не выходишь у меня из головы с того дня, как мы познакомились! Разве ты не устала?$6",

///Neutral
"Blair.MarriageDialogue.Neutral_0": "Думаешь о том, какое дополнение нам сделать дома?#$b#Было бы неплохо время от времени делать перепланировку, чтобы освежать обстановку, верно?",
"Blair.MarriageDialogue.Neutral_1": "Я с утра думаю о наживках.$7#$b#Я имею в виду, что я здесь самая большая наживка, особенно потому, что я поймала самую крупную рыбку в долине.$4",
"Blair.MarriageDialogue.Neutral_2": "Сегодня такой сумасшедший день, милашка.$7#$b#Я так устала, мне нужен отдых!$s",
"Blair.MarriageDialogue.Neutral_3": "Это неделя была такая утомительная.$u#$b#Когда же она закончится.$s",
"Blair.MarriageDialogue.Neutral_4": "Тринни спрашивала, из каких ракушек получаются лучшие лампы.#$b#Я слышала о красивом прозрачном моллюске под названием «ракушка Капиз». Думаю, она идеально подойдёт для лампы.",
"Blair.MarriageDialogue.Neutral_5": "Это безумие, когда кажется, что дни проходят незаметно, правда, милашка?#$b#Кажется, только вчера мы узнали о твоём приезде в город.$4",
"Blair.MarriageDialogue.Neutral_6": "Я никогда не видела такого трудолюбивого человека, как ты.#$b#Как ты это делаешь, милашка?",
"Blair.MarriageDialogue.Neutral_7": "@, ты фотоаппарат?#$b#О, только не притворяйся, что ты не знаешь, о чём я. Хи-хи!$6",
"Blair.MarriageDialogue.Neutral_8": "Солнце, каким спортом ты занимаешься?#$b#Просто с каждым днём ты выглядишь всё аппетитнее и аппетитнее.$4",
"Blair.MarriageDialogue.Neutral_9": "Мама спрашивала о тебе, милашка.#$b#Давай как-нибудь навестим её вместе, иначе она сама будет навещать нас, и мы никогда от неё не избавимся.$u",

///Bad
"Blair.MarriageDialogue.Bad_0": "О чём ты говоришь?$a#$b#То, что ты говоришь, - чушь! Ты просто хочешь меня разозлить!$8",
"Blair.MarriageDialogue.Bad_1": "Фу, как ты меня раздражаешь!$a",
"Blair.MarriageDialogue.Bad_2": "Почему ты продолжаешь делать мне больно?$8#$b#Я тебе больше не интересна?$8",
"Blair.MarriageDialogue.Bad_3": "Это безумие, винить всех остальных вокруг, кроме самого себя.$a^Это безумие, винить всех остальных вокруг, кроме самой себя.$a",
"Blair.MarriageDialogue.Bad_4": "Что на тебя нашло?$8#$b#Ты уже не такой, каким был раньше.$8^Ты уже не такая, какой была раньше.$8",
"Blair.MarriageDialogue.Bad_5": "%Блэр игнорирует вас сегодня.",
"Blair.MarriageDialogue.Bad_6": "%Блэр даже не смотрит в вашу сторону.",
"Blair.MarriageDialogue.Bad_7": "Если бы я только знала, до чего дойдёт этот брак, я бы не пошла на это.$a#$b#Ты знаешь, как я презираю лжецов и меркантильных людей!$8",
"Blair.MarriageDialogue.Bad_8": "*Вздох* Я слишком устала от всего этого, @. Давай просто остановимся.$s",
"Blair.MarriageDialogue.Bad_9": "Это нелогично, что ты обращаешься со мной как с принцессой в один день, а потом обращаешься со мной как с ничтожеством - в другой!$a#$b#Прими уже наконец решение и придерживайся его!$a",

//Paula Marriage Dialogue
///Spring
"Paula.MarriageDialogue.spring_1": "Чувствуешь запах свежего воздуха, дорогой?^Чувствуешь запах свежего воздуха, дорогая?#$b#Весна пришла!$h",
"Paula.MarriageDialogue.spring_12": "Раньше Яичный фестиваль был довольно жёсткий.$u#$b#За год до твоего приезда в город Тринни и Кеяхи так набегались в поисках яиц...#$b#...что они оба запыхались и чуть упали в обморок, пока мэр Льюис продолжал считать.",
"Paula.MarriageDialogue.spring_23": "Знаю, я не лучший танцор, но я с нетерпением жду завтрашнего дня, чтобы потанцевать с тобой, моя любовь.$4#$e#Но мы должны быть начеку, понятно?$9#$b#Возможно, придётся лечить растянутые лодыжки или мозоли.$8",

///Summer
"Paula.MarriageDialogue.summer_1": "А вот и лето наступило!$h#$b#Не забывай пить много воды и не находись слишком долго на жаре!$6#$b#Это нужно делать для профилактики теплового удара, хорошо, солнце?$7",
"Paula.MarriageDialogue.summer_10": "Ты уже выбрал, что добавишь в общий суп?#$b#Главное, чтобы его не пересолили, тогда всё будет хорошо!$h",
"Paula.MarriageDialogue.summer_27": "Вот бы у нас были телескопы на завтрашнем празднике.$8#$b#Я хотела бы посмотреть на звезды, пока мы будем ждать медуз.$9",

///Fall
"Paula.MarriageDialogue.fall_1": "Ах, осень.$h#$b#Мне очень нравится это время года, потому что оно не слишком жаркое и не слишком холодное.#$e#Но больше всего мне нравятся цвета, в которые превращаются листья.$h#$b#Не знаю, меня это просто успокаивает.$4#$b#Как и ты...$h",
"Paula.MarriageDialogue.fall_15": "@, нам нужно придумать план для завтрашней ярмарки.#$b#Я думаю, это хорошая идея, так мы можем проверить состояние здоровья всех тех, кто будет присутствовать на мероприятии.$9#$e#Хе-хе, прости. Мой внутренний доктор никогда не спит.$8",
"Paula.MarriageDialogue.fall_19": "Я с нетерпением жду завтрашнего дня, дорогой.$h^Я с нетерпением жду завтрашнего дня, дорогая.$h#$b#Мы можем встретиться со всеми и поговорить о жизни.#$b#Это будет похоже на мини-собрание.$h#$e#Знаешь, до твоего приезда в городе были одни и те же старые и разные истории...$7#$b#Теперь, когда ты здесь, все кажется таким живым и новым.$h#$b#Ты действительно придаёшь красок этому миру, моя любовь.$4",
"Paula.MarriageDialogue.fall_26": "Как думаешь, какой костюм будет лучше всего смотреться на мне, @?#$b#Мне хочется нарядиться к завтрашнему дню.$4",

///Winter
"Paula.MarriageDialogue.winter_1": "Фалалалала ла ла ла ла.$h#$b#%Паула поёт.#$e#Счастливого зимнего сезона, дорогуша!$h#$b#Одевайся тепло и не находись слишком долго на морозе, хорошо?$8#$b#Ты всегда можешь прийти ко мне, если тебе нужно согреться.$4",
"Paula.MarriageDialogue.winter_7": "Завтра нам нужно обязательно взять с собой термос с горячей водой.$6#$b#Она может понадобиться всем, особенно пожилым людям. Поэтому лучше прийти подготовленными.$9#$e#А также желаю  тебе удачи завтра на соревнованиях по подлёдной рыбалке, моя любовь!$h#$b#И принеси домой суши!$h",
"Paula.MarriageDialogue.winter_24": "Уже почти конец года, @. За что бы тебе хотелось его поблагодарить?$4#$b#Я очень надеюсь, что мне удалось сделать твой год немного счастливее, потому что ты, безусловно, сделал его лучшим для меня.$8^Я очень надеюсь, что мне удалось сделать твой год немного счастливее, потому что ты, безусловно, сделала его лучшим для меня.$8",

///Room
"Paula.MarriageDialogue.spouseRoom_Paula.1": "Мои книги не трогали уже целую вечность.$u#$b#Если я найду время, я хочу перечитать роман 'Лувия и Умуви'.$7#$e#Ты тоже можешь прочитать её, если захочешь. Она про то, как адвокат влюбился в архитектора и преследовал её, пока та не согласилась встречаться с ним.#$b#История немного запутанная, но она того стоит.$9",
"Paula.MarriageDialogue.spouseRoom_Paula.2": "Дорогой, напомнишь мне как-нибудь купить ещё один коврик?$9^Дорогая, напомнишь мне как-нибудь купить ещё один коврик?$9#$b#Тот, который у меня есть, похоже скоро износится.$9",
"Paula.MarriageDialogue.spouseRoom_Paula.3": "На днях я разговаривала с Флор, и она рассказала, что горячая вода превращается в лёд быстрее, чем холодная.#$b#Это была полезная информация, потому что в клинике мне почти всегда нужен лёд.$9",
"Paula.MarriageDialogue.spouseRoom_Paula.4": "Солнце, что ты думаешь о том, чтобы поручить Киарре сделать наш портрет и повесить его на стену?#$e#О, я просто предложила, ведь здорово иметь что-то памятное для нас, здесь, дома.$4",
"Paula.MarriageDialogue.spouseRoom_Paula.5": "Взросление сопровождается многими страхами и тревогами.$6#$b#Особенно это касается нашего здоровья, различных возможностей и даже упущенного времени с любимыми людьми.$7#$b#Одно знаю точно - я рада, что именно с тобой мне предстоит состариться, @.$4",


///Patio
"Paula.MarriageDialogue.patio_Paula.1": "Ветерок здесь гораздо прохладнее, правда?#$b#Я думаю, что растения дают дополнительную прохладу.$9",
"Paula.MarriageDialogue.patio_Paula.2": "Мне очень нравится находиться во внутреннем дворике. Это идеальное место для того, чтобы подумать и собраться с мыслями.$8",
"Paula.MarriageDialogue.patio_Paula.3": "Я помню, как мне хотелось иметь такое место, когда я была в полевых условиях.$8#$b#Было трудно медитировать из-за шума.$7#$b#Но я как-то умудрялась медитировать каждое утро.$8#$e#Медитация дала мне ощущение мира и спокойствия посреди всего происходящего.$8",
"Paula.MarriageDialogue.patio_Paula.4": "Помню, как-то, когда мы были моложе, Антон, Мария и я были на пляже, и Антон забыл перевернуться, пока загорал.$8#$b#Он был похож на половинку красного бархатного печенья!$h",
"Paula.MarriageDialogue.patio_Paula.5": "Однажды Лола научила меня маленькой хитрости.#$b#Она сказала, что лучший способ завоевать сердце человека - перепить его.$h#$b#Теперь ты знаешь, почему я тогда бросила тебе вызов.$4",


///Rainy Day
"Paula.MarriageDialogue.Rainy_Day_0": "О, нет!$u#$b#Я надеюсь, что сегодня люди, особенно пожилые, будут соблюдать повышенные меры предосторожности.$s#$b#Из-за дождя все становится скользким.$s",
"Paula.MarriageDialogue.Rainy_Day_1": "Солнце, возьми с собой зонтик, пожалуйста.#$b#Или надень шляпу, если тебе не хочется ничего брать с собой.#$b#Так ты прикроешь голову от дождя, дорогой.^Так ты прикроешь голову от дождя, дорогая.",
"Paula.MarriageDialogue.Rainy_Day_2": "Мне нужно запастись бинтами.#$b#В дождливые дни часто случаются вывихи.$6#$e#Будь осторожней, когда отправляешься на поиски приключений. Особенно когда идёт дождь, хорошо?",
"Paula.MarriageDialogue.Rainy_Day_3": "За что мне нравится дождь, так это за отличный повод поесть острую пищу.$h#$b#Дорогой, будешь очень милым и любящим супругом, и принесёшь мне домой что-нибудь остренькое от Пайка, пожалуйста?$4^Дорогая, будешь очень милой и любящей супругой, и принесёшь мне домой что-нибудь остренькое от Пайка, пожалуйста?$4",
"Paula.MarriageDialogue.Rainy_Day_4": "Давай обниматься, @?#$b#О, ничего, я просто хотела тепло обнять тебя перед уходом.$4",
"Paula.MarriageDialogue.Rainy_Day_Paula": "Несмотря на то, что он может быть опасен для здоровья, я считаю, что дождь - это очень красиво.#$b#Я чувствую, что он очищает землю, понимаешь?",

///Rainy Night
"Paula.MarriageDialogue.Rainy_Night_0": "Где же ты пропадал, мой дорогой?^Где же ты пропадала, моя дорогая?#$b#Иди сюда, будем сушиться.$4",
"Paula.MarriageDialogue.Rainy_Night_1": "Ты вымок под дождём!$u^Ты вымокла под дождём!$u#$b#Тебе нужно принять ванну, солнце.$6",
"Paula.MarriageDialogue.Rainy_Night_2": "Добро пожаловать домой, большое мокрое создание!$h#$b#Давай высушу тебя и напою горячим напитком, хорошо?",
"Paula.MarriageDialogue.Rainy_Night_3": "Ах, дождь! Это лучшая погода для объятий.$h#$b#Не хочешь ли ты пройти со мной в спальню, дорогой?$4^Не хочешь ли ты пройти со мной в спальню, дорогая?$4",
"Paula.MarriageDialogue.Rainy_Night_4": "В поле дождь был настолько редким, что когда бы он ни шёл, мы воспринимали его как благословение.",
"Paula.MarriageDialogue.Rainy_Night_5": "%Паула напевает себе под нос.#$b#О, прости, дорогой. Я просто думала о том, что мы можем добавить в клинику.^О, прости, дорогая. Я просто думала о том, что мы можем добавить в клинику.#$b#Теперь я готова тебя выслушать.$4",
"Paula.MarriageDialogue.Rainy_Night_Paula": "Солнце, хочешь посидеть у огня и выпить со мной чаю?#$b#Я хочу отдохнуть и расслабиться вместе с тобой.$4",

///Indoor Day
"Paula.MarriageDialogue.Indoor_Day_0": "Проснись и пой, дорогой.$h^Проснись и пой, дорогая.$h#$b#Нас ждут великие дела.",
"Paula.MarriageDialogue.Indoor_Day_1": "%Паула, похоже, напевает, делая какую-то работу по дому.#$b#Да, моё маленькое солнышко?#$b#О, наверное, я увлеклась. Я и не заметила, что напеваю себе под нос.$h",
"Paula.MarriageDialogue.Indoor_Day_2": "Дорогой, не забывай пить воду в течение дня, хорошо?^Дорогая, не забывай пить воду в течение дня, хорошо?#$b#Если ты забудешь об этом, у тебя может наступить обезвоживание.$6",
"Paula.MarriageDialogue.Indoor_Day_3": "В ближайшие дни нам нужно запланировать поход на хребет, солнце.#$b#Для того, чтобы мы могли развивать нашу выносливость! К тому же это полезно для сердца.",
"Paula.MarriageDialogue.Indoor_Day_4": "Какое же приятное чувство - просыпаться рядом со своим любимым человеком.$4#$b#Это делает остаток дня таким интересным.",
"Paula.MarriageDialogue.Indoor_Day_Paula": "Дорогой, я знаю, что ты отправляешься на поиски приключений и все такое.^Дорогая, я знаю, что ты отправляешься на поиски приключений и все такое.#$b#Пообещай мне, что будешь заботиться о себе, хорошо?$7#$b#Безопасность превыше всего!$a",

//Indoor Night
"Paula.MarriageDialogue.Indoor_Night_0": "Я с нетерпением жду, когда вернусь домой, чтобы увидеть твоё лицо.$4#$b#Это делает весь утомительный день терпимым.$4",
"Paula.MarriageDialogue.Indoor_Night_1": "Ты выглядишь уставшим, дорогой.$s^Ты выглядишь уставшей, дорогая.$s#$b#Может быть, чашка горячего чая поможет тебе расслабиться.",
"Paula.MarriageDialogue.Indoor_Night_2": "Есть некоторые вещи, которые я бы сочла личными...#$e#Например, массаж, который я сделаю тебе перед сном.$4#$b#Скажем так, на все тело.$4#$b#Ха-ха, пошутила.#$b#Пошли на кровать, дорогой. Я позабочусь о твоём уставшем теле.^Пошли на кровать, дорогая. Я позабочусь о твоём уставшем теле.",
"Paula.MarriageDialogue.Indoor_Night_3": "Иоба, какой утомительный день!$u#$b#Мы можем просто обняться и спать всю ночь?$s",
"Paula.MarriageDialogue.Indoor_Night_4": "Я слышала, ты сегодня много исследовал, дорогой.^Я слышала, ты сегодня много исследовала, дорогая.#$b#Ты пьёшь воду в течение дня, как я говорила?",
"Paula.MarriageDialogue.Indoor_Night_Paula": "Блин, я просто в шоке сегодня.$s#$b#Но как же я рада, что могу вернуться домой к тебе, @.$4#$b#Для меня это самая лучшая часть каждого дня.$4",

///Outdoors
"Paula.MarriageDialogue.Outdoor_0": "Ферма выглядит восхитительно, дорогуша.#$b#Ты добился потрясающих результатов.$h^Ты добилась потрясающих результатов.$h#$b#Я, наверное, твой счастливый талисман, да?$h",
"Paula.MarriageDialogue.Outdoor_1": "Привет, солнце! Не забывай пить воду, хорошо?",
"Paula.MarriageDialogue.Outdoor_2": "Антон на днях говорил о том, какие у тебя прекрасные способности к ландшафтному дизайну.#$b#Я сказала ему, что ты был бы рад сотрудничать с ним - за определённую плату, конечно.$h^Я сказала ему, что ты была бы рада сотрудничать с ним - за определённую плату, конечно.$h",
"Paula.MarriageDialogue.Outdoor_3": "Ты выглядишь так очаровательно, когда занимаешься своими повседневными делами, моя любовь.$7#$b#Хе-хе, забудь. Я просто думаю о том, как хорошо ты выглядишь, когда работаешь мотыгой.$8",
"Paula.MarriageDialogue.Outdoor_4": "Чем сейчас будет заниматься мой маленький искатель приключений?#$b#Хорошо, только будь осторожнее. Я люблю тебя!$h",

//Leaving
"Paula.MarriageDialogue.funLeave_Paula.1": "До свидания, дорогуша! Я ухожу спасать жизни!$h#$e#Ну, это было преувеличением, ха-ха. Я хотела сказать, что отправляюсь делать жизнь людей немного лучше и комфортнее.$h",
"Paula.MarriageDialogue.funLeave_Paula.2": "Веселись во время своих маленьких побегов, дорогуша.$h#$b#Я продолжу.",
"Paula.MarriageDialogue.funLeave_Paula.3": "Не уходи далеко, хорошо?#$b#Тебе лучше быть без синяков, когда я вернусь домой. Иначе!..$a",
"Paula.MarriageDialogue.funLeave_Paula.4": "Хорошего тебе дня, моя любовь.#$b#Увидимся, когда вернусь домой, ладно?$h",
"Paula.MarriageDialogue.funLeave_Paula.5": "Если у тебя будет потом время, то можешь навестить меня, и мы устроим небольшое обеденное свидание.$h ",

//Returning
"Paula.MarriageDialogue.funReturn_Paula.1": "Привет, солнце!$h#$b#Ты скучал по мне?^Ты скучала по мне?#$b#Сегодня в клинике произошло так много событий. Кеяхи чуть не опрокинул на пол иглу и шприц!$u",
"Paula.MarriageDialogue.funReturn_Paula.2": "Добро пожаловать к нам домой, мой дорогой!$hДобро пожаловать к нам домой, моя дорогая!$h#$b#Ты достаточно занимаешься ежедневной физической нагрузкой?#$b#Ты сегодня выглядишь особенно... хорошо.$4#$b#Может, нам стоит... продолжить наше общение в спальне после того, как мы переоденемся?$4",
"Paula.MarriageDialogue.funReturn_Paula.3": "А-ах, наконец-то дома.#$b#О, хе-хе. Честно говоря, я имела в виду тебя, когда говорила о доме.$4#$b#Это так, на всякий случай.$9",
"Paula.MarriageDialogue.funReturn_Paula.4": "О, солнце, ты не поверишь, какой у меня был день.$9#$b#Это было утомительно, но так весело! Мои пациенты сегодня были просто восхитительны! Все были здоровы.$h",
"Paula.MarriageDialogue.funReturn_Paula.5": "Самое лучшее в возвращении домой - это увидеть твоё прекрасное лицо, @.$8#$b#Мне не хватало этого смазливого лица с самого утра.$9#$b#Хе-хе, звучит немного банально, но не знаю, почему я не могу перестать сходить по тебе с ума.$4",

//One kid
"Paula.MarriageDialogue.OneKid_0": "О, @, посмотри на нашу маленькую лапочку!$h#$b#Похоже, что %kid1 будет брать с тебя пример.$h",
"Paula.MarriageDialogue.OneKid_1": "Наш малыш так вырос, @.$11#$b#Я никогда не думала, что буду так счастлива.$11#$b#Спасибо тебе, моё солнышко, за то, что дал мне и %kid1 ту жизнь, которую мы заслуживаем.$11^Спасибо тебе, моё солнышко, за то, что дала мне и %kid1 ту жизнь, которую мы заслуживаем.$11",
"Paula.MarriageDialogue.OneKid_2": "Удивительно, но я представляла себе свою жизнь совсем по-другому.$8#$b#Но я очень рада, что всё сложилось именно так, потому что у меня теперь есть...$9#$b#Ты.$4#$b#Ну, то есть, ты и %kid1.$h",
"Paula.MarriageDialogue.OneKid_3": "Иоба!$u#$b#Ты заметил, какой у %kid1 аппетит? Ест так, что за ушами трещит!$9^Ты заметила, какой у %kid1 аппетит? Ест так, что за ушами трещит!$9#$b#С таким аппетитом %kid1 может легко победить тебя и Антона в соревновании по поеданию!!$h#$e#Пожалуйста, когда у вас обоих будет время... ДЕЛАЙТЕ УПРАЖНЕНИЯ, хорошо?$u",

//Two kids
"Paula.MarriageDialogue.TwoKids_0": "Иоба, как же быстро растут %kid1 и %kid2.#$b#@, я надеюсь, что они вырастут хорошими людьми,.$8",
"Paula.MarriageDialogue.TwoKids_1": "Знаешь что, дорогой?$9^Знаешь что, дорогая?$9#$b#Думаю, что кое-кто берёт с тебя пример. Я видела, как %kid1 волнуется, когда у нашего второго ребёнка пошла кровь из носа.$h#$e#О, непоседа %kid2 в порядке, возможно, это реакция на смену погоды.$8#$b#Я проверила обоих, с ними всё хорошо.",
"Paula.MarriageDialogue.TwoKids_2": "Спасибо, @.$4#$b#Я знаю, что многое произошло с тех пор, как мы впервые встретились...$8#$b#И несмотря на мои недостатки и проблемы, ты всегда был и остаёшься терпеливым ко мне.$9^И несмотря на мои недостатки и проблемы, ты всегда была и остаёшься терпеливой ко мне.$9#$b#Не говоря уже о детях.$8#$b#Ты подарил мне и детям прекрасную и счастливую жизнь. Спасибо тебе, мой дорогой.$4^Ты подарила мне и детям прекрасную и счастливую жизнь. Спасибо тебе, моя дорогая.$4",
"Paula.MarriageDialogue.TwoKids_3": "Солнце, ребята просили взять их с собой на пикник на хребте.#$b#Как думаешь, нам лучше взять с собой вещи и остаться в хижине? Или нам лучше пораньше уйти домой?$8",

//Relationship-dependent
///Good
"Paula.MarriageDialogue.Good_0": "Что ты думаешь о пополнении в семье, дорогуша?$8#$b#Топот маленьких ножек будет приятным будильником.$h",
"Paula.MarriageDialogue.Good_1": "Удивительно, как быстро летит время, правда, любовь моя?$8#$b#Как будто годы пролетели незаметно, и мы скоро вместе состаримся.$9",
"Paula.MarriageDialogue.Good_2": "Я думала о том, чтобы научить маленьких детей оказывать первую помощь.#$b#Как думаешь, это хорошая идея?$8",
"Paula.MarriageDialogue.Good_3": "Я очень ценю то, что ты стараешься проводить со мной время, несмотря на наши плотные графики, @.$4#$b#Ты действительно заставляешь меня чувствовать себя самой счастливой женщиной в долине.$8",
"Paula.MarriageDialogue.Good_4": "Что ты думаешь насчёт перепланировки, @?#$e#Да ничего, я просто подумала... Было бы неплохо время от времени менять сцену перед нами.$9",
"Paula.MarriageDialogue.Good_5": "Ты выглядишь вполне здоровым, дорогой.^Ты выглядишь вполне здоровой, дорогая.$4#$b#Ты счастлив?^Ты счастлив?",
"Paula.MarriageDialogue.Good_6": "%Паула, похоже, напевает себе под нос.#$e#О, да, моя маленькая пышечка?$9#$b#Прости, я просто задумалась о том, как прекрасна наша жизнь... Ты действительно делаешь меня такой счастливой.$8",
"Paula.MarriageDialogue.Good_7": "Ты занимаешься спортом, моя любовь?$4#$b#Я не хотела пялиться, но я не знаю...$9#$b#Ты сегодня просто сияешь.$4",
"Paula.MarriageDialogue.Good_8": "Дорогой, можно тебя обнять?$8^Дорогая, можно тебя обнять?$8#$e#О, ничего. Я просто хочу подзарядить свой аккумулятор твоими объятиями.$4",
"Paula.MarriageDialogue.Good_9": "Я должна была сделать что-то хорошее, чтобы заслужить такого человека, как ты, @.$9#$b#Спасибо, что всегда был рядом и заботился обо мне. Ты действительно лучший!$4^Спасибо, что всегда была рядом и заботилась обо мне. Ты действительно лучшая!$4",

///Neutral
"Paula.MarriageDialogue.Neutral_0": "На днях в клинику заходили мистер и миссис Блейдбейн.$9#$b#Они были в восторге, услышав, как хорошо у нас идут дела.$h",
"Paula.MarriageDialogue.Neutral_1": "Тринни и Кеяхи спрашивали о том, что делать с бо-бо.#$b#Они такие милые, когда чем-то интересуются.$h#$b#Я научила их промывать ссадины без риска занесения инфекции.#$b#Они даже это записывали!$h",
"Paula.MarriageDialogue.Neutral_2": "Я думаю об организации продажи лекарств.#$b#Как ты думаешь, Ленни это одобрит?$6",
"Paula.MarriageDialogue.Neutral_3": "Я никогда не видела таких красивых пейзажей.$h#$b#Обычно \"пейзажем\" на нашем поле был... ну, песок.$6",
"Paula.MarriageDialogue.Neutral_4": "Флор рассказывала о лекарственных травах, используемых для лечения ран.$9#$b#Честно говоря, мне очень любопытно, как это работает.#$b#Это может быть полезно для людей в полевых условиях.$8",
"Paula.MarriageDialogue.Neutral_5": "Ты правильно питаешься, солнце?$6#$b#Ты выглядишь очень бледным.$6^Ты выглядишь очень бледной.$6#$b#Съешь что-нибудь сладкое? У тебя может быть гипогликемия, дорогуша.$s",
"Paula.MarriageDialogue.Neutral_6": "Антон и Киарра говорили о том, чтобы сделать статую или что-то подобное для нашей лужайки, @. Что ты думаешь?#$b#Дадим им свободу для творчества?$9",
"Paula.MarriageDialogue.Neutral_7": "Я думаю, что нам нужно держать дома аптечку первой помощи.$6#$b#Знаешь, на случай, если что-нибудь случится?$7",
"Paula.MarriageDialogue.Neutral_8": "Постоянно заклеивать ссадины пластырем вредно для здоровья.$6#$b#Иногда инфекция тоже может развиться, если рана не может дышать.$7#$e#Самое главное - тщательно промыть её.$8",
"Paula.MarriageDialogue.Neutral_9": "Бывают моменты, когда я думаю о том, что было бы, если бы я осталась в поле.#$b#Но потом я думаю о тебе и забываю обо всех своих 'а что, если...'.$4",

///Bad
"Paula.MarriageDialogue.Bad_0": "Хм-м?$6",
"Paula.MarriageDialogue.Bad_1": "Я слишком устала, чтобы говорить о нас.$6#$b#Мы можем сделать это в другой раз?$s",
"Paula.MarriageDialogue.Bad_2": "Хм-м?$7#$b#Я не знаю, что случилось... Я просто устала, наверное.$s",
"Paula.MarriageDialogue.Bad_3": "Ты изменился, @...$s^Ты изменилась, @...$s#$b#В чём дело?$7",
"Paula.MarriageDialogue.Bad_4": "%Паула вас не замечает.#$b#Хм, да? Тебе что-нибудь нужно?$7",
"Paula.MarriageDialogue.Bad_5": "Ты сильно потеешь.$6#$b#Вытри пот и выпей воды, @.$a",
"Paula.MarriageDialogue.Bad_6": "Хм, прости.$6#$b#Мне нужно, эм... Иди.$u",
"Paula.MarriageDialogue.Bad_7": "*Вздох* Сражаться утомительно, @.$s#$b#Мы можем прекратить это на сегодня?$a",
"Paula.MarriageDialogue.Bad_8": "Я слишком устала для этого...$a",
"Paula.MarriageDialogue.Bad_9": "Хм-м?$s",


//Anton Marriage Dialogue
///Spring
"Anton.MarriageDialogue.spring_1": "Что? Уже наступила весна?#$b#Быстро время пролетает, да?#$e#В любом случае, разбуди меня, когда наступит время завтракать.$h",
"Anton.MarriageDialogue.spring_12": "Мои брат и сестра попросили меня помочь им позже приготовить блюда из яиц.$6#$b#Если они придут в гости, скажи им, что я на работе или типа того, хорошо, солнце?$h",
"Anton.MarriageDialogue.spring_23": "Признаюсь, мне сложно украшать цветами!#$b#Поэтому я восхищаюсь людьми, которые готовят праздник Цветочных танцев. У них прямо глаз намётан на цветочные композиции.",

///Summer
"Anton.MarriageDialogue.summer_1": "Одна из приятных особенностей летнего сезона заключается в том, что повсюду появляются яркие цвета.#$b#Я действительно восхищаюсь людьми, которые умеют смешивать и сочетать цвета, особенно в одежде.$6#$e#Хех, я знаю только нейтральные цвета для своего гардероба. Было бы неплохо добавить туда немного цвета.$4#$b#Как ты привнёс цвет в мою жизнь, милый.$4^Как ты привнесла цвет в мою жизнь, милая.$4",
"Anton.MarriageDialogue.summer_10": "Солнце, не забудь принести самый вкусный ингредиент, какой только сможешь. Хорошо?#$b#Ужин будет полезен для живота. Я в восторге!$h",
"Anton.MarriageDialogue.summer_27": "Давай завтра возьмём одеяло для пикника?#$b#Я могу показывать тебе разные созвездия и рассказывать разные истории о них, если хочешь.$4#$e#С удовольствием буду путешествовать с тобой по звёздам, моя любовь.$h",

///Fall
"Anton.MarriageDialogue.fall_1": "Вот блин. Осенний сезон прямо вскружил мне голову.$h#$b#Было бы здорово просто сидеть и пить холодное пиво.$6",
"Anton.MarriageDialogue.fall_15": "Завтра ярмарка будет очень интересной...$6#$b#Хех, понимаешь?$4#$e#О, но мне нравится бродить по этому месту, пока идёт фестиваль.#$b#Меня вдохновляет эта атмосфера праздника и то, как каждый демонстрирует свою продукцию.$h",
"Anton.MarriageDialogue.fall_19": "Завтра день сбора.$h#$b#Как думаешь, какая еда там будет?#$b#Не могу дождаться, чтобы все попробовать!$h#$e#О да, и, конечно, собраться вместе со всеми.$4",
"Anton.MarriageDialogue.fall_26": "День всех духов существует уже давно.#$b#Забавно думать, что Мадам Аметин когда-то, давным-давно, надевала костюмы для этого праздника.$h",

///Winter
"Anton.MarriageDialogue.winter_1": "%Антон зевает.#$b#А? Что?$u#$b#О, ничего, солнце. Я просто хочу поспать.$6#$e#Разбуди меня пожалуйста, когда закончится зима.$6#$b#Шучу, я всё равно хочу обниматься с тобой, когда мы не спим, солнце.$4",
"Anton.MarriageDialogue.winter_7": "Солнце, поймай завтра самую большую рыбу!$h#$b#Потом спрячь её в пакет и не выпускай обратно, чтобы мы могли её съесть! Ха-ха!$h#$b#Шучу, милый. Типа того.$6^Шучу, милая. Типа того.$6",
"Anton.MarriageDialogue.winter_24": "Знаю, что не часто это говорю, но я действительно хочу поблагодарить тебя, @.$4#$b#Ты помог мне понять, что во мне есть нечто большее, чем кажется на первый взгляд.$6^Ты помогла мне понять, что во мне есть нечто большее, чем кажется на первый взгляд.$6#$b#Поэтому ты - самое лучший подарок, который я получил.$4#$e#Хех, похоже, я расчувствовался перед завтрашним праздником.$4#$b#Теперь я должен вернуться к своему спокойному, безмятежному образу жизни.$6",

///Room
"Anton.MarriageDialogue.spouseRoom_Anton.1": "Милый, что бы ты ни делал, пожалуйста, не трогай те чертежи на столе, хорошо?^Милая, что бы ты ни делала, пожалуйста, не трогай те чертежи на столе, хорошо?#$b#Это то немногое, над чем я работал.",
"Anton.MarriageDialogue.spouseRoom_Anton.2": "Мы с Ленни говорили о том, чтобы сделать молодёжный центр, где могли бы играть дети.#$b#Хочешь сотрудничать со мной?$4#$b#Конечно, если это что-то даст.#$b#Но это может быть ещё один проект, над которым мы могли бы работать вместе.$4",
"Anton.MarriageDialogue.spouseRoom_Anton.3": "Мама мия!$u#$b#Я потерял свой транспортир!$u#$b#Если ты его найдёшь, солнце, я тебя крепко поцелую!$6",
"Anton.MarriageDialogue.spouseRoom_Anton.4": "Милый, не мог бы ты взять табуретку и принять удобную позу на минутку?^Милая, не могла бы ты взять табуретку и принять удобную позу на минутку?#$b#Я хочу запечатлеть твою красоту на бумаге.$4#$e#И, может быть, даже добавить крылья с рогами.$6#$b#Ха-ха, шучу, солнце.$h",
"Anton.MarriageDialogue.spouseRoom_Anton.5": "Эй, солнце? Если мои брат или сестра зайдут сюда, скажи им, что я занят на работе.$6#$b#Хе-хе, я просто хочу остаться и быть с тобой весь день.$4",


///Patio
"Anton.MarriageDialogue.patio_Anton.1": "Солнце, посмотри, как я попытаюсь сломать это бревно голыми руками!$h",
"Anton.MarriageDialogue.patio_Anton.2": "Ах, свежий воздух!$h#$b#Так что, пожалуйста, не пукай. Хорошо, милый?$h^Так что, пожалуйста, не пукай. Хорошо, милая?$h",
"Anton.MarriageDialogue.patio_Anton.3": "Как думаешь, здесь хорошо будет смотреться комнатное растение?#$b#Хотя я боюсь, что растение из-за меня погибнет.$s",
"Anton.MarriageDialogue.patio_Anton.4": "В прошлый раз Киарра спросила, может ли она сотрудничать со мной в рамках комиссии.#$b#Очевидно, кто-то из города Зузу хотел нанять её в качестве декоратора, и она хотела принять проект вместе со мной.#$b#Я о том, что могу работать в многозадачном режиме.$6#$b#Но... Я немного устал от стресса.#$b#Я подумаю над этим позже.$h",
"Anton.MarriageDialogue.patio_Anton.5": "Помимо моего маленького уголка в доме, я нахожу внутренний дворик прекрасным местом для того, чтобы очистить голову, понимаешь?$h",


///Rainy Day
"Anton.MarriageDialogue.Rainy_Day_0": "У дождя совсем другой запах...#$b#Это приятно и притягательно, правда, милый?^Это приятно и притягательно, правда, милая?",
"Anton.MarriageDialogue.Rainy_Day_1": "Хм-м...#$b#Я тут подумал... Что если дождь изначально был снегом, когда он начал падать, но просто растаял из-за тепла, и поэтому стал каплями, а не снегом?$u#$b#Вау! Взрыв мозга!$u",
"Anton.MarriageDialogue.Rainy_Day_2": "Я думаю о мозговом штурме всякий раз, когда идёт дождь.#$b#О, ничего. Они никак не связаны, просто шторм и дождь очень близки. Ха-ха!$6",
"Anton.MarriageDialogue.Rainy_Day_3": "Что такое, детка?#$b#Ну, там точно не солнце, потому что льёт дождь.$u",
"Anton.MarriageDialogue.Rainy_Day_4": "*зевает* Который час, солнце?#$b#Думаю, мой мозг всё ещё спит.",
"Anton.MarriageDialogue.Rainy_Day_Anton": "Лучше захвати запасную рубашку и полотенце, солнце.#$b#Там идёт сильный ливень. Не хочу, чтобы ты заболела, и уж точно не желаю слышать, как Паула называет меня плохим мужем.$6^Там идёт сильный ливень. Не хочу, чтобы ты заболел, и уж точно не желаю слышать, как Паула называет меня плохим мужем.$6",

///Rainy Night
"Anton.MarriageDialogue.Rainy_Night_0": "Дождь всё ещё идёт, солнце.#$b#Почему бы тебе не остаться дома и не пообниматься со мной у камина?$4#$b#Мы могли бы обсудить наш день и... сделать нашу ночь ещё более интересной?$6",
"Anton.MarriageDialogue.Rainy_Night_1": "Знаешь, что сцены дождя - это одна из тех вещей, которые я люблю рисовать и писать?#$b#Ну, я просто делаю это для тренировки... Но я не знаю, мне нравится, что у дождя есть разное настроение.#$b#Мне кажется, что он выражает какие-то эмоции.$6#$e#Я, наверное, сошёл с ума, дорогой. Дождь с эмоциями.$6^Я, наверное, сошёл с ума, дорогая. Дождь с эмоциями.$6",
"Anton.MarriageDialogue.Rainy_Night_2": "Я могу нарубить дров прямо сейчас, солнце.#$b#Мы могли бы разжечь огонь в камине и приготовить дома шашлык.$h",
"Anton.MarriageDialogue.Rainy_Night_3": "Ты точно человек, @?#$b#Ты, наверное, инопланетянин, если так хорошо выглядишь в темноте И в мокрой одежде!$h#$b#Но на самом деле, ты самый красивый человек, которого я знаю, солнце.$4",
"Anton.MarriageDialogue.Rainy_Night_4": "Ночной дождь хорош тем, что после него можно принять ванну.#$b#Может примем её вместе?$6#$b#Хе-хе, я просто тебя дразню. Мы тогда с тобой израсходуем всю горячую воду.$h",
"Anton.MarriageDialogue.Rainy_Night_5": "Это был сумасшедший день, дорогой.$u^Это был сумасшедший день, дорогая.$u#$b#Дождь сегодня идёт без остановки.$u#$b#Безумный, сумасшедший дождь.$6",
"Anton.MarriageDialogue.Rainy_Night_Anton": "Эй, @?#$b#Что тебя больше всего привлекает в дожде?#$e#О, это просто вопрос. Мне просто интересно, что ты думаешь.$4",

///Indoor Day
"Anton.MarriageDialogue.Indoor_Day_0": "Я хочу спагетти.#$b#Принесёшь мне немного, когда будешь возвращаться домой?$4",
"Anton.MarriageDialogue.Indoor_Day_1": "Я планирую позже зайти к Лоренцо.#$b#Если он, конечно, сам к нам не придёт.$u#$b#Вот это было бы напряжённо.$u",
"Anton.MarriageDialogue.Indoor_Day_2": "Мне хочется думать, что я могу разговаривать с животными.#$b#То есть, когда я смотрю в их глаза, я иногда думаю, видят ли они мою душу.$u#$e#Мамма мия, это было случайно.$6",
"Anton.MarriageDialogue.Indoor_Day_3": "Нам стоит запланировать поход на хребет в ближайшие дни, милый.$h^Нам стоит запланировать поход на хребет в ближайшие дни, милая.$h#$b#Я думаю, свежий воздух пойдёт нам на пользу. Он очистит наши лёгкие!$h#$e#И, честно говоря, я думаю, что смена обстановки позволит мне хорошо отдохнуть.$4",
"Anton.MarriageDialogue.Indoor_Day_4": "У меня спина болит, солнце! ЧЧем мы таким занимались этой ночью?$6#$b#Ха-ха! Шучу! Иоба, не злись.$h",
"Anton.MarriageDialogue.Indoor_Day_Anton": "Я получил несколько писем с запросами о моих тарифах из города Зузу.#$b#Как думаете, я готов выйти в свет?",

//Indoor Night
"Anton.MarriageDialogue.Indoor_Night_0": "Откуда ты, солнце?#$b#Я скучал по тебе.$4",
"Anton.MarriageDialogue.Indoor_Night_1": "Ах, Иоба, ты выглядишь потрясающе, даже когда устал, mi amore.$4^Ах, Иоба, ты выглядишь потрясающе, даже когда устала, mi amore.$4#$b#У меня от тебя просто дух захватывает.$4",
"Anton.MarriageDialogue.Indoor_Night_2": "Как я рад, что ты вернулся, дорогой!^Как я рад, что ты вернулась, дорогая!#$b#Я хотел увидеть тебя с самого утра...$4#$e#О, мне не нужно ничего особенного. Просто я хотел тебя увидеть.$h",
"Anton.MarriageDialogue.Indoor_Night_3": "Вау, ты выглядишь так, будто тебе было весело, солнце.#$b#Исследование пошло на пользу?",
"Anton.MarriageDialogue.Indoor_Night_4": "Мамма мия, я как я устал.$u#$b#Единственная хорошая вещь в этом дне - это то, что ты здесь, дома.$4#$b#Спасибо, дорогой. Ты лучший.$4^Спасибо, дорогая. Ты лучшая.$4",
"Anton.MarriageDialogue.Indoor_Night_Anton": "Уф, сегодня был долгий день, солнце.$s#$b#Можно мы просто придём в кровать и обнимемся?$6#$b#Это был бы прекрасный способ закончить день.$4",

///Outdoors
"Anton.MarriageDialogue.Outdoor_0": "Мамма мия!$h#$b#Ты выглядишь потрясающе!$h",
"Anton.MarriageDialogue.Outdoor_1": "Свет на улице отличается от света в помещении.#$b#Он 'естественный' и идеально подходит для рисования.$h",
"Anton.MarriageDialogue.Outdoor_2": "Ферма выглядит хорошо, @.#$b#Я действительно восхищён тем, как ты хорошо относишься к окружающей флоре и фауне.$6#$b#Научишь меня этому как-нибудь?",
"Anton.MarriageDialogue.Outdoor_3": "Мне очень нравится оставаться на улице, когда вокруг нет людей.$h#$b#Это даёт мне глоток свежего воздуха, чтобы побыть вдали от всех.$6#$e#Прости. Я думаю, что мой социальный аккумулятор предназначен только для тебя, солнце.$4",
"Anton.MarriageDialogue.Outdoor_4": "Удивительно, что у тебя есть связь с растениями и животными, @.#$b#Я искренне восхищаюсь твоим терпением по отношению к ним. Я бы тоже хотел быть таким, но, наверное, не у всех есть мягкие руки и любящие домашних животных объятия.$6",

//Leaving
"Anton.MarriageDialogue.funLeave_Anton.1": "Эй, ты мой, ясно?$6^Эй, ты моя, ясно?$6#$e#Я не хочу показаться собственником - я просто хочу, чтобы весь мир знал, что ты мой.$4^Я не хочу показаться собственником - я просто хочу, чтобы весь мир знал, что ты моя.$4",
"Anton.MarriageDialogue.funLeave_Anton.2": "До встречи, дорогой!$h^До встречи, дорогая!$h",
"Anton.MarriageDialogue.funLeave_Anton.3": "Я пошёл к Лоренцо, любовь моя!",
"Anton.MarriageDialogue.funLeave_Anton.4": "Пока, солнце.#$b#Я ухожу на работу.$4#$e#Как же приятно об этом говорить, хех. Работа. У меня снова есть работа.$h#$b#И я в этом лучший!$h",
"Anton.MarriageDialogue.funLeave_Anton.5": "Приятных приключений, солнце!#$b#Не забудь, пожалуйста, принести мне еды.$4",

//Returning
"Anton.MarriageDialogue.funReturn_Anton.1": "Чао, любимый! Как прошёл твой день?^Чао, любимая! Как прошёл твой день?",
"Anton.MarriageDialogue.funReturn_Anton.2": "Милый, ты выглядишь немного уставшим.$s^Милая, ты выглядишь немного уставшей.$s#$b#Может, хочешь рассказать про свой день?#$b#А может, ты просто хочешь снять обувь и отдохнуть?#$e#Только скажи, и мы сделаем все, что ты захочешь.$h",
"Anton.MarriageDialogue.funReturn_Anton.3": "Блин, это был утомительный день!$u#$b#Надеюсь, твой день был более приятным, чем мой.$s",
"Anton.MarriageDialogue.funReturn_Anton.4": "Всегда так приятно видеть тебя дома после работы, солнце.$4#$b#Не знаю, мне кажется, что так я вижу тебя. Настоящего тебя, @.^Не знаю, мне кажется, что так я вижу тебя. Настоящую тебя, @.#$b#Того, кто устал после работы, без унции косметического средства на теле, того, что без маски, которую видят люди за пределами нашего дома.$6^Ту, кто устала после работы, без унции косметического средства на теле, ту, что без маски, которую видят люди за пределами нашего дома.$6#$b#Я чувствую себя счастливым человеком, которому ты показываешь эту сторону.$4",
"Anton.MarriageDialogue.funReturn_Anton.5": "О, слава Иобе, ты дома!$h#$b#Ты принёс мне что-нибудь от Пайка?$4^Ты принесла мне что-нибудь от Пайка?$4",

//One kid
"Anton.MarriageDialogue.OneKid_0": "Аюто! Помоги, солнце!$h#$b#Наш ребёнок только что приложил лёд к спине моей рубашки.$u#$b#Помоги мне вытащить его!$u",
"Anton.MarriageDialogue.OneKid_1": "Ой-ёй-ёй!$u#$b#Солнце, %kid1 так часто спотыкается!$u#$e#Блин, этот ребёнок такой же неуклюжий, как и ты.$6#$b#Ха-ха, я просто подтруниваю тебя.$h",
"Anton.MarriageDialogue.OneKid_2": "Ты видел %kid1, милый?^Ты видела %kid1, милая?#$b#Этот ребёнок вынослив, как лось.$h#$b#Это так очаровательно.$4",
"Anton.MarriageDialogue.OneKid_3": "Знаешь что, дорогой?^Знаешь что, дорогая?#$b#Я рад, что ты и %kid1 появились в моей жизни.$4#$b#Я чувствую себя таким довольным... Я никогда не мог просить большего.$4",

//Two kids
"Anton.MarriageDialogue.TwoKids_0": "Солнце, нам нужно запланировать поход в гости к Лоренцо и Шанис, потому что если мы не сходим к ним...#$b#...то они придут к нам.$u#$b#И поверь мне, мы не хотим этого.$u#$e#Я люблю своего брата, но... иногда он просто бывает ворчлив.$6",
"Anton.MarriageDialogue.TwoKids_1": "Я знаю, что говорил раньше, что меня устраивают только ты, %kid1 и я.#$b#Но, честно говоря, после появления %kid2 я чувствую, что наша семья стала полной.$4#$e#Нам так повезло, что мы есть друг у друга, @.$h#$b#Спасибо, что сделал это возможным.$4^Спасибо, что сделала это возможным.$4",
"Anton.MarriageDialogue.TwoKids_2": "Я всегда думал, что дети раздражают.$u#$b#Но то, что %kid1 и %kid2 бегают и радуются, заставляет меня думать, что у всего есть свои причины.$h#$b#Я рад, что вы трое появились в моей жизни.$4",
"Anton.MarriageDialogue.TwoKids_3": "Ой-ей, я надеюсь, что никто из наших не споткнётся и не упадёт.$u#$b#Паула смеялась надо мной, когда я в последний раз ходил в клинику, потому что у нашего ребёнка был ушиб колена.$u#$e#Аааа! Дети сводят меня с ума.$u#$b#Обними меня крепче, солнце!$s#$b#Хех,я в порядке.#$b#Я просто хотел обнять тебя.$4#$e#Но на самом деле ребятам нужно быть осторожнее.$u",

//Relationship-dependent
///Good
"Anton.MarriageDialogue.Good_0": "Что скажешь, если мы превзойдём Шанис и Лоренцо, дорогой?6Что скажешь, если мы превзойдём Шанис и Лоренцо, дорогая?#$b#Давай увеличим нашу семью быстрее, чем они.$h#$e#Хаха, я просто дразнил тебя!$4#$b#Но если говорить серьёзно, что ты думаешь о пополнении в семье?",
"Anton.MarriageDialogue.Good_1": "Киарра говорила о том, какой ты хороший родственник.^Киарра говорила о том, какая ты хорошая родственница.#$e#Хм, скажи мне, что ты заставил её съесть? Ты наложил на неё заклятие?$u^Хм, скажи мне, что ты заставила её съесть? Ты наложила на неё заклятие?$u#$b#Ха-ха, это просто шутка, дорогой.$h^Ха-ха, это просто шутка, дорогая.$h#$b#Это мило, что она говорила о тебе.$4",
"Anton.MarriageDialogue.Good_2": "С ума сойти, как быстро летит время.#$b#Кажется, что ещё вчера моя жизнь не имела направления.$s#$b#То есть, пока не появился ты.$4^То есть, пока не появилась ты.$4#$e#Я не знаю как, но когда я встретил тебя, каким-то образом я смог отпустить свои запреты.$6#$b#Медленно, но верно я смог снова доверять себе.",
"Anton.MarriageDialogue.Good_3": "Я никогда не задумывался о том, какой будет жизнь после катастрофы, которая произошла с семьёй Аметин.#$b#Но как же я рад, что ты есть в моей жизни.$4#$b#Ты принёс с собой солнечный свет и радость, дорогой. Спасибо тебе за то, что ты есть.$4^Ты принесла с собой солнечный свет и радость, дорогая. Спасибо тебе за то, что ты есть.$4",
"Anton.MarriageDialogue.Good_4": "%Антон, кажется, погрузился в раздумья.#$b#О, ничего, солнце.#$b#Я как раз думал о том, какие дополнения мы могли бы сделать к дому.$h",
"Anton.MarriageDialogue.Good_5": "Чёрт, милый.$4^Чёрт, милая.$4#$b#Ты прекрасно выглядишь!$h#$b#Я имею в виду, ты как вино.#$b#С каждым днём ты становишься все лучше и лучше. Мне так повезло.$4",
"Anton.MarriageDialogue.Good_6": "Я знаю, что я не очень хороший человек, но я должен был сделать что-то хорошее в своей жизни, чтобы заслужить тебя.$4",
"Anton.MarriageDialogue.Good_7": "Когда я был моложе, я видел красивый старый дом, который был так похож на особняк Аметин.#$b#Кажется, он назывался \"Casa Mariquit\", что в переводе означает \"Великолепный дом\".#$e#Поверь, этот особняк был настолько красив, что вдохновил меня заняться архитектурой.#$b#Понимаешь, я хотел иметь возможность реставрировать такие старые дома, как тот, и придавать им новый вид, сохраняя при этом их уникальный стиль.$h",
"Anton.MarriageDialogue.Good_8": "Солнце! Давай сделаем перерыв и сходим к Пайку?#$b#Мне захотелось Пикантного тунца.",
"Anton.MarriageDialogue.Good_9": "Я знаю, что не часто говорю приятные вещи, любовь моя.#$b#Но если я не говорю об этом достаточно, то я всё равно люблю тебя.$4#$b#Всегда и во всём.$4",

///Neutral
"Anton.MarriageDialogue.Neutral_0": "Аюто! Помоги, солнце!$u#$b#Я искал вдохновение для своих новых тарелок и думаю, что у меня плохой случай ментального блока.$10#$e#У тебя есть какие-нибудь предложения?$s",
"Anton.MarriageDialogue.Neutral_1": "Киарра показала мне заказ, который она сделала для мистера Ричарда.#$b#Я сказал ей, что это \"non e male\", неплохо.#$b#Но это было все - не отлично, но и не ужасно.#$e#Она решила сделать ещё один, потому что этот, как она выразилась ранее, был несовершенен.$h#$b#Я так горжусь ею. Она никогда не соглашается на меньшее.$4",
"Anton.MarriageDialogue.Neutral_2": "Дорогой, что если я начну преподавать искусство и рисование детям и взрослым?^Дорогая, что если я начну преподавать искусство и рисование детям и взрослым?#$b#Это может стать моей новой подработкой, чтобы помочь нашему будущему.$h#$b#Я могу попросить Киарру помочь мне, и таким образом детям и взрослым будет чем заняться, когда у них будет свободное время.",
"Anton.MarriageDialogue.Neutral_3": "В ближайшие дни я пойду на хребет, хорошо, солнце?#$b#Я найду хорошее тихое место, чтобы попрактиковаться в рисовании, и, возможно, если мне повезёт, я смогу заметить существо, похожее на оленя, о котором другие говорили на протяжении многих лет.$h",
"Anton.MarriageDialogue.Neutral_4": "Ты знаешь, что клубника - это не настоящая ягода?#$b#Я был совершенно потрясён, когда Юма рассказал об этом мне и Пауле.$u#$e#Я упомянул, что ему тогда было всего 6 лет?#$b#Этот ребёнок умен не по годам.$6",
"Anton.MarriageDialogue.Neutral_5": "Когда я был моложе, мне очень нравилось смотреть кулинарные шоу.#$b#Они вызывали у меня сильный голод, и я начинал искать новые вкусы, чтобы их попробовать.#$e#Я был близок к тому, чтобы изучать кулинарное искусство вместо архитектуры, понимаешь?$h#$b#Но архитектура действительно захватила меня, моё сердце - и все остальное осталось в прошлом.$4",
"Anton.MarriageDialogue.Neutral_6": "Хм, мне действительно нужно подтянуть знания о различных архитектурных сооружениях.#$b#Мадам Мейв сказала, что хочет сделать что-то не от мира сего.$u#$b#Я должен подготовиться к этому.$6",
"Anton.MarriageDialogue.Neutral_7": "Когда я в последний раз был у Пайка, Фэй рассказывала о жареном курином бедре размером с твою ладонь.#$b#Блин, у меня тогда аж слюнки потекли.$6",
"Anton.MarriageDialogue.Neutral_8": "Может, нам стоит запастись холодным пивом, солнце.#$b#Так мы можем провести прохладный вечер, не выходя из дома.$h",
"Anton.MarriageDialogue.Neutral_9": "Помню, когда я был маленьким, Лоренцо иногда брал меня за руку и приводил к киоску с мороженым.#$b#Обычно он позволял мне сначала выбрать вкус, так что если я хотел более дорогой, то он брал более дешёвый.$6#$b#Я не понимал его, пока не стал намного старше, но жертвы, на которые пришлось пойти Лоренцо ради Киарры и меня, были огромны.$h#$b#Я очень горжусь тем, что могу называть его своим братом.$h",

///Bad
"Anton.MarriageDialogue.Bad_0": "Ах, пицца, какая же она сегодня скучная.$s#$b#Разве ты никогда не хочешь пригласить меня сделать что-нибудь весёлое?$s",
"Anton.MarriageDialogue.Bad_1": "*вздох*$s#$b#Неужели так будет всегда?$9#$b#Я начинаю уставать от всего этого.$10",
"Anton.MarriageDialogue.Bad_2": "Одна вещь, которая мне действительно не нравится, - это неопределённость.$s#$b#Именно поэтому я не понимаю, почему ты продолжаешь подавать неопределённые сигналы.$a#$b#Почему ты не можешь быть честным хотя бы раз???$10^Почему ты не можешь быть честной хотя бы раз???$10",
"Anton.MarriageDialogue.Bad_3": "Заткнись. Ты меня бесишь, отстань от меня.$a",
"Anton.MarriageDialogue.Bad_4": "%Антон игнорирует вас.#$e#Может хватит уже?$7",
"Anton.MarriageDialogue.Bad_5": "Я разочарован в семейной жизни с тобой.$9#$b#Я люблю тебя, очень сильно. Но почему всё идёт таким образом?$12#$b#Ты можешь тоже что-нибудь делать для НАС?$10",
"Anton.MarriageDialogue.Bad_6": "Просто перестань говорить! Ты так раздражаешь.$7",
"Anton.MarriageDialogue.Bad_7": "Ох... Я не могу в это поверить!$a#$b#Ты такой бесполезный!$7^Ты такая бесполезная!$7",
"Anton.MarriageDialogue.Bad_8": "Хочешь знать, в чём разница между нами?$s#$b#Дело в том, что я знаю свои границы.$s#$b#А ты свои знаешь?$s",
"Anton.MarriageDialogue.Bad_9": "%Антон не хочет сейчас с вами разговаривать.",


//Flirtified 8 and 10 heart dialogues - Blair
//8 Hearts
"Blair.Dialogue.Mon8.dating": "Есть ли ещё такие милашки, как ты, там, откуда ты родом, @?$4#$b#Ха-ха! Просто шучу!$h#$b#Ха! Подловила я тебя! Смотри, какой ты красный!$7^Ха! Подловила я тебя! Смотри, какая ты красная!$7#$b#Ладно, ладно! В качестве компенсации за эту пошлую шутку я тебя поцелую!$l",
"Blair.Dialogue.Tue8.dating": "О, это ты, @! А я тебя не заметила.$4#$b#Наверное, я хожу во сне - или, быть может, я замечталась? Сейчас точно уже и не скажу.$7#$e#Видимо, я очень устала за последнее время.#$b#Можно я посплю у тебя на коленях? Пожалуйста? А ты пока тоже отдохни.$l",
"Blair.Dialogue.Wed8.dating": "Я правда не понимаю, почему моя мама так подшучивает над моим отцом.$a#$e#Если мы с тобой сойдёмся, я не хочу, чтобы мы ссорились и закончили, как мои родители. Понимаешь, милашка?$s",
"Blair.Dialogue.Thu8.dating": "%Блэр выглядит расстроенной. Наверное, сейчас лучше оставить её в покое.",
"Blair.Dialogue.Fri8.dating": "Ух, эти пару дней были тяжёлыми.$s#$e#$b#Тем не менее, я очень благодарна тебе.$4#$b#Спасибо, что выслушаешь мою бесконечную болтовню.$6",
"Blair.Dialogue.Sat8.dating": "Шон был мне очень хорошим другом.#$e#Не волнуйся, ты для меня уже не просто «друг», милашка.$4",
"Blair.Dialogue.Sun8.dating": "Если захочешь как-нибудь заглянуть, мы с Шоном планируем в ближайшее время выбраться на пикник с детьми.$h#$b#А потом, быть может, мы могли бы прогуляться в лес, и ты мог бы погоняться за мной.$h^А потом, быть может, мы могли бы прогуляться в лес, и ты могла бы погоняться за мной.$h",

//10 Hearts
"Blair.Dialogue.Mon10.dating": "Привет, приятель!$h^Привет, подружка!$h#$b#Ха-ха. Ты удивлён, милый?$l^Ха-ха. Ты удивлена, милая?$l#$e#Я правда считаю тебя своим лучшим другом.$4#$b#Ты понимаешь меня, а я понимаю тебя! Вот почему я так люблю тебя, милашка!$l",
"Blair.Dialogue.Tue10.dating": "Моя мама изо всех сил старается сдерживать шуточки.#$b#Я ценю то, что она старается ради меня.#$b#Но если она когда-нибудь снова начнёт, я знаю, что у меня есть ты, к которому я могу обратиться.$l^Но если она когда-нибудь снова начнёт, я знаю, что у меня есть ты, к которой я могу обратиться.$l",
"Blair.Dialogue.Wed10.dating": "Эй, @! Можешь закрыть на секунду свои глазки?#$b#Так, а теперь открывай.#$b#Теперь видишь, каким бы стал мой мир без тебя?$6#$b#Ха-ха, шучу-шучу. Просто мне нравится, когда твои щёки краснеют!$h#$b#*хихикает* Как сегодня обстоят дела в городе?$h#$b#Давай снова как-нибудь устроим свидание, договорились?$h",
"Blair.Dialogue.Thu10.dating": "%Блэр, похоже, мечтает.#$e#Ой! Похоже я завиталась в облаках!$h#$b#Спасибо, что разбудил меня, милашка!^Спасибо, что разбудила меня, милашка!#$b#Я только что мечтала о том, как было бы классно поймать «Легенду», которая, по слухам, живёт в горном озере города Пеликан!$h#$e#Разве это не здорово, милашка?",
"Blair.Dialogue.Fri10.dating": "Хоть мама и объяснила мне, почему она так относится к моему отцу, я всё равно скучаю по нему.$s#$e#Спасибо большое за утешение, милашка!$h#$b#Ты всегда меня поддерживаешь.$l",
"Blair.Dialogue.Sat10.dating": "Ты один из лучших людей, приехавших в город.$4^Ты одна из лучших людей, приехавших в город.$4#$b#Так что вот тебе особая награда от меня!$l#$b#%Блэр поцеловала вас.#$e#Хочешь ещё, милашка?$l",
"Blair.Dialogue.Sun10.dating": "Милашка?.. Я признаю, что иногда мне кажется, что я для тебя большая обуза, особенно потому, что я громкая, легкомысленная и всегда выплёскиваю на тебя свои проблемы...$s#$b#Но я очень благодарна, что ты всегда рядом! Поэтому я буду стараться изо всех сил быть более внимательной к твоему времени и чувствам.$l#$b#Так что, если я буду слишком много говорить, просто скажи мне, хорошо?",

//Flirtified 8 and 10 heart dialogues - Paula
//8 Hearts
"Paula.Dialogue.Mon8.dating": "Иоба мой! У тебя, как обычно, есть время посещать нашу деревню.$h#$b#Думаю, тебе нравится прохладный ветерок здесь, так?#$b#Или, может быть, тебе нравится подниматься? Хотя на самом деле я думаю, что тебе просто нравится меня навещать.$4#$b#Ха-ха, я шучу, @. В любом случае, это хорошо, что ты преодолеваешь такое большое расстояние.$h",
"Paula.Dialogue.Tue8.dating": "Киарра на днях спросила меня, как перевязать вывихнутую лодыжку.#$b#Очевидно, она часто растягивает связки.$6#$e#Эта девочка должна быть более осторожной.$a#$b#Хм, а может у неё плоскостопие... Ах, надо её осмотреть.#$e#С другой стороны! Всегда нужно заботиться о себе, верно ведь я говорю?$a",
"Paula.Dialogue.Wed8.dating": "Привет, дорогуша!$h#$b#Надеюсь, этот день принесёт тебе радость.$h#$b#Если хочешь, в следующий раз мы можем устроить пикник на Хребте.#$b#Можем пригласить Антона или, если хочешь, просто провести время вдвоём.$4",
"Paula.Dialogue.Thu8.dating": "Так приятно видеть, как твои пациенты приходят больные или ослабленные, а после нескольких сеансов и последующих занятий с тобой им становится лучше!$h#$e#Разумеется, не все пациенты идут на поправку.$s#$b#Не каждого пациента удаётся спасти...$s#$b#Но такова жизнь, это случается, и приходится искать способ пережить это.",
"Paula.Dialogue.Fri8.dating": "%Паула сильно концентрируется на чём-то.",
"Paula.Dialogue.Sat8.dating": "Прошу прощения за то, что вчера была без настроения к разговорам.#$b#Я пыталась упростить комплекс мероприятий по уходу за одним из моих пациентов.$6#$e#Я, честно говоря, немного скучала по тебе, @.$4#$b#Ха-ха, в общем... Как проходит твой день?$h",
"Paula.Dialogue.Sun8.dating": "Солнышко, ты снова здесь?#$b#Не можешь вдоволь насмотреться на меня, да?$h#$e#Я знаю, что тебе нравится приходить сюда, но не забывай отдыхать, хорошо?#$b#И обязательно пей воду, ведь поход на гору довольно утомителен.$u",

//10 Hearts
"Paula.Dialogue.Mon10.dating": "Дорогуша, чтобы поддерживать пульс, необходимо устраивать прогулки по городу.#$b#К тому же, мы ведь не хотим потерять форму, правда?$h#$e#Слушай, а может нам устроить пешее свидание?#$b#О-о, звучит захватывающе!$h",
"Paula.Dialogue.Tue10.dating": "Впервые в жизни я чувствую, что всё начинает идти хорошо.$h#$b#Особенно теперь, когда ты рядом.$l",
"Paula.Dialogue.Wed10.dating": "Раньше я думала, что всё контролирую, что всё успеваю.#$b#Но теперь я понимаю, что жизнь просто проходит. И единственное, что нам остаётся делать, это пытаться идти в ногу со временем - пытаться просто продолжать жить.#$e#Я счастлива, что до сих пор нахожусь здесь, с тобой и со всеми остальными, дорогуша.$l#$b#Я рада, что ты рядом! Я так тебя люблю.$h",
"Paula.Dialogue.Thu10.dating": "Хочу сказать тебе спасибо, @.#$b#Ты придаёшь красок каждому дню, и я действительно имею в виду это, когда говорю, что многие вещи не были бы такими же, если бы не твои частые визиты ко мне.$l#$e#Так что построй уже наконец здесь дом!$h#$b#Шучу! Никто ведь не захочет покидать дом, доставшийся в наследство от дедушки, верно?$h",
"Paula.Dialogue.Fri10.dating": "Я знаю, что всегда болтаю о здоровье, медицине и прочем.#$b#Но спасибо тебе, солнышко. Спасибо, что выслушиваешь меня, даже если я постоянно что-то бормочу.$h#$e#Было бы... Было бы чудесно состариться с тобой однажды. *кхм*$l",
"Paula.Dialogue.Sat10.dating": "Мне нравится в тебе то, что ты всегда чем-то интересуешься.$l#$b#Ты точно не хочешь когда-нибудь стать врачом?$h#$e#Я всегда готова поддержать тебя во всех твоих мечтах, солнышко!$h",
"Paula.Dialogue.Sun10.dating": "Ах, что мы только не делаем, чтобы другие могли жить.#$e#Я всегда чувствую себя замечательно, если знаю, что могу добавить годы к чьей-то жизни.$h#$b#Более того, если я могу добавить силы к их жизненному пути.$h#$e#Забавно, но ты, пожалуй, лучшее лекарство для меня, солнышко.$l#$b#Поскольку я никогда не чувствовала себя более живой с тех пор, как мы разделили тот первый поцелуй.$l",

//Flirtified 8 and 10 heart dialogues - Anton
//8 Hearts
"Anton.Dialogue.Mon8.dating": "Привет! Как дела?#$b#Надеюсь, на этой ферме тебе не будет слишком весело! Иначе ты больше не захочешь меня навещать.$s#$b#Ха-ха, просто шучу. Надеюсь, у тебя дела идут отлично.$h",
"Anton.Dialogue.Tue8.dating": "Привет, @! Вчера вечером я закончил последние штрихи на очень красивой вещи, над которой я работал.$h#$b#Хочешь взглянуть?#$b#Пару раз я порезал пальцы, когда вырезал, но результат того стоил.$h",
"Anton.Dialogue.Wed8.dating": "На днях я встретился с Мейв, и мы обменялись взглядами...#$e#Взгляд её глаз...$s#$b#Понимаю, что в душе надолго остаются плохие чувства.$s#$b#Но я буду стараться. Всё, что мы можем делать, это учиться на своих ошибках, понимаешь?#$e#О, прошу прощения. Я опять болтаю о прошлом.$s#$b#Спасибо, что выслушал...$4^Спасибо, что выслушала...$4",
"Anton.Dialogue.Thu8.dating": "Вчера мы с Паулой прогулялись по Хребту.$h#$b#Было так приятно просто побыть на природе. Кстати, я говорил с ней о тебе.$h#$b#Я рассказал ей о том, какой ты удивительный человек.$4",
"Anton.Dialogue.Fri8.dating": "Как дела?#$b#Что-нибудь нужно?#$e#Я знаю, что, возможно, я не лучший человек, чтобы просить о помощи, но... если я могу, я с радостью тебе помогу.$h#$b#Я с радостью найду время для тебя, @.$4",
"Anton.Dialogue.Sat8.dating": "Киарра на днях рассказала мне о какой-то книге, которую она прочитала об истории активизма Ферн-Айленда.#$b#Я не совсем понял всё, о чём она говорила, но мне нравится, с каким удовольствием она занимается тем, что ей нравится.#$e#Это просто удивительно, как можно быть настолько увлечённым чем-то, правда?$h",
"Anton.Dialogue.Sun8.dating": "Ещё одна неделя позади. Ещё одна неделя впереди.#$b#Обожаю новую неделю, это возможность начать что-то новое.$h#$b#Как и то, как ты появился в городе. Новое начало для удивительного человека.$h^Как и то, как ты появилась в городе. Новое начало для удивительного человека.$h",

//10 Hearts
"Anton.Dialogue.Mon10.dating": "О, привет, @! Я очень рад тебя видеть!$h#$b#Ты не поверишь, какие у меня есть идеи для новых проектов архитектуры.$h#$b#Мейв покажет, на что я действительно способен, ха-ха.$h#$e#Несмотря на то, что я всю ночь провёл в поисках идей. Эм, а могу я немного поспать у тебя на коленях, когда представится возможность?$l#$b#Если ты не занят, разумеется.$h^Если ты не занята, разумеется.$h",
"Anton.Dialogue.Tue10.dating": "@, давай в скором времени устроим свидание у пруда на Хребте.#$b#Я давно мечтал вздремнуть с тобой под облаками!$h#$e#Я даже могу попросить своих брата и сестру приготовить для нас пару блюд!$h#$b#Эй! Ну конечно, я им помогу!#$b#Буду руководить процессом.$h",
"Anton.Dialogue.Wed10.dating": "Соскучился по мне? Ха-ха!$h^Соскучилась по мне? Ха-ха!$h#$b#Я-то? Нет. Я не скучаю по тебе.$l#$b#Ну... Ладно! Может быть, немного.$h#$e#В общем, эм... Что-нибудь интересное происходит в городе Пеликан?#$b#Я бы сходил туда, но слишком уж утомительно спускаться пешком!$h#$b#Да шучу я! Конечно, я найду время, чтобы побывать там в ближайшее время!#$b#В один прекрасный день ты меня там увидишь, я зайду к тебе в гости.$h",
"Anton.Dialogue.Thu10.dating": "Как успехи, @?#$b#Надеюсь, ты не забываешь периодически находить время расслабиться и выпустить пар.$h#$e#Если вдруг почувствуешь усталость, просто скажи мне, и я прибегу к тебе, хорошо?#$b#И мы вдвоём уютно вздремнём где-нибудь!$h",
"Anton.Dialogue.Fri10.dating": "Я прекрасно провёл время в ресторанчике Пайка прошлым вечером.#$b#Этот человек действительно умеет готовить!$h#$e#Лоренцо и Киарра были немного смущены тем, насколько насыщенными стали события, но знаете ли, я люблю хорошую еду!$h#$e#Давай в следующий раз устроим там пьянку, @!#$b#Проигравший планирует следующий вечер свидания.$h",
"Anton.Dialogue.Sat10.dating": "Как дела?#$b#Надеюсь, у тебя всё складывается так, как ты этого желаешь.$h#$b#У меня? Ну, ты - это всё, чего я желаю.$l#$b#Ха-ха! Ладно, ладно, я больше не буду.$h",
"Anton.Dialogue.Sun10.dating": "Сегодня хороший день, жизнь хороша, и я чувствую себя прекрасно.$h#$b#Я и подумать не мог, что жизнь может стать лучше - пока не появился ты.$l^Я и подумать не мог, что жизнь может стать лучше - пока не появилась ты.$l",

//Extra romance dialogue for Blair, Paula, and Anton
"Romance.Engagement.Blair0": "Ты правда не мог дождаться того момента, когда наденешь мне на палец кольцо?$6^Ты правда не могла дождаться того момента, когда наденешь мне на палец кольцо?$6#$b#Иоба, должно быть, ты на седьмом небе. Ха-ха!$4",
"Romance.Engagement.Blair1": "Мама сошла бы с ума, если бы узнала об этом!$h#$b#Приготовься получить от неё крепкие объятия и поцелуи!$h#$b#У этой женщины нет границ для семьи!$u#$b#Ха-ха!$h",
"Romance.give.flowersA.Blair": "O!$h#$b#Конечно, тебе хотелось быть с самой красивой женщиной в долине.$4#$b#Наверное, это хорошо, что я принимаю твоё предложение, да, детка?$h",
"Romance.give.flowersB.Blair": "Почему бы и нет!$h#$b#Я согласна встречаться с тобой, @!$h",
"Romance.stardrop.gift.Blair": "Вот небольшой подарок к текущим событиям.$h#$b#Разве я не остроумна, детка?$h",
"Romance.rejectNPCA.Blair": "Ай, нет!$u#$b#Мне очень жаль, но ты, скорей всего, меня не понимаешь.#$b#Думаю, стоит уточнить, что ты не нравишься мне в этом смысле. Прости.$s",
"Romance.rejectNPCB.Blair": "Ай-ай-ай. Я боялась, что это случится.$s#$b#Я знаю, что люди вроде тебя обожают меня, но ты мне не нравишься в этом смысле, @.$7#$b#Я думаю, будет лучше, если мы будем просто друзьями.",
"Romance.MovieInvite.Spouse.Blair": "Ах, ты скучаешь по тому, чтобы показать меня, верно?#$b#Поэтому ты приглашаешь меня на свидание? Ха-ха!$h#$b#Хорошо, я только переоденусь. Встретимся в кино, ладно?",

"Romance.Engagement.Paula0": "О, я так счастлива!$h#$b#Не могу дождаться, чтобы рассказать об этом Антону и всей своей компании!$4#$b#Я никогда не думала, что снова буду так счастлива, @.$4",
"Romance.Engagement.Paula1": "Это правда? Я сплю? Мне кажется, что я всё ещё на седьмом небе!$h#$b#Мы должны найти время, чтобы все подготовить!#$b#Установить пункт первой помощи, а также декорации! О, столько всего нужно сделать! Я так взволнована!$h",
"Romance.give.flowersA.Paula": "Правда? Ты хочешь, чтобы я была твоей девушкой?$4#$b#Ты уверен в этом? Если ответишь 'да', пути назад уже не будет!$h^Ты уверена в этом? Если ответишь 'да', пути назад уже не будет!$h",
"Romance.give.flowersB.Paula": "Да, да! Конечно, я согласна!$h",
"Romance.stardrop.gift.Paula": "Благодаря тебе я поняла, что многое упускаю только потому, что зацикливаюсь на чём-то, что не могу контролировать.$4#$b#Так что вот тебе подарок, потому что ты для меня особенный, и я тебя люблю.$4^Так что вот тебе подарок, потому что ты для меня особенная, и я тебя люблю.$4",
"Romance.rejectNPCA.Paula": "Эм, прости. Не думаю, что знаю тебя достаточно хорошо, чтобы начать встречаться с тобой.$a#$b#Я уверена, что ты хороший человек!",
"Romance.rejectNPCB.Paula": "Прости, но я вынуждена отказаться...$s#$b#На данный момент моё сердце занято другим человеком.#$b#Хотя я не уверена, что он чувствует то же самое по отношению ко мне.$s",
"Romance.MovieInvite.Spouse.Paula": "О, хорошо!$h#$b#Мы могли бы провести время в кино.$h#$b#Иди вперёд, я тебя догоню, @.",

"Romance.Engagement.Anton0": "Это оно!$h#$b#Мы действительно собираемся обвенчаться!$4#$e#Я не могу дождаться, чтобы сообщить Пауле и брату с сестрой хорошие новости.$4",
"Romance.Engagement.Anton1": "Ух ты, не могу поверить, что кто-то остался.$6#$b#Я не могу поверить, что мы поженимся, @!$4#$b#Я люблю тебя всегда и во всех смыслах.$4",
"Romance.give.flowersA.Anton": "Хе-хе, ты уверен, что хочешь быть в отношениях со мной?$7^Хехе, ты уверена, что хочешь быть в отношениях со мной?$7#$b#Ха-ха, шучу! Я до сих пор не могу взять в толк, почему ты выбрал меня.$4^Ха-ха, шучу! Я до сих пор не могу взять в толк, почему ты выбрала меня.$4#$e#Я чувствую себя на седьмом небе.$h",
"Romance.give.flowersB.Anton": "Конечно, я с удовольствием стану твоим парнем!$4#$b#Назад дороги уже нет, понятно?$6",
"Romance.stardrop.gift.Anton": "Эй, милый?^Эй, милая?#$b#Вот тебе кое-что на память.$4#$b#Ты был так терпелив со мной и заботлив с самого начала. Я просто хотел напомнить тебе о том, какой ты особенный для меня.$6^Ты была так терпелива со мной и заботлива с самого начала. Я просто хотел напомнить тебе о том, какая ты особенная для меня.$6#$b#Так что вот, держи. Я люблю тебя.$4",
"Romance.rejectNPCA.Anton": "Ээ... Я даже не знаю тебя настолько хорошо. С чего бы это?$7",
"Romance.rejectNPCB.Anton": "Нет, не думаю.$7",
"Romance.MovieInvite.Spouse.Anton": "О, да!$h#$b#Я скучаю по общению с тобой, конечно, я пойду!$h#$b#Давай встретимся в кино. Только сначала мне нужно занести кое-какие вещи.",

"Blair.Dialogue.breakUp": "Ты можешь просто дать мне немного свободы?$a#$b#Это начинает раздражать, @.$a",
"Blair.Dialogue.danceRejection": "Нет, спасибо. У меня уже есть планы с Тринни, Кеяхи и Шоном.",
"Blair.Dialogue.divorced": "Не знаю, почему я влюбилась в такого человека, как ты.$a",

"Paula.Dialogue.breakUp": "Я прошу прощения за все, @...$s#$b#Но я не думаю, что готова к разговору с тобой. Надеюсь, ты меня поймёшь.$7",
"Paula.Dialogue.danceRejection": "О, спасибо за приглашение. Но, боюсь, я вынуждена отказаться.#$b#Сегодня у меня дежурство по оказанию первой помощи. Знаешь, много кто друг другу на ноги наступает, плюс мозоли от ношения каблуков и ремней.$h",
"Paula.Dialogue.divorced": "Я желаю тебе удачи в своих начинаниях, @, но я бы предпочла, чтобы эти \"начинания\" были подальше от меня.$a",

"Anton.Dialogue.breakUp": "Я не очень хочу говорить... Надеюсь, ты меня поймёшь.$7",
"Anton.Dialogue.danceRejection": "Э-э-э...$u#$b#Я не слишком хорошо тебя знаю, и мне неудобно танцевать.#$b#Если хочешь, попробуй спросить других.",
"Anton.Dialogue.divorced": "Просто... Держись от меня подальше с этого момента.$7",

//Summit Events
"Blair.summit.1": "%Блэр сделала глубокий вдох.#$b#Я люблю тебя, @!!!$h",
"Blair.summit.2": "Ты слышишь, как горы повторяют мои слова?$l#$b#И ещё тысячу таких же, и, возможно, вскоре они достигнут того, что сравнятся с силой моей любви к тебе!$h#$b#Никогда не устану повторять тебе это каждый день, детка!$l",

"Paula.summit.1": "Красиво, правда?$8#$b#Мы должны приезжать сюда почаще, дорогой.$h^Мы должны приходить сюда почаще, дорогая.$h",
"Paula.summit.2": "Привет... Я просто хочу сказать...$9#$b#Я рада, что ты появился в моей жизни.$l^Я рада, что ты появилась в моей жизни.$l#$b#Я каждый день просыпаюсь с улыбкой, зная, что у меня есть ты.$9#$b#Твоя улыбка... твои привычки... твои руки...$9#$b#Даже та глупая манера тереть нос, когда он чешется... Я люблю в тебе все.$9#$b#Я люблю тебя, @.$9#$b#Ты сделал мою жизнь такой же прекрасной, как вид, открывающийся отсюда... Может быть, ещё лучше.$9^Ты сделала мою жизнь такой же прекрасной, как вид, открывающийся отсюда... Может быть, ещё лучше.$9",

"Anton.summit.1": "Это вид...#$b#Эй, я думаю, мы можем построить особняк для кого-нибудь.$h",
"Anton.summit.2": "Ха-ха! Я шучу!$h#$b#Но ради тебя я бы сделал это в одно мгновение.$l#$b#Ты мотивируешь меня быть лучше и стоять на своём, когда хочется сдаться.$l#$b#Ты удивительный, и я хочу быть таким же удивительным для тебя, @.$l^Ты удивительная, и я хочу быть таким же удивительным для тебя, @.$l#$b#Спасибо, что терпеливо относишься ко мне... Я люблю тебя!$l",

//Festival Spouse Dialogues for Kiarra, Sean, Blair, Paula, and Anton
"Festivals.EggFest.Kiarra_spouse": "Украшения выглядят восхитительно, правда?#b#В этом году Кеннет, Йен и остальные члены команды действительно превзошли самих себя.$h",
"Festivals.FlowerDance.Kiarra_spouse": "Я знаю, говорила, что не буду ревновать, когда ты будешь танцевать с кем-то другим...#$b#Но не мог бы ты оставить мне свой первый танец?$4^Но не могла бы ты оставить мне свой первый танец?$4",
"Festivals.Luau.Kiarra_spouse": "Отлично, наши ингредиенты дополняют друг друга!$h#$b#Разве мы не милашки, сокровище?$h",
"Festivals.Jellies.Kiarra_spouse": "Я не могу дождаться, когда приплывут медузы.#$b#Они являются одним из источников вдохновения для моего проекта, над которым я сейчас работаю.$h",
"Festivals.StardewFair.Kiarra_spouse": "Ещё есть время подкупить судью, сокровище.$h#$b#Хаха, шучу! Я знаю, что и без этого ты справишься!$h",
"Festivals.SpiritEve.Kiarra_spouse": "Чёрт, как же мы хорошо выглядим!$h#$b#Уверена, мы здесь самая лучшая и круто одетая пара!$4",
"Festivals.IceFest.Kiarra_spouse": "Хорошо, что мэр решил отпустить рыбу после подведения итогов.#$b#Было бы бесчеловечно держать их всех. Прямо как убийство.$a",
"Festivals.WinterStar.Kiarra_spouse": "Ты готов к подарку?$4^Ты готова к подарку?$4#$b#Обязательно много поешь, у меня уже есть планы!$h",
"Festivals.Gathering.Kiarra_spouse": "Что-то в таком разделении на \"мальчик/девочка\" меня не устраивает.#$b#Но не обращай на меня внимания, сокровище.#$b#Занимайся своими делами.$h",
"Festivals.EoR.Kiarra_spouse": "Просто в тебе есть что-то такое, заставляющее меня думать, что всё будет длиться вечно...$4#$b#Спасибо, сокровище!$4#$b#Спасибо, что заставил меня поверить.^Спасибо, что заставила меня поверить.",

"Festivals.EggFest.Sean_spouse": "Пусть победит сильнейший из нас, солнце!#$b#Но я всё равно готов поспорить, что смогу найти больше яиц, чем ты!$h",
"Festivals.FlowerDance.Sean_spouse": "Итак, будет ли самый красивый партнёр танцевать со своим самым красивым мужем в долине?$h^Итак, будет ли самая красивая партнёрша танцевать со своим самым красивым мужем в долине?$h#$b#Приготовься, солнце! Я смету тебя с ног!$4",
"Festivals.Luau.Sean_spouse": "Луау, должно быть, стоит много мула-ау!$h#$b#Эй! Эти каламбуры про луау трудно придумать!$h",
"Festivals.Jellies.Sean_spouse": "Эй, солнце.#$b#Почему бы нам не найти укромное место и не покачаться вместе, как медузы?$h#$b#Ха-ха, понятно? Медузы? Качаться?$h#$b#Я уморительный!$4",
"Festivals.StardewFair.Sean_spouse": "Давай вызовем банду на бой водяными шариками, солнце!$h#$b#Уверен, это будет в тысячу раз веселее, чем просто играть на ярмарке!$h",
"Festivals.SpiritEve.Sean_spouse": "\"Духи\" готовы, дорогой!$h^\"Духи\" готовы, дорогая!$h#$b#Хе-хе, понятно?#$b#Только убедись, что они не попадутся в руки детям, иначе нам конец!$u",
"Festivals.IceFest.Sean_spouse": "Раньше я подумывал о том, чтобы надеть контактные линзы, но решил, что со своими холодными глазами я составил бы конкуренцию самому холодному льду.$h#$b#Ха-ха! Приготовься к новым каламбурам, дорогой!$h^Ха-ха! Приготовься к новым каламбурам, дорогая!$h",
"Festivals.WinterStar.Sean_spouse": "Внимание, все! Звезда пришла!$h#$b#Познакомьтесь с @, лучшей звездой, которая появилась в моей жизни!$4",
"Festivals.Gathering.Sean_spouse": "Мы должны попросить Изи и Хэйли сфотографировать самую красивую пару в долине.$h",
"Festivals.EoR.Sean_spouse": "Не думаю, что мне потом стоит трогать дрова.#$b#Я, очевидно, настолько горяч, что могу их поджечь!$h",

"Festivals.EggFest.Blair_spouse": "Хм, когда начнётся фестиваль?$a#$b#После того, как объявят победителя, может, начнём яичный бой, детка?$7",
"Festivals.FlowerDance.Blair_spouse": "Эй, детка! Разве я не прекрасна?$4#$b#Убедись, что ты не бросишь меня позже, хорошо?$h",
"Festivals.Luau.Blair_spouse": "Тебе когда-нибудь приходилось видеть, как красивая девушка поглощает еду?#$b#Приготовься, детка, я умираю с голоду.$6",
"Festivals.Jellies.Blair_spouse": "Мне не терпится увидеть медуз, детка.#$b#Флор так долго рассказывала об их светящихся свойствах, что мне кажется, будто я начала воспринимать их по-другому.$u#$b#Я должна увидеть их снова, КАК МОЖНО СКОРЕЕ.$u#$b#Пока они не потеряли свою магию в моих глазах.$9",
"Festivals.StardewFair.Blair_spouse": "Итак... Мы собираемся разделять и властвовать?#$b#Думаю, это будет лучший выбор, потому что тогда мы охватим больше территории.$h#$b#Но я также хочу проводить время с тобой, детка.$4#$b#Итак, выбирай!$h",
"Festivals.SpiritEve.Blair_spouse": "О нас заговорят в городе, детка!$h#$b#Мы выглядим так легендарно!$6",
"Festivals.IceFest.Blair_spouse": "У нас лучшая наживка в городе! Если мы не выиграем... Давай не будем об этом.$7",
"Festivals.WinterStar.Blair_spouse": "С праздником Зимней звезды, детка!$h#$b#Давай поболеем за лучшее исполненное желание!$4#$e#Я люблю тебя.$6",
"Festivals.Gathering.Blair_spouse": "Тринни и Кеяхи раньше искали Юму.#$b#Они хотели, чтобы он судил какой-то конкурс, который они придумали.$h#$b#Хочешь присоединиться к ним или, может быть, даже судить их?$h",
"Festivals.EoR.Blair_spouse": "Хе-хе, разве плохо, что я просто хочу сидеть у костра и жарить зефир с тобой и со всеми?$4",

"Festivals.EggFest.Paula_spouse": "Следи за охотниками за яйцами!$8#$b#Они в возбуждении могут растоптать тебя!$h",
"Festivals.FlowerDance.Paula_spouse": "Хе-хе, я постараюсь потом не наступить тебе на ногу, дорогой.$9^Хе-хе, я постараюсь потом не наступить тебе на ногу, дорогая.$9#$b#Но не волнуйся, у меня есть лёд на всякий случай.$4",
"Festivals.Luau.Paula_spouse": "Надеюсь, никто не принёс ингредиенты, приводящие к удушью.$7#$b#Это довольно распространённое явление, что делает его немного пугающим.$u",
"Festivals.Jellies.Paula_spouse": "Помню, как в юности я смотрела на ночное небо.#$b#Мне всегда казалось, что звезды - это люди, смотрящие на нас сверху вниз, а медузы - это просто некоторые из тех, кто упал с неба.$9",
"Festivals.StardewFair.Paula_spouse": "Дорогой, давай поищем что-нибудь поесть, пока мы осматриваемся.6Дорогая, давай поищем что-нибудь поесть, пока мы осматриваемся.#$b#Честно говоря, я ищу что-нибудь сладкое.$9",
"Festivals.SpiritEve.Paula_spouse": "Как говорится, без улыбки не бывает полного костюма!$h#$b#Надеюсь, дети не будут слишком шумными.$7#$b#Однажды Кеяхи так напугал мистера Джорджа, что у него чуть не случился сердечный приступ!$u",
"Festivals.IceFest.Paula_spouse": "Я принесла для тебя несколько горячих пакетов на случай, если у тебя озябнут руки, дорогуша.#$b#Но я читала, что контакт кожа-к-коже будет лучшим решением при замерзании.$4#$b#Так может нам стоит взяться за руки?$4",
"Festivals.WinterStar.Paula_spouse": "Ты - самое лучшее благословение, @.#$b#Я просто хочу ещё раз сказать спасибо за то, что ты со мной.$4",
"Festivals.Gathering.Paula_spouse": "Миссис Блейдбейн уговаривала меня зайти к ней в сарай и выпить с ней чаю.#$b#Мне кажется, что она будет чувствовать себя плохо, если я этого не сделаю.$6#$b#В любом случае, у тебя была возможность осмотреть прилавки?#$b#Я думаю, что в этом году побеждают девушки!$h",
"Festivals.EoR.Paula_spouse": "Я очень хочу провести ещё один год с тобой, дорогой.$h^Я очень хочу провести ещё один год с тобой, дорогая.$h#$b#За нашу любовь и за наше будущее!$4",

"Festivals.EggFest.Anton_spouse": "Помни, не говори моим братьям и сёстрам, что я вчера был свободен, хорошо?#$b#Если ты об этом забудешь, то они будут в бешенстве!$u#$b#Однако они прекрасно справились с принесёнными блюдами из яиц!$h",
"Festivals.FlowerDance.Anton_spouse": "Удивительно, как им удалось так искусно расставить цветы.#$b#Честно говоря, когда я пытаюсь это сделать, это выглядит настолько беспорядочно, что я просто сдаюсь.$6",
"Festivals.Luau.Anton_spouse": "Блин, надеюсь, каждый принёс самый вкусный ингредиент, который у него есть.#$b#Было бы обидно ждать так долго и разочароваться.$u",
"Festivals.Jellies.Anton_spouse": "Знаешь, что созвездия считаются картами для мореплавателей?#$b#Однажды в юности я попробовал выйти на самодельной байдарке на пляж ночью, используя в качестве ориентира Малую Медведицу.#$b#В итоге я всё же вернулся на берег.$4#$b#Должно быть, я сделал что-то не так.$7#$b#Но я думаю, что мне следовало использовать настоящую лодку.$h#$e#Ты можешь в это поверить? Я чуть не потерялся в море из-за своего любопытства.$h",
"Festivals.StardewFair.Anton_spouse": "Хочешь, я буду сопровождать тебя, пока ты ходишь вокруг, милый?^Хочешь, я буду сопровождать тебя, пока ты ходишь вокруг, милая?",
"Festivals.SpiritEve.Anton_spouse": "Насколько же креативны люд, украсившие эту территорию.#$b#Они смогли скоординировать декорации, несмотря на то, что некоторые элементы не совсем сочетаются друг с другом.$7",
"Festivals.IceFest.Anton_spouse": "У меня здесь есть мешок, если хочешь спрятать других рыб, которых поймаешь.$7#$b#Ха-ха, я пошутил!$h#$b#Киарра убьёт нас, если узнает, что мы сделали что-то подобное.$u",
"Festivals.WinterStar.Anton_spouse": "Я знаю, что я не самый лучший собеседник, и у нас не всегда все как солнышко и ромашка.#$b#Но я очень хочу поблагодарить тебя за все, @.$4#$b#За то, что терпеливо относишься ко мне и понимаешь каждую мелочь, которая со мной происходит.#$b#Я люблю тебя всегда и во всём, солнце.$4",
"Festivals.Gathering.Anton_spouse": "В этом году ребята становятся очень конкурентоспособными.#$b#Ну что ж, главное...#$b#Мы сможем полакомиться едой Пайка!$h",
"Festivals.EoR.Anton_spouse": "Прошёл ещё один год, и я рад, что ты не устал от меня, дорогой.$h6^Прошёл ещё один год, и я рад, что ты не устала от меня, дорогая.$h#$b#Желаю, чтобы впереди у нас было ещё много лет, @!$4#$b#Вперёд, новый год! Мы готовы к тебе.$h",

"MapString.rsv.roadsign": "` Деревня Риджсайд^@ Город Зузу",

"MovieData.Kiwi.*.Love.BeforeMovie": "Киви находиться в странном человеческом месте.#$b#Киви будет начеку!$a",
"MovieData.Kiwi.*.Love.DuringMovie": "Киви не понимать, что происходит.#$b#Но Киви любить двигающийся свет!$h",
"MovieData.Kiwi.*.Love.AfterMovie": "Киви увидеть волшебную коробку с движущимися огоньками.#$b#Киви, должно быть, стать более сильный.$h",

"MapString.rsv.aguarbasement4": "Различные заметки о магических существах.#От Великой Ведьмы Бел к моему ученику.#Это закладка на странице о русалках...#Она гласит...#'Если русалку слишком долго держали вне воды, несмотря на то, что она может дышать кислородом, у неё медленно, но постепенно начинают проявляться различные симптомы бреда или помешательства, переходящие в неизбежное безумие, если её не вернуть домой.'",

"GuestDialogue.1": "Гость: Почему мне нельзя на балкон?#Где здесь менеджер!",
"GuestDialogue.2": "Гость: Вы фермер? Вау! Круто.#Так... а почему вы здесь? В отпуске?#Надеюсь, вы не отлыниваете от работы.",
"GuestDialogue.3": "Гость: Почему в этой деревне все такие красивые?#Здесь тебе и рыжая милашка...#И горячая брюнетка...#Ну почему?!",
"GuestDialogue.4": "Гость: Когда мне показывали деревню, мне на глаза попалось катящееся киви.#О, мне вовсе не показалось это странным. Вокруг полно ферм. К тому же, здесь большой склон.#Наверняка, киви просто покатилось с одной из ферм вниз, верно?",
"GuestDialogue.5": "Гость: Прошу прощения, я вас знаю?#Тогда почему вы говорите со мной?#Опасный вы незнакомец! Аллё?! Ну!",
"GuestDialogue.6": "Гость: Я только что из спортзала отеля. Фух! Хорошая была тренировка!#Какой-то парень учил других людей тому, как добиться правильных форм. Так круто.",
"GuestDialogue.7": "Гость: Здесь есть кондиционер?#Немного холодновато, но... Я не вижу никаких больших машин или чего-то такого!#Только не говорите мне... что это магия?!",
"GuestDialogue.8": "Гость: Недавно мне встретился странный паренёк, он так странно улыбался мне.#Потом он подошёл ко мне и вдруг похлопал по спине.#Апчхи! Простите. Чую что-то неладное.#В общем... Остерегайтесь этого странного типа!",
"GuestDialogue.9": "Гость: Чего надо? Что смешного?#Хочешь подраться? Давай! Будет тебе уроком!",
"GuestDialogue.10": "Гость: Блин, батарея камеры села!#Э-эх! А мне так хотелось сфотографироваться у водопада...",
"GuestDialogue.11": "Гость: Я здесь с целью посетить храм Горного Духа.#Знаете, о нём даже слагают легенды.#Это так интересно!",
"GuestDialogue.12": "Гость: О! А вы знаете, что деревня Риджсайд раньше была обычной шахтёрской деревенькой?#Или где-то близ неё всего-навсего находилась шахта...#Приношу извинения! Кажется, мне надо перечитать материал ещё раз.",
"GuestDialogue.13": "Гость: Здравствуйте! В ресторане Пайка подают несколько чудесных блюд.#Иоба! Как же хочется взять какое-нибудь одно в дорогу!#Но у меня кончилась мелочь... Эм, можете одолжить мне немного?",
"GuestDialogue.14": "Гость: Поездка на канатной дороге была довольно страшной, но вид отсюда того стоит!#Хотя водопады вокруг создают много шума.",
"GuestDialogue.15": "Гость: Фестивали здесь одновременно милые и страшные.#Милые, потому что они кажутся уютными!#Страшные, потому что они легко могут закончится дракой едой.#А на другом нужно взаимодействовать с огнём!",
"GuestDialogue.16": "Гость: Интересно, куда делся мой кошелёк...#Клянусь, он только что был у меня!#О, Иоба! Неужели даже в этой деревне есть карманники?!#Отстой!",
"GuestDialogue.17": "Гость: Что с тем таинственным парнем на Хребте?#Он появился из ниоткуда и сказал нам держаться подальше от леса на севере!#Грубиян!",
"GuestDialogue.18": "Гость: Думаю, эта деревушка прекрасна.#Но знаете, что может быть лучше?#Крутые вечеринки по вечерам.#Это место слишком домашнее!",
"GuestDialogue.19": "Гость: Почему ты со мной разговариваешь?#Ты псих или типа того?#Вот и я о том же!",
"GuestDialogue.20": "Гость: Представляете, здесь можно увидеть куриц, которые просто гуляют сами по-себе.#Думаю, можно сказать, что те курицы свободны от общественного гнёта.#Безумие, да?#А ещё у пруда живёт черепаха.#И представляете, что она сделала? Она укусила меня за палец!#В этой деревне живут одни безумцы!#П-п-п-похоже на бред, да? Но знайте, эта сущая правда!",

"MapString.rsv.eggfest.1": "Эта курица не свободна от общественного гнёта.",

//Blair and farmer go fishing in the beach (Blair 6 heart event)
  "event-75160311.01": "О, привет, @!$h#$b#Сегодня хороший денёк для рыбалки, не так ли?",
  "event-75160311.02": "Чего ты там стоишь?$h#$b#Лучше присядь рядом со мной!$h#$b#Стесняшка, да? Или тебя пугает красивая девушка перед тобой?$7#$b#Ха-ха! Шучу я!$h",
  "event-75160311.03": "Слушай, если мне на крючок попадётся большая рыбка, поможешь мне её выловить, ладно?$h",
  "event-75160311.04": "Ах... Как это занятие расслабляет, да?",
  "event-75160311.05": "Почему я нахожусь здесь, вдали от дома, спрашиваешь?#$b#Ну, что ж, путь назад действительно неблизок.#$b#Я не часто спускаюсь сюда, на пляж города Пеликан, не говоря уже о рыбалке.#$b#Но сегодня... Я просто почувствовала, что мне необходимо побыть вдали от мамы...$a#$b#Уф! Иногда она ведёт себя чересчур, понимаешь?$a",
  "event-75160311.06": "М-да... А я всего лишь спросила её, могу ли я навестить своего отца, который живёт далеко-далеко.$s#$b#Ну, знаешь, просто проведать его и всё такое.#$b#О, да. Они разошлись. Я совсем забыла об этом упомянуть.#$b#Виновата!$h#$b#Но... эм... я не хочу говорить об этом долго...$s#$b#Дело в том, что... я просто хочу навестить его, понимаешь? Несмотря ни на что...$s#$b#Я веду себя как эгоистичная дочь по отношению к маме, желая знать, как дела у моего отца, верно?$s#$b#Надеюсь, что нет... Но она иногда так раздражает, что... Ух!$a#$b#Всё это превращается в большую неразбериху...$s",
  "event-75160311.07": "Извини, что я так странно себя веду.$h#$b#Глупая я! Всей своей драмой я, наверное, отпугиваю рыбок, да?$h",
  "event-75160311.08": "Извини за всё это.",
  "event-75160311.09": "Всё хорошо, я здесь, и я не против тебя выслушать.",
  "event-75160311.10": "Рыбкам наверняка интересна твоя драма. Продолжай в том же духе!",
  "event-75160311.11": "Да, лучше сконцентрируйся на рыбалке, рыбкам такое не по нраву.",
  "event-75160311.12": "Должна сказать... ты настоящий эксперт в том, как заставить милых девушек улыбаться.$7#$b#Ха-ха! Я просто подшучиваю над тобой!$h",
  "event-75160311.13": "Ну, если уж на то пошло... Я очень ценю, что ты выслушал мою маленькую тираду, @.$h^Ну, если уж на то пошло... Я очень ценю, что ты выслушала мою маленькую тираду, @.$h#$b#Мне жаль, но я пока не могу долго говорить об этом... Не думаю, что пока готова делиться с кем-то подробностями о семье...$s#$b#Но послушай! Я счастлива, что мне есть с кем поговорить! Ты классный, @.$h^Но послушай! Я счастлива, что мне есть с кем поговорить! Ты классная, @.$h",
  "event-75160311.14": "После ещё нескольких часов рыбалки мы с Блэр не поймали ни одной рыбы.#Тем не менее, с ней было весело общаться!",
  "event-75160311.15": "Жаль, что мы ничего не поймали!$h",
  "event-75160311.BlairShut.01": "Пожалуй, мне хочется побыть одной какое-то время, @...$s#$b#Извини, но ты можешь уйти?$s",
  "event-75160311.BlairShut.02": "Хмф...$s",

  "blair6_choice1": "Оу! Ты такой милый! Спасибо, @!$h^Оу! Ты такая милая! Спасибо, @!$h",
  "blair6_choice2": "Пф-ф! Просто помолчи, глупышка!$h",
  "blair6_choice3": "Да... мне стоит помолчать...$s%fork",

//Blair argues with Carmen (Blair 8 heart event)
  "event-75160312.01": "...так что, пожалуйста, мама. Всего один раз!$s#$b#Почему ты никогда не позволяешь мне видеться с папой?$a",
  "event-75160312.02": "Миджа (от исп. - Доча!)... Пожалуйста, пойми, это сложно объ...$s#$b#Почему бы мне не приготовить сегодня твою любимую еду, чтобы ты могла ощутить себя более...$s",
  "event-75160312.03": "Мама! Пожалуйста, воспринимай меня всерьёз!$a#$b#Мне кажется, что ты даже не слушаешь!$a",
  "event-75160312.04": "Блэр... Миджа... Может, мне просто нужно тебя обнять?$s",
  "event-75160312.05": "Мама, пожалуйста! Остановись!$a#$b#Ух!$a",
  "event-75160312.06": "Блэр!",
  "event-75160312.07": "O... @.$s#$b#Прости меня за всё это... Мне кажется, что я не очень хорошо справляюсь с ролью матери...$s#$b#Я даже не могу ответить ей как следует...$s",
  "event-75160312.08": "Понимаешь ли, @... Мы с отцом Блэр разошлись, когда она была совсем маленькой...$s#$b#Мы разошлись, потому что он изменил мне...$s#$b#Но я никогда не говорила об этом своей дочери, потому что не хотела, чтобы она ощутила, что её отец не хочет её видеть... Как ощутила однажды я...$s#$b#Это так эгоистично с моей стороны, но я думаю, что сейчас эта глупая затея обернулась против меня...$s#$b#Просто...$s",
  "event-75160312.09": "@?$s",
  "event-75160312.10": "Не окажешь мне услугу и не составишь ей компанию на некоторое время?$s#$b#Мне нужно прийти в себя, прежде чем начать разговор с ней...$s#$b#Надо найти нужные слова...$s",
  "event-75160312.11": "...$s",
  "event-75160312.12": "@?.. Мне жаль, что тебе пришлось это видеть...$s#$b#Я в самом деле ещё ребёнок, да?$s",
  "event-75160312.13": "Знаешь...$s#$b#Когда я впервые увидела, как ссорятся мои родители, первое, что пришло мне в голову, было: «Это из-за меня?»$s#$b#Это потому, что я постоянно слышала от них что-то вроде: «Ты никогда не был таким до того, как у нас появилась дочка.» или: «Подумай о будущем Блэр.».$s#$b#Я знаю, что была ещё совсем маленькой, и, возможно, я всё неправильно поняла... Но мне так показалось...$s#$b#И в конце концов пришло время, я увидела, как мой отец уходит через входную дверь в последний раз... Он даже не оглянулся на меня...$s",
  "event-75160312.14": "В момент, когда вы протягиваете руку, чтобы коснуться плеча Блэр, она вдруг продолжает свой рассказ...#Вы продолжаете внимательно слушать.",
  "event-75160312.15": "Я знаю, мой отец уже нашёл другую семью...$s#$b#Я догадываюсь о причине, и знаю, что мама скрывает её от меня...$s#$b#Я не глупая... Но почему мне кажется, что это так?$s#$b#Мне кажется, что я ничего не стою и что я была недостаточно хорошей дочерью? Словно, что могла бы быть лучше? Наверное?$s#$b#Неужели из-за меня распалась моя семья?$s#$b#Я знаю, что моя мама родила меня, когда была совсем молодой...$s#$b#Может, я украла у них молодость?$s#$b#Может же быть такое? Я не знаю...$s#$b#Всё равно я просто глупая девчонка...$8",
  "event-75160312.16": "Честно говоря, я не могу забыть своё детство...$8#$b#Я продолжаю цепляться за счастливые воспоминания, которые были у меня с ними обоими... Я продолжаю надеяться, что когда-нибудь они повторятся...$8#$b#Я продолжаю надеяться... Я продолжаю мечтать... И я продолжаю спрашивать себя, что я могла бы сделать для этого?$8#$b#Я также хочу спросить своего отца... Но, честно говоря, мне страшно видеть его и его новую семью...$8#$b#И я осознаю, что в глубине души мне страшно хочется видеть его счастливым...$8#$b#Впрочем, возможно, это ответит на вопрос, стоило ли бросать меня?$8#$b#Может, у его нового малыша будет нормальное детство... в отличие от меня...$8#$b#Честно говоря, я даже не знаю, злюсь ли я на него... У меня с ним осталось столько счастливых воспоминаний...$9#$b#О Иоба, я просто ужасна, верно?$9",
  "event-75160312.17": "Ну, наверное, пора возвращаться...$8#$b#Ух!$u",
  "event-75160312.18": "При попытке встать Блэр поскользнулась.#Вы протянули руку, чтобы схватить её, но вместо этого вас потянуло вместе с ней!",
  "event-75160312.19": "@! Ты в порядке?!$10",
  "event-75160312.20": "Пф-ф! Это было довольно забавно!$10#$b#После всей этой драмы, которую я вывалила на тебя, какой финал!$10",
  "event-75160312.21": "@?.. Спасибо...$9#$b#Спасибо, что выслушал меня.$9^Спасибо, что выслушала меня.$9#$b#Поделиться с близким человеком своими переживаниями - словно камень с души убрать...$10#$b#Несмотря на это, мы сейчас буквально плаваем вместе с рыбками.$9",
  "event-75160312.22": "На этот раз по-настоящему, давай вернёмся.$9#$b#Мама, возможно, уже начала переживать.$10",
  "event-75160312.23": "Блэр... Прости меня... Правда...$s#$b#Я никогда раньше не говорила тебе правду... Но теперь я готова...$s",
  "event-75160312.24": "Мама... всё хорошо...$9#$b#Я знаю... Я уже давно догадалась...$9#$b#Я была такой упрямой и не могла с этим мириться...$8",
  "event-75160312.25": "Миджа...$s",
  "event-75160312.26": "... Мне кажется, что это я виновата в том, что папа ушёл...$8#$b#А может, ты винила меня и просто заставляла себя любить меня...$8#$b#Я часто слышала, как ты злилась на папу, но, возможно, в глубине души ты злилась и на меня...$8#$b#П... Прости, мама...$8",
  "event-75160312.27": "Нет, милая, нет!$6#$b#Ты никогда не была причиной моей грусти...$6#$b#Наоборот... Ты - причина, по которой я так счастлива...$6#$b#Ты - причина, по которой я каждый день просыпаюсь и работаю не покладая рук... Всё ради тебя...$6#$b#Никогда не вини себя за ошибки своих родителей, ладно?$6#$b#Мне очень жаль... очень жаль за все те страдания, через которые ты прошла из-за нас...$6#$b#Прости...$6",
  "event-75160312.28": "Мама...$8#$b#Я тебя люблю...$8",
  "event-75160312.29": "И я тебя очень люблю, милая моя...$6",
  "event-75160312.30": "Похоже, отношения Блэр и Кармен наконец наладились.",
  "event-75160312.31": "Диос миджо! Блэр! Почему ты такая мокрая?$u",
  "event-75160312.32": "Хи-хи... Не обращай на это внимания. А приготовишь сегодня вечером моё любимое блюдо, пожалуйста?$10#$b#От всех этих рыданий я проголодалась!$10",
  "event-75160312.33": "Ай-яй-яй! А ну-ка, иди-ка прими ванну, а то простудишься!$4",
  "event-75160312.34": "Мы с мамой ещё немного поговорили... Беседа получилась приятной.",

//Carmen reads letters from her parents (Carmen 6 heart event)
  "event-75160315.01": "Похоже, Кармен читает какую-то почту.",
  "event-75160315.02": "\"...если тебе трудно одной растить нашу внучку, позволь нам позаботиться о ней.\"$a#$b#\"...и отправь её обратно в наш родной город.\"$a#$b#Ая-яй! О чём думают мама и папа!?$a#$b#Разве они мне не доверяют? Я сама могу прекрасно позаботиться о своей милашке!$a",
  "event-75160315.03": "@! Я тебя не заметила!#$b#Я читала письма от мамы и папы, бабушки и дедушки моей милашки, понимаешь?$s#$b#Они говорят мне, что мне нужно отправить Блэр обратно в родной город, потому что они думают, что я не могу её обеспечить!$a#$b#Как они смеют полагать, что я не могу вырастить свою малышку одна!$a",
  "event-75160315.04": "То есть... Я знаю, что у них хорошие намерения...$s#$b#Но эти слова меня очень разозлили!$a#$b#Хм!$a",
  "event-75160315.05": "Что вы думаете?",
  "event-75160315.06": "Ты хорошая мама и знаешь, что для неё лучше.",
  "event-75160315.07": "Я не думаю, что имею право голоса в ваших семейных делах.",
  "event-75160315.08": "Я думаю, что Блэр было бы лучше жить с бабушкой и дедушкой.",
  "event-75160315.09": "Я не могу представить, как можно отослать Блэр...$s",
  "event-75160315.CarmenHappy.01": "Спасибо за тёплые слова, @.$h#$b#Честно говоря, я действительно иногда сомневаюсь...$s#$b#Но наличие таких друзей, как ты, помогает мне отвлечься от этих сомнений.#$b#Я очень ценю это.$h",
  "event-75160315.CarmenHappy.02": "Ты действительно хороший друг, @! Если тебе нужна помощь в чём-либо, не стесняйся и обращайся ко мне, хорошо?$h",

  "carmen6_choice1": "Оу, как мило, @!#$b#Теперь я чувствую себя намного увереннее!$h%fork",
  "carmen6_choice2": "Ой! Прости меня, @.$s#$b#Иногда я слишком много говорю, да?$h#$b#Забудь о том, что я сказала! Хорошо?$h#$b#Семейные проблемы должны оставаться в семье.",
  "carmen6_choice3": "Что!?$a#$b#Нет, нет, нет! Я вполне способна вырастить Блэр одна - может быть, даже лучше, чем кто либо другой!$a#$b#Ух! Зачем я только тебя об этом спросила!$a",

//Blair practices how to dance (Blair 10 hearts)
  "event-75160388.01": "Блэр бросилась к вам и поцеловала!",
  "event-75160388.02": "Детка! Доброе утро!$h",
  "event-75160388.03": "Ха-ха! Я напугала тебя, да?$h#$b#Прости меня за это, но я просто очень хотела увидеть тебя сегодня!$l#$b#Ну же! Помоги мне с чем-нибудь.$h",
  "event-75160388.04": "Иди за мной!$h",
  "event-75160388.05": "Так ну... эм-м...$l#$b#Хе-хе, это неловко, но...$l#$b#Ты можешь помочь мне научиться танцевать?$h#$b#Я всегда чувствую себя неуверенно на каждом празднике Цветочных танцев, потому что выгляжу такой скованной и неуклюжей!$h#$b#А теперь, когда у меня есть ты... эта неуверенность стала ещё сильнее!$s#$b#Я просто хочу хорошо станцевать для тебя, детка.$l#$b#Хе-хе, глупо, да?$l",
  "event-75160388.06": "Я подумала, что мы можем потренироваться здесь!$h#$b#Здесь очень красивый вид, да?$h#$b#Правда, не такой красивый, как я, но всё же.$7",
  "event-75160388.07": "Ладно, итак... Думаю, стоит начать с простых шагов.#$b#Я читаю книгу \"Танцы для начинающих\", которую мне посоветовала Изабель.$h#$b#Хорошо, дай мне свою руку.",
  "event-75160388.08": "Знаешь, детка...$l#$b#Вблизи ты выглядишь намного красивее.$6",
  "event-75160388.09": "Хорошо! Хорошо! Хватит отвлекаться!$h#$b#Ты не можешь винить меня! Пфф!$h",
  "event-75160388.10": "Вы и Блэр делаете небольшие шаги туда и обратно.",
  "event-75160388.11": "Это напоминает мне о далёком счастливом воспоминании, которое я храню о своих маме и папе...$7#$b#В те редкие моменты, когда они не ссорились... когда мы просто веселились.$7#$b#Мы тоже так танцевали...$7",
  "event-75160388.12": "О! Не волнуйся, детка.$h#$b#Я в порядке... Особенно потому, что я с тобой...$l#$b#Переживая это воспоминание вместе с тобой, я чувствую, что готова двигаться дальше и взрослеть...$6#$b#Потому что я больше не зациклена на том, чтобы мои родители были рядом со мной и можно было полагаться на них во всём...$6#$b#По крайней мере, именно так я себя сейчас чувствую...$6#$b#Потому что с тобой, @, я чувствую, что могу одолеть весь мир.$h#$b#Я чувствую, что могу стать лучше.$l",
  "event-75160388.13": "Ой!$u",
  "event-75160388.14": "Блэр наступила себе на ногу.",
  "event-75160388.15": "Ха-ха! Думаю, взросление тоже может быть довольно болезненным, да?$h",
  "event-75160388.16": "@? Детка?$l",
  "event-75160388.17": "Блэр долго смотрит на ваше лицо.",
  "event-75160388.18": "Ничего.$6#$b#Я просто хотела назвать твоё имя.$6",
  "event-75160388.19": "Я люблю тебя...$6",
  "event-75160388.20": "От всех этих танцев я проголодалась!$h#$b#Хочешь перекусить у меня дома?$l#$b#Мама тоже на работе, так что...$l",
  "event-75160388.21": "Возможно, это был мой самый сладкий завтрак, детка...$6",

//Maive at the cliff (Maive 6 hearts) (earned 900,000)
  "event-75160339.01": "Добрый день, @.$h",
  "event-75160339.02": "Это @?#$b#Хочешь посетить сегодня деревню?",
  "event-75160339.03": "Хм-м...$h",
  "event-75160339.04": "Кажется, Мейв смотрит в обрыв.",
  "event-75160339.05": "Прежде чем отправиться в деревню, @...#$b#Можно тебя на пару слов?",
  "event-75160339.06": "Обещаю, что не займу много времени.$h",
  "event-75160339.07": "В последнее время я слышал о твоих достижениях и о твоей ферме и должна сказать, что это произвело на меня большое впечатление.#$b#Ты оправдал мои ожидания и, возможно, даже превзошёл их.^Ты оправдала мои ожидания и, возможно, даже превзошла их.",
  "event-75160339.08": "Твои бабушка и дедушка гордились бы тобой, @.",
  "event-75160339.09": "Почему меня так волнует твоя ферма?#$b#Хм... Думаю, что я задала довольно неопределённый вопрос, да?$h",
  "event-75160339.10": "Понимаешь, твои бабушка и дедушка были моими самыми близкими друзьями.#$b#Твой дедушка был местным фермером, а бабушка - деревенской цветочницей.#$b#Мы познакомились на одном из местных собраний, которые устраивала моя семья.$h#$b#Уже не помню, как именно расцвела наша дружба.#$b#Но все, что я знаю, так это то, что они были рядом в самые светлые и самые тёмные дни для меня.$h#$b#Я любила их как родных...$s",
  "event-75160339.11": "Я знала все о наследстве, которое оставил тебе твой умирающий дедушка. Но ты был ещё ребёнком, когда это случилось.$s^Я знала все о наследстве, которое оставил тебе твой умирающий дедушка. Но ты была ещё ребёнком, когда это случилось.$s#$b#Так что пока тобой не было предъявлено требований на землю, я присматривала за участком, чтобы с ним ничего не случилось.#$b#Честно говоря, у меня были некоторые сомнения на твой счёт.$s#$b#Но я не посмела бы пойти против воли своих старых друзей.$a#$b#Поэтому я внимательно слежу за тобой.$h",
  "event-75160339.12": "Продолжай в том же духе, @.$h#$b#Буду с нетерпением ждать, каким будет твоё следующее достижение.$h",
  "event-75160339.13": "Если тебе будет нужна помощь в чём-либо, не стесняйся спрашивать.$h",

//Shanice looking over Zuzu (Shanice 8 heart event)
  "event-75160360.01": "Доброе утро, дорогуша.$h#$b#Я как раз собиралась отдохнуть около утёса.#$b#Хочешь составить мне компанию?",
  "event-75160360.02": "О, как чудесно. Пошли!$h",
  "event-75160360.03": "От сюда открывается великолепный вид. Как думаешь?$h",
  "event-75160360.04": "Здесь сплошная природа и сельские городки.#$b#Все просто. И в то же время элегантно?#$b#Хм-м...$s",
  "event-75160360.05": "Хотя иногда мне хочется, чтобы отсюда был виден город Зузу.#$b#Может быть, я болею дома? Или, может быть, я всё ещё сомневаюсь в том, что мы переехали сюда из города.$s",
  "event-75160360.06": "Знаешь, после того как мы с мужем поженились, ещё в Зузу, у нас обоих была приличная работа.#$b#Но когда Антон захотел поступить в университет, Киарре понадобился человек, который бы присматривал за ней.$s#$b#В конце концов, тогда она была ещё очень юной. Мы с Лоренцо волновались за неё и за магазин.$s#$b#Брат и сестра не хотели бросать семейный бизнес.#$b#Поэтому Лоренцо вернулся домой один.$s#$b#По сути, мы были в браке на расстоянии в течение нескольких лет.$s#$b#Через некоторое время я поняла, что это не совсем здорово. Поэтому решила переехать сюда, в Риджсайд, вместе с мужем и управлять магазином вместе с ним.",
  "event-75160360.07": "Но это было очень давно.$s#$b#Теперь два моих зятя уже не такие маленькие.$s#$b#Так почему же мы с мужем всё ещё остаёмся здесь?$s#$b#Честно говоря, я думаю, что Лоренцо всё ещё остаётся здесь, потому что он очень заботится о них двоих. Он очарователен.$4#$b#Я их очень люблю - они моя семья.$h#$b#Но я не могу отделаться от чувства, что растратила свой потенциал...$s#$b#Все ради любви? Или, может быть, я уже достигла своего пика и просто ещё не смирилась с этим?$s#$b#Дорогуша. Это действительно есть то, над чем можно подумать.$s",
  "event-75160360.08": "Эти мысли то приходят, то уходят.#$b#Но я думаю... Думаю, что просто ищу новую цель в жизни. Ты понимаешь, о чём я?$s#$b#Я настолько целеустремлённый человек, что без цели я не чувствую никакой мотивации.$s#$b#До этого я была учительницей. Готовила молодые умы для светлого будущего.#$b#Затем я стала менеджером магазина - это была большая перемена, но я научилась!$h#$b#Но в последние дни я чувствую, что это превратилось в монотонную рутину. Но такова жизнь.s",
  "event-75160360.09": "Ну, хорошо. Однажды я снова найду свою цель.",
  "event-75160360.10": "Тяжеловато было, да, дорогуша?#$b#Прошу прощения. Но мне просто легко говорить о своих проблемах с таким хорошим другом, как ты.#$b#Я очень ценю твоё общество, @. Спасибо.$h",
  "event-75160360.11": "О, Иоба! Посмотри на время!$u#$b#Мне пора возвращаться, дорогуша.#$b#У меня ещё много работы.$h",
  "event-75160360.12": "Шанис, казалось, чувствовала себя немного лучше, когда могла говорить о своих проблемах.",
  "event-75160360.13": "Я часто говорю со своим мужем о том, что мы обсуждали ранее, но мне было приятно высказаться и перед тобой, @.$h",

//Sean 14 Heart Event (Part 2 - Cloud Gazing)
  "event-75160370.01": "*зевает*",
  "event-75160370.02": "Блин, это может быть слишком расслабляющим.$h",
  "event-75160370.03": "Дорогой! Дорогой! Смотри!$h^Дорогая! Дорогая! Смотри!$h#$b#Я думаю, что у нас здесь хороший набор облаков.",
  "event-75160370.04": "Вы смотрите на облака и видите группу облаков причудливой формы.",
  "event-75160370.05": "Посмотри на это! Оно похоже на сердце.#$b#Это романтично... и очень удобно, как думаешь?$h",
  "event-75160370.06": "Эй! Посмотри на это! Оно похоже на ящерицу.#$b#Или на какого-нибудь динозавра!$h#$b#Ты видишь это, дорогой?^Ты видишь это, дорогая?#$b#Знаешь...$l#$b#Если бы я был динозавром и жил без тебя...#$b#То был бы 'Тираннозавром-Разрушителем'.$l#$b#Ха-ха!$h",
  "event-75160370.07": "Эй... Подожди минутку...#$b#Разве это маленькое облачко не похоже на Кеяхи?$u#$b#А рядом с ним похоже на фрукт или что-то вроде того!$h#$b#Я думаю, это помидор, дорогой!$u^Я думаю, это помидор, дорогая!$u#$b#О нет... Я вспомнил о том, как кто-то подарил Кеяхи запас помидоров!$u#$b#*вздрагивает* Это был страшный день. Он был жесток с нами, своими жертвами.$u#$b#Интересно, где он достал эти помидоры...",
  "event-75160370.08": "*зевает*",
  "event-75160370.09": "Это мило... Правда?$l",
  "event-75160370.10": "Шон повернулся к  вам лицом.",
  "event-75160370.11": "Эй, солнце?$l#$b#Прежде чем я внезапно *зевок* засну.$h#$b#Я просто хочу сказать, что очень ценю то, что ты подыгрываешь моим глупым идеям, как эта...$l#$b#Я знаю, что иногда могу быть беспокойным или слишком многого не успеваю...$l#$b#У меня часто бывают проблемы с концентрацией внимания... И я знаю, что это может раздражать...$s#$b#Но ты всегда поддерживаешь меня во всём.$l#$b#Я просто думаю, что это очень здорово, что у меня есть такой человек, как ты, с которым я буду просыпаться всю оставшуюся жизнь.$l#$b#Я люблю тебя, @...$l#$b#Я очень-очень-очень-*зевок*-ЛЮБЛЮ тебя!$h#$b#Ха-ха! Блин! Я, наверное, уже сплю, потому что мне сейчас снится такой замечательный сон.$l#$b#Мы просто... расслабляемся... под забавными облаками!$h",
  "event-75160370.12": "Хотя, если серьёзно, то облако, похожее на Кеяхи, было просто жутким!$u#$b#Как будто этот ребёнок везде, детка! Он не человек!$u",
  "event-75160370.13": "Вы с Шоном провели ещё несколько часов, любуясь облаками.#В конце концов, вы оба заснули в объятиях друг друга.#Правда, после этого все очень чесалось.",
  "event-75160370.14": "Солнце! Прости, я забыл принести одеяло!$u#$b#Ай! чешется!$u",
  "event-75160370.15": "Чешется, чешется, чешется! Ой!$u",

//Naomi cooking (Naomi 6 heart event)
  "event-75160347.01": "...Я не уверена, что делаю это правильно.$s",
  "event-75160347.02": "@? Я не ждала сегодня гостей.#$b#Прошу прощения за беспорядок на кухне, я готовила.",
  "event-75160347.03": "Точнее, пытаюсь готовить.$s",
  "event-75160347.04": "Сейчас я объясню.",
  "event-75160347.05": "Наоми взяла с полки фотографию.",
  "event-75160347.06": "Она показывает вам фотографию иностранного блюда.",
  "event-75160347.07": "Это блюдо - фирменное блюдо моего мужа, Шото, главного повара в семье.#$b#Я знаю толк в кухне, но не на его уровне.$s",
  "event-75160347.08": "Вернёмся к теме - недавно мой муж прислал экзотические ингредиенты и рецепт этого блюда.#$b#Но у меня никак не получается!$s",
  "event-75160347.09": "Что мне сказать?",
  "event-75160347.10": "Давай я тебе помогу?",
  "event-75160347.11": "Ну, удачи!",
  "event-75160347.12": "О, мне точно понадобится 'удача'!$s",
  "event-75160347.13": "Может, мне нужно просто позвонить мужу, пока я готовлю блюдо?$s",
  "event-75160347.HelpNaomi.01": "Хм? Ты правда хочешь мне помочь?#$b#О! Похоже, ты меня не так понял! Мне не надо помогать!$h^О! Похоже, ты меня не так поняла! Мне не надо помогать!$h#$b#Но спасибо за предложение, @.$h",
  "event-75160347.HelpNaomi.02": "Я прошу прощения, что отклонила его.$s#$b#Понимаешь, я сказала своему мужу, что сама прекрасно приготовлю это блюдо.$h#$b#Он не перестаёт дразнить меня за мои кулинарные способности!$a#$b#Он даже пошутил, что Юма и Широ должны приготовить это блюдо вместо него!$a#$b#В общем, моё самолюбие задето. Так что я заставлю взять свои слова обратно.$h",
  "event-75160347.HelpNaomi.03": "Я не отступлюсь от этого блюда!$a",

//Anton's feelings (Anton 6 heart event)
  "event-75160303.01": "Выглядит неплохо, верно?",
  "event-75160303.02": "Немного, наверное?",
  "event-75160303.03": "... ты правда так думаешь, Тон?$s#$b#Я тоже собиралась использовать это как референс.$s",
  "event-75160303.04": "Эх. Это не соответствует теме, которую ты выбрала.#$b#Ты придумываешь обои для гостиной, а не для спальни.$h",
  "event-75160303.05": "Пф! Ладно, ладно! Пойду поищу ещё дизайны в «Pinstagram».$h",
  "event-75160303.06": "Хм? О, привет, @.#$b#Не обращай на нас внимания. Я просто болтался здесь, а потом Киарра начала доставать меня по всяким пустякам.$h",
  "event-75160303.07": "Извините! Я ищу вдохновения для дизайна моей текущей работы!$h#$b#И я прошу помощи у этого ленивого архитектора, потому что у него может быть хоть какое-нибудь да профессиональное понимание.",
  "event-75160303.08": "Ой, да ладно! Не думаю, что я подходящий человек для...",
  "event-75160303.09": "О! Выглядит неплохо!$h#$b#Погляди, Тон!$h",
  "event-75160303.10": "Признаю, выглядит неплохо.#$b#Может быть, немного безвкусно?$h",
  "event-75160303.11": "Тебя ничего не впечатляет, да?$h#$b#Эй, @! Взгляни-ка на это!$h",
  "event-75160303.12": "«Pinstagram» - это приложение, показывающее различные фотографии.#Когда вы пытаетесь прокрутить страницу немного вниз, то случайно нажимаете на фотографию женщины и мужчины.",
  "event-75160303.13": "Упс! Всё в порядке, мы можем просто прокрутить страницу назад.$u",
  "event-75160303.14": "Погоди! Разве это не?..$s#$b#О... Она выглядит такой счастливой, да?$s",
  "event-75160303.15": "Э... Давай  вернёмся к дизайну?$s",
  "event-75160303.16": "Хмф...$s",
  "event-75160303.17": "Киарра кладёт телефон.#Она смотрит на вас, потом снова на брата.",
  "event-75160303.18": "Эй, Тон? Ты в порядке?$s",
  "event-75160303.19": "Да, конечно! А почему ты спрашиваешь?$6#$b#Эм...$s#$b#Ребят, хотите перекусить у Пайка или ещё где-нибудь?#$b#Может даже выпить?$6",
  "event-75160303.20": "Конечно, бро! Я заплачу.#$b#Пошли, @!$h",
  "event-75160303.21": "Ты хорошо себя чувствуешь, братан?$s",
  "event-75160303.22": "*отрыжка* Ах! Спасибо за угощение, сестрёнка!$h",
  "event-75160303.23": "Пожалуйста!$h#$b#Теперь продолжим с...$h",
  "event-75160303.24": "Ой! Извините, кто-то звонит.$u",
  "event-75160303.25": "Алло?#$b#О! Ленни! Привет!$h#$b#А? Что значит, я нужна тебе прямо сейчас?$u#$b#Но-$s#$b#Хорошо! Хорошо! Уже иду!$s",
  "event-75160303.26": "Простите, ребята! Но Ленни, похоже, в панике или близка к ней.$s#$b#Тон? Ты не против, если я уйду?$s",
  "event-75160303.27": "Без проблем, сестрёнка.$6#$b#Можешь идти!$6",
  "event-75160303.28": "Ну, потому что, знаешь...$s#$b#Неважно. Я поверю тебе на слово.$s#$b#Хорошо, увидимся позже!#$b#@! Присмотри за этим здоровяком, ладно?$h",
  "event-75160303.29": "Антон опускает взгляд.",
  "event-75160303.30": "Хех.$6",
  "event-75160303.31": "Эй, @. Та фотография...$6#$b#Как думаешь, та пара выглядела счастливой?$6",
  "event-75160303.32": "Прежде чем вы успеваете ответить, Антон прерывает вас.",
  "event-75160303.33": "Не... Уже неважно.$s#$b#Я всё равно ничего не могу с этим поделать.$s",
  "event-75160303.34": "Кто же эти люди?",
  "event-75160303.35": "Эта женщина была моей бывшей невестой.$s#$b#А парень? Ну, я думаю, она нашла кого-то другого...$s#$b#И похоже, что они вполне счастливы... Я заметил кольцо на её пальце...$s#$b#Я не виню её... В конце концов, столько лет прошло.$s",
  "event-75160303.36": "Хех. Отвратительно. Это чувство - отстой.$s#$b#Признаюсь, это убивало меня каждую ночь, от постоянных мыслей «А что, если», понимаешь?$s#$b#Как долго я дулся? Кто знает?$s#$b#Честно говоря, с тех пор, как я вернулся домой, чувствую себя большой обузой для окружающих...$s#$b#Для моих брата и сестры, моей невестки, даже для моих друзей, как Паула или ты...$s#$b#Я хочу измениться, но...$s#$b#Хм-м...$s",
  "event-75160303.37": "Мне кажется, что на меня навалился дом...$s#$b#Как будто трудно двигаться... Быть мотивированным...$s#$b#Это хреново...$s#$b#Может, я просто очень ленивый?",
  "event-75160303.38": "Что мне сказать?",
  "event-75160303.39": "(Промолчать.)",
  "event-75160303.40": "Ну так сделай же что-нибудь с этим.",
  "event-75160303.41": "Не торопись. У тебя получится!",
  "event-75160303.42": "Ну что ж. Рано или поздно мне придётся что-то с этим делать.#$b#Это помогает... Если есть с кем поговорить... То это действительно помогает, @.$s#$b#Спасибо.$h",
  "event-75160303.43": "Эй... Не хочешь заказать напитки?$h#$b#В качестве извинения  за выслушивание моей болтовни.$h",
  "event-75160303.44": "Хех. Ты хороший человек, @.#$b#Спасибо за внимание.$h",
  "event-75160303.45": "Фух! Я наелся!$h",

  "anton6_choice1": "Хм-м...$s",
  "anton6_choice2": "Я знаю...$s",
  "anton6_choice3": "Хех... Может быть...$s",

//Anton fixes Paula's lights (Anton 8 heart event)
  "event-75160304.01": "Антон, я правда думаю, что нам нужно просто позвонить Кеннету...$s#$b#Ты вообще уверен в том, что делаешь?$6",
  "event-75160304.02": "О, да ладно! Для меня это не должно быть трудно! В конце концов, я зарабатываю на жизнь строительством домов.$h#$b#Кроме того, разве ты не должна радоваться, что я проявляю инициативу?$h",
  "event-75160304.03": "Думаю, да, но это опасно!$6#$b#И эта лестница выглядит ужасно ржавой - как-будто вот-вот сломается!$a",
  "event-75160304.04": "Поверь! Всё будет в по...$h#$b#А-а!$u",
  "event-75160304.05": "Ай!$s",
  "event-75160304.06": "Антон!$s",
  "event-75160304.07": "Антон, у тебя рука в крови.$s#$b#Не двигайся.$s#$b#@, поможешь?$s",
  "event-75160304.08": "Ух... Одна неприятная царапина...$s",
  "event-75160304.09": "Паула обработала рану Антона.",
  "event-75160304.10": "Нужно продезинфицировать рану.$s#$b#Но я не могу найти раствор повидон-йода.$s#$b#Должно быть, я оставила его у Ленни!$s",
  "event-75160304.11": "@, ты можешь присмотреть за Антоном?$s#$b#Я вернусь как можно скорее.$s",
  "event-75160304.12": "   ",
  "event-75160304.13": "Хорошо. Я останусь и поговорю с Антоном до твоего возвращения.",
  "event-75160304.14": "Я схожу за повидон-йодом. Тебе нужно побыть с Антоном... Ты нужна ему прямо сейчас.",
  "event-75160304.15": "Хех. Я жалок, правда?$6#$b#В тот момент, когда я действительно что-то пытаюсь сделать, я снова терплю неудачу...$6#$b#Весь мир настроен против меня.$6",
  "event-75160304.16": "В чём смысл всего этого?$6#$b#Я бы всё равно потерпел неудачу!$7#$b#Я ни на что не гожусь...$7#$b#Я ничтожество, правда?$6",
  "event-75160304.17": "Что мне сказать?",
  "event-75160304.18": "Антон...",
  "event-75160304.19": "Всё хорошо...",
  "event-75160304.20": "Нет, это не так!",
  "event-75160304.21": "Только посмотри на меня!$6#$b#Я - огромное бремя для всех, кто меня окружает.$6#$b#Я даже прячусь от Аметинов, потому что я такой трус!$6#$b#А теперь моя бывшая невеста выходит замуж... Она идёт дальше, а я застрял в прошлом...$6#$b#Мои братья и сёстры, кажется, справляются лучше меня...$6#$b#Я просто трачу время каждого!$8#$b#Наверняка мои покойные родители тоже стыдились бы меня.$8",
  "event-75160304.22": "Что мне сказать?",
  "event-75160304.23": "(Попытаться дотронуться до его плеча)",
  "event-75160304.24": "Антон, успокойся...",
  "event-75160304.25": "Ты всё ещё можешь встать на ноги и жить полной жизнью.",
  "event-75160304.26": "Да я даже не могу починить дурацкую лампочку!$8#$b#Ничтожество!$8",
  "event-75160304.27": "Что мне сказать?",
  "event-75160304.28": "Всё хорошо.",
  "event-75160304.29": "Выпусти всё наружу.",
  "event-75160304.30": "Ты перегибаешь палку.",
  "event-75160304.31": "Ты можешь ОСТАНОВИТЬСЯ!?$9#$b#Почему ты вообще здесь? Ты зря тратишь время!$9",
  "event-75160304.32": "Прости...$11",
  "event-75160304.33": "Что мне делать?",
  "event-75160304.34": "(Обнять его.)",
  "event-75160304.35": "Тебе не нужно извиняться передо мной. Я твой друг, и я всегда буду рядом с тобой.",
  "event-75160304.36": "Вы обняли Антона.#Вы чувствуете его дрожащую попытку обнять вас в ответ, по его лицу текут слёзы.",
  "event-75160304.37": "Прости, @...$11#$b#Я не хотел повышать на тебя голос...$11#$b#Я просто...$11#$b#Я чувствую себя потерянным...$11",
  "event-75160304.38": "Антон обнял вас крепче.",
  "event-75160304.39": "Ещё раз извиняюсь за то, как я себя вёл, @...$11#$b#И... Спасибо, за то, что ты здесь...$10",
  "event-75160304.40": "Я вернулась с повидон-йодом!",
  "event-75160304.41": "Антон вытер слёзы.",
  "event-75160304.42": "Ай! Я забыл о своей ране!$l#$b#Давай позволим доктору Пауле приступить к работе, хорошо?$h",
  "event-75160304.43": "Всё хорошо?$s#$b#Мне показалось, что я слышала крик Антона, когда была снаружи.$s",
  "event-75160304.44": "Да, я просто вёл себя странно и расстроился.$6",
  "event-75160304.45": "Но сейчас я в порядке.$h#$b#Благодаря @.$h",
  "event-75160304.46": "О! Э-э-э... Понятно...$7#$b#Я думаю... М-м-м...$s",
  "event-75160304.47": "Эй, @.$8#$b#Это средство простое в применении. Просто нанеси немного повидон-йода вокруг раны.$8#$b#... Только осторожней...$7#$b#Я, э-э-э... Буду у стойки. Мне нужно прибрать некоторые бумаги и прочее...$9",
  "event-75160304.48": "Эй, Пау? Что случилось?#$b#Ты выглядишь подавленной.$s#$b#Моя рана настолько серьёзная?$s",
  "event-75160304.49": "Не волнуйся, всё в порядке. Особенно после того, как @ применит лекарство для обработки раны.$9#$b#Мне просто... э-э-э... Нужно кое-что сделать.$9#$b#Если я понадоблюсь, позови, хорошо?$8",
  "event-75160304.50": "Хех. Хорошо, Пау.$h",
  "event-75160304.51": "Ну...$6#$b#Будь помягче, ладно?$h",
  "event-75160304.52": "Вы держите руку Антона и применяете раствор.",
  "event-75160304.53": "Ай! Жжёт.$u",
  "event-75160304.54": "Хех...$l",
  "event-75160304.55": "Кажется, Антон сейчас улыбается.",
  "event-75160304.56": "Ты прав, @.^Ты права, @.#$b#Я должен не спешить и встать на ноги.$h#$b#Спасибо, что был рядом со мной и выслушал.$6^Спасибо, что была рядом со мной и выслушала.$6",
  "event-75160304.57": "Антон уже не кажется таким подавленным. Вы рады...",
  "event-75160304.PaulaStays.01": "Хех. Я жалок, правда?$6#$b#В тот момент, когда я действительно что-то пытаюсь сделать, я снова терплю неудачу...$6#$b#Весь мир настроен против меня.$6#$b#В чём смысл всего этого?$6#$b#Я бы всё равно потерпел неудачу!$7#$b#Я ни на что не гожусь...$7#$b#Только посмотри на меня!$6#$b#Я - огромное бремя для всех вокруг. Я даже прячусь от Аметинов, потому что я такой трус!$6#$b#А теперь Мария выходит замуж... Она движется дальше, а я застрял в прошлом...$6#$b#Лоренцо застрял, заботясь обо мне, Киарре я больше не нужен...$6#$b#Я просто трачу время каждого!$8#$b#... Наверняка мои покойные родители тоже стыдились бы меня.$8#$b#Да я даже не могу починить дурацкую лампочку! Ничтожество!$8",
  "event-75160304.PaulaStays.02": "Что?! После всего ты даже не собираешься мне ничего сказать?$9",
  "event-75160304.PaulaStays.03": "Антон... я...$s",
  "event-75160304.PaulaStays.04": "Я опять всё испортил, Пау...$s#$b#Как всегда...$6#$b#Хех. Бесполезный я.$8",
  "event-75160304.PaulaStays.05": "А?$11",
  "event-75160304.PaulaStays.06": "Ты же знаешь, что не должен справляться со всем в одиночку?$9#$b#Я знаю, что ты держишь все эмоции внутри... С тех пор как...$7#$b#И я знала это... Но я никогда ничего не говорила... Я никогда ничего не делала...$10",
  "event-75160304.PaulaStays.07": "Паула... Я...$11",
  "event-75160304.PaulaStays.08": "Паула вытерла слёзы.",
  "event-75160304.PaulaStays.09": "Но теперь я здесь, Антон...$8#$b#Я здесь, чтобы выслушать... и побыть твоим плечом, чтобы ты мог поплакаться...$8#$b#Я всегда была здесь...$11#$b#Хах, я не могу остановить поток воды. Какая же я глупая.$11",
  "event-75160304.PaulaStays.10": "Антон обнял Паулу в ответ.",
  "event-75160304.PaulaStays.11": "Я знаю, что ты всегда была рядом, глупышка...$10#$b#Это моя вина, что я держу все эти эмоции в себе...$10#$b#Я просто думал, что было бы странно, если бы так расчувствовался перед тобой.$11",
  "event-75160304.PaulaStays.12": "Глупости! Почему это должно быть странно?$11#$b#Мы дружим с давних пор! Ты всегда много плакал, когда мы были маленькими! Ты большой плакса!$11",
  "event-75160304.PaulaStays.13": "Не-а! Это ты всегда была плаксой!$10#$b#Мне было непонятно, почему ты хочешь стать врачом, ведь ты плакала каждый раз, когда видела кровь!$10",
  "event-75160304.PaulaStays.14": "Эй! Это было очень давно!$11",
  "event-75160304.PaulaStays.15": "Дурак...$11",
  "event-75160304.PaulaStays.16": "Нет, это ты...$10",
  "event-75160304.PaulaStays.17": "*Кхе*$6",
  "event-75160304.PaulaStays.18": "Эм...$9",
  "event-75160304.PaulaStays.19": "Скажите, док?$6#$b#Теперь, когда @ снова здесь, как насчёт того, чтобы достать лекарство для моей раны, а?$l",
  "event-75160304.PaulaStays.20": "О! Да, конечно!$l#$b#Это ты виноват, что отвлёк меня!$l",
  "event-75160304.PaulaStays.21": "Хех. Правда, да?$l",
  "event-75160304.PaulaStays.22": "Вот, дай мне руку...$9",
  "event-75160304.PaulaStays.23": "Не шевелись, хорошо?$8",
  "event-75160304.PaulaStays.24": "Эй, Пау?..$6#$b#Спасибо за терпение ко мне...$6#$b#Теперь я успокоюсь. И я обещаю, что мне будет лучше.$6",
  "event-75160304.PaulaStays.25": "Поменьше разговоров, побольше отдыха...$8#$b#Маленький «Плак-тон»...$4",
  "event-75160304.PaulaStays.26": "Эй! Я думал, мы забыли об этом прозвище!$6",
  "event-75160304.PaulaStays.27": "Кажется, рука Антона больше не беспокоит его... Что же произошло, пока вас не было?",
  "event-75160304.AntonPlatonic.01": "Спасибо, @. Я очень благодарен, что у меня есть такой друг, как ты, понимаешь?$10#$b#Может быть, я не... не чувствую себя сейчас на седьмом небе...$11#$b#Но это не значит, что я не смогу пройти через это... Верно?$11",
  "event-75160304.AntonPlatonic.02": "Похоже, Паула вернулась. Думаю, пора подлатать мою рану, а?$1#$b#Блин, без вас двоих, я не знаю, как бы я выжил. Думаю, несмотря на всё это, я могу считать, что мне в чём-то повезло...$4",
  "event-75160304.AntonPlatonic.03": "Даже если Антон не верит в себя, вы знаете, что он скоро встанет на ноги.",

  "anton8_place": "Хм...$6",
  "anton8_choice1": "Спасибо, @. Я сейчас вернусь!",
  "anton8_choice2": "А? Да?$s#$b#Хорошо... Ну, повидон-йод должен быть в коричневом флаконе на её кухонном столе.#$b#... Спасибо, @. Я ценю это.$8%fork",
  "anton8_choice3": "Что?$3",
  "anton8_choice4": "... Хмф. Так ты это имеешь в виду?$11%fork",
  "AntonLikesFarmer.Anton": "Эй! Спасибо, что терпел меня, когда я был в самом тяжёлом состоянии.$h^Эй! Спасибо, что терпела меня, когда я был в самом тяжёлом состоянии.$h#$b#Ты лучший, @.$l^Ты лучшая, @.$l",
  "AntonLikesFarmer.Paula": "Спасибо за заботу об Антоне, @.$8#$b#Будь рядом с ним, хорошо?$9",
  "AntonLikesPaula.Anton": "Извини за весь этот беспорядок, @...$s#$b#И спасибо, что помог Пауле позаботиться обо мне.^И спасибо, что помогла Пауле позаботиться обо мне.",
  "AntonLikesPaula.Paula": "Антон будет в порядке. Ещё раз спасибо, что принёс повидон-йод.^Антон будет в порядке. Ещё раз спасибо, что принесла повидон-йод.#$b#Этот старый болван быстро поправится.$l",

//Paula drinking buddy (Paula 6 heart event)
  "event-75160351.01": "@! Привет!$h",
  "event-75160351.02": "Привет, @.$h#$b#Сегодня прекрасная ночь, чтобы выпить, не правда ли?#$b#Присоединяйся к нам!$h",
  "event-75160351.03": "Ага! Нашёл!$h",
  "event-75160351.04": "О, нет. Вот оно!$s",
  "event-75160351.05": "Отлично! Мы скоро начнём.!$h",
  "event-75160351.06": "В этот раз ещё лучше! Этот ром крепче, чем тот, что я дал тебе в прошлый раз!$h",
  "event-75160351.07": "Что происходит?",
  "event-75160351.07.5": "Эм... Мне нужно идти...",
  "event-75160351.08": "Эй! Давай! Какое совпадение!$s",
  "event-75160351.09": "Это точно так?$h",
  "event-75160351.10": "Говори за себя, братишка!$h",
  "event-75160351.11": "Хорошо! Начинаем жеребьёвку!$h",
  "event-75160351.12": "Скажи, @. Хочешь присоединиться?$h#$b#Давай! Это будет весело!$h#$b#И не волнуйся! Если что-то пойдёт не так, с нами будет врач! Правда, Тита?$h",
  "event-75160351.13": "Не стоит полностью полагаться на меня, понимаешь?$6#$b#Но всё равно будет весело, несмотря ни на что!$h#$b#Что скажешь, @?",
  "event-75160351.14": "Хотите присоединиться к игре?",
  "event-75160351.15": "Конечно! Давайте поиграем!",
  "event-75160351.16": "Ничего, если я просто посмотрю?",
  "event-75160351.17": "Добро пожаловать на борт, @!$h#$b#Удачи тому, кого выберут!$h",
  "event-75160351.18": "Хорошо! Я добавила имя «@» в нашу маленькую коробку.#$b#А теперь я назову два имени...$h",
  "event-75160351.19": "Интересно, кто сегодня напьётся?$h",
  "event-75160351.20": "И эти два человека...",
  "event-75160351.21": "Паула и @!$h",
  "event-75160351.22": "Ну всё, похоже, доктора завтра утром можно и не ждать.$h",
  "event-75160351.23": "Ух! Поехали!$h",
  "event-75160351.24": "Эй! Уже начали, что ли?$h",
  "event-75160351.25": "Ещё одна шумная компания. Тьфу!$a",
  "event-75160351.26": "Док! Ты участвуешь в соревнованиях? Удачи!$h",
  "event-75160351.27": "Ещё одна ночь весёлых игр! Ух ты!$h",
  "event-75160351.28": "О-о-о! Сказочные праздники!$h",
  "event-75160351.29": "Хорошо! Я приготовлю напитки!$h",
  "event-75160351.30": "Готово!$h",
  "event-75160351.31": "Хорошо! Вы оба готовы?$h",
  "event-75160351.32": "Полегче! Хорошо, @?$h#$b#Не заставляй себя пить слишком много, ладно?$8",
  "event-75160351.33": "И наливай!$h",
  "event-75160351.34": "За ваше здоровье!$h",
  "event-75160351.35": "Фух!$h",
  "event-75160351.36": "Хорошая работа, ребята.!$h",
  "event-75160351.37": "У-у-у!",
  "event-75160351.38": "Ух ты! Это было сильно!$h",
  "event-75160351.39": "Доктор Паула пьёт с таким изяществом! Потрясающе!$h",
  "event-75160351.40": "Паула, тебе осталось ещё 5, а тебе, @, ещё 7!$h",
  "event-75160351.41": "Ты сможешь, @!$h",
  "event-75160351.42": "*ик* У-упс!$l",
  "event-75160351.43": "Не могу поверить! Док почти закончила!$h",
  "event-75160351.44": "О Иоба, будьте осторожны!$u",
  "event-75160351.45": "Готово!$h#$b#Ух!$h",
  "event-75160351.46": "Отличная работа!",
  "event-75160351.47": "Ух!",
  "event-75160351.48": "Грозный у нас доктор, я вам скажу.",
  "event-75160351.49": "И победителем становится... Тита Паула!$h",
  "event-75160351.50": "*ик* Погодите? Правда?$l#$b#Ура! Я победила!$h",
  "event-75160351.51": "Поздравляю!$h#$b#Я не сдерживал себя в выпивке, понимаете?$h",
  "event-75160351.52": "Молодец, @!$h#$b#*ик* Ты справился!$h^*ик* Ты справилась!$h",
  "event-75160351.53": "Вы оба молодцы!$h^Вы обе молодцы!$h",
  "event-75160351.54": "Выпивка за счёт проигравшего!$h",
  "event-75160351.55": "Эй! Киарра! Никто об этом не говорил!$h",
  "event-75160351.56": "Ха-ха, я пошутила!$h",
  "event-75160351.57": "Давайте все выпьем ещё немного!$h",
  "event-75160351.58": "С тобой очень весело, @!$h#$b#Спасибо, что присоединился к нам!$h^Спасибо, что присоединилась к нам!$h",
  "event-75160351.59": "Пайк, ещё напитков, пожалуйста!$h",
  "event-75160351.60": "Уже иду!$h",
  "event-75160351.61": "Ладно, следующий раунд за мной!$h#$b#Но после вы все будете сами по себе, хорошо?$h",
  "event-75160351.62": "За ваше здоровье!$h",
  "event-75160351.63": "Напитки уже на подходе!",
  "event-75160351.64": "Вы веселились ещё несколько часов.#Было здорово хоть раз дать себе волю!",
  "event-75160351.65": "*ик* Кажется, я слишком много выпила сегодня!$h",
  "event-75160351.PaulaPlaysAlone.01": "Облом!$s",
  "event-75160351.PaulaPlaysAlone.02": "Ничего страшного, мы все понимаем.$h#$b#Пока, @.$h",
  "event-75160351.PaulaPlaysAlone.03": "*ик* Кажется, я слишком много выпила сегодня!$h",
  "event-75160351.PaulaVsAnton.00": "Удачи тому, кого выберут!$h",
  "event-75160351.PaulaVsAnton.01": "Итак, барабанную дробь, пожалуйста!#$b#А теперь... два несчастливых победителя...$h",
  "event-75160351.PaulaVsAnton.02": "Антон и Паула!$h",
  "event-75160351.PaulaVsAnton.03": "Доктор вот-вот проиграет!",
  "event-75160351.PaulaVsAnton.04": "Простите? Это мы ещё посмотрим!$h",
  "event-75160351.PaulaVsAnton.05": "Эй! Уже начали, что ли?$h",
  "event-75160351.PaulaVsAnton.06": "Ещё одна шумная компания. Тьфу!$a",
  "event-75160351.PaulaVsAnton.07": "Док! Ты участвуешь в соревнованиях? Удачи!$h",
  "event-75160351.PaulaVsAnton.08": "Ещё одна ночь весёлых игр! Ух ты!$h",
  "event-75160351.PaulaVsAnton.09": "О-о-о! Сказочные праздники!$h",
  "event-75160351.PaulaVsAnton.10": "Хорошо! Я приготовлю напитки!$h",
  "event-75160351.PaulaVsAnton.11": "Готово!$h",
  "event-75160351.PaulaVsAnton.12": "Хорошо! Вы оба готовы?$h",
  "event-75160351.PaulaVsAnton.13": "И наливай!$h",
  "event-75160351.PaulaVsAnton.14": "За ваше здоровье!$h",
  "event-75160351.PaulaVsAnton.15": "Ах! Это было в точку!",
  "event-75160351.PaulaVsAnton.16": "Не говори мне, что это всё, с чем ты можешь справиться? Ты потерял дар речи!$h",
  "event-75160351.PaulaVsAnton.17": "Доктор Паула пьёт с таким изяществом! Потрясающе!$h",
  "event-75160351.PaulaVsAnton.18": "Ну же, братишка! Не позорь фамилию!$h",
  "event-75160351.PaulaVsAnton.19": "*фырк* А-а-а, мне ударило в нос!$u",
  "event-75160351.PaulaVsAnton.20": "Ха! Ты как всегда неуклюжа, Пау!$h",
  "event-75160351.PaulaVsAnton.21": "О, тише, ты!$l",
  "event-75160351.PaulaVsAnton.22": "Паула, тебе осталось ещё 5, а тебе, Антон, ещё 7!$h",
  "event-75160351.PaulaVsAnton.23": "Ты действительно собираешься проиграть два раза подряд, Антон? Поторопись!$u",
  "event-75160351.PaulaVsAnton.24": "*глоть* Что в этом напитке, Пайк? Мне кажется, мой должен быть крепче!$u",
  "event-75160351.PaulaVsAnton.25": "Всегда ищешь оправдания, да?$h",
  "event-75160351.PaulaVsAnton.26": "Эй! Теперь я точно не дам тебе победить!$h",
  "event-75160351.PaulaVsAnton.27": "Мило, что ты думаешь, что у тебя есть шанс.$h",
  "event-75160351.PaulaVsAnton.28": "Не могу поверить! Док почти закончила!$h",
  "event-75160351.PaulaVsAnton.29": "О Иоба, будьте осторожны!$u",
  "event-75160351.PaulaVsAnton.30": "Почти закончили! Вперёд, Тита!",
  "event-75160351.PaulaVsAnton.31": "*сглатывает* Ох!$h",
  "event-75160351.PaulaVsAnton.32": "*глоть*$u",
  "event-75160351.PaulaVsAnton.33": "Готово!$h#$b#Ух!$h",
  "event-75160351.PaulaVsAnton.34": "Отличная работа!",
  "event-75160351.PaulaVsAnton.35": "Ух!",
  "event-75160351.PaulaVsAnton.36": "Грозный у нас доктор, я вам скажу.",
  "event-75160351.PaulaVsAnton.37": "И победителем становится... Тита Паула!$h",
  "event-75160351.PaulaVsAnton.38": "*ик* Погодите? Правда?$l#$b#Ура! Я победила!$h",
  "event-75160351.PaulaVsAnton.39": "Поздравляю!$h#$b#Я не сдерживал себя в выпивке, понимаете?$h",
  "event-75160351.PaulaVsAnton.40": "Я же говорила, что не дам тебе выиграть! *ик*$h",
  "event-75160351.PaulaVsAnton.41": "Ага, ага... *ик* Я просто был с тобой помягче!$l",
  "event-75160351.PaulaVsAnton.42": "Выпивка за счёт проигравшего!$h",
  "event-75160351.PaulaVsAnton.43": "Эй! Киарра! Это не входило в *ик* правила!$u",
  "event-75160351.PaulaVsAnton.44": "Ха-ха, я пошутила!$h",
  "event-75160351.PaulaVsAnton.45": "С тобой очень весело, @!$h#$b#Спасибо, что присоединился к нам!$h^Спасибо, что присоединилась к нам!",
  "event-75160351.PaulaVsAnton.46": "А теперь давайте все выпьем ещё немного!$h",
  "event-75160351.PaulaVsAnton.47": "Пайк, ещё напитков, пожалуйста!$h",
  "event-75160351.PaulaVsAnton.48": "Уже иду!$h",
  "event-75160351.PaulaVsAnton.49": "Ладно, следующий раунд за мной!$h#$b#Но после вы все будете сами по себе, хорошо?$h",
  "event-75160351.PaulaVsAnton.50": "За ваше здоровье!$h",
  "event-75160351.PaulaVsAnton.51": "Напитки уже на подходе!",
  "event-75160351.PaulaVsAnton.52": "Вы веселились ещё несколько часов.#Было так здорово пообщаться со всеми!",
  "event-75160351.PaulaVsAnton.53": "*ик* Кажется, я слишком много выпила...$u#$b#Но утереть нос Антону того стоило!$h",

  "paula6_choice1": "О! Прости, что не ввела тебя в курс дела!#$b#Легамы здесь периодически устраивают игру «Выпить за здравие», в которой они последовательно выпивают 10 разных напитков.#$b#К сожалению, поскольку я их близкий друг, мне тоже приходится участвовать.$h#$b#Они проводят жеребьёвку и выбирают, кто станет двумя неудачливыми выпивохами на эту ночь.#$b#В прошлый раз это были Антон и Шанис, и Шанис победила!$h",
  "paula6_choice2": "О, правда?$s%fork",
  "paula6_choice3": "Правда? Это восхитительно!$h",
  "paula6_choice4": "Конечно! Можешь болеть за меня, если я буду на ногах! Хи-хи-хи~$h%fork",

//Anton and farmer visit Maive (Anton 10 heart event part 2)
  "event-75160392.01": "Эх. Ещё не поздно отказаться, да?$6",
  "event-75160392.02": "Я шучу! Эй!$h#$b#Но, признаюсь, мне немного страшно.$6#$b#Но мне нужно это сделать.",
  "event-75160392.03": "Хорошо, я готов.",
  "event-75160392.04": "Доброго дня вам обоим.#$b#Мадам была заинтригована вашим звонком сегодня утром, месье Легам.#$b#Пожалуйста, следуйте за мной.$h",
  "event-75160392.05": "Что?! Мадам заинтригована?!$u",
  "event-75160392.06": "Прошу прощения, мадам.#$b#Прибыли архитектор Антон Легам и фермер @.",
  "event-75160392.07": "Очень хорошо.#$b#Извините, я закончу разговор.",
  "event-75160392.08": "Рад снова вас видеть, мадам.$6",
  "event-75160392.09": "Антон. Возможно, это первый раз, когда вы напрямую общаетесь со мной после нашего неудачного сотрудничества.",
  "event-75160392.10": "Ну, эм... Знаете, я вроде как взял перерыв в работе.$6#$b#Всякое случалось, и...$6",
  "event-75160392.11": "Позвольте мне остановить вас на этом, господин Легам.",
  "event-75160392.12": "Полагаю, вы считаете, что я держу на вас обиду из-за неудачного проекта.#$b#Уверяю вас, я не настолько мелочна, мистер Легам.$a#$b#И, честно говоря, я очень расстроена, что вы считаете меня таким человеком.$a",
  "event-75160392.13": "Мадам, я ещё раз прошу прощения за свою ошибку...$s",
  "event-75160392.14": "Мистер Легам, это была не только ваша вина.#$b#У меня есть своя доля неудач в этом проекте, например, нерациональное использование своего времени по личным причинам, ведущее к некачественному планированию.$s#$b#Но позвольте мне сказать вам вот что...$a#$b#Я не позволяю неудачам мешать будущему. Я извлекаю из них уроки.#$b#И, честно говоря, я была разочарована, увидев вас в таком боязливом состоянии после всего этого.$a#$b#Я всегда знаю, что меня окружает, мистер Легам. И я знаю, что вы трусливо избегали меня.$a#$b#И я нахожу это довольно грубым.$a",
  "event-75160392.15": "Мадам, ещё раз прошу прощения...$s",
  "event-75160392.16": "Извинения ни к чему не приведут, архитектор.#$b#Докажите, что вы всё ещё являетесь тем компетентным профессионалом, которым были раньше.#$b#Эта единственная неудача не позволяет вам вести себя так, как вы вели себя до неё.$a#$b#Я по-прежнему доверяю вашим профессиональным навыкам, господин Легам.#$b#На этот раз давайте работать вместе для достижения лучшего результата.#$b#Договорились?",
  "event-75160392.17": "Разумеется, мадам!$h#$b#На этот раз я вас не подведу.",
  "event-75160392.18": "Очень хорошо.",
  "event-75160392.19": "Мейв смотрит на вас.",
  "event-75160392.20": "Санни, любезно передай детали проекта господину Легаму.#$b#Фермер, можно вас на пару слов?",
  "event-75160392.21": "Увидимся через некоторое время, @?",
  "event-75160392.22": "Ухаживайте за ним как следует, @.#$b#Нужно быть лучше его предыдущего партнёра.#$b#Люди, которые не могут справиться с самыми простыми трудностями, вызывают у меня наибольшую жалость.$a",
  "event-75160392.23": "Откуда я знаю?#$b#Я оскорблена, что вы думаете, что у меня нет связей повсюду, фермер.$a",
  "event-75160392.24": "Фух! Это было напряжённо!$h#$b#Но я чувствую облегчение, что всё прошло очень хорошо.",
  "event-75160392.25": "Не могу поверить, @! Я вернулся на работу!$h#$b#И Мадам всё ещё доверяет мне! Ух!$h",
  "event-75160392.26": "Я знаю, что не смог бы набраться храбрости без тебя, @...$l#$b#Спасибо, что ты есть в моей жизни... Я люблю тебя!$l",
  "event-75160392.27": "После этого вы с Антоном провели вместе ещё несколько часов.",
  "event-75160392.28": "@? Хочешь пойти в магазин и купить пива?#$b#Я чувствую, что нам нужен перерыв после такого насыщенного дня!$h",
  "event-75160392.29": "@, думаю, мы немного увлеклись после того, как выпили пива дома.$l",

//Ariah breaks down (Ariah 6 heart event)
  "event-75160307.01": "...*всхлип*.",
  "event-75160307.02": "Вы слышите чей-то плач в разбитой машине.",
  "event-75160307.03": "Оставьте все как есть.",
  "event-75160307.04": "Проверить.",
  "event-75160307.05": "А?$6",
  "event-75160307.06": "О... Это ты.$6",
  "event-75160307.07": "Ария пытается незаметно стереть слёзы с лица.",
  "event-75160307.08": "Я просто... отдыхаю от учёбы... вот и всё...$6",
  "event-75160307.09": "(Что я могу сказать?)",
  "event-75160307.10": "Хочешь поговорить об этом? (Остаться)",
  "event-75160307.11": "Извини за беспокойство. (Уйти)",
  "event-75160307.12": "Я хочу... Но я чувствую, что не могу...$6",
  "event-75160307.13": "Я... Я прячусь от бабушки...$6#$b#Я прячусь от своей семьи, потому что получила плохую оценку на очень важном экзамене... и я не знаю, почему и как...$6#$b#Я делала все... Я училась, училась и училась!$6#$b#*всхлип* Я столько времени потратила на подготовку к этому экзамену! Но я просто не понимаю...$6#$b#Я пересматривала снова и снова... Но почему я не сдала? Почему мох стараний было мало?$6#$b#Я работала до изнеможения... Но этого всё равно было недостаточно...$6#$b#Я... *всхлип* Я опять всех разочаровала... Бабушку... Родителей...$6#$b#Я не хочу... Но я очень устала...$6#$b#Я каждый день просыпаюсь с тревогой о том, что я ещё не изучила и не подготовилась...$6#$b#Я просто... *всхлип* Я просто хочу заставить их гордиться... и оправдать это жалкое проклятие фамилии...$6#$b#Я очень устала... Но я... *всхлип* Я бесполезна...$6",
  "event-75160307.14": "Я прошу прощения... Я не хотела говорить плохо о своей семье...$6#$b#Пожалуйста, не рассказывай бабушке...$6#$b#Я просто так устала... Я чувствую себя так глупо...$6#$b#Может быть, поэтому родители передали меня бабушке, ведь я такая неудачная дочь...$6#$b#Мама снова говорила что-то вроде: «Ты - член семьи Аметин! Делай лучше!'» или «Не позволяй своим двоюродным братьям превзойти себя!».$6#$b#И я просто киваю... и делаю то, что она говорит...$6",
  "event-75160307.15": "*всхлип* В таком возрасте быть несчастной...$6#$b#Иоба, а было ли у меня вообще детство?$6#$b#Являются ли психические и эмоциональные срывы частью взросления?$6#$b#... Может быть, это только для таких глупых, как я...$6",
  "event-75160307.16": "Всегда будет следующий раз.",
  "event-75160307.17": "Твоя семья, кажется, очень большая.",
  "event-75160307.18": "Всё в порядке... Выпусти всё наружу.",
  "event-75160307.19": "... Знаю, но...$6",
  "event-75160307.20": "Я не хотела проявлять неуважение, но...$6",
  "event-75160307.21": "*всхлип* Я... Я просто хочу передохнуть...$6",
  "event-75160307.22": "*всхлип* Иоба! Я прошу прощения за то, что выплеснула на тебя все свои разочарования, @.$7#$b#Мне жаль, но я не хочу говорить об этом дальше... Я чувствую, что это проблема, которую я должна решить сама...$6#$b#Но... Я благодарна, что у меня есть друг, с которым можно поговорить...$7#$b#Честно говоря... Я никогда не думала, что у меня будет друг...$6#$b#Я всегда считала это пустой тратой времени...$6#$b#Но ты здесь, и я благодарна...$7#$b#*всхлип* И я также прошу прощения за то, как вела себя раньше...$6",
  "event-75160307.23": "Ария вытерла слёзы.",
  "event-75160307.24": "Думаю, теперь я готова идти домой...$7",
  "event-75160307.25": "Кажется, Ариа успокоилась.",

  "ariah6_choice1": "%Вы решаете оставить всё как есть.%fork",
  "ariah6_choice2": "%Вы медленно приближаетесь к автомобилю.",

//Louie asking about his parents (Louie 6 heart event)
  "event-75160373.01": "Хм... Санни? Почему бабушка не убрала эту сломанную машину возле особняка?#$b#Она прямо бельмо на глазу!$4",
  "event-75160373.02": "Очевидно, этот автомобиль принадлежал вашему прадеду, молодой господин.#$b#Мадам действительно планировала убрать её, но её дети настояли на том, чтобы оставить всё как есть.#$b#Ваш отец, а также ваши тётя и дядя, по-видимому, имели личные причины для принятия этого решения, которые, к сожалению, я не могу раскрыть по желанию вашего отца, вашей тёти и вашего дяди.#$b#Я предлагаю вам напрямую спросить их об этом по почте или в следующий раз, когда они вернутся домой.",
  "event-75160373.03": "Когда мой отец вернётся домой, а?$s",
  "event-75160373.04": "Когда они вернутся домой?$s",
  "event-75160373.05": "Прошу прощения, молодой господин, но я и сам не слишком много знаю об этом.$s#$b#Ваши родители очень заняты и находятся где-то далеко.$s#$b#Но я уверен, что когда-нибудь они приедут сюда.",
  "event-75160373.06": "O...$s",
  "event-75160373.07": "А?! Фермер?! Как долго ты там стоишь?$u",
  "event-75160373.08": "Добрый день, @.$h",
  "event-75160373.09": "Хм.$a#$b#Ну что ж, если у моего отца есть причины, по которым оставляют эту сломанную машину, то я приму его решение.$a#$b#Надеюсь, он скоро приедет...$s",
  "event-75160373.10": "Молодой господин...$s",
  "event-75160373.11": "Забудьте об этом!$4",
  "event-75160373.12": "Ты! Фермер! Сопроводи нас с Санни за мороженым! Сейчас же!$4#$b#Я угощаю тебя, так что ты должен чувствовать себя польщённым!$h^Я угощаю тебя, так что ты должна чувствовать себя польщённой!$h",
  "event-75160373.13": "Ну, пошли!#$b#Не заставляйте меня ждать!$a",
  "event-75160373.14": "Я прошу прощения, если слова молодого господина показались грубыми.$s#$b#Но он искренне обожает вашу компанию, @. Ему просто нужно улучшить то, как он выражает свои чувства.#$b#Так что спасибо тебе за то, что ты его друг, @.",
  "event-75160373.15": "Луи почувствовал себя лучше после того, как вы вместе съели мороженое.",
  "event-75160373.16": "Мороженое было неплохим. Хотя я хорошо провёл время в вашей компании.$4",

//Lorenzo and children (Lorenzo 6 heart event)
  "event-75160335.01": "@? О, чао!$h#$b#Ты сюда за продуктами или...$h",
  "event-75160335.02": "Ты водишь!$h",
  "event-75160335.03": "А-А-А!$u",
  "event-75160335.04": "Мама мия! Осторожно!$u",
  "event-75160335.05": "Ворчун из магазина! Вы водите!$h",
  "event-75160335.06": "А?$u",
  "event-75160335.07": "Кеяхи! Мистер Продавец не участвует в игре!$a",
  "event-75160335.08": "Что? Но будет веселее, если присоединится больше людей!$h",
  "event-75160335.09": "А? Поиграть со мной? Но...$u",
  "event-75160335.10": "Лоренцо смотрит на вас, не зная, что ему делать дальше.",
  "event-75160335.11": "Как быть?",
  "event-75160335.12": "Сказать детям, чтобы они играли в другом месте.",
  "event-75160335.13": "Кивнуть Лоренцо, чтобы он согласился с идеей недолго поиграть с ними.",
  "event-75160335.14": "Нам очень жаль, мистер Продавец! Мы...$s",
  "event-75160335.15": "Ну что ж, дети, тогда я вам дам фору!$h#$b#Я быстро бегаю, вы это знаете!$h",
  "event-75160335.16": "Ура! Мистер Ворчун из Магазина будет играть с нами! $h",
  "event-75160335.17": "А! Отлично!$h",
  "event-75160335.18": "Эй! Кто назвал меня ворчуном!?$h",
  "event-75160335.19": "Эй! Будьте осторожны с продуктами!$h",
  "event-75160335.20": "Ты не сможешь меня поймать! Неа-нана-нана-нана!$h",
  "event-75160335.21": "Что здесь за шум?$h",
  "event-75160335.22": "Иоба!$h#$b#Не переусердствуй, дорогой!$h",
  "event-75160335.23": "Фух! Конечно, не буду!$s",
  "event-75160335.24": "Фух! Дайте мне перевести дух! Эти дети такие быстрые!$h",
  "event-75160335.ScoldKidsToPlaySomewhere.01": "О! Простите!$s#$b#Видишь! Я же говорила тебе, Кеяхи! Мы им мешаем!$a",
  "event-75160335.ScoldKidsToPlaySomewhere.02": "Оу! Хорошо!$s#$b#Пойдём играть в другое место!$h",
  "event-75160335.ScoldKidsToPlaySomewhere.03": "Простите!",
  "event-75160335.ScoldKidsToPlaySomewhere.04": "Я - скорость!",
  "event-75160335.ScoldKidsToPlaySomewhere.05": "М-м-м... Думаю, спасибо?$s#$b#Я действительно не знаю, как обращаться с детьми!#$b#Но я признаю, что идея поиграть с ними приходила мне в голову.#$b#Хотя, у меня есть работа. Так что лучше мне не утомлять себя ими!$h",
  "event-75160335.ScoldKidsToPlaySomewhere.06": "Интересно, почему тот мальчик назвал меня «ворчуном»?$u",

//Naomi going to work on a rainy day (Naomi 8 hearts)
  "event-75160348.01": "Ах! Я опоздала!$s",
  "event-75160348.02": "@? Что ты делаешь под дождём!?$s#$b#Подожди-ка, почему я остановилась, чтобы поговорить с тобой под дождём?!$u#$b#А-а! Давай укроемся в отеле!$s",
  "event-75160348.03": "Наконец-то!",
  "event-75160348.04": "О, Иоба! Я думала, что опоздала!$u#$b#Хотя я уверена, что вчера спала допоздна.$s",
  "event-75160348.05": "О, Юма попросил меня почитать ему какую-то сказку.#$b#Я была удивлена, потому что знаю, что мой сын уже умеет читать.$s#$b#Но мне кажется, это был милый жест.$h#$b#Но я запаниковала, когда проснулась, потому что думала, что опоздала!#$b#Я даже забыла взять с собой зонтик! Какая я растяпа!$s#$b#Мне действительно нужны полные восемь часов, иначе, как видишь, я в полном беспорядке.$s",
  "event-75160348.06": "Хотя мне хотелось бы проводить с ними больше времени.$s#$b#С тех пор как я вернулась домой, большую часть времени я провожу на работе.$s#$b#Я надеюсь, что мы с детьми будем проводить больше времени вместе.#$b#Например, расслабляющий день в отеле!$h#$b#Это было бы...$h",
  "event-75160348.07": "Юма?! Что ты здесь делаешь?$u#$b#Ты насквозь промок под дождём!$a#$b#Ты можешь заболеть!$a",
  "event-75160348.08": "Мамочка! Прости меня!$s#$b#Я побежал за тобой, потому что ты забыл взять зонтик!$s",
  "event-75160348.09": "Держи зонтик, мама...$s#$b#Прости, что заставил тебя допоздна читать мне сказку...$s#$b#Я чувствую, что это моя вина, что ты спешила на работу!$s#$b#Я могу поговорить с мистером Ричардом и сказать, что это моя вина!$s#$b#Мамочка... Прости меня!$s",
  "event-75160348.10": "О, мой милый маленький мальчик...$4#$b#Эй! Мамочка в порядке, хорошо?$h#$b#Я была очень рада, что мне удалось провести с тобой время вчера вечером, милый.$h#$b#Так что не волнуйся, ладно?$s",
  "event-75160348.11": "О! Эм-м-м... Я... Прости, что побеспокоил тебя!$s#$b#Тебе ещё что-нибудь нужно, мама?",
  "event-75160348.12": "Да, вообще-то...#$b#Иди прими душ и вытрись!$a#$b#Ты промок! Ты простудишься, Юма!$s",
  "event-75160348.13": "А! Да-да, мама!$u#$b#Но... но где я...$s",
  "event-75160348.14": "Воспользуйся ванной комнатой отеля, конечно!$a#$b#Я уверена, что Ричард поймёт.#$b#А теперь, топ-топ!$a#$b#После этого ты можешь провести день здесь, в отеле, вместе со мной.#$b#Если хочешь, дорогой?",
  "event-75160348.15": "Да, мама!$u#$b#И, конечно же! Я с удовольствием проведу с тобой больше времени!$h",
  "event-75160348.16": "Мои дети такие ответственные!$h",

  //Paula 14 heart event (Part 2 - Non-drinking version)
    "event-75160399.01": "...Итак, дорогуша.$l#$b#Ты готов?$h^Ты готова?$h",
    "event-75160399.02": "Реванш!$h",
    "event-75160399.03": "Ха-ха, они уже готовы!$h#$b#Свежая порция ледяного Риджсайдского шакетини!#$b#Будет весело!$h",
    "event-75160399.04": "Заказываю!$h",
    "event-75160399.05": "Простите...",
    "event-75160399.06": "Док! @! Закуски готовы!$h",
    "event-75160399.07": "Оооо! Кажется, начинается!$h",
    "event-75160399.08": "Прошу!",
    "event-75160399.09": "Мама мия! Они больше моей головы!$u",
    "event-75160399.10": "О, дорогуша. Удачи!$h#$b#*Шёпотом* Хе-хе... Любители.$h",
    "event-75160399.11": "Ух ты! Берегитесь заморозки мозга!$h",
    "event-75160399.12": "Сделайте это!$h",
    "event-75160399.13": "Вы готовы?$h",
    "event-75160399.14": "Ба! Соревнование?#$b#Я должен присоединиться!$h",
    "event-75160399.15": "Папа! Нет! Доктор сказал следить за потреблением сахара!$a",
    "event-75160399.16": "Дорогой...$l^Дорогая...$l#$b#То, что я теперь твоя жена, не значит, что я буду поддаваться, ясно?$l#$b#Хи-хи! <$h",
    "event-75160399.17": "За нас!$h",
    "event-75160399.18": "Приготовьтесь...#$b#Погнали!",
    "event-75160399.19": "Хорошее шоу!",
    "event-75160399.20": "Интересно, насколько они холодные...",
    "event-75160399.21": "Док Паула лидирует!$h#$b#Но @ догоняет её!$h",
    "event-75160399.22": "Вперёд, Тита!$h",
    "event-75160399.23": "Не сдавайся, юный @!$h^Не сдавайся, юная @!$h",
    "event-75160399.24": "Ая-яй-яй! @ побеждает!$h",
    "event-75160399.25": "Эм... Я думаю, они на равных.$h",
    "event-75160399.26": "@ лидирует!$h",
    "event-75160399.27": "И через 3... 2... 1...$h",
    "event-75160399.28": "Все!$h",
    "event-75160399.29": "Это...#$b#Это - ничья!$h",
    "event-75160399.30": "*ик* Что? Иоба!$h#$b#Все закончилось? Это было весело, солнце!$h",
    "event-75160399.31": "Паула обняла вас!",
    "event-75160399.32": "Хи-хи! <$4",
    "event-75160399.33": "Все весело провели вечер вместе.#Через некоторое время все закончилось.#И когда вы возвращались домой...",
    "event-75160399.34": "Солнце...$4",
    "event-75160399.35": "Ничего... Просто...$9",
    "event-75160399.36": "Паула подошла ближе.",
    "event-75160399.37": "Я просто хотела сказать спасибо...$9#$b#Спасибо, что всегда был глотком свежего воздуха в мои наполненные стрессом дни...$9^Спасибо, что всегда была глотком свежего воздуха в мои наполненные стрессом дни...$9#$b#Спасибо за то, что продолжаешь терпеть моё упрямство...$9#$b#Я знаю, это может быть неожиданно, но...#Но... Я просто хотела сказать тебе всё это, любовь моя.$8#$b#То, как сильно я тебя люблю... и как благодарна тебе за то, что ты меня любишь...$8",
    "event-75160399.38": "Это была такая замечательная ночь...",
    "event-75160399.39": "Пошли домой, хорошо?$l",
    "event-75160399.40": "Мне нужно принять душ! Кажется, я пролила на себя немного Шакетини.$h",

//Paula 14 heart event (Part 2 - Drinking version)
  "event-75160400.01": "...Итак, дорогуша.$l#$b#Ты готов?$h^Ты готова?$h",
  "event-75160400.02": "Реванш!$h",
  "event-75160400.03": "Хаха! Я нашёл его!$h#$b#Этот должен быть крепче предыдущего.#$b#Будет весело!$h",
  "event-75160400.04": "Заказываю!$h",
  "event-75160400.05": "Простите...",
  "event-75160400.06": "Док! @! Закуски готовы!$h",
  "event-75160400.07": "Оооо! Кажется, начинается!$h",
  "event-75160400.08": "Прошу!",
  "event-75160400.09": "Мама мия! Они выглядят так, будто они могут ударить!$u",
  "event-75160400.10": "О, дорогуша. Удачи!$h#$b#*Шёпотом* Хе-хе... Любители.$h",
  "event-75160400.11": "Ой! Думаю, я буду придерживаться этой бутылки!$h",
  "event-75160400.12": "Сделайте это!$h",
  "event-75160400.13": "Вы готовы?$h",
  "event-75160400.14": "Ба! Соревнование?#$b#Я должен присоединиться!$h",
  "event-75160400.15": "Папа! Нет! Этой бутылки тебе хватит!$a",
  "event-75160400.16": "Дорогой...$l^Дорогая...$l#$b#То, что я теперь твоя жена, не значит, что я буду поддаваться, ясно?$l#$b#Хи-хи! <$h",
  "event-75160400.17": "За нас!$h",
  "event-75160400.18": "Приготовьтесь...#$b#Погнали!",
  "event-75160400.19": "Хорошее шоу!",
  "event-75160400.20": "Интересно, каково это на вкус...",
  "event-75160400.21": "Док Паула лидирует!$h#$b#Но @ догоняет её!$h",
  "event-75160400.22": "Вперёд, Тита!$h",
  "event-75160400.23": "Не сдавайся, юный @!$h^Не сдавайся, юная @!$h",
  "event-75160400.24": "Ая-яй-яй! @ побеждает!$h",
  "event-75160400.25": "Эм... Я думаю, они на равных.$h",
  "event-75160400.26": "@ лидирует!$h",
  "event-75160400.27": "И через 3... 2... 1...$h",
  "event-75160400.28": "Все!$h",
  "event-75160400.29": "Это...#$b#Это - ничья!$h",
  "event-75160400.30": "*ик* Что? Иоба!$h#$b#Все закончилось? Это было весело, солнце!$h",
  "event-75160400.31": "Паула обняла вас!",
  "event-75160400.32": "Хи-хи! <$4",
  "event-75160400.33": "Все вместе веселились и выпивали.#Через некоторое время все закончилось.#И когда вы возвращались домой...",
  "event-75160400.34": "Солнце...$4",
  "event-75160400.35": "Ничего... Просто...$9",
  "event-75160400.36": "Паула подошла ближе.",
  "event-75160400.37": "Я просто хотела сказать спасибо...$9#$b#Спасибо, что всегда был глотком свежего воздуха в мои наполненные стрессом дни...$9^Спасибо, что всегда была глотком свежего воздуха в мои наполненные стрессом дни...$9#$b#Спасибо за то, что продолжаешь терпеть моё упрямство...$9#$b#Я знаю, это может быть неожиданно, но...#Но... Я просто хотела сказать тебе всё это, любовь моя.$8#$b#То, как сильно я тебя люблю... и как благодарна тебе за то, что ты меня любишь...$8",
  "event-75160400.38": "Это была такая замечательная ночь...",
  "event-75160400.39": "Пошли домой, хорошо?$l",
  "event-75160400.40": "Мне нужно принять душ! Кажется, я пролила на себя немного своего коктейля.$h",

//Paula is out for a walk (Paula 8 hearts) (Must have seen Anton's 4 heart event)
  "event-75160352.01": "Кто здесь?$a",
  "event-75160352.02": "@? Что ты делаешь здесь так поздно?$6#$b#То есть... Кто я такая, чтобы спрашивать об этом, а?$9",
  "event-75160352.03": "О, ничего...$9#$b#Я просто не могла заснуть и подумал, что свежий воздух может помочь.$8#$b#*вздох*$7",
  "event-75160352.04": "Скажи... @?$7#$b#Если ты никуда не собираешься... я бы не отказалась от компании...$8",
  "event-75160352.05": "...$8",
  "event-75160352.06": "Паула смотрит на вас, а затем снова смотрит на открытые травяные поля.#Пока вы рассматриваете открывающийся вид, сзади дует лёгкий ветерок.",
  "event-75160352.07": "Скажи, @, могу я тебе кое-что сказать?$9",
  "event-75160352.08": "Вы садитесь на траву рядом с Паулой.#Вы смотрите в её сторону...#Её колени подтянуты к груди, и она трёт их большими пальцами.",
  "event-75160352.09": "Я глубоко, безумно влюблена в человека...$9#$b#Или, может быть, я должна сказать 'была'? Сейчас я даже не уверена...$7#$b#Но меня убивает это чувство, потому что... Я чувствую, что внесла непосредственный вклад в страдания этого человека...$7#$b#И это так больно, потому что, если я действительно любила его, то почему я так поступила с ним? Почему я такая... такая эгоистка? На каждом шагу?$7#$b#Я... я знаю, что говорю бессмыслицу... Но, честно говоря, я не знаю, с чего начать!$9",
  "event-75160352.10": "Забавно... Неважно, сколько ты узнаешь о лечении боли как врач, ты ничего не сможешь сделать, когда дело доходит до такой боли.$9",
  "event-75160352.11": "Что мне сказать?",
  "event-75160352.12": "Кто этот человек?",
  "event-75160352.13": "Мне кажется, я знаю, о ком ты говорите.",
  "event-75160352.14": "(Молчать)",
  "event-75160352.15": "Да... Это Антон...$9#$b#Мой друг детства, лучший друг, доверенное лицо...$7#$b#И человек, который почти женился на другой моей подруге детства, Марии. Я уже упоминала о ней, верно?$9#$b#Я знала, что они нравятся друг другу с самого начала, поэтому никогда не утруждала себя тем, чтобы сказать ему о своих чувствах.$9#$b#Зачем мне рисковать своей дружбой с ними обоими и их отношениями друг с другом, чтобы потакать своим эгоистичным иллюзиям, верно?$11",
  "event-75160352.16": "Паула вытирает слёзы.",
  "event-75160352.17": "Прости! Водяные флюиды появились из ниоткуда!$9#$b#Но да... Я знаю, что Антон уже рассказал тебе обо всём...$7#$b#Или, по крайней мере, я предполагаю, что это было, учитывая, как много он говорит о том, какой ты хороший слушатель.$8#$b#Поэтому я надеюсь, что ты не будешь возражать, если я использую тебя как плечо, на котором можно поплакать сегодня вечером, хорошо?$9",
  "event-75160352.18": "*хихикает*$8#$b#Хорошо, хорошо! Не позволяй похвале захлестнуть тебя с головой!$8",
  "event-75160352.19": "В любом случае, на чем я остановилась...?$7#$b#Я никогда никому об этом не говорила, но я записалась в армию, как только узнала, что они собираются пожениться...$7#$b#Просто чтобы у меня был повод не быть на их свадьбе - Представляешь? Я такая трусиха...$9#$b#А потом, когда они были в самой низкой точке своих отношений - ну, знаешь, прямо перед тем, как они расстались?$7#$b#Мария тогда звонила мне практически каждый день - Антон не знал, да и сейчас не знает...$7#$b#...Казалось, она искала кого-то, кто сказал бы ей НЕ уходить...$9#$b#Но на протяжении десятков и десятков телефонных разговоров... я ни разу не сказала: 'Оставайся с ним' или 'Не сдавайся'.$9#$b#Я никогда не помогала... Просто... Не знаю...$7#$b#Я просто позволила этому случиться... когда могла бы сделать что-то, чтобы исправить положение... Но смогла бы я вообще что-то сделать?$7#$b#Или это просто отговорка, которую я говорю себе?$7#$b#*вздох* Я - ничтожество...$10#$b#Я ужасный врач, да?..$11",
  "event-75160352.20": "Что мне сказать?",
  "event-75160352.21": "Паула...",
  "event-75160352.22": "Ты не сделала ничего плохого!",
  "event-75160352.23": "(Молчать)",
  "event-75160352.24": "Не знаю... Я чувствую, что...$10#$b#Честно говоря, я чувствую, что мне нужно что-то сделать... Например, высказаться ему?$10#$b#Но почему я так сомневаюсь?$10#$b#Я хочу пойти, но не хочу идти! Ха! Я выхожу из себя.$11#$b#Мне кажется, что если я пойду к нему сейчас, то всё равно сломаюсь...$10",
  "event-75160352.25": "Что мне сказать?",
  "event-75160352.26": "Может, просто посидим здесь немного и полюбуемся ночным небом?",
  "event-75160352.27": "Тебе нужно пойти к нему и рассказать о своих чувствах.",
  "event-75160352.28": "Паула вытирает слёзы.",
  "event-75160352.29": "Да... Да, думаю, я так и сделаю...$8",
  "event-75160352.30": "Можно я возьму тебя за руку?$8",
  "event-75160352.31": "Рука Паулы хватает вашу, когда она склоняет голову на ваше плечо.",
  "event-75160352.32": "Спасибо... что нашёл меня здесь сегодня...$11^Спасибо... что нашла меня здесь сегодня...$11#$b#Выслушал меня...$11^Выслушала меня...$11#$b#И за то, что удержал меня от поступка, о котором бы я пожалела...$11^И за то, что удержала меня от поступка, о котором бы я пожалела...$11",
  "event-75160352.33": "Прости... Я странно себя веду...$11",
  "event-75160352.34": "...Такое чувство, что этот огромный груз наконец-то снят с моих плеч после стольких лет...$9#$b#Сейчас я понимаю, что мне нужно сначала разобраться в своих чувствах, прежде чем подходить к нему... и не торопить события... $7#$b#Ещё раз спасибо, @... Ты пробудил меня.$8^Ещё раз спасибо, @... Ты пробудила меня.$8",
  "event-75160352.35": "Вы ещё немного поговорили с Паулой.#Вы рады, что ей уже лучше.",
  "event-75160352.PaulaGoesToAnton.01": "Да... Больше никаких оправданий...$9#$b#Думаю, мне пора идти.$8",
  "event-75160352.PaulaGoesToAnton.02": "@...$9",
  "event-75160352.PaulaGoesToAnton.03": "Паула обняла вас.",
  "event-75160352.PaulaGoesToAnton.04": "Спасибо, что выслушал меня...$9^Спасибо, что выслушала меня...$9",
  "event-75160352.PaulaGoesToAnton.05": "Ну... Пожелай мне удачи?$9",
  "event-75160352.PaulaGoesToAnton.06": "Антон!$11",
  "event-75160352.PaulaGoesToAnton.07": "А? Паула?",
  "event-75160352.PaulaGoesToAnton.08": "Подожди!$11",
  "event-75160352.PaulaGoesToAnton.09": "Эй? Почему ты плачешь?$s#$b#И что ты делаешь так поздно ночью?$s#$b#Я как раз возвращался домой от Пайка. В чём же твоё оправдание?$h",
  "event-75160352.PaulaGoesToAnton.10": "Моё оправдание?...$10",
  "event-75160352.PaulaGoesToAnton.11": "Эй, что случилось?$s",
  "event-75160352.PaulaGoesToAnton.12": "Я просто хотела извиниться...$10#$b#Я сожалею, что не смогла помочь тебе, когда ты был на самом дне...$10#$b#Особенно с Марией...$10#$b#Прости...$10#$b#И самое главное... Прости, что я, эгоистка, сейчас говорю тебе это...$10",
  "event-75160352.PaulaGoesToAnton.13": "Сказать мне что, Пау?$s",
  "event-75160352.PaulaGoesToAnton.14": "...Что ты мне нравишься... Ты нравишься мне с тех пор...$10#$b#Всегда...$10",
  "event-75160352.PaulaGoesToAnton.15": "А!? Подожди, о чём ты говоришь?$u",
  "event-75160352.PaulaGoesToAnton.16": "Тебе не нужно ничего говорить об этом, хорошо?$11#$b#Я просто хотела сказать тебе это... И я надеюсь, что между нами ничего не изменится...$10",
  "event-75160352.PaulaGoesToAnton.17": "Док? Я думаю, у вас бесСанница.$h#$b#Почему все должно измениться? Этого никогда не случится, ясно?$h#$b#То есть, честно говоря, я даже не знаю, что ответить...$l#$b#Но все, что я могу сказать... Спасибо.$l",
  "event-75160352.PaulaGoesToAnton.18": "Для меня этого более чем достаточно...$11",

  //Paula 8 heart event choices
  "paula8_choice1": "@...$11",
  "paula8_choice2": "Но...$10%fork",
  "PaulaLikesFarmer.Paula": "У меня был прекрасный вечер благодаря нашему разговору, @.$8#$b#Я рада, что познакомилась с тобой!$h",
  "PaulaLikesFarmer.Anton": "Я слышал, ты утешал Паулу, когда ей было очень грустно.^Я слышал, ты утешала Паулу, когда ей было очень грустно.#$b#Спасибо, что присматриваешь за ней, @.$h#$b#Мы тоже поговорили, и я рад узнать, что ей уже лучше.$h",
  "PaulaLikesAnton.Paula": "Ещё раз спасибо тебе, @, за то, что, благодаря твоей поддержке, я подошла к нему.$h#$b#Я чувствую, что с моих плеч снято огромное бремя!$h",
  "PaulaLikesAnton.Anton": "Я слышал, ты успокаивал Паулу перед тем, как она бросилась за мной той ночью?^Я слышал, ты успокаивала Паулу перед тем, как она бросилась за мной той ночью?#$b#Спасибо, что присматриваешь за ней, @. Честно говоря, я всё ещё удивлён тем, что она мне рассказала. Но я рад, что ей стало лучше.$h",

//Paula 8 hearts follow up (Stay here answer)
  "event-75160389.01": "Привет, @!$h#$b#Прошу прощения за неожиданный визит.$9",
  "event-75160389.02": "Я просто хотела сказать тебе, что я наконец-то сделала это!$h#$b#Я наконец-то поговорила с Антоном сегодня утром!$h",
  "event-75160389.03": "После нашего вчерашнего разговора... я поняла, что пришло время двигаться дальше.$9#$b#И вот у нас состоялся хороший разговор о том, что я накапливала в себе этим утром.$9#$b#И я счастлива, что всё сложилось хорошо.$9",
  "event-75160389.04": "Так что... я решила зайти и ещё раз поблагодарить тебя... за то, что нашёл меня прошлой ночью.$8^Так что... я решила зайти и ещё раз поблагодарить тебя... за то, что нашла меня прошлой ночью.$8#$b#Антон был прав - Ты действительно хороший слушатель!$l",
  "event-75160389.05": "Так, эм...$9#$b#Да, вот и все!$l#$b#Думаю, мы ещё увидимся.$8#$b#Конечно, когда ты придёшь в клинику!$h#$b#О! Для этого с тобой не обязательно должно случиться что-то плохое!$u#$b#То есть...$9",
  "event-75160389.06": "*кхе* Я имею в виду, когда ты просто захочешь ко мне прийти! Глупышка!$9",
  "event-75160389.07": "Паула выглядит довольной.",

//Anton asks farmer to accompany him (Anton 10 hearts part 1)
  "event-75160391.01": "Привет, @.$l#$b#Прежде всего, я должен сказать... Ты выглядишь очень мило в это раннее утро.$l",
  "event-75160391.02": "В общем, у меня есть новости!$6#$b#Дворецкий Аметинов, мистер Санни, верно? Он покупал вещи в магазине на днях.#$b#Он упомянул, что Мадам ищет соратников для одного из своих благотворительных проектов, который предполагает реконструкцию общественного центра.#$b#А для строительства нужны архитекторы, да?$6",
  "event-75160391.03": "Я знаю! Похоже, это мой шанс искупить свою вину.#$b#Но, честно говоря, я немного напуган.$6#$b#Так что, если всё в порядке и ты не против...$6#$b#Можешь сопроводить меня в их особняк?$l#$b#Мне кажется, что я рассыплюсь, не дойдя до их двери, если пойду один.$s",
  "event-75160391.04": "Тебя это устраивает?! Правда?$l#$b#Спасибо, @.$l",
  "event-75160391.05": "Хорошо! Тогда жду тебя в деревне с 6 утра до 20 часов вечера.$h",

//Paula's assistant for the day (Paula 10 heart event)
  "event-75160390.01": "...и убедиться, что он достаточно спит.#$b#Повторный осмотр можно провести через неделю.$h",
  "event-75160390.02": "Махало! Спасибо, Док!$h",
  "event-75160390.03": "Никакая лихорадка не может победить Кеяхи Великого!$h",
  "event-75160390.04": "О! Дорогой!^О! Дорогая!#$b#Погоди, дай мне секунду!",
  "event-75160390.05": "Мистер и миссис Блейдбейн, прошу прощения за ожидание.$8#$b#Я подготовила рецепт на ваши поддерживающие лекарства и витамины.",
  "event-75160390.06": "Спасибо, дорогая.$h#$b#И не волнуйся, мы понимаем, что ты сегодня очень занята.",
  "event-75160390.07": "Позаботься и о себе. Хорошо, док?",
  "event-75160390.08": "Вы оба такие милые, как всегда! Большое спасибо за заботу.$8#$b#Я вернусь, хорошо?$h",
  "event-75160390.09": "Дорогой! Прости, что заставила тебя ждать!$l^Дорогая! Прости, что заставила тебя ждать!$l#$b#Клиника сегодня очень забита, Киарра уехала за город, а Филипп в городе Пеликан лечит Джорджа.$8#$b#Так ты можешь немного подождать до нашего свидания?$8",
  "event-75160390.10": "А? Что? Помочь мне?$8#$b#Это очень мило с твоей стороны, @. Но я не хочу тебя беспокоить.$s",
  "event-75160390.11": "Но, дорогой...$s^Но, дорогая...$s",
  "event-75160390.12": "Док! Какие бумаги мне нужно подписать ещё раз!?$a#$b#Ба! Почему так много бумажной работы!$a",
  "event-75160390.13": "Я сейчас приду, мистер Дэниелс.$8",
  "event-75160390.14": "Да, думаю, мне нужна помощь...$9#$b#Ты уверен, дорогой?$8^Ты уверена, дорогая?$8",
  "event-75160390.15": "Мне очень повезло с тобой!$8#$b#Ладно, просто делай, что я говорю, хорошо?",
  "event-75160390.16": "...и я просто поставлю здесь свою подпись?",
  "event-75160390.17": "...пальцы ног твоей мамы будут в порядке, дорогая.#$b#Я могу назначить несколько методов обезболивания при подагрическом артрите, Ольга.#$b#Надеюсь, это поможет облегчить боль, особенно ночью.$8",
  "event-75160390.18": "С мамой всё будет хорошо, да, доктор Паула?$s",
  "event-75160390.19": "Не волнуйся, Тринни. С мамой всё будет хорошо благодаря доктору Пауле, хорошо?$h#$b#Большое спасибо, док!$h",
  "event-75160390.20": "Не за что.$h",
  "event-75160390.21": "Всё хорошо, дорогой?^Всё хорошо, дорогая?",
  "event-75160390.22": "И я назначила тебе встречу на следующую неделю, Ленни.$h#$b#Я знаю, что ты занята, но, пожалуйста, больше не забывай, хорошо?$8",
  "event-75160390.23": "Я знаю, знаю! Виновата, док!$h#$b#Спасибо за терпение!$h",
  "event-75160390.24": "Миссис Ривера! Как ваша рана?$8#$b#Обезболивающее помогает?#$b#Солнце? Можешь потрогать её руку?$8",
  "event-75160390.25": "Ай-яй! Я ничего не чувствую!$h#$b#Такое ощущение, что я сама могу вытащить этот крючок, док Паула!$h",
  "event-75160390.26": "О! Нет, пожалуйста! Подожди меня!$8#$b#Я буду через секунду, чтобы обработать рану, хорошо?#$b#Дай мне только купить новую пару перчаток.",
  "event-75160390.27": "О, что это?$h#$b#Ты наняла свою вторую половинку в качестве нового помощника, док?#$b#Вы оба такие очаровательные!$h^Вы обе такие очаровательные!$h",
  "event-75160390.28": "Ленни!$l#$b#Сегодня @ просто помогает мне!$8",
  "event-75160390.29": "*шепчет* О, я уверена, что @ помогает тебе не только по клинике, док.$4",
  "event-75160390.30": "Ленни! Шалунишка!$l",
  "event-75160390.31": "Похоже, что они говорят о вас, голубки!$h#$b#Интересно, что такого сказала Ленни, что док так покраснела?",
  "event-75160390.32": "И готово!$h#$b#С ежедневными записями закончено.$8",
  "event-75160390.33": "*вздох* Мы пережили этот день!$8#$b#Прости, что отнимаю у тебя время, солнце.$s#$b#Я знаю, что сегодня мы планировали пойти на свидание, но вместо этого мы провели большую часть времени в клинике.$7#$b#Мне очень жаль, что я испортила наше свидание.$s",
  "event-75160390.34": "А? Всё в порядке?$8#$b#Оу... Это слишком мило.$8#$b#Эй... Спасибо за помощь, @.$8#$b#И... это может показаться банальным, но...$9#$b#Я просто хочу сказать спасибо за то, что ты всегда был рядом со мной.$l^Я просто хочу сказать спасибо за то, что ты всегда была рядом со мной.$l#$b#За понимание и заботу.$l#$b#Я знаю, что иногда забываю заботиться о себе, особенно если увлечена работой.$9#$b#Но ты всегда рядом, чтобы помочь мне. Я очень благодарна, что ты есть в моей жизни, @...$l",
  "event-75160390.35": "Я люблю тебя, @...$l",
  "event-75160390.36": "*кхе* Знаешь... У меня есть новый... эээ... чай в моей комнате.$l#$b#Пойдёшь со мной за чаем?$l",
  "event-75160390.37": "Забавно то, что вы совсем забыли про этот чай...$l",

//Sonny in the storage (Sonny 6 heart event)
  "event-75160363.01": "...это будет тут.",
  "event-75160363.02": "...а это здесь.",
  "event-75160363.03": "Простите меня за то, что я вас не заметил!#$b#Добро пожаловать, господин @. Вам что-нибудь нужно?$h^Добро пожаловать, госпожа @. Вам что-нибудь нужно?$h",
  "event-75160363.04": "Чем я занимался?#$b#Я просто складывал вещи, которые прислали дети мадам.#$b#Время от времени они посылают подарки своей матери.#$b#Хотя хорошо видно, что они соперничают друг с другом за её внимание.$s",
  "event-75160363.05": "Дети мадам?#$b#Все они работают за границей, каждый из них управляет крупным бизнесом в рамках основной организации своей семьи.#$b#Но они редко приезжают домой, так как все они очень заняты.#$b#Как жаль... Их детям часто не хватает родительского присутствия.$s",
  "event-75160363.06": "Иоба! Я увлёкся нашим разговором!$h#$b#Я ценю вашу компанию, господин @. Нам нужно общаться чаще!$h#$b#Пардон, но я должен вернуться к работе.^Я ценю вашу компанию, госпожа @. Нам нужно общаться чаще!$h#$b#Пардон, но я должен вернуться к работе.",
  "event-75160363.07": "Хорошего дня, мой друг! Да благословит вас Иоба.$h",

//Ariah gets to know the village (Ariah 8 heart event)
  "event-75160308.01": "@! Как раз вовремя!$h",
  "event-75160308.02": "Мне... Мне нужна помощь.$s#$b#Сегодня я хотела дать себе отдохнуть, поэтому планировала встретиться с людьми в окрестностях деревни.#$b#Стыдно признаться, что я живу здесь уже несколько лет, но мне ещё не удалось как следует познакомиться с жителями Риджсайда.$s#$b#Я всегда отгораживалась от людей, потому что для меня важнее всего было произвести впечатление на свою семью...$s#$b#Я планировала попросить Айрин сопровождать меня, но забыла, что она поехала с гостившей бабушкой в город Зузу!$s#$b#И поэтому... эмм... Будешь сопровождать меня сегодня?$4#$b#Я хочу познакомиться и с другими детьми! Знаешь... с кем-то кроме своего хвастливого кузена Луи!$h#$b#Пожалуйста, не говори ему это!$h#$b#*кхе* Ты, возможно, мой единственный друг в этой долине, кроме Айрин... И я благодарна тебе за это!#$b#Благодаря дружбе с тобой я поняла, как многого мне сейчас не хватает в моей жизни.$s#$b#Я о факторах, которые я могу контролировать.$h#$b#И поэтому я чувствую, что заслужила этот перерыв.$h",
  "event-75160308.03": "Ты можешь со мной прогуляться?",
  "event-75160308.04": "Конечно!",
  "event-75160308.05": "Прости, но у меня сегодня много дел.",
  "event-75160308.06": "Признаюсь, я очень волнуюсь...$s#$b#Но я также взволнована.#$b#Пойдём?$h",
  "event-75160308.07": "Твой наряд просто великолепен!",
  "event-75160308.08": "Приятно наконец-то познакомиться с тобой!",
  "event-75160308.09": "О! Привет, милая Аментин!",
  "event-75160308.10": "Привет!",
  "event-75160308.11": "Добрый день! О! Привет!",
  "event-75160308.12": "Новый друг!",
  "event-75160308.13": "ДРУГ!",
  "event-75160308.14": "Шон! Иди на помощь!",
  "event-75160308.15": "Новый человек в городе?",
  "event-75160308.16": "Я здесь, если тебе понадобится помощь.",
  "event-75160308.17": "Хап-хап!",
  "event-75160308.18": "Здравствуйте, дорогие мои.",
  "event-75160308.19": "Всё это время здесь жили такие замечательные и интересные люди...$h#$b#Я... Я никогда бы не узнала...$s",
  "event-75160308.20": "Я очень благодарна, что ты мой друг, @.$4#$b#Ты как старший брат или сестра, которых у меня никогда не было!$h#$b#Возможно, раньше ты был довольно любопытным, но я ценю твоё присутствие.$4^Возможно, раньше ты была довольно любопытной, но я ценю твоё присутствие.$4#$b#Я действительно научилась отвлекаться от книг и давать себе передышку.$4#$b#И за это... Спасибо! И я также ценю твою компанию!$h",
  "event-75160308.21": "Ну, эм... Я знаю, что тебе нужно вернуться к работе.#$b#И так, я буду ждать возвращения Айрен или Санни, пока снова не обойду деревню.$h#$b#Мне очень интересно посетить мисс Шанис! Мне кажется, что я могла бы многому у неё научиться!$h#$b#Погоди, так вот почему её имя показалось мне знакомым! Когда-то она была учительницей Зейна! Она потрясающая!$h#$b#О! Прошу прощения, что затянула наше прощание!$h",
  "event-75160308.22": "Похоже, Ария сейчас в восторге.",
  "event-75160308.23": "Я не могу дождаться, чтобы провести больше времени с новыми друзьями, которых я сегодня приобрела!$h",
  "event-75160308.FarmerNotAccompanyAriah.01": "Я полностью понимаю тебя, @... Хотя должна признать, что это меня немного разочаровывает.$s#$b#Всё в порядке. Я могу просто подождать возвращения Айрин.$h#$b#Надеюсь, у тебя будет приятный день.",
  "event-75160308.FarmerNotAccompanyAriah.02": "Надеюсь, Айрин потом не будет занята.$s",

  "ariah8_choice1": "Правда? Большое спасибо!$h",
  "ariah8_choice2": "О! Прошу прощения... Я совсем забыла об этом!$s%fork",

//The Amethyne Brunch (Maive 8 heart event part 2)
  "event-75160340.01": "Добрый день, @.$h#$b#Мадам ждала вас.#$b#Пожалуйста, следуйте за мной.",
  "event-75160340.02": "Я же тебе говорил! Не трогай мои растения, Надалин!$a",
  "event-75160340.03": "Приношу прощения, Луи.$s#$b#Я просто не могла удержаться! Твоя коллекция растений проста, но элегантна!$h#$b#Я даже слышала, что ты назвал имена некоторых из них? Мне... любопытно.$4",
  "event-75160340.04": "Как будто сад твоей лачуги может с ней сравниться, Надалин!$4#$b#Кроме того, откуда ты узнала об этом!?$a#$b#Неважно! Это не твоё дело!$a",
  "event-75160340.05": "Я... Я просто пыталась узнать тебя получше!$u#$b#Прошу прощения, если я перегнула палку, дорогой брат.$s",
  "event-75160340.06": "Не смей меня так называть, ты...$a",
  "event-75160340.07": "*кхем* Извините, молодые господин и госпожа.#$b#Наш гость прибыл.^Наша гостья прибыла.",
  "event-75160340.08": "Прошу прощения, Санни.$s#$b#...но он ещё и бабушкин гость.$s^...но она ещё и бабушкина гостья.$s",
  "event-75160340.09": "Хмф! Так ты наконец-то здесь!$4",
  "event-75160340.10": "Думаю, вы уже знакомы с Юным Господином Луи.#$b#@, познакомьтесь с юной госпожой Надалин.#$b#Мисс Надалин, познакомьтесь с @ - фермером %farm.",
  "event-75160340.11": "Приятно познакомиться, фермер @.$h#$b#Мы с сестрой много слышали о твоих сельскохозяйственных достижениях от отца и бабушки.",
  "event-75160340.12": "Хмпф!$a",
  "event-75160340.13": "Дети, давайте вернёмся в столовую?#$b#Госпожа желает, чтобы все собрались вместе, раз уж наш гость прибыл.$h^Госпожа желает, чтобы все собрались вместе, раз уж наша гостья прибыла.$h",
  "event-75160340.14": "Да, нам не стоит заставлять ждать бабушку.$4",
  "event-75160340.15": "Ария, подойди и послушай нашу дискуссию о внешней торговле.#$b#Опыт обоих твоих двоюродных братьев может быть полезен для твоей учёбы.",
  "event-75160340.16": "Но, мама, я всё ещё читаю...$s",
  "event-75160340.17": "Дорогая...",
  "event-75160340.18": "Да-да, мама. Прошу прощения.$s",
  "event-75160340.19": "Пардон, что прерываю вас, но гость Мадам прибыл.^Пардон, что прерываю вас, но гостья Мадам прибыла.",
  "event-75160340.20": "В соответствии с просьбой госпожи, я представлю нашего гостя заранее.^В соответствии с просьбой госпожи, я представлю нашу гостью заранее.#$b#Госпожа Алтея, господин Зейн, госпожа Лоррейн...#$b#Позвольте представить вам фермера @ из фермы %farm.#$b#@, для меня честь представить вам госпожу Алтею, генерального директора Лила Драгоценности корпорации Аметин, она же дочь госпожи. Вместе с юной госпожой Арией.#$b#Господин Зейн, посол Республики Фернгилл.#$b#И госпожа Лоррейн, главный менеджер по маркетингу корпорации Аметин.",
  "event-75160340.21": "Добрый день, молодой человек.^Добрый день, юная леди.#$b#Я слышала многообещающие впечатления о тебе от мамы.#$b#Приятно познакомиться.$h",
  "event-75160340.22": "Приветствую, @.#$b#Я рад снова встретиться с вами.$h",
  "event-75160340.23": "Я также рада нашему знакомству, @.",
  "event-75160340.24": "Хм? Наш гость наконец-то здесь?^Хм? Наша гостья наконец-то здесь?",
  "event-75160340.25": "Идите все сюда.",
  "event-75160340.26": "Конечно, мама.$h",
  "event-75160340.27": "Фермер @, прежде всего, я хотела бы представить своего сына, Захари.#$b#Он - генеральный директор AГК, горнодобывающей компании под названием Аметин, а также отец Зейна и Луи.#$b#Затем у нас есть Лоррейн и Надалин, из... ну...$s",
  "event-75160340.28": "От его внебрачной связи.$a",
  "event-75160340.29": "Алтея!$a",
  "event-75160340.30": "...$s",
  "event-75160340.31": "Хех.$4",
  "event-75160340.32": "Тётушка...$s",
  "event-75160340.33": "Мама... Пожалуйста, не надо.$s",
  "event-75160340.34": "Все! Давайте позволим бабушке продолжить.$a#$b#Следите за своими манерами.$a",
  "event-75160340.35": "*кхем* Как я уже говорила...$a#$b#Думаю, вы уже знакомы с моей дочерью и внуками.#$b#Они все здесь в гостях, хотя, к сожалению, их супруги заняты.#$b#Так что, дети мои, вашим партнёрам лучше придумать хорошее объяснение, почему они сегодня отсутствуют.$a",
  "event-75160340.36": "Прошу прощения за небольшой переполох.$s#$b#Но для начала я хотел бы выразить своё восхищение, ведь мама высоко отзывалась о тебе, @.#$b#Рад наконец-то встретиться с тобой.#$b#Когда мы были маленькими, твой дедушка был ярким примером для подражания в честном трудолюбии и настойчивости.$h",
  "event-75160340.37": "И твоя бабушка тоже, фермер.$h#$b#Когда я была маленькой, я всегда с нетерпением ждала её визитов.#$b#Она научила меня многому о дизайне и цветовых композициях с помощью цветов.#$b#Я смогла перенести это на свою профессию.$h",
  "event-75160340.38": "Я рада, что наследие моих хороших друзей продолжает жить с моими детьми и с вами, мой друг.$h",
  "event-75160340.39": "Очевидно, что достижения @ отражаются на похвалах отца и тёти.$h",
  "event-75160340.40": "Согласна.$h#$b#Я с нетерпением жду твоего роста и твоей фермы, а также дополнительных достижений в будущем.",
  "event-75160340.41": "Теперь, когда вы все познакомились, давайте займём свои места и, наконец, поедим.#$b#Вы, конечно, не торопились, фермер.$h",
  "event-75160340.42": "Было приятно пообедать с Аметинами.#(Хотя между некоторыми членами семьи существовало неловкое напряжение...).",
  "event-75160340.43": "Хм... Признаюсь, было приятно хоть раз увидеть семью в полном составе.",

//Kimpoi and the kids (Kimpoi 6 heart event)
  "event-75160331.01": "Мистер! У меня вопрос! У меня вопрос! У меня вопрос! У меня вопрос!$h",
  "event-75160331.02": "Дядя! Дядя! Дядя! Дядя! Дядя! Дядя! Дядя! Дядя! Дядя! Дядя!$h",
  "event-75160331.03": "Ух. Что...$u",
  "event-75160331.04": "Если я проглочу семена... у меня в животе вырастут растения?!$u",
  "event-75160331.05": "Мама сказала, что ты можешь поднять целую кучу больших коробок! Давай поиграем? Ты можешь быть ходячим горным замком, а я буду принцессой, которая там живёт!$h",
  "event-75160331.06": "Погодите, что?$u",
  "event-75160331.07": "O! @!$s#$b#Помоги.$s",
  "event-75160331.08": "Йе! @! Ура!$h",
  "event-75160331.09": "Привет, @!!! Давай играть!$h",
  "event-75160331.10": "Ну... Моя сестра должна была сегодня куда-то уехать.$s#$b#Так что я нянчусь с малышкой Тринни.$h#$b#Я не знал, что этот мальчик тоже входит в пакет сделки!$u",
  "event-75160331.11": "Ты слышишь!? Я пакет!$u#$b#О! Новая идея игры! Я буду пакетом в посылке, а вы, ребята, курьерами!$h",
  "event-75160331.12": "А!? Что!? Мы с Кеяхи - пакетная сделка?$4#$b#Оу! Это так мило! Мы - милые пакеты!$h",
  "event-75160331.13": "Нет! Я буду единственным пакетом! Вы положите меня в коробку и доставите от двери до двери!$a#$b#Давайте уже играть!$h",
  "event-75160331.14": "Не-а! Дядя сказал, что мы - пакетная сделка! Так что мы идём вместе!$a",
  "event-75160331.15": "Иоба...$s#$b#Хорошо! Э... Кто хочет покататься на моих плечах?#$b#Мы можем потом... эмм... прогуляться по фруктовому саду?$h",
  "event-75160331.16": "ОМГ! Правда, дядя?!$h",
  "event-75160331.17": "Вперёд!!!$h",
  "event-75160331.18": "Эй, сработало!$u#$b#Э... Ну тогда забирайтесь наверх!$h",
  "event-75160331.19": "Следующие несколько минут они провели, играя в саду.",
  "event-75160331.20": "У меня сейчас спина отвалится...$s",

//Malaya at work (Malaya 6 heart event)
  "event-75160343.01": "Доброе утро, дорогуша.$h#$b#Я просто навожу порядок на столах.#$b#Дай мне минутку, хорошо?",
  "event-75160343.02": "...теперь выглядит лучше.$h",
  "event-75160343.03": "О! Тут есть крошки.#$b#Позволь мне все убрать...$h",
  "event-75160343.04": "Я прошу прощения за ожидание! Я действительно не торопилась.$s#$b#Так чем я могу тебе помочь, дорогуша?$h",
  "event-75160343.05": "О, ты просто ко мне в гости, да?#$b#Я не могу тебя винить. Услуги отеля - звучит безмятежно, верно?$h#$b#О, как бы я хотела поскорее познакомиться с местными достопримечательностями вместе со своим мужем!$h#$b#Но пока что у меня есть работа, так что, может быть, в другой раз.$h",
  "event-75160343.06": "О! Не пойми меня неправильно! Я обожаю свою работу.$h#$b#Это такое приятное времяпрепровождение! А именно - быть кондитером.$h#$b#Понимаешь, когда Алисса была маленькой, она очень любила кондитерские изделия.#$b#Поэтому, когда мы с мужем отправились в путешествие, я нашла время, чтобы отточить свои навыки, изучая рецепты кондитерских изделий разных стран!$h#$b#Человеческие созда... То есть, наш вид - весьма креативный и инновационный, верно? Это удивительная черта!$h",
  "event-75160343.07": "Я не так много знаю о фермерстве, как остальные члены моей семьи.$7#$b#И поэтому, когда я услышала о вакансии миссис Кобаяши и мистера Голдсворна в этом небольшом кафе, я сразу же бросилась туда!$7#$b#Я просто счастлива, что могу помогать своей семье, занимаясь любимым делом.$h#$b#О! А иногда я беру с собой немного для Алиссы!$h#$b#О, как я обожаю блеск в её глазах, когда я приношу ей любимые вещи...$7",
  "event-75160343.08": "Ой! Я забыла, что у меня в духовке печенье!$u#$b#Прости, @!$u",
  "event-75160343.09": "Иоба! Печенье!",
  "event-75160343.10": "Фух! Мне удалось спасти печенье! Я очень благодарна за беседу, @.$h",

//Shanice helps Trinnie (Shanice 6 heart event)
  "event-75160359.01": "Привет, @!$h#$b#Тебе нужны какие...$h",
  "event-75160359.02": "Здравствуйте, Мисс Леди Магазина!$h#$b#А мука у вас есть?",
  "event-75160359.03": "Иоба! Ты нас удивила, Тринни!$h#$b#А с кем ты сегодня?",
  "event-75160359.04": "Мама на улице разговаривает с мистером Магазинным Ворчуном о сельскохозяйственных товарах!$h#$b#Она сказала мне пойти купить небольшой пакет муки, чтобы потом мы могли испечь блины!$h",
  "event-75160359.05": "О! Звучит как отличное времяпрепровождение!$h#$b#Мука должна быть где-то рядом...",
  "event-75160359.06": "Ура!",
  "event-75160359.07": "Ого! Она прямо на самой верхней полке!$u#$b#Думаю, я смогу дотянуться до неё!",
  "event-75160359.08": "О, пого...$u",
  "event-75160359.09": "Слишком высоко!$s",
  "event-75160359.10": "Никогда не помешает попросить о помощи, правда, дорогая?$h#$b#Ты была так близко! Спорим, однажды ты будешь даже выше меня!$h",
  "event-75160359.11": "Правда, мисс Леди Магазина!?$h",
  "event-75160359.12": "Шанис взяла небольшой пакет с мукой.",
  "event-75160359.13": "Я уверена в этом!$h#$b#Поэтому обязательно спи и ешь побольше, чтобы вырасти здоровой, хорошо?$h",
  "event-75160359.14": "Ага! Я съем вагон и маленькую тележку блинов!$h",
  "event-75160359.15": "О, эм...$u",
  "event-75160359.16": "Тринни обняла Шанис.",
  "event-75160359.17": "Спасибо, что помогли мне, мисс Леди Магазина!$h#$b#Когда-нибудь я стану такой же высокой и красивой, как вы!$h",
  "event-75160359.18": "О, Иоба!$l#$b#Конечно, дорогая.$h",
  "event-75160359.19": "Шанис обняла Тринни в ответ.",
  "event-75160359.20": "Тринни! Ты там закончила?",
  "event-75160359.21": "О! Я лучше пойду!$u#$b#Вот оплата, мисс Леди Магазина!$h",
  "event-75160359.22": "Спасибо, Тринни!$h#$b#И, пожалуйста, зови меня Шанис. Хорошо?",
  "event-75160359.23": "Хорошо, мисс Леди Магазина Шанис!$h#$b#До свидания!$h",
  "event-75160359.24": "Мама, смотри!",
  "event-75160359.25": "Вы видите, как по лицу Шанис катится слеза, когда она улыбается.",
  "event-75160359.26": "О, Иоба! Прости!$h#$b#Интересно, почему я там прослезилась.$s#$b#Как глупо!$h",
  "event-75160359.27": "Ничего! Я просто подумала о том, как прекрасно было, когда Тринни обняла меня.#$b#Родители воспитывают её правильно.$h",
  "event-75160359.28": "Ну, чтож! Если тебе что-нибудь понадобится, я буду у стойки.$h",
  "event-75160359.29": "Похоже, Шанис что-то беспокоит.",
  "event-75160359.30": "Думаю, что позже приготовлю несколько блинчиков для себя и мужа.$h",

//Anton 14 heart event (Part 2 - Cookie House)
  "event-75160402.01": "Доброе утро, голубки!$h#$b#Я уже приготовила вам инструменты для выпечки на сегодня. Просто идите наверх.#$b#И ещё я оставила поваренную книгу, Антон, по твоей просьбе.$h#$b#Твой старший брат смеялся над тобой прошлой ночью, вспоминая, как сильно ты... ммм... с детства испытывал трудности с выпечкой.$h",
  "event-75160402.02": "Он сказал тебе!?$u#$b#Этот старик! Я ему покажу!$a#$b#Спасибо, что организовала всё это, Шанис.#$b#Я обещаю, что мы потом все уберём.$h",
  "event-75160402.03": "Что ж, давай займёмся выпечкой?$h",
  "event-75160402.04": "Хорошо, вот ингредиенты...#$b#И, э-э...$s",
  "event-75160402.05": "Антон размазал немного муки по носу.",
  "event-75160402.06": "Буп! Попался!$h^Буп! Попалась!$h#$b#Ха-ха!",
  "event-75160402.07": "Хорошо, хорошо! Давай начнём как следует!#$b#Но для записи, даже с мукой на лице...#$b#Ты всё ещё выглядишь мило, как чёрт!$l",
  "event-75160402.08": "...и мы испечём эти...",
  "event-75160402.09": "Вау!$h",
  "event-75160402.10": "Ух ты! Сработало!$h#$b#Честно говоря, у меня были низкие ожидания насчёт себя.$h",
  "event-75160402.11": "Ты действительно мой талисман, да?$l",
  "event-75160402.12": "На этот раз вы намазываете немного шоколадного соуса на нос Антона!",
  "event-75160402.13": "А!?$u#$b#Хех. Ты меня поймал!$h^Хех. Ты меня поймала!$h#$b#Но ты так просто не уйдёшь! Иди-ка сюда!$l",
  "event-75160402.14": "Эй, солнце? Давай пока не будем слишком увлекаться.$l#$b#Давай сначала соберём домик из печенья!$h",
  "event-75160402.15": "...и я думаю, мы можем поместить это здесь...#$b#Солнце, помоги мне подержать здесь...",
  "event-75160402.16": "Дом обретает форму!",
  "event-75160402.17": "Я думаю, мы достигли цели, дорогой!$h^Я думаю, мы достигли цели, дорогая!$h#$b#Что думаешь?",
  "event-75160402.18": "Теперь осталось сделать ему крышу.#$b#Дай-ка я разберусь с этим...$h",
  "event-75160402.19": "Антон делает небольшую крышу, используя печенье.",
  "event-75160402.20": "Знаешь, солнце...$6#$b#Я никогда не думал, что снова буду так счастлив... после всего того, через что мне пришлось пройти.$6#$b#Хех... Я был как это печенье... Хрупким и легко крошился.$s#$b#Я так долго находился в этом состоянии...$s#$b#Но потом...$6",
  "event-75160402.21": "Антон установил сверху крышу, чтобы завершить строительство дома.",
  "event-75160402.22": "Я встретил тебя.$l",
  "event-75160402.23": "Например, как мы сегодня делали этот нежный домик из печенья...$l#$b#Ты сделал меня лучше своими нежными и тёплыми объятиями...$l^Ты сделала меня лучше своими нежными и тёплыми объятиями...$l#$b#Ты очень заботился обо мне, когда я был в полном отчаянии.$l^Ты очень заботилась обо мне, когда я был в полном отчаянии.$l#$b#Ты был рядом со мной... Всегда...$l^Ты была рядом со мной... Всегда...$l#$b#Так что... Да...$l",
  "event-75160402.24": "Ты подарил мне новый дом, милый.$l^Ты подарила мне новый дом, милая.$l",
  "event-75160402.25": "Приходи сюда ещё, ладно?$l",
  "event-75160402.26": "Ха-ха! Посмотри, что мы сделали, солнце!$h#$b#Теперь... Уже пора есть?#$b#Давай! Только кусочек!$6",
  "event-75160402.27": "Затем вы с Антоном договорились разделить выпечку с остальными членами семьи.#Вы прибрались на кухне, пока ждали их.#Это было действительно весело! <",
  "event-75160402.28": "*рыгает* Ах! Это было в точку!$h",

//Sonny and Raeriyala (Sonny 8 heart event)
  "event-75160364.01": "Добрый вечер, господин @.$h^Добрый вечер, госпожа @.$h",
  "event-75160364.02": "Вам, наверное, интересно, почему я здесь в столь поздний час? Хм?",
  "event-75160364.03": "Всё в порядке. Пойдёмте, составьте мне компанию.$h",
  "event-75160364.04": "Иногда я прихожу сюда, чтобы успокоить себя в ночи, когда не могу заснуть.#$b#Перед этой статуей я часто говорю обо всём, что у меня на уме.#$b#Я держусь за веру, которая была у меня с детства, когда я видел мельком Горного Духа.#$b#Я знаю, что могу показаться странным... Но я не против того, что говорят другие.$h#$b#Я верю, что духи существуют... И они защищают эту гору.#$b#И я всегда буду выражать им свою благодарность по многим причинам.$h#$b#За ту защиту, которую они нам дают...#$b#...и за комфорт, который они приносят в мою жизнь.$h#$b#Я признаю... Иногда я чувствую разочарование, потому что жажду увидеть этот проблеск снова, особенно в дни, когда у меня есть сомнения.$s#$b#Но я никогда не должен быть жадным. Нужно просто быть благодарным за то, что я жив, потому что она защищала меня раньше, и, возможно, до сих пор.$h",
  "event-75160364.05": "Я также благодарен вам, мой друг.#$b#Вы тот, кто готов слушать бредни старика.$h#$b#За это я искренне благодарен.",
  "event-75160364.06": "Ну чтож, думаю, мне пора возвращаться.$h#$b#Приятного вам вечера, мой друг.$h",
  "event-75160364.07": "Спасибо тебе, о дитя...$4",
  "event-75160364.08": "Вы что-то сказали, господин @?^Вы что-то сказали, госпожа @?",
  "event-75160364.09": "Прошу прощения. Наверное, это было моё воображение!$h",
  "event-75160364.10": "Глупый фермер! Зачастую люди не могут видеть духов.$h",
  "event-75160364.11": "Хотя...$s",
  "event-75160364.12": "Я бы хотела исполнить его желание увидеть меня...$s#$b#Я очень ценю его веру в моё существование.$4",
  "event-75160364.13": "Ты знаешь, что мы, духи, можем посещать это царство, только если на этом месте есть души, которые верят в нас?#$b#Человеческая вера - это, по сути, наш спасательный круг.$4#$b#И поэтому... Я никогда не ожидала, что буду существовать здесь так долго... особенно потому, что у меня никогда не было достойных последователей.$s#$b#Поэтому я очень благодарна этому человеку...$4#$b#Он - драгоценная душа, которой я дорожу...$s",
  "event-75160364.14": "Я знаю, что ты его близкий друг... И поэтому мне нужно, чтобы ты кое-что знал, о фермер.$s^Я знаю, что ты его близкая подруга... И поэтому мне нужно, чтобы ты кое-что знала, о фермер.$s",
  "event-75160364.15": "Это правда. Я спасла этого человека, когда он был мальчиком, после того, как он попал в аварию на этом хребте давным-давно.$s#$b#Но я никогда не спасала его из бескорыстных соображений... На самом деле, он умер в тот день...$s",
  "event-75160364.16": "Но я поняла, что могу извлечь выгоду из этого конкретного случая...$s#$b#Я позволила ему взглянуть на меня, прежде чем он ушёл.$s#$b#Затем я вернула его к жизни.$s#$b#Чтобы он до конца своих дней верил, что я существую...$s#$b#Но восстановление жизни имеет свои недостатки...$s#$b#Он проклят тем, что никогда не обретёт своё самое большое желание... Заключающееся в том, чтобы увидеть меня снова. Даже если я попытаюсь открыться ему...$s#$b#Он никогда не обретёт покой.$s#$b#И когда его смертное тело умрёт, его душа никогда не вознесётся к Иобе, а будет заперта в царстве духов вместе со мной.$s",
  "event-75160364.17": "Я знаю, что мой поступок был эгоистичным...$s#$b#Но мне нужно было сделать это ради себя...$s",
  "event-75160364.18": "Пожалуйста, пойми... Мне нужно было продолжать существовать в этом мире.$s#$b#Я знаю, что он твой друг... И поэтому, я глубоко извиняюсь...$s#$b#Но это ради общего блага.$s#$b#Мне просто нужно было рассказать тебе, чтобы хоть немного снять с себя чувство вины.$4",
  "event-75160364.19": "Санни...",

//Malaya can see the open bridge (Malaya 8 heart event)
  "event-75160344.01": "@? Ты поразил меня, дорогой!$h^@? Ты поразила меня, дорогая!$h",
  "event-75160344.02": "Дождь?#$b#О! Я никогда не возражала против дождя!$h#$b#Наоборот, под ним очень спокойно.",
  "event-75160344.03": "Ты видишь этот мост, да?$h",
  "event-75160344.04": "Меня всегда интриговал этот мост, с тех пор как я впервые приехал сюда.#$b#Видимо, большинство людей его не видят.$s#$b#Правда, он был закрыт несколько лет назад. Удивительно, что после нашего с мужем возвращения сюда он был открыт.#$b#Ты случайно не знаешь что-нибудь об этом мосте и о том, что находится за ним, дорогуша?$s",
  "event-75160344.05": "Тебе не обязательно отвечать, @. Я прошу прощения, если я вторглась в личную жизнь.$s#$b#Но... Мне всегда было интересно узнать о другой стороне.",
  "event-75160344.06": "Я... Я собираюсь пойти туда.$7",
  "event-75160344.07": "Вы побежали за Малайей в сторону горного водопада.",
  "event-75160344.08": "Посмотри на это место, @!$h#$b#Это... Это прекрасно!$h#$b#Подожди... Почему ты выглядишь так удивлённо?$u#$b#В чём дело, дорогуша?$s",
  "event-75160344.09": "Я - русалка!?$u#$b#Подожди! Откуда... Откуда ты это знаешь!?$u#$b#А? Я сейчас стала русалкой?$u",
  "event-75160344.10": "Малайя смотрит вниз на свой гигантский плавник.",
  "event-75160344.11": "Что ты имеешь в виду, дорогуша? Мои ноги всё ещё здесь!$u",
  "event-75160344.12": "Фермер? И... кто-то ещё?#$b#Ооо! Новый гость?$h",
  "event-75160344.13": "Ах! Дух!?$u",
  "event-75160344.14": "Приветствую тебя, русалка.$h#$b#Я - Рэрияла, горный дух.$h#$b#Я удивлена, что русалка смогла взобраться на гору!$h#$b#Погоди... Нет...$s",
  "event-75160344.15": "Откуда... Откуда ты знаешь, что я русалка?!$u#$b#Мои ноги исчезли?$u",
  "event-75160344.16": "О, Иоба! Ты 'была' русалкой!$h#$b#Я ошиблась, смертная!$4#$b#Горный туман - тот ещё обманщик, верно?$h",
  "event-75160344.17": "Ты, должно быть, совсем запуталась.#$b#Понимаешь, местный горный туман может показать чей-то истинный облик глазами другого.$h#$b#Это такое удовольствие, правда?$h",
  "event-75160344.18": "То есть...$s#$b#Вы можете видеть мой старый плавник, а я нет?$s#$b#Неужели... Я потеряю ноги? О нет... Если потеряю...$s",
  "event-75160344.19": "Маленькая русалочка! Не бойся!$4#$b#Твои ноги в порядке! Какая бы магия не превратила тебя в человека, она не будет стёрта здесь.#$b#Это просто иллюзия тумана, которая заставляет местных фермеров видеть тебя такой, какая ты есть на самом деле.$4",
  "event-75160344.20": "О, дорогая...$s",
  "event-75160344.21": "О, фермер? Думаю, тебе лучше пока проводить свою подругу на другую сторону моста.$4#$b#Я не думаю, что для её нынешнего психического состояния полезно оставаться здесь!$4",
  "event-75160344.22": "Вы проводили Малайю из горного водопада.",
  "event-75160344.23": "Я... Я прошу прощения за беспокойство, дорогуша...$s#$b#Я... Я просто не могла удержаться! Как будто это место звало меня перейти мост!$s#$b#Наверное, какая-то часть меня зовёт... Как бы скучая по русалке...$s",
  "event-75160344.24": "Полагаю, секрет раскрыт? О, Иоба...$7#$b#Но знаешь что, дорогуша? Я вообще-то не против, чтобы тебе это было известно.$7#$b#Ты мой близкий друг, и я думаю, что рано или поздно это должно было раскрыться.$7#$b#Я знаю, что могу доверять тебе... Но, пожалуйста, пока не говори об этом Алиссе.$s#$b#Это семейное дело, и я должна быть той, кто скажет ей об этом.$s#$b#В обмен на это я расскажу тебе свою историю.$7",
  "event-75160344.25": "Спасибо, дорогуша.$7",
  "event-75160344.26": "Иоба... С чего начать?$7#$b#Наверное, начну с того, когда я встретила своего мужа, Кимпоя.$7#$b#Однажды ночью, когда я плавала у поверхности, я увидела корабль, освещённый тёплыми золотыми огнями и звуками весёлых мелодий и музыки! Я была в восторге!$7#$b#Я не могла не заглянуть... И вот, я это сделала.$7#$b#Я увидела людей на небольшой вечеринке! Они танцевали, улыбались, кружились и прыгали! Это было завораживающе!$h#$b#Я не понимала, что уже плохо прячусь, и почувствовала, как рука коснулась моей головы.$7#$b#Это был Кимпой. Он не заметил моего хвоста и только с большой тревогой спросил, все ли у меня в порядке. Может быть, он подумал, что я упала за борт?$h#$b#Он мне так дорог...$4#$b#И вот... С тех пор мы стали друзьями... Вскоре он узнал, что я русалка, но это не испортило нашей дружбы.$7#$b#С тех пор мы всегда встречались, когда могли.#$b#От друзей... к лучшим друзьям... к чему-то большему...$4#$b#И в конце концов я поняла, что хочу быть с ним... Но я не была человеком...$s#$b#Моё племя никогда бы этого не позволило... Они сказали, что я предаю свой род... И я сбежала...$s#$b#Я нашла могущественного волшебника, который превратил меня в человека в обмен на некоторые сокровища глубин.$7#$b#После этого мы с Кимпоем сыграли свадьбу, и у нас родилась дочь...$4#$b#По сути, я сбежала из дома. Но я была счастлив... довольна, даже...$7",
  "event-75160344.27": "Но я не понимала, что волшебство не вечно... Что скоро я потеряю ноги...$s#$b#Поэтому мы попросили г-на Агуара найти какой-нибудь способ, и он предложил постоянное решение.#$b#Но для заклинания требовалось благословение моего родного племени... Точнее, моих родителей...$s#$b#Мне было страшно... Потому что, что если я вернусь, и они больше никогда не позволят мне уйти?$s#$b#Я не могла оставить мужа и дочь...$s#$b#Но... У нас не было выбора... Поэтому мы сделали прыжок веры...$s",
  "event-75160344.28": "Много всего произошло... Так много всего случилось...$7#$b#Но мы смогли завершить заклинание. Моя семья разрешила мне стать человеком - с одним условием.$s",
  "event-75160344.29": "Чтобы мы с мужем служили им инструментом для удовлетворения их потребностей, требующих передвижения по земле.$s#$b#И после того, как мы отбывали свой срок, нас отпускали...$s#$b#Только так они позволили бы мне иметь семью... Поэтому нам пришлось пойти на жертву и оставить Алиссу на долгие годы...$s#$b#Мы сделали всё это для неё... Мы сделали все эти ужасные вещи для неё...$s",
  "event-75160344.30": "Мы были инструментами для русалок, которые делали все, что хотели, ради собственной выгоды...$s#$b#...А моё племя русалок было особенно жадным...$s",
  "event-75160344.31": "Но... Мне было всё равно.$7#$b#Лишь бы у меня была семья до конца наших дней после всех этих мучений.$7#$b#Всё это того стоило.$7#$b#Мы вернулись... И это всё, что теперь имеет значение.$7",
  "event-75160344.32": "Клянусь, @... Мы изо всех сил старались не причинить никому вреда во время наших путешествий...$s#$b#Я могу заверить тебя в этом.$7",
  "event-75160344.33": "В любом случае...$7#$b#Я очень рада, что у меня есть с кем поговорить об этом, кроме моей семьи.$7#$b#Ты очень ценный друг, @. И я благодарна за это.$7#$b#Но, пожалуйста... Оставь это пока между нами... Я разберусь с тем, как открыть всё это Алиссе.$s",
  "event-75160344.34": "Малайя сжала вашу руку в знак подтверждения.#Вы замечаете, что её кожа кажется сухой, несмотря на дождь.",
  "event-75160344.35": "Я не знаю, что бы я делала, если бы моя дочь бросила меня...$s",
  "event-75160344.36": "Дождь расслабляет, правда?",

//Lorenzo is thinking about being a father someday (Lorenzo 8 heart event)
  "event-75160336.01": "Ах, воспоминания...",
  "event-75160336.02": "А! Привет, @.#$b#Не обращай на меня внимания! Я просто вспоминал старые времена.$h#$b#Мы с братом и сестрой часто устраивали здесь пикники.#$b#Теперь это место регулярных свиданий для нас с женой.$h#$b#Ах! Почему я сейчас говорил как старик?$h",
  "event-75160336.03": "Ха-ха. Но, наверное, это правда.#$b#Время пролетает так быстро, да?#$b#В одну секунду мои младшие брат и сестра были... ну, такими маленькими.#$b#А в следующую секунду они уже самостоятельно познают мир!#$b#У них своя работа, проблемы, приключения и даже собственные кошельки!$s",
  "event-75160336.04": "Мама мия! Я просто не могу поверить!$s",
  "event-75160336.05": "Mi dispiace! Прости! Это было внезапно!$h#$b#Но с тобой легко разговаривать, @. Я ценю это.#$b#Ты хороший друг, близкий к семье! Ну, по крайней мере, для меня.$h#$b#Надеюсь, что и для тебя тоже.",
  "event-75160336.06": "Скажи, @... Ты не против, если я буду больше говорить с тобой о том, что у меня в голове?#$b#В последнее время я понял кое-что, что заставляет меня слишком много размышлять.$6",
  "event-75160336.07": "Понимаешь, с тех пор как наши папа и мама внезапно ушли из жизни, я остался один заботиться о своих младших брате и сестре.$s#$b#Я много работал! Я управлял магазином некоторое время, пока Антон не смог взять его на себя, чтобы я мог получать больше денег, работая в большом городе.$6#$b#Было ощущение, что я стал для них и новой мамой, и новым папой... И я так гордился этим.#$b#Мама мия! Я с гордостью могу сказать, что смог помочь одному из них закончить колледж!$h#$b#Я ухаживал за ними почти всю свою жизнь.#$b#А теперь...$s#$b#В последнее время я понял, что они выросли...$6#$b#И я чувствую, что глава моей жизни заканчивается.$s#$b#Но... Я не думаю, что готов...$s#$b#Я просто... не могу поверить, что они могут справиться сами.$6#$b#Мама мия... Почему мне кажется, что я просто не готов их отпустить?$6#$b#Когда с Антоном произошёл весь этот инцидент, первое, что я ему сказал, это вернуться домой.$s#$b#А когда Киарра сказала, что хочет уехать куда-то далеко для какого-то проекта или чего-то ещё...$s#$b#Я чувствую, что сейчас выпалю 'нет' на месте!$s#$b#Я просто хочу, чтобы они были рядом...$s#$b#Почему они так быстро выросли?$6#$b#У меня в нутрии сильное чувство горечи.$6#$b#Я действительно не понимаю себя.$6#$b#Ха-ха! Был даже случай, когда тема рождения детей всплыла во время нашего с женой разговора.$6#$b#Забавно, что первое, что пришло мне в голову, это то, что у меня нет времени беспокоиться о ребёнке.$6#$b#В то время также я беспокоюсь за своих двух младших брата и сестру!$h#$b#Мама мия... Я действительно должен их отпустить, да?$6",
  "event-75160336.08": "Но что бы ни случилось... Я горжусь тем, чего мои брат и сестра добились сами.$h#$b#Я чувствую, что могу медленно двигаться дальше...$h",
  "event-75160336.09": "Ха-ха. Я думаю, единственное, чего здесь не хватает - это холодного напитка в наших руках!$h#$b#Прошу прощения за всю эту тяжёлую драму!$h#$b#Но... Я чувствую себя намного лучше после того, как всё это высказал.#$b#И, честно говоря... Мне кажется, что я даже успел поразмышлять.$h#$b#И может быть, когда я разберусь с этим... Может быть, я смогу с нетерпением ждать новой главы в своей жизни.$6#$b#Кто знает? Правда, мой друг?$h",
  "event-75160336.10": "Кажется, Лоренцо стало легче после того, как он высказал свои переживания.",
  "event-75160336.11": "@! Спасибо, что выслушал меня. Если тебе когда-нибудь что-нибудь понадобится от меня, обязательно заходи.$h^@! Спасибо, что выслушала меня. Если тебе когда-нибудь что-нибудь понадобится от меня, обязательно заходи.$h",

//Carmen fell asleep (Carmen 8 heart event)
  "event-75160316.01": "Кармен спит посреди дорожки!",
  "event-75160316.02": "*хр-р*...",
  "event-75160316.03": "А?$s",
  "event-75160316.04": "Диос мио! Уже поздно!$u",
  "event-75160316.05": "Ая-яй! Я просто присела отдохнуть на несколько минут!$s#$b#Я и не заметила, что уже заснула!$s#$b#Это позор! Я права, @?$h",
  "event-75160316.06": "Я знаю, знаю! Я должна быть осторожна в следующий раз.$s#$b#Диос мио, я думаю, это был знак, что мне нужен выходной!$h",
  "event-75160316.07": "Но знаешь что? Я даже не понимала, что уже так устала.#$b#Я знаю, что это звучит плохо... Но, возможно, это из-за моего стремления сделать так, чтобы моя Мия жила хорошо и комфортно, которое подпитывает все фибры моего тела...$h#$b#Я просыпаюсь каждый день и иду на пляж этого города в поисках лучшего улова за лучшие деньги.#$b#Но я знаю, что она будет волноваться, если узнает об этом!$s#$b#Нет, подожди! Она рассердится!$u",
  "event-75160316.08": "Хех... Забавно, что иногда мне кажется, что моя мия - самая взрослая между нами.$h",
  "event-75160316.09": "Эй, @! Спасибо, что разбудил меня!^Эй, @! Спасибо, что разбудила меня!#$b#Или, по крайней мере, просто услышать твои следы было достаточно, чтобы разбудить меня! Кто знает, сколько бы я проспала здесь, если бы не ты? А?$h",
  "event-75160316.10": "Я знаю! Я знаю, что мне нужно отдохнуть.$h#$b#Я не хочу волновать и свою Мию.",
  "event-75160316.11": "Ха-ха!$h",
  "event-75160316.12": "Меня снова осенило, что моя Мия выросла...#$b#И... Она выросла такой красивой и доброй...$7#$b#Мне... Мне кажется, я неплохо справляюсь с её воспитанием? Верно?$6#$b#Мне странно гордиться тем, что я растила её одна, хотя я знаю, что она всегда жаждала присутствия отца...$6#$b#Но всё же... Я просто хочу сказать, что счастлива, что она может улыбаться каждый день со своими друзьями и близкими...$7#$b#Я сделаю все для своей мии...$7",
  "event-75160316.13": "*всхлип*",
  "event-75160316.14": "Ая-яй! Посмотри, как я вдруг стала эмоциональной!$7#$b#Но я чувствую, что могу сказать тебе все, @. Ты такой замечательный друг.$7#$b#Мучас грасиас и спасибо, что ты мой друг.$7",
  "event-75160316.15": "Хорошо! Хватит болтать! Я лучше пойду домой.$h#$b#Ай! И, пожалуйста, не говори моей мие, что я заснула посреди дороги, хорошо?$h",
  "event-75160316.16": "*зевает* Ая-яй! Как же болит спина!$s",

//Louie invites the farmer to play (Louie 8 hearts)
  "event-75160374.01": "Добрый день, @.$h#$b#Молодой господин хотел бы с вами поговорить.#$b#Он также хотел бы сообщить, что он \"совершенно не ждал вас или чего-то ещё\".$h",
  "event-75160374.02": "Санни!$a",
  "event-75160374.03": "Фермер! То есть... @!#$b#Я заказываю... то есть... У тебя случайно не найдётся сегодня свободного времени?$4#$b#Чтобы... эм... поиграть?$h#$b#*кхем* Не пойми меня неправильно! Это потому что другие дети попросили меня поиграть с ними!$a#$b#И я чувствую, что игра, в которую мы собирались играть, будет лучше с большим количеством людей!$a#$b#Поэтому я решил, что должен пригласить тебя!$4",
  "event-75160374.04": "Поиграть с Луи и друзьями?",
  "event-75160374.05": "Конечно! Пошли!",
  "event-75160374.06": "Может быть, в следующий раз.",
  "event-75160374.07": "Оу... Правда?$s#$b#Э, то есть, всё в порядке! Ты всё равно не единственный человек!$4",
  "event-75160374.08": "Пойдём, Санни. Пошли обратно.$s#$b#Я думаю, мы можем просто заплатить какому-нибудь простолюдину, чтобы он поиграл с нами.$4",
  "event-75160374.PlayWithLouie.01": "Что? Ты правда будешь!?$h#$b#Отлично!$h#$b#Э... То есть... Как и ожидалось. Кто бы отказался от моего приглашения?$4",
  "event-75160374.PlayWithLouie.02": "Давай вернёмся к остальным, Санни.#$b#И пусть начнутся игры!$h",
  "event-75160374.PlayWithLouie.03": "Ух ты! Ты действительно пошёл и нашёл @!$u#$b#Теперь ты ведёшь себя круто, Луи!$h",
  "event-75160374.PlayWithLouie.04": "Ага, ага, ага, ага! Эй!!! Луи прав! Больше людей - больше веселья!$h",
  "event-75160374.PlayWithLouie.05": "Привет, @.$h#$b#Луи настоял на том, чтобы ты поиграл с нами!$h^Луи настоял на том, чтобы ты поиграла с нами!$h",
  "event-75160374.PlayWithLouie.06": "Хватит болтовни, давайте начнём игру!$4#$b#Вы всё равно проиграете!$h",
  "event-75160374.PlayWithLouie.07": "Ура! Время пряток!$h",
  "event-75160374.PlayWithLouie.08": "Кеяхи! Ты проиграл предыдущую игру! Так что теперь твоя очередь искать нас.",
  "event-75160374.PlayWithLouie.09": "ЧЕГО?!$u#$b#Вот блин!$s#$b#Но не прячьтесь слишком далеко, хорошо?!$h",
  "event-75160374.PlayWithLouie.10": "Ха! Ты никогда меня не найдёшь!$h",
  "event-75160374.PlayWithLouie.11": "Кажется, у Луи теперь есть друзья.#Вы рады видеть, как он веселится с другими детьми.",
  "event-75160374.PlayWithLouie.12": "Давай сыграем в следующий раз, понятно?$h",

//Kimpoi looking at an old photo (Kimpoi 8 heart event)
  "event-75160332.01": "О! Привет, @.$h#$b#Ольга попросила меня принести кое-что из её дома.#$b#Но вместо этого я увлёкся просмотром старого фотоальбома из нашего детства.$h",
  "event-75160332.02": "Вот! Взгляни на эту фотографию!$h",
  "event-75160332.03": "Это старая фотография группы детей у знакомого дерева.",
  "event-75160332.04": "Ха! Не могу поверить, что это было 35 лет назад.$h#$b#Мисс Ленни одолжила у Мадам Мейв портативный фотоаппарат и заставила нас, детей, сфотографироваться у качающегося дерева на хребте.$h#$b#Я не могу поверить, что раньше здесь было так много детей.#$b#О, это сын Ричарда и шурин Эзикиеля справа.#$b#О! Берт, Кармен и моя сестра выглядят такими маленькими!$h#$b#Я помню, как Наоми была старшей сестрой для этих малышей.$h#$b#И кто может забыть Аметинов! Посмотри здесь слева.#$b#Видишь? Это мой старый приятель Захари, старший ребёнок мадам.#$b#А это его младшая сестра рядом с ним, малышка Алтея.$h#$b#Я так давно не видел этих двоих. Интересно, как они сейчас поживают.#$b#...О, ну, это же Аметины, я уверен, что они в порядке.$h",
  "event-75160332.05": "Ой... Упс! Я чуть не забыл о просьбе моей сестры!$u",
  "event-75160332.06": "...а фотоальбом - здесь.",
  "event-75160332.07": "Было приятно поделиться с другом историями о своём детстве.$h#$b#Если хочешь, не стесняйся просмотреть фотоальбом ещё раз.#$b#И ты всегда можешь спросить меня о любых старых историях, которыми я могу поделиться!$h",
  "event-75160332.08": "Кимпой похлопал вас по плечу.",
  "event-75160332.09": "Э... Создай как можно больше хороших воспоминаний.$h#$b#Возможно, я не очень хорошо владею словами, но думаю, что это лучший совет, который я могу дать своему дорогому другу.$h#$b#...И... Если что-нибудь понадобится, не стесняйся спрашивать.$h",
  "event-75160332.10": "Ну... Я лучше пойду.$h#$b#До встречи, @.$h",
  "event-75160332.11": "Интересно, как скоро старая компания сможет снова сделать групповой снимок?",

//Sean 14 Heart Event (Part 1 - Relax Idea)
  "event-75160369.01": "Милый! Привет! Ты сегодня свободен, да?$h^Милая! Привет! Ты сегодня свободна, да?$h",
  "event-75160369.02": "Круто!$h#$b#Ладно, я прочитал в интернете о том, как мы можем устроить свидание.#$b#Это называется \"смотреть на облака\" - звучит расслабляюще, правда?$h#$b#Я знаю, что это может показаться глупым и скучным, но просто поверь мне!$h#$b#Кроме того, мне просто нужен повод, чтобы прилечь и расслабиться с тобой где-нибудь ещё, кроме нашей кровати.$l#$b#Типа, я тебя 'затуманил'! Хе-хе. Понятно?$h",
  "event-75160369.03": "*шепчет* Хе-хе. К тому же это хороший повод прогулять работу, потому что это семейное мероприятие.$h",
  "event-75160369.04": "Эй! Я шучу! Шучу! Ха-ха!$h#$b#Можно сказать, как облако, эта шутка прошла мимо твоей головы!$h",
  "event-75160369.05": "Ха-ха! Ладно! Я перестану!$h#$b#Хорошо! Давай устроим свидание на утёсе, хорошо?#$b#Увидимся там до полудня, солнце!",
  "event-75160369.06": "А теперь... Вот тебе \"до встречный\" поцелуй!$l",
  "event-75160369.07": "Хе-хе. От твоих поцелуев я чувствую себя на седьмом небе.$l",
  "event-75160369.08": "Увидимся на утёсе, дорогой!$h^Увидимся на утёсе, дорогая!$h",

//Kiarra 14 Heart Event (Part 1 - Worry)
  "event-75160366.01": "Это плохо...$s",
  "event-75160366.02": "@! Подойди и посмотри на это!$a",
  "event-75160366.03": "На телефоне Киарры появляется статья об исчезающем виде лисиц.",
  "event-75160366.04": "Здесь говорится, что златогубая лисица является местным видом в этой долине.$s#$b#Однако тревожное снижение его численности озадачивает учёных.$s#$b#Последние данные показывают, что это может быть связано с чрезмерным загрязнением отходов от туристов, посещающих этот район.$a#$b#Эта неуловимая лиса может оказаться в тяжёлых условиях, близких к исчезновению, если люди не изменят свой образ жизни. По крайней мере, так считают эксперты.$a",
  "event-75160366.05": "Это ужасно!$s#$b#Знаешь, теперь, когда я думаю об этом... я ни разу не видела этих лисиц поблизости.$s#$b#Но мой брат, Лоренцо, сказал, что однажды видел такую 20 лет назад!$a#$b#Может быть, их с каждым годом становится все меньше и меньше!$s",
  "event-75160366.06": "Мы должны что-то сделать, моя звезда!$a#$b#Я предлагаю установить небольшой ларёк рядом с туристической точкой.#$b#Может, у Пайка! Мы всегда можем спросить у него разрешения.$h#$b#В киоске будет размещена информация о лисах и об утилизации отходов загрязнения, о том, как помочь уменьшить их количество.#$b#Я надеюсь, что это повысит осведомлённость и, возможно, даже поможет остановить тех надоедливых туристов, которые бездумно бросают мусор вокруг природы!$a#$b#Я подготовлю всё это к завтрашнему дню!$h",
  "event-75160366.07": "Я могу провести все исследования и подготовку к нему, звезда. Не волнуйся!#$b#Просто проснись завтра пораньше, чтобы мы могли как можно скорее отправиться в деревню и все подготовить, хорошо?$h#$b#Я знаю, что ты сегодня устал после работы, поэтому я обо всём позабочусь.$l^Я знаю, что ты сегодня устала после работы, поэтому я обо всём позабочусь.$l",
  "event-75160366.08": "Хорошо отдохни, моя звезда.$l#$b#Давай поможем изменить мир завтра, шаг за шагом!$h",
  "event-75160366.09": "Хорошо! Я приготовила кофе и музыку на всю ночь!$h",

//Kiarra 14 Heart Event (Part 2 - Savior Of Foxes)
  "event-75160367.01": "Зевок",
  "event-75160367.02": "Доброе утро, звёздочка!$h#$b#*Зевок* Ах! Я все закончила! Разве я не удивительная?$h#$b#Все собрано снаружи.#$b#И я уже позвонил Пайку и Ленни насчёт ларька. Нам дали зелёный свет!$h#$b#Я уже попросил Йена и Шона помочь мне с установкой ларька. Это срочный заказ, но я знаю, что они справятся великолепно.#$b#*зевок* Я буду в долгу перед многими людьми после этого. Они мне очень помогли.",
  "event-75160367.03": "Ну, чтож! Поехали!$h",
  "event-75160367.04": "Ух!",
  "event-75160367.05": "Что!?",
  "event-75160367.06": "Я согласна!",
  "event-75160367.07": "С ума сойти!",
  "event-75160367.08": "Я знаю, что сейчас ещё раннее утро.#$b#Но я не могу поверить, что многие люди стекаются к нашему киоску!$h#$b#Я чувствую, что наше послание доходит до них, звезда!$h",
  "event-75160367.09": "Продолжаем в том же духе!$h",
  "event-75160367.10": "Спасите лисиц!",
  "event-75160367.11": "Спасите милых лисичек!",
  "event-75160367.12": "Небольшое собрание продолжалось ещё несколько часов.#Вы надеетесь, что ваше послание дойдёт до них.",
  "event-75160367.13": "*зевает*...",
  "event-75160367.14": "Я в ударе! Давай...$h#$b#ОГО!$u",
  "event-75160367.15": "Киарра пропустила ступеньку на лестнице.#Вам удалось её поймать.",
  "event-75160367.16": "Упс! Спасибо, звезда!$l#$b#Я так плохо сплю, что становлюсь неуклюжей!$h#$b#Забавно, что раньше я всегда спала допоздна, делая все эти художественные заказы и все такое.$s#$b#Хе-хе. Похоже, ты действительно изменил меня, звезда...$l^Хе-хе. Похоже, ты действительно изменила меня, звезда...$l",
  "event-75160367.17": "Может быть, из-за тебя... Я бы предпочла сейчас лечь спать пораньше.$h#$b#Чтобы у меня было больше времени на обнимашки с тобой...$l#$b#Ха-ха! Ого! Это было дерзко с моей стороны!$h",
  "event-75160367.18": "Но...$l",
  "event-75160367.19": "Киарра положила голову на ваше плечо.#Вы чувствуете, как она старается не заснуть.",
  "event-75160367.20": "Это правда, хотя...$l",
  "event-75160367.21": "Спасибо, что всегда прикрывал меня, звезда....$l^Спасибо, что всегда прикрывала меня, звезда....$l#$b#*зевает* Я знаю, что я не очень выразительный человек в плане романтики...$s#$b#Но ты - огромная опора... *зевает* кто-то, кто двигает меня и мотивирует.$l#$b#Я люблю тебя... очень сильно.$l",
  "event-75160367.22": "Вы сделали перерыв, и Киарра немного отдохнула на ваших коленях на соседней скамейке.#Она спала как убитая!",
  "event-75160367.23": "О, Иоба! Который час!?$u#$b#А!!! Нам нужно убрать наш ларёк!$u",
  "event-75160367.24": "*зевает* Мне так хочется спать, звезда!$s",

//Blair 14 Heart Event (Part 1 - Curious)
  "event-75160396.01": "Детка! Хе-хе~ У тебя ведь нет завтра никаких дел?$h#$b#Я просто лежала на кровати, и это заставило меня задуматься...#$b#Что я никогда раньше не рыбачила в городе Пеликан!$u#$b#Я имею в виду, не считая случайной рыбалки на пляже с моей мамой, да!$7#$b#Но теперь, когда я живу здесь с тобой, мне показалось странным, что я даже не пробовала ловить рыбу в пресных водоёмах этого города!$h#$b#Интересно, каких рыб можно здесь поймать!$h",
  "event-75160396.02": "У меня есть несколько мест на примете...#$b#А как насчёт свидания на рыбалке у лесного пруда?$h#$b#Знаешь, возле той старой башни, где иногда загораются и гаснут странные огни?#$b#Ооо! Жутко! Видишь! Это добавляет острых ощущений в наше свидание!$h",
  "event-75160396.03": "Блэр бросилась к вам и обняла вас.",
  "event-75160396.04": "Давай, детка! Веред, пошли-пошли!$h#$b#Я знаю, что ты не сможешь устоять, когда я так близко к тебе, верно?$6#$b#Хи-хи! <$l",
  "event-75160396.05": "Так... это работает?$l",
  "event-75160396.06": "Хи-хи! <$l#$b#Я приму это как знак согласия!$6#$b#Я люблю тебя, я люблю тебя, Я ЛЮБЛЮ ТЕБЯ!$h",
  "event-75160396.07": "Хорошо! Встретимся в лесу завтра до полудня, хорошо?$h#$b#Пока что... Давай повеселимся дома.$6",
  "event-75160396.08": "Ура! Завтра свидание с моей милой-любимой-сладкой-булочкой! <$h",

//Paula 14 Heart Event (Part 1 - Breath of fresh air) (Plan drinking version)
  "event-75160398.01": "...Ох, голова раскалывается.$s#$b#О! Привет, солнце. Прости, я просто принимала таблетки от мигрени.$6#$b#Просто... Я слишком много работаю в последнее время, наверное?$s",
  "event-75160398.02": "Хе-хе. Я знаю, что, возможно, перебрала.$9#$b#Просто...$8",
  "event-75160398.03": "Паула обняла вас.",
  "event-75160398.04": "...Я просто хочу усердно работать для нашего совместного будущего.$8#$b#Хех. Я понимаю, что лицемерю.$9#$b#Всё это время я постоянно напоминаю тебе, что нужно заботиться о себе, но я не делаю того же для себя.$9#$b#Хе-хе. Прости, дорогой.$l^Хе-хе. Прости, дорогая.$l",
  "event-75160398.05": "Вы обняли Паулу в ответ.",
  "event-75160398.06": "Я не уверена, что таблетки уже действуют...$l#$b#Или твои объятия просто помогли мне почувствовать себя намного лучше.$l#$b#*вздох* Прости меня за упрямство, солнце.$9#$b#Иди сюда...$l",
  "event-75160398.07": "Паула поцеловала вас.",
  "event-75160398.08": "Скажи, как насчёт того, чтобы пойти выпить завтра вечером, солнце?#$b#Как в старые добрые времена!$h#$b#Мы можем пригласить наших друзей! Например, на ночь!$h",
  "event-75160398.09": "Звучит заманчиво!",
  "event-75160398.10": "Звучит здорово, но можно обойтись как-то без выпивки?",
  "event-75160398.11": "Ай! Моя голова!$s#$b#Хе-хе. Этот доктор считает, что мне нужна большая доза времени для тебя и меня...$l",
  "event-75160398.12": "Давай останемся так на некоторое время...$h",
  "event-75160398.13": "Я не могу дождаться завтрашнего вечера!$h",

  "paula14_choice1": "Правда!? Замечательно!$h#$b#Давай встретимся завтра у Пайка между 12 утра и 20 часами вечера, хорошо?",
  "paula14_choice2": "Конечно! Я никогда не попрошу тебя пить, если ты не хочешь, солнце. Вместо этого мы можем заказать безалкогольные напитки!$h#$b#Давай встретимся завтра у Пайка между 12 утра и 20 часами вечера, хорошо?",

//Anton 14 Heart Event (Part 1 - Bake)
  "event-75160401.01": "Привет, солнце#$b#Хочешь завтра построить дом?$h",
  "event-75160401.02": "Ха-ха! Я имею в виду, построить дом из печенья или что-то в этом роде!$h#$b#Шанис позвонила и сказала, что у них есть лишняя партия теста для печенья, которое мы можем использовать.#$b#Я подумал, что мы можем повеселиться с ним! Ну, знаешь, испечь что-нибудь вместе.$h#$b#Может быть, даже попробовать сделать пряничный домик!$h#$b#Паула и Киарра сказали мне, что такие простые свидания действительно сделают кого-то счастливым.$l#$b#Итак...$l",
  "event-75160401.03": "Что скажешь?$h#$b#Мы можем встретиться в Хипсе завтра утром до полудня.#$b#Шанис сказала, что приготовит для нас совсем немного.$h",
  "event-75160401.04": "Теперь, когда все решено...#$b#Могу я спросить... Ты умеешь печь?#$b#Честно говоря, я в этом не смыслю, поэтому полагаюсь в этом вопросе на тебя.$h",
  "event-75160401.05": "Ха-ха! Я просто прикалываюсь над тобой! Конечно, я знаю!$h#$b#Может... немного? Хех.$h#$b#О, иди сюда!$l",
  "event-75160401.06": "Я должен узнать, как печь, да?",

//Blair 14 heart event (Part 2 - Fishing Pond)
  "event-75160397.01": "Уже что-нибудь поймал, малыш?^Уже что-нибудь поймала, малышка?#$b#Если ты не занят, можешь оказать мне услугу?$7^Если ты не занята, можешь оказать мне услугу?$7",
  "event-75160397.02": "Хе-хе. Я вроде как проголодалась.#$b#Можешь накормить меня печеньем, которые мы взяли с собой?$6",
  "event-75160397.03": "Я знаю, что могу просто положить свою удочку.$7#$b#Но я хочу, чтобы это сделал ты.$6^Но я хочу, чтобы это сделала ты.$6#$b#Пожалуйста?$6",
  "event-75160397.04": "Вы кормите Блэр печеньем.",
  "event-75160397.05": "Хи-хи! <$h#$b#Ура! Я чувствую энергию...$h",
  "event-75160397.06": "Я что-то поймала!$u#$b#И... оно огромное!$u#$b#Аргх! Помоги мне пожалуйста, детка!$u",
  "event-75160397.07": "Тяни!$a",
  "event-75160397.08": "Мы ещё не сдаёмся, рыбка!$a",
  "event-75160397.09": "Вот она!$a",
  "event-75160397.10": "И-и-и!$u",
  "event-75160397.11": "Это... Киви!?",
  "event-75160397.12": "Что за...!?$u",
  "event-75160397.13": "А!? Что делает плод киви на дне пруда?$u#$b#И почему было так трудно тянуть?!$u",
  "event-75160397.14": "Киви выполнять подводный миссия!$a#$b#Лист Киви зацепиться за крючок!$u#$b#Следующее, что знать Киви, это то, что Киви плыть назад очень быстро!$u",
  "event-75160397.15": "Киви не простит компанию фермера!$a#$b#Киви должен немедленно сообщить об этом Джио!$a",
  "event-75160397.16": "...может быть, его тянула большая рыба?$a#$b#Детка? Эй! Почему ты смотришь на этот киви?",
  "event-75160397.17": "АХ! Куда он делся!?$u",
  "event-75160397.18": "@! Он... Он просто исчез!$u#$b#Что происходит!?$u",
  "event-75160397.19": "Что было в этом печенье?!$h",
  "event-75160397.20": "Вы ненадолго отвлеклись от рыбалки и провели следующие несколько часов болтая, пока Блэр лежала головой на ваших коленях.#Это было такое насыщенное свидание!",
  "event-75160397.21": "А? Закуски?#$b#Ух, детка! Я больше не притронусь к этому печенью!$h#$b#Давай ещё немного пообнимаемся!$l",
  "event-75160397.22": "Это было такое сумасшедшее свидание! Каждый день становится захватывающим, когда я с тобой!$h",



  //Quests
  "FishingQuest.Carmen.Description": "Хола! Кто-нибудь хочет порыбачить? Я бросаю вызов кому-нибудь, чтобы поймать {1} {0}! Увидимся позже!          -Кармен",
  "FishingQuest.Carmen.ReactionText": "Ого! Отличная работа, @. Вот твоя награда!",



	"bert_honey.title": "Муж в панике",
	"bert_honey.description": "Ольга на меня злиться, но я знаю, как сделать её счастливее! Мне нужен мёд для моей пчёлки.\n        -Берт. \n \n- 300з. за доставку \n- Берт будет благодарен",
	"bert_honey.objective": "Принесите 1 баночку мёда Берту",
	"bert_honey.reactiontext": "Ты его принёс! Большое тебе спасибо! Надеюсь, жёнушка меня простит!$h^Ты его принесла! Большое тебе спасибо! Надеюсь, жёнушка меня простит!$h",

	"trinnie_sunflower.title": "Принцесса подсолнухов",
	"trinnie_sunflower.description": "Тринни нужны подсолнухи для платья, которое она хочет сшить, чтобы стать принцессой Подсолнухов!\n        -Тринни. \n \n- 2000з за доставку \n- Тринни станет Принцессой подсолнухов",
	"trinnie_sunflower.objective": "Принесите Тринни 10 подсолнухов",
	"trinnie_sunflower.rewardDesc": "2000з от моего Папы",
	"trinnie_sunflower.reactiontext": "Ах, цветочки! Я так счастлива! Огромное спасибо, @!!!$h",

	"keahi_slime.title": "Слаймовый король",
	"keahi_slime.description": "Я хочу собирать слизь и стать Слаймовым королём!!!\n        -Кеяхи. \n \n- 500з за доставку \n- Кеяхи станет Слаймовым королём",
	"keahi_slime.objective": "Принесите Кеяхи 50 шт. слизи",
	"keahi_slime.reactiontext": "Это невероятно склизкое. И мерзкое! Но и КРУТОЕ!? Спасибо! Теперь я Слаймовый король!$4",

	"yuuma_ring.title": "Потерянное кольцо Юмы",
	"yuuma_ring.description": "Могу я попросить о помощи? Я потерял своё кольцо... Кольцо, которое мама подарила мне давным-давно. Я заплачу тебе! Обещаю! Я просто не могу оставить Широ одного, пока буду искать его... Пожалуйста, найди кольцо!\n        -Юма \n \n- 200з за завершение",
	"yuuma_ring.objective": "Найдите кольцо Юмы и верните его ему. Он помнит, что кольцо было у него, когда он покупал вещи на ферме Джерика.",
	"yuuma_ring.reactiontext": "Тебе удалось его найти?! Огромное спасибо, @! Я искренне тебе благодарен!h",

	"olga_tuna.title": "Жажда тунца",
	"olga_tuna.description": "Я хотела бы попросить тунца. Моя семья уже давно хочет блюда из тунца, и мы хотели бы купить его свежим.\n        -Ольга. \n \n- 400з за доставку \n- Ольга будет благодарна",
    "Objective": "Принесите одного тунца Ольге",
	"olga_tuna.objective": "Принесите одного тунца Ольге",
	"olga_tuna.reactiontext": "О, ты всё же принёс его! Он ещё и свежий! Отличная работа, @!$h^О, ты всё же принесла его! Он ещё и свежий! Отличная работа, @!$h$h",

	"aguar_essence.title": "Эксперимент пустоты",
	"aguar_essence.description": "Мне требуется помощь в сборе эссенции пустоты для моего следующего исследовательского проекта. Не спрашивай, какого и зачем.\n        -Мистер Агуар. \n \n- 1000з за доставку \n- Мистер Агуар будет благодарен",
	"aguar_essence.objective": "Принесите 10 эссенций пустоты мистеру Агуару",
	"aguar_essence.reactiontext": "Изумительная работа, @. Вот плата. А теперь прошу меня извинить...",

	"freddie_sword.title": "Старый друг",
	"freddie_sword.description": "Я потерял свой старый меч! Последнее, что я помню, это то, что я прогуливался у водопадов, но я не помню, у какого именно. Надеюсь, никто не пострадает, когда найдёт его, он довольно острый.\n        -Freddie \n \n- 500з за завершение ",
	"freddie_sword.objective": "Найдите меч Фредди и верните его ему. Он помнит только то, что стоял рядом с водопадом.",
	"freddie_sword.reactiontext": "Вот ты где, мой старый друг. Спасибо, @!$h",

	"pika_mayonnaise.title": "Майонезный сюрприз",
	"pika_mayonnaise.description": "Я обдумывал рецепт нового блюда и никак не мог найти достойный майонез для него. Понимаете, майонез будет секретным ингредиентом! Кто-нибудь может принести мне немного?\n        -Пайк. \n \n- 600з за доставку \n- Пайк будет благодарен",
	"pika_mayonnaise.objective": "Принесите 1 банку майонеза Пайку",
	"pika_mayonnaise.reactiontext": "Махало, @! Спасибо! И качество очень хорошее! Вот оплата, как и обещал!$h",

	"richard_glasses.title": "Потерянные очки",
	"richard_glasses.description": "Кажется, я потерял свои очки, и мне трудно их найти, потому что.... я плохо вижу без них. Все, что я знаю, это то, что я не выходил из отеля до конца дня. Я заплачу вам за беспокойство.\n        -Ричард \n \n- 300з за завершение ",
	"richard_glasses.objective": "Найдите очки Ричарда и верните их ему. Он помнит только то, что не выходил из отеля целый день.",
	"richard_glasses.reactiontext": "Ты нашёл их?! Большущее спасибо, @! Хе-хе, что бы я без тебя делал.$h^Ты нашла их?! Большущее спасибо, @! Хе-хе, что бы я без тебя делал.$h",

	//Board Quests
	"aguar_gem.title": "Поиск аквамарина",
	"aguar_gem.description": "Мне необходим аквамарин. Я обязательно заплачу вам как полагается, если вы принесёте мне его.\n        -Мистер Агуар.\n \n- 400 з. за доставку\n- Мистер Агуар будет благодарен",
	"aguar_gem.objective": "Принесите аквамарин мистеру Агуару",
	"aguar_gem.reactiontext": "Недурно. Вот плата. А теперь, прошу меня извинить...",

	"aguar_fairystone.title": "Поиск камня феи",
	"aguar_fairystone.description": "Мне необходим камень феи. Я обязательно заплачу вам как полагается, если вы принесёте мне его.\n        -Мистер Агуар.\n\n- 500 з. за доставку\n- Мистер Агуар будет благодарен",
	"aguar_fairystone.objective": "Принесите камень феи мистеру Агуару",
	"aguar_fairystone.reactiontext": "Недурно. Вот плата. А теперь, прошу меня извинить...",

	"bert_orange.title": "Апельсиновый Берт",
	"bert_orange.description": "Я хочу начать бизнес по производству апельсинового сока! Мне нужен поставщик апельсинов... 3 штучки будет неплохо для начала. \n        -Берт.\n\n- 900 з. за доставку\n- Берт будет просто счастлив",
	"bert_orange.objective": "Принесите Берту 3 апельсина",
	"bert_orange.reactiontext": "Радуешься поди, что я не попросил принести бананы? Апельсиновое спасибо, @!",

	"ezekiel_cavecarrot.title": "Ностальгический вкус",
	"ezekiel_cavecarrot.description": "Давненько я не пробовал пещерной морковки. Если кто-нибудь принесёт мне её, я заплачу.\n        -Эзикиель.\n\n- 200 з. за доставку\n- Эзикиель будет благодарен",
	"ezekiel_cavecarrot.objective": "Принесите Эзекиилю пещерную морковку",
	"ezekiel_cavecarrot.reactiontext": "Ба, вкус отвратительный. Хотя он напоминает мне о старых временах.#$b#Спасибо.",

	"freddie_shadowbrute.title": "Теневой воротила",
	"freddie_shadowbrute.description": "Теневой воротила - опасное одичалое существо. Уничтожьте нескольких, чтобы принести мир в долину. Вперёд, юный искатель приключений!\n        -Фредди.\n\n- 3000 з. за выполнение",
	"freddie_shadowbrute.objective": "Уничтожьте 10 теневых воротил",
	"freddie_shadowbrute.reactiontext" : "Ты отлично ${поработал^поработала}$, ${юный искатель^юная искательница}$ приключений! Ты ${сделал^сделала}$ эту долину немного безопаснее.$h",

	"freddie_pepperrex.title": "Замечательное хобби",
	"freddie_pepperrex.description": "Кто-нибудь слышал о перечных динозаврах? На них очень весело охотиться! Я бросаю вызов любому, кто сразит нескольких из них, и обязательно вознагражу. Удачи!\n        -Фредди.\n\n- 4000 з. за выполнение",
	"freddie_pepperrex.objective": "Уничтожьте 10 перечных динозавров",
	"freddie_pepperrex.reactiontext" : "О, Иоба! Разве не весело было истреблять этих монстров? \"Больше тренироваться, чтобы больше убивать\", Я бы всегда так говорил!$h",

	"keahi_tomato.title": "Новый шедевр",
	"keahi_tomato.description": "Кто-нибудь может принести мне большой жирный сочный помидор? Он нужен для секретного проекта.\n        -Кеяхи.\n\n- 200 з. за доставку\n- Кеяхи будет благодарен\n- Кеяхи пощадит вас",
	"keahi_tomato.objective": "Принесите Кеяхи помидор",
	"keahi_tomato.reactiontext": "А! Он прекрасен, @! Грядёт кое-что эпичное!$h",

	"keahi_bomb.title": "Безобидная шутка",
	"keahi_bomb.description": "Итак, мой папа не хочет покупать мне бомбу. Поэтому я и написал объявление! Если она у кого-нибудь есть, принесите её мне, и я заплачу вам из своих сбережений! Только быстро! Пока объявление снова не убрали!.\n        -Кеяхи.\n\n- 1000 з. за доставку\n- Кеяхи будет просто счастлив\n- Горожане будут обеспокоены",
	"keahi_bomb.objective": "Принесите Кеяхи бомбу",
	"keahi_bomb.reactiontext": "Никто тебя не видел, правильно? Класс! До встречи, @! Спасибо большое!$h",

	"lenny_eggplant.title": "Здоровый салат",
	"lenny_eggplant.description": "Я нашла рецепт приготовления интересного салата, и для него нужны баклажаны. Принесите мне один и я заплачу!.\n        -Ленни.\n\n- 500 з. за доставку\n- Ленни будет просто счастлива",
	"lenny_eggplant.objective": "Принесите Ленни баклажан",
	"lenny_eggplant.reactiontext": "Ну вот, наконец-то! Большое спасибо, @! Сегодня у меня на ужин здоровая еда!$h",

	"lenny_wine.title": "Как снять стресс",
	"lenny_wine.description": "Кто-нибудь может принести мне вино? Мне нужно снять напряжение. Не могу обещать, что бутылка доживёт до следующего дня.\n        -Ленни.\n\n- -1000 з. за доставку\n- Ленни будет благодарна",
	"lenny_wine.objective": "Принесите Ленни вино",
	"lenny_wine.reactiontext": "Ах! Я так этого ждала! Спасибо, @.",

	"lola_hauntedskull.title": "Лучшие из лучших",
	"lola_hauntedskull.description": "Кто-нибудь готов принять вызов? Я щедро заплачу любому, кто сумеет уничтожить 20 призрачных черепов. Будьте добры, убейте пожалуйста парочку.\n        -Лола.\n\n- 10000 з. за выполнение",
	"lola_hauntedskull.objective": "Уничтожьте 20 призрачных черепов",
	"lola_hauntedskull.reactiontext" : "Эти жуткие черепа оказались не такими уж и жуткими! Разве я не права, дорогуша?$h",

	"lola_slime.title": "Истребитель слаймов",
	"lola_slime.description": "Я практически везде натыкаюсь на зелёных слаймов. Уже начинает тошнить от такого большого количества. Ишь, расплодились тут! Я заплачу любому, кто урежет их популяцию.\n        -Лола.\n\n- 750 з. за выполнение",
	"lola_slime.objective": "Уничтожьте 10 зелёных слаймов",
	"lola_slime.reactiontext" : "Если бы не спина, я бы присоединилась к тебе в охоте на слаймов! Отличная работа, дорогуша.$h",

	"olga_coffee.title": "Чашечка кофе",
	"olga_coffee.description": "Пожалуй, я могла бы попробовать кофе. Меня начинает тошнить от чая. Я заплачу любому, кто принесёт мне чашечку.\n        -Ольга.\n\n- 250 з. за доставку\n- Ольга будет благодарна",
	"olga_coffee.objective": "Принесите Ольге кофе",
	"olga_coffee.reactiontext": "Спасибо, @. Вот это куда лучше чая!",

	"pika_cheese.title": "Сырные воспоминания",
	"pika_cheese.description": "Мне нужен сыр, чтобы приготовить блюдо из моего детства. Я хочу, чтобы мой сын попробовал блюдо, которое заставило меня увлечься кулинарией.\n        -Пайк.\n\n- 800 з. за доставку\n- Пайк будет благодарен",
	"pika_cheese.objective": "Принесите Пайку сыр",
	"pika_cheese.reactiontext": "Махало! Спасибо! Мне не терпится начать готовить!$h",

	"pika_starfruit.title": "Блюдо с острова Эмбер",
	"pika_starfruit.description": "Я уже довольно давно скучаю по одному блюду с острова Эмбер. Впрочем, мне нужна карамбола, и если кто-нибудь сможет принести мне её, я буду очень благодарен.\n        -Пайк.\n\n- 2000 з. за доставку\n- Пайк будет просто счастлив",
	"pika_starfruit.objective": "Принесите Пайку карамболу",
	"pika_starfruit.reactiontext": "Махало! Я уже обыскался её! Ещё раз спасибо, @!$h",

	"richard_caviar.title": "Дорогая кулинария",
	"richard_caviar.description": "Я планирую добавить ещё несколько блюд в меню гостиничного обслуживания. Один из гостей предложил икру. Я обязательно щедро заплачу за доставку.\n        -Ричард.\n\n- 3000 з. за доставку\n- Ричард будет благодарен",
	"richard_caviar.objective": "Принесите Ричарду чёрную икру",
	"richard_caviar.reactiontext": "Отличное качество, @! Я тебе очень благодарен.$h",

	"richard_bat.title": "Проклятье, опять эти летучие мыши!",
	"richard_bat.description": "В последнее время по ночам в отеле шныряют летучие мыши! Они могут отпугнуть гостей! Кто-то должен будет перебить их в шахтах, чтобы они перестали прилетать.\n        -Ричард.\n\n- 1000 з. за выполнение\n- Ричард будет благодарен",
	"richard_bat.objective": "Уничтожьте 20 летучих мышей",
	"richard_bat.reactiontext": "Уф! Спасибо за помощь, @. Теперь эти надоедливые летучие мыши не будут беспокоить наших туристов.$h",

	"trinnie_pinkcake.title": "Розовый сон",
	"trinnie_pinkcake.description": "Прошлой ночью мне приснился сон, будто я живу в ОГРОМНОМ замке, сделанном из РОЗОВОГО торта! А потом я проснулась и теперь хочу съесть розовый торт! Папочка дал мне денег, чтобы оплатить доставку!\n        -Тринни.\n\n- 600 з. за доставку\n- Тринни будет просто счастлива",
	"trinnie_pinkcake.objective": "Принесите Тринни розовый торт",
	"trinnie_pinkcake.reactiontext": "Да! Наконец-то! Огромное спасибо, @! Вот денежки!$h",

	"trinnie_poppy.title": "Рисунок мака",
	"trinnie_poppy.description": "Я хочу мак! Мне трудно его нарисовать! Кто-нибудь, ПОЖАЛУЙСТА, принесите мне цветочек! Спасибо!\n        -Тринни.\n\n- 400 з. за доставку\n- Тринни будет благодарна",
	"trinnie_poppy.objective": "Принесите Тринни цветок мака",
	"trinnie_poppy.reactiontext": "У-у-у! Какая прелесть Спасибо, @! Я начну рисовать как можно скорее!$h",

	"yuuma_burger.title": "Желание ребёнка",
	"yuuma_burger.description": "Ничего страшного, если никто не захочет это выполнять. Но если кто-то всё же согласится мне помочь, я просто хочу снова попробовать бургер для выживания. Я так давно его не ел. Но, да, в этом нет ничего особенного. Спасибо.\n        -Юма.\n\n- 300 з. за доставку\n- Юма будет просто счастлив",
	"yuuma_burger.objective": "Принесите Юме бургер для выживания",
	"yuuma_burger.reactiontext": "Как же долго я об нём мечтал! Спасибо большое, @!$h",

	"yuuma_iron.title": "Сломанные качели",
	"yuuma_iron.description": "Широ хочет починить качели перед домом, но я ему не разрешаю. Я лучше сам починю их, но мне нужен железный слиток. Кто-нибудь может принести мне? Я заплачу, обещаю. Спасибо.\n        -Юма.\n\n- 300 з. за доставку\n- Юма будет благодарен",
	"yuuma_iron.objective": "Принесите Юме железный слиток",
	"yuuma_iron.reactiontext": "Спасибо большое, @. Я рад, что повесил это объявление, мне было немного страшно самому идти в шахты.",

	"mysticfalls_1.title": "Водопад дружбы",
	"mysticfalls_1.description": "Подсказки о подземном водопаде можно найти в Горном лесу. По слухам, он благословляет тех, кто ценит дружбу.",
	"mysticfalls_1.objective": "Найдите водопады скрытые за пышной зелёной листвой горного леса.",
	"mysticfalls_1.rewardDesc": "Редкий разноцветный камень",

	"mysticfalls_2.title": "Водопад любви",
	"mysticfalls_2.description": "Подсказки о подземном водопаде можно найти в Горном лесу. По слухам, он благословляет тех, кто ценит любовь.",
	"mysticfalls_2.objective": "Найдите водопады скрытые в объятьях розовых деревьев и песков горного леса Риджсайд",
	"mysticfalls_2.rewardDesc": "Симпатия от всех холостяков и незамужних девушек долины",

	"mysticfalls_3.title": "Водопад жертвоприношения",
	"mysticfalls_3.description": "Подсказки о подземном водопаде можно найти в Горном лесу. По слухам, он благословляет тех, кто интересуется незримым.",
	"mysticfalls_3.objective": "Найдите водопады скрытые в тени горного леса ",
	"mysticfalls_3.rewardDesc": "Обсидиановое лезвие",

	// Story guideline quests
	"preparations_complete.title": "Подготовка завершена!",
	"preparations_complete.description": "Теперь, когда вы собрали все странные предметы, о которых просила Дайя, возвращайтесь завтра в дом ниндзя для дальнейших инструкций.",
	"preparations_complete.objective": "Возвращайтесь в дом ниндзя завтра.",

	"follow_ninja_note.title": "Записка от ниндзя",
	"follow_ninja_note.description": "Вы прочитали записку на двери базы, в которой говорилось вернуться сегодня вечером, чтобы встретиться с Провидицей.",
	"follow_ninja_note.objective": "Приходите на Хребет после 20:00 ясной ночью.",

	"rae_pre_unseal.title": "Дополнительные приготовления",
	"rae_pre_unseal.description": "Белинда сказала вам прийти завтра в Горный Лес, чтобы помочь ей \"освободить дорогого ей человека\".",
	"rae_pre_unseal.objective": "Отправляйтесь в Горный Лес в солнечный день до 19:00.",

	"rae_unseal.title": "Освобождение",
	"rae_unseal.description": "Блисс велела вам прийти сегодня вечером на Хребет, чтобы совершить Освобождение.",
	"rae_unseal.objective": "Приходите на Хребет в ясную ночь после 20:00.",

	"open_spirit_portal.title": "Открытие Портала",
	"open_spirit_portal.description": "Белинда и Рэрияла попросили вас собрать девять Благословенных артефактов и положить их на нужные пьедесталы, заставляя светиться глаза лисиц. Об артефактах вы можете прочитать в красной книге в доме ниндзя.",
	"open_spirit_portal.objective": "Соберите девять реликвий и разместите их в правильном порядке на пьедесталах.",

	"phantom_greenhouse_1.title": "Невежество и блаженство",
	"phantom_greenhouse_1.description": "Блисс сказала что-то неопределённое о приходе в заброшенную оранжерею после полуночи... Может быть, стоит проверить?",
	"phantom_greenhouse_1.objective": "Отправляйтесь в заброшенную оранжерею после полуночи.",

	"phantom_greenhouse_2.title": "Проклятая оранжерея",
	"phantom_greenhouse_2.description": "Когда вы вернулись на горную тропу, Блисс сказала что-то о \"проклятии\" и предложила вам вернуться, когда оранжерея будет открыта ночью.",
	"phantom_greenhouse_2.objective": "Вернитесь в заброшенную оранжерею после полуночи.",

//Paula x Anton events
  "event-75160405.01": "...и эти заметки о ходе работы почти закончены.#$b#Фух!$h",
  "event-75160405.02": "Ха! Посмотри на себя! Ты большая рабочая пчела.#$b#У тебя ещё так много работы, даже без пациентов, да?$h",
  "event-75160405.03": "Антон?$4#$b#Эй! Я думал, ты теперь помогаешь Йену и Шону?$h#$b#Обычно они так заняты, что ты здесь делаешь?#$b#Только не говори мне, что ты сокращаешь работу!$6",
  "event-75160405.04": "Я хочу, чтобы ты знала, что у меня перерыв.$h#$b#Ух ты! Странно, что я могу сказать это сейчас.$6#$b#Знаешь, я так долго был безработным.$h",
  "event-75160405.05": "А теперь посмотри на себя! Видишь? Я знала, что ты сможешь.$h#$b#Да...$l",
  "event-75160405.06": "Хех. Я знаю, да?$6",
  "event-75160405.07": "Итак... эм...$9",
  "event-75160405.08": "Что ты здесь делаешь?$8",
  "event-75160405.09": "О! Да! Я забыл об этом!$h#$b#Держи!$h",
  "event-75160405.10": "Я купил нам выпивку!$h#$b#Я вообще-то заказал еду у Пайка, но он сказал, что это займёт некоторое время.#$b#И я сказал ему, чтобы кто-нибудь доставил её сюда!#$b#Я думаю, что это хорошо, потому что сегодня ресторан полон туристов!$u#$b#По крайней мере, здесь ты можешь немного расслабиться.#$b#Я знаю, что ты много работаешь, Пау.$h",
  "event-75160405.11": "Не стоило! Глупышка!$8#$b#Только не говори мне, что ты доставил её, чтобы я оплатил счёт?$l#$b#Признайся!$l",
  "event-75160405.12": "Эй! Я хочу, чтобы ты знала, что у меня теперь есть зарплата!$h#$b#Так что это за мой счёт, док.$l",
  "event-75160405.13": "Вау! Посмотрите на мистера Денежные Карманы!$h#$b#Ха-ха! Хотя на самом деле, спасибо.",
  "event-75160405.14": "Ну, за тебя!$h",
  "event-75160405.15": "Ах! Это было в точку!$h",
  "event-75160405.16": "*рыгает*!$h",
  "event-75160405.17": "Тон! Это было очень громко!$h#$b#Ха-ха!$h",
  "event-75160405.18": "Не-а! Твои глотки были громче! Ты уверена, что умеешь пить?$h",
  "event-75160405.19": "Эм...$l#$b#Эй... Спасибо за это.$l#$b#Мне нужен был этот перерыв.$h",
  "event-75160405.20": "В любое время, Пау!$h#$b#И, эм... Ну...#$b#Мне просто интересно...$6#$b#Ты завтра свободна?$6",
  "event-75160405.21": "А? Подожди...$9",
  "event-75160405.22": "Пау?$s",
  "event-75160405.23": "*кхем* Прости меня за это!$9#$b#Но да, завтра я свободна. Почему ты спрашиваешь, Тон?$l",
  "event-75160405.24": "Ничего! Ну... Я просто хотел спросить, не хочешь ли ты...$6#$b#Прогуляться со мной по долине?$l#$b#*кхе* То есть... Я думаю, мне нужны физические упражнения, да? И поэтому... кардио нагрузка может быть хорошей для начала?$6#$b#Верно?$l",
  "event-75160405.25": "*хихикает* Глупышка!$l#$b#Но... да, думаю, мне тоже нужен выходной.$l#$b#А будучи врачом, я должна способствовать физическому здоровью! Так что кардио - звучит неплохо.$l",
  "event-75160405.26": "Хорошо!$h#$b#Тогда... Я полагаю, это будет свидание?$l",
  "event-75160405.27": "Да, это свидание.$l#$b#*хихикает*$l",

  "event-75160406.01": "Ты знаешь...$l#$b#Ты смотришь на меня гораздо больше обычного.$l#$b#У меня что-то на лице?$8#$b#Только не говори, что всё это время, пока мы шли, у меня что-то было на лице!$u",
  "event-75160406.02": "Хех. Может быть?$6",
  "event-75160406.03": "Эй! Ты серьёзно?!$6#$b#Антон!$a",
  "event-75160406.04": "Эй! Да ладно! Я просто прикололся над тобой!$h#$b#Не волнуйся, всё в порядке.",
  "event-75160406.05": "Ты удивительная.$l",
  "event-75160406.06": "А? Эй! Что ты сказал?#$b#Давай! Тон! Я не услышала!$6",
  "event-75160406.07": "Нет.$h",
  "event-75160406.08": "Придурок.$9",
  "event-75160406.09": "*хихикает* Это очень ностальгическое чувство, верно?$8#$b#Разве не в этом утёсе мы впервые встретили друг друга, когда были детьми?$h",
  "event-75160406.10": "О да!#$b#Я помню, как ты играла с мальчишками деревянными мечами и щитами.$h#$b#Ты была очень страшной!$u",
  "event-75160406.11": "Эй! Я просто была вся в грязи! Вот и все!$h",
  "event-75160406.12": "Ты была страшной, потому что ты победила трёх последних мальчиков, которые бросили тебе вызов!#$b#Даже если это были просто дети!$6",
  "event-75160406.13": "О! Точно!$9#$b#Я была таким странным ребёнком, правда?$8",
  "event-75160406.14": "Нет, ты была потрясающей.$h#$b#...Ты и сейчас такая.$l",
  "event-75160406.15": "А? Правда?$l#$b#Ты говоришь так только потому, что я согласилась прогуляться, верно?$l",
  "event-75160406.16": "Хе-хе... Может быть?$6#$b#Может, нет?$l",
  "event-75160406.17": "Ты никогда не останавливаешься, правда?$l",
  "event-75160406.18": "А? О чём ты?$u",
  "event-75160406.19": "Заставляешь меня улыбаться.$8#$b#С самого детства.$9#$b#*хихикает* Это ты страшный.$8",
  "event-75160406.20": "И почему?$l",
  "event-75160406.21": "Думаю, ты знаешь почему.$9",
  "event-75160406.22": "Возможно, да.$l",
  "event-75160406.23": "Эй... Паула?$l",
  "event-75160406.24": "Да, Антон?$l",
  "event-75160406.25": "Спасибо... За то, что ты есть в моей жизни.$l",
  "event-75160406.26": "Аналогично... Придурок.$l",

  //More offerings
  "Offering.Prismatic": "Это интригующее и красочное предложение! Большое спасибо, о фермер.#$b#Я дарую тебе благословение!$h",

  //Torts + spirits
  "event-75160407.01": "В чём дело, дорогая? Ты весь день в раздумьях.$s",
  "event-75160407.02": "Да, я давно думаю о кое-чем...$s",
  "event-75160407.03": "Не так давно я заметила, что в последний день каждого сезона магическая аура долины внезапно усиливается.$s#$b#Я долго пыталась найти источник, но безрезультатно. Он исчезает так же быстро, как и появляется.$s",
  "event-75160407.04": "Ах, да, это происходит столько, сколько я себя помню.$h#$b#Не беспокойся, дорогая. За все годы моей жизни от этого не было никаких негативных последствий.",
  "event-75160407.05": "Тем не менее, такое количество магии никогда не является хорошим знаком.$s#$b#Мы многое упустим, если не попытаемся найти источник сегодня, пока его причина ещё может оставаться в силе - хотя бы для того, чтобы мы, наконец, смогли поставить точку в этом вопросе.$a",
  "event-75160407.06": "Ну, моя дорогая, ты же знаешь, что я никогда не отказываюсь от приключений.$h",
  "event-75160407.07": "В течение довольно долгого времени в эту почву просачивался мощный источник магии.#$b#Может стоит поискать здесь?",
  "event-75160407.08": "Нет... Это похоже на совершенно другой тип магии. Магия, которую мы ищем, гораздо более... естественна, чем эта.$s",
  "event-75160407.09": "...И так всякий раз! Я ищу источник, а он ведёт в другой тупик... Это раздражает.$s",
  "event-75160407.10": "О, Бел, мне неприятно видеть тебя в таком мрачном виде.$s#$b#Но я верю, что мы сможем найти его вместе.$l",
  "event-75160407.11": "...Ты права. Я не позволю себе так легко сдаться. Давай продолжим.$l",
  "event-75160407.12": "Рэй, ты чувствуешь это?#$b#Она может быть слабой, но по ощущениям аура похожа на ауру магических шипов.$h#$b#Похоже, что она происходит из...",
  "event-75160407.13": "...Конуры?$u",
  "event-75160407.14": "Нет, не может быть. Единственное, что здесь живёт - это черепаха.$s",
  "event-75160407.15": "На самом деле, это может быть ответом...$h",
  "event-75160407.16": "Теперь, когда я размышляю над этим вопросом, эта черепаха всегда была странным явлением...$s#$b#Одна жила в долине, когда я только появилась на свет, и с тех пор они больше не появлялись - была всегда только одна черепаха...$s#$b#...Это так просто! Как я могла не заметить этого раньше?$u",
  "event-75160407.17": "Этого не может быть! Тогда ему сотни... нет, тысячи лет!!!$u",
  "event-75160407.18": "Что ты делаешь, Бел?$s",
  "event-75160407.19": "Источник магии, похоже, исходит изнутри.$a#$b#Истина теперь в моей власти... Я не позволю ей ускользнуть от меня снова.$7",
  "event-75160407.20": "Я пойду с тобой. Мы не знаем, что может ждать нас по ту сторону...$a",
  "event-75160407.21": "Должно быть, я сплю... Что-то настолько поразительное было скрыто от наших глаз так долго?$u",
  "event-75160407.22": "Я знал, что когда-нибудь настанет день, когда вы двое найдёте меня здесь.",
  "event-75160407.23": "Так вот как ты на самом деле выглядишь, черепаха. Никогда бы не подумала...$u#$b#Но зачем скрывать такую потрясающую форму? Конечно, вам нечего бояться, учитывая вашу огромную силу?$s",
  "event-75160407.24": "Позвольте мне начать с самого начала. Мой рассказ ответит на этот и многие другие вопросы, дорогой дух.#Как вы уже догадались, я не дух, как вы, а Малое Божество - хранитель этой планеты.#Когда было создано это царство, я и мои сородичи появились на свет вместе с ним. Наша задача - защищать его, чтобы баланс природы никогда не был нарушен.#В прошлом я был гораздо снисходительнее, когда дело касалось моей истинной формы. Я никогда не видел причин маскироваться от людей.#Я даже стал доверять группе из них, на какое-то время.#Но перед лицом власти человеческими сердцами быстро овладевает жадность. Они стремились использовать мою силу для своих мелких войн и потворствующих кампаний.#Однажды я решил помочь деревне, которая мне очень нравилась, в их военных действиях... Это была долгая, тяжёлая война, в которой я использовал свои силы, чтобы навредить тем самым существам, которых должен был защищать.#Вскоре после этого я решил скрывать себя от людей - как ради себя, так и ради них.#И вот я принял скромное обличье, которое вы узнали, дорогие духи.",
  "event-75160407.25": "Но как вы можете выполнять свой долг по защите в таком уменьшенном виде?$s#$b#Наверняка есть способы помочь человечеству, не отстраняясь полностью от его дел...?$s#$b#Эти люди верили в вас, и вы сами говорили, что заботитесь о них - но вы бросили их...$s",
  "event-75160407.26": "В твоих словах есть доля правды, хотя мне больно это признавать. Но я не жалею о своих действиях.#Я никогда не стремился к любви или поклонению человечества. Задача, поставленная передо мной и моими сородичами, одинока, но, тем не менее, я не отношусь к ней легкомысленно.#Как дух природы, ты не хуже меня знаешь, что баланс природы легко нарушить. Любое проявление помощи с моей стороны может быстро оказаться губительным как для человечества, так и для развития планеты.#Мы присматриваем за людьми, животными, монстрами и даже духами, такими как вы двое. Если бы я оказывал помощь лишь избранным, они бы процветали, да - но остальные существа, несомненно, поплатились бы за это.#Какое право имею я, предполагаемый опекун, приговаривать стольких людей к такой участи?",
  "event-75160407.27": "Тем не менее, я не помню, чтобы я когда-либо говорил, что полностью прекратил помогать людям... *подмигивает*",
  "event-75160407.28": "Что ж... Этим я дал вам двоим повод задуматься о вашем собственном месте во вселенной.#Прощайте, дорогие духи. Я буду следить за вашими путешествиями только с самыми высокими ожиданиями.",

//Blueprints translatable stuff
"Blueprint.Name.RSVObelisk": "Обелиск Риджсайда",
"Blueprint.Description.RSVObelisk": "Переносит вас в Риджсайд.",

"MapString.rsv.purplemansion65": "Балконные двери заперты.",
"irene8_1": "%Вы решили сначала позвать Зейна.%fork",
"irene8_2": "%Вы решили сначала проведать Айрин.",

"zayne8_1": "%Вы держали Зейна за руку.%fork",
"zayne8_2": "%Зейн показывает улыбку.",

"Mail.MaiveInviteLetter": "Адресовано: @^От: Особняк Аметин.^^Пишу, чтобы пригласить вас на простую встречу в Особняке Аметин на бранч с моей семьёй. Я хотела бы, чтобы вы познакомились с определёнными людьми, которые могут оказаться полезными для вашего и нашего семейного бизнеса. Загляните в особняк между 9:00 и 14:00 в любой солнечный день после получения этого письма.^^С уважением,^Мэйв Аметин[#]Приглашение на бранч в особняке Аметин",
"Mail.ZayneLetter": "Адресовано: @^От: Зейн Аметин.^^Привет, @. Хотел бы формально пригласить тебя на тёплый ужин в Особняке Аметин с семьёй и близкими друзьями. Бабушка попросила устроить это собрание для какого-то важного объявления. Загляни в особняк между 20:00 и 02:00 в любой солнечный день после получения этого письма. Надеюсь на твоё присутствие.^^С уважением,^Зейн Аметин[#]Приглашение на ужин в особняке Аметин",

//Summit Events
"Irene.summit.1": "Я много путешествовала, но ничто не сравнится с этим прекрасным видом.$h#$b#Лэнгга! От этого захватывает дух, не правда ли?",
"Irene.summit.2": "Мы зашли так далеко, но я знаю, что у нас ещё есть мечты и цели, к которым можно и нужно стремиться.#$b#Но прямо сейчас... крайне удивительно, как далеко мы продвинулись.$3#$b#*Скви*! Ах! Я просто так счастлива быть замужем за тобой!$l#$b#Я действительно горжусь тобой, @...$l",

"Zayne.summit.1": "Ах!$h#$b#Вид отсюда просто очаровательный.",
"Zayne.summit.2": "Мы прошли через множество испытаний и невзгод, не так ли?#$b#Но в конечном счёте мы одержали победу!$h#$b#Что бы ни ждало нас впереди, я уверен, мы справимся с этим. Верно, любимый?$h^Что бы ни ждало нас впереди, я уверен, мы справимся с этим. Верно, любимая?$h#$b#И вот... Я просто хочу сказать, как я горжусь тобой.$7#$b#Горжусь за твои достижения, характер и твою целеустремлённость...$l#$b#Я люблю тебя.$l",

//Zayne gift tastes
"Gift.Love.Zayne": "Это мне? Ну разве это не чудесно! Спасибо, @.",
"Gift.Like.Zayne": "Такой приятный подарок, @. Благодарю тебя.",
"Gift.Dislike.Zayne": "Приношу свои извинения, но... Мне это не очень нравится.",
"Gift.Hate.Zayne": "Разве это не грубость, дарить такое?",
"Gift.Neutral.Zayne": "Подарок? Что ж, спасибо вам.",

//call animation string
"Animations.zayne.call": "Прошу прощения. У меня важный звонок.$s",

//Zayne festival dialogue
"Festivals.EggFest.Zayne": "Я надеюсь, что тебе понравится сегодняшний праздник, и твоё яичное возбуждение достигнет пика!$h#$b#О, извини. Это была ужасная игра слов!$u",
"Festivals.EoR.Zayne": "Какие у тебя планы на предстоящий год, @?#$b#Надеюсь, он будет ещё более насыщенным, чем предыдущий.",
"Festivals.FlowerDance.Zayne": "Этот фестиваль является прекрасным проявлением грации и рыцарства.#$b#Бабушка всегда учила нас соблюдать честь во всех наших поступках, и это был первый фестиваль, на котором она позволила нам попробовать себя.",
"Festivals.Gathering.Zayne": "Иногда я становлюсь агрессивным во время соревнований.#$b#Думаю, это всё из-за того, что я вырос в огромной семье. Когда мы были такими же маленькими, как Надалин и Луи, нас учили стремиться быть лучше всех и отстаивать честь нашей семьи.",
"Festivals.IceFest.Zayne": "У меня так и не было возможности научиться ловить рыбу раньше.#$b#Санни и другие прислуги занимались ловлей рыбы с тех самых пор, как мы были детьми.#$b#А ещё бабушке просто привозили рыбу ящиками из-за границы.",
"Festivals.Luau.Zayne": "Губернатор и бабушка - близкие друзья.#$b#Его присутствие сегодня даёт нам возможность немного погрузиться в политику.",
"Festivals.Jellies.Zayne": "Медузы представляют собой источник энергии, который можно было бы использовать для производства электричества.#$b#Хм, может быть, я мог бы попросить кого-нибудь из наших учёных изучить этот вопрос.$6",
"Festivals.SpiritEve.Zayne": "Когда-то День всех духов был моим любимым праздником.#$b#Полагаю, теперь прошёл тот возраст, когда я мог наслаждаться им. Или, может быть, во всём виноваты взрослые обязанности.#$b#Хм...",
"Festivals.StardewFair.Zayne": "Я верю, что ты приложишь все усилия для подготовки к этому праздничному дню,",
"Festivals.WinterStar.Zayne": "Надеюсь, что твой секретный друг подарил тебе то, что ты хотел, @.^Надеюсь, что твой секретный друг подарил тебе то, что ты хотела, @.#$b#Я желаю тебе всего наилучшего в ближайшие дни.",

		//8 Hearts
"Zayne.Dialogue.Mon8": "Эта деревня и земли вокруг неё обладают огромным потенциалом коммерческого использования.#$b#Но я уверен, что местные жители этого бы не оценили.$h#$b#Итак, пожалуй, я откажусь от этих неуместных идей.$7",
"Zayne.Dialogue.Tue8": "Ах, рад видеть, @.#$b#Что привело тебя сюда в этот прекрасный день?$h#$e#Я жду важный звонок от делового партнёра. Так что извини меня, пожалуйста.",
"Zayne.Dialogue.Wed8": "Подготовка к тому, чтобы занять место бабушки, - непростая задача. $s#$b#Но этого следовало ожидать. В её положении нет ничего смешного.",
"Zayne.Dialogue.Thu8": "Отгружаются ли продукты с %farm ежедневно, как только появляется возможность продать её, или ежемесячно?#$b#Держу пари, что ты стараешься подготовить и организовать как можно больше в своём бизнесе.#$b#Иначе, как могла твоя ферма стать такой успешной?$h",
"Zayne.Dialogue.Fri8": "У меня мало друзей в этой деревне, потому что я много путешествую.$7#$b#И поэтому я хотел бы выразить благодарность тебе за нашу дружбу, @.$h#$b#Если тебе что-нибудь понадобится, я буду здесь.",
"Zayne.Dialogue.Sat8": "Корпорация Аметин контролирует множество семейных предприятий.#$b#Но мы не ограничиваемся только ведением бизнеса. Мы также инвестируем в стартапы, которые имеют большой потенциал.$h",
"Zayne.Dialogue.Sun8": "Местные праздники очень весёлые и яркие.#$b#Если бы мне когда-нибудь представилась такая возможность, я бы хотел посетить один из них! Я уверен, что это был бы замечательный опыт!$h#$e#Пожалуйста, скажи мне, если в ближайшее время будет организация очередного фестиваля, @. Я бы хотел, чтобы ты составил мне компанию.$h^Пожалуйста, скажи мне, если в ближайшее время будет организация очередного фестиваля, @. Я бы хотел, чтобы ты составила мне компанию.$h",

//Zayne Romance Dialogue
//Marriage Dialogue-----------------
///Spring
"Zayne.MarriageDialogue.spring_1": "Весна - отличное время для обновления маркетинговых стратегий.#$b#И, может быть, даже возродить нашу искру?$6#$b#Что скажешь, может быть, отправимся в небольшое путешествие или поужинаем в отеле 'Бревенчатый Домик', дорогой?^Что скажешь, может быть, отправимся в небольшое путешествие или поужинаем в отеле 'Бревенчатый Домик', дорогая?",
"Zayne.MarriageDialogue.spring_12": "Ты готов к завтрашнему фестивалю?^Ты готова к завтрашнему фестивалю?#$b#Луи не устаёт напоминать мне, чтобы мы постоянно поддерживали его во время охоты за яйцами.$h",
"Zayne.MarriageDialogue.spring_23": "Я попробую улучшить свои танцевальные навыки для тебя, моя любовь. Обещаю сделать завтрашний день незабываемым.$6",

///Summer
"Zayne.MarriageDialogue.summer_1": "Ах, первый день лета!#$b#Мы должны победить летнюю жару, окунувшись в бассейн в особняке, любовь моя!$h#$b#Или, может быть, мы могли бы построить такой прямо у себя на ферме.$h",
"Zayne.MarriageDialogue.summer_10": "Любимый, пожалуйста, убедись, что ты привезёшь ингредиенты высшего качества, хорошо?^Любимая, пожалуйста, убедись, что ты привезёшь ингредиенты высшего качества, хорошо?#$b#Бабушка придёт в ужас, если узнает, что мы когда-либо пытались принести что-нибудь ниже заданного стандарта.$u",
"Zayne.MarriageDialogue.summer_27": "Почему бы нам не взять одеяло для пикника на завтра?$6#$b#Так мы сможем насладиться моментом после того, как медузы уплывут.$4",

///Fall
"Zayne.MarriageDialogue.fall_1": "Брр, настала холодная пора, моя любовь.#$b#Убедись, что ты тепло одеваешься, хорошо?#$e#Если понадобится, можем попросить Фэй или наших портных сделать что-нибудь для тебя.",
"Zayne.MarriageDialogue.fall_15": "Удачи завтра, моя любовь!$h#$b#Уверен, что твой выставочный лоток завоюет завтра приз!$h",
"Zayne.MarriageDialogue.fall_19": "Конкуренция на Собрании Риджсайда довольно напряжённая.$u#$b#Я сказал другим парням, что нам придётся подтянуть свой уровень, если хотим победить завтра!$h",
"Zayne.MarriageDialogue.fall_26": "Моя любовь, будешь ли ты наряжаться на завтрашний фестиваль?#$b#Мне крайне интересно увидеть тебя в каком-нибудь костюме.$4",

///Winter
"Zayne.MarriageDialogue.winter_1": "Горячий какао и свидания перед камином каждую ночь, когда мы приходим домой, это прекрасно.$4",
"Zayne.MarriageDialogue.winter_7": "Твои навыки рыбной ловли будут испытаны завтра. Ты готов к вызову, любовь моя?$6^Твои навыки рыбной ловли будут испытаны завтра. Ты готова к вызову, любовь моя?$6",
"Zayne.MarriageDialogue.winter_24": "Думая об этом прямо сейчас, мне не важно, какой подарок я получу завтра, потому что у меня уже есть ты рядом, и это лучший подарок, о котором можно мечтать.$4",

///Room
"Zayne.MarriageDialogue.spouseRoom_Zayne.1": "Я знаю, что путешествия считаются привилегией для большинства людей.#$b#Я, например, наслаждался днями, проведёнными в путешествиях, и я очень благодарен за то, что у моей семьи есть возможность в любой момент отправиться куда-нибудь.#$b#Но сейчас я рад, что могу обосноваться в одном месте. Особенно потому, что в этом месте есть ты.$l",
"Zayne.MarriageDialogue.spouseRoom_Zayne.2": "Любовь моя, есть ли у тебя интерес, чтобы занять какую-нибудь должность в Корпорации Аметин?#$b#Если ты хочешь, я могу для тебя организовать это.",
"Zayne.MarriageDialogue.spouseRoom_Zayne.3": "Я рад, что благодаря своему положению смог оказать большее влияние на мир...$l#$b#Я искренне ценю тебя за то, что ты подталкиваешь меня к раскрытию моего большего потенциала, любовь моя. Ты действительно мой счастливый талисман!$h",
"Zayne.MarriageDialogue.spouseRoom_Zayne.4": "Я беспокоюсь о давлении, которое бабушка оказывает на маленьких детей.$s#$b#Надалин и Луи должны наслаждаться своим детством, не боясь потерпеть неудачу...$7#$e#Я надеюсь, что создам более безопасную среду для них, а также для наших детей, в которой они смогут расти и ни о чём не беспокоиться.$s",
"Zayne.MarriageDialogue.spouseRoom_Zayne.5": "Любовь моя, что ты думаешь о том, чтобы пить чай во время встреч?#$b#На мой взгляд, я действительно нахожу их довольно ужасными.$u#$b#Но иногда я притворяюсь, что мне это нравится, потому что в других культурах это считается признаком уважения и удовольствия.",


///Patio
"Zayne.MarriageDialogue.patio_Zayne.1": "Тсс, сегодня такой напряжённый день с этими деловыми звонками и организациями встреч.$s#$b#Но я рад, что ты здесь, чтобы подбодрить меня.$l",
"Zayne.MarriageDialogue.patio_Zayne.2": "Ах, атмосфера в городе не может сравниться с тем, что у нас здесь, на ферме, любовь моя.#$b#Я всегда буду ставить это превыше всего остального.$h",
"Zayne.MarriageDialogue.patio_Zayne.3": "Я слышал, что губернатор подумывает о том, чтобы баллотироваться на более высокую должность на предстоящих выборах.#$b#Хотя бабушка, похоже, считает, что это не очень хорошая идея.#$b#Я просто надеюсь, что ей не придёт в голову попросить меня баллотироваться на какую-нибудь должность.$u",
"Zayne.MarriageDialogue.patio_Zayne.4": "Приятно, что у меня есть возможность проводить с тобой больше времени теперь, когда я больше не занимаю должность посола.$h#$b#Я думаю, это одно из величайших преимуществ того, чтобы быть Аметином.",
"Zayne.MarriageDialogue.patio_Zayne.5": "Ты когда-нибудь задумываешься о будущем, любовь?#$b#Например, о том, чего ты всё ещё хочешь достичь.#$e#Я знаю, что мы находимся на таком этапе нашей жизни, когда уже должны приобретать все, что хотим.#$b#Но что будет после? Какие ставить цели дальше?$s",


///Rainy Day
"Zayne.MarriageDialogue.Rainy_Day_0": "Раньше, когда я был моложе, я обожал дождь.#$b#Лоррейн и я всегда играли на улице, под дождём.#$b#Потом мы убегали от Санни, потому что бабушка каждый раз из-за этого ругалась.$h#$b#Это были чудесные дни.$s",
"Zayne.MarriageDialogue.Rainy_Day_1": "Замечал ли ты, как пахнет земля после дождя?^Замечала ли ты, как пахнет земля после дождя?#$e#Как ни странно, некоторым людям этот запах нравится настолько, что они превращают его в аромат.$u#$b#Вот почему Корпорация Аметин. выпускает аромат с запахом росы, который продают в некоторых местах.",
"Zayne.MarriageDialogue.Rainy_Day_2": "Дождливые дни полезны в сельском хозяйстве, верно, любовь моя?#$b#Главное – чтобы дождь не превращался в ливень или грозу.$s#$e#Может быть, мы сможем обратиться к экспертам из Аметин и попросить их разработать план для подобных случаев. Так мы сможем быть уверены, что ничего плохого не произойдёт с нашей фермой.$7",
"Zayne.MarriageDialogue.Rainy_Day_3": "Любимый, пожалуйста, возьми с собой зонт или надень кепку, чтобы защититься от дождя.$s^Любимая, пожалуйста, возьми с собой зонт или надень кепку, чтобы защититься от дождя.$s",
"Zayne.MarriageDialogue.Rainy_Day_4": "*Вздыхает* Любимый, идёт дождь, и я понимаю, что не могу тебе запретить выходить на улицу, поэтому, пожалуйста, будь осторожнее и не промокни. Хорошо?$7^*Вздыхает* Любимая, идёт дождь, и я понимаю, что не могу тебе запретить выходить на улицу, поэтому, пожалуйста, будь осторожнее и не промокни. Хорошо?$7",
"Zayne.MarriageDialogue.Rainy_Day_Zayne": "Дождь дарит мне особое спокойствие, которое я не могу объяснить.#$b#Стук капель дождя позволяет мне размышлять о вещах совсем на ином уровне.$l",

///Rainy Night
"Zayne.MarriageDialogue.Rainy_Night_0": "Меня утешает то, что мы можем просто обниматься в эту дождливую ночь.$l#$b#Ты такой счастливчик!$6^Ты такая удачливая!$6",
"Zayne.MarriageDialogue.Rainy_Night_1": "Стук дождя напоминает мне о чечёточниках, которых мы с бабушкой любили смотреть в театре.#$b#Ты бы их видел, они выглядят так невероятно.$h^Ты бы их видела, они выглядят так невероятно.$h#$b#Мы должны попытаться попасть на шоу в нашем следующем путешествии.$h",
"Zayne.MarriageDialogue.Rainy_Night_2": "Сегодня ночью звезды скрылись за тучами, но это не страшно.#$b#Ведь самая яркая звезда сияет в твоих глазах.$4",
"Zayne.MarriageDialogue.Rainy_Night_3": "Цель Корпорации Аметин - каким-то образом запечатлеть красоту звёзд на небе и разместить их на ювелирных изделиях.#$b#Не правда ли, это великолепно?$h",
"Zayne.MarriageDialogue.Rainy_Night_4": "Хм... Любимый, что ты скажешь о складных палатках?^Хм... Любимая, что ты скажешь о складных палатках?#$b#Мне пришла в голову мысль о том, насколько полезными были бы складные палатки, особенно для тех, кто испытывает определённые сложности.$b#Я думаю, что наши благотворительные организации смогут использовать их, безусловно.",
"Zayne.MarriageDialogue.Rainy_Night_5": "Любовь моя, ты ${промок^промоклa}$.$u#$b#*Вздох*$s#$b#Что ж, тебе сегодня повезло, я купил тебе тыквенный суп [236]. Вот он!$h",
"Zayne.MarriageDialogue.Rainy_Night_Zayne": "Ох, идёт дождь.$s#$b#Я хотел полетать с тобой на воздушном шаре сегодня вечером.$s#$e#О, что ж, мы могли бы просто остаться дома и пообниматься. Это было бы отличным завершением дня! $h#$b#Так что, полетать мы сможем и в другой раз.",

///Indoor Day
"Zayne.MarriageDialogue.Indoor_Day_0": "Одно из замечательных преимуществ того, что ты сам себе начальник, заключается в том, что я могу видеться с тобой в любое время суток, когда захочу.$h#$b#При условии, конечно, что я выполню свой список дел в течение дня.$6",
"Zayne.MarriageDialogue.Indoor_Day_1": "Ах, моя прекрасная половинка!#$b#Вот небольшой подарок, который мне привезли из Изумрудного Города! [279]#$b#Надеюсь, он тебе понравится!$h",
"Zayne.MarriageDialogue.Indoor_Day_2": "Иоба, мне предстоит очень насыщенный день, любовь моя.$s#$b#Жаль, что я не могу взять тебя с собой.$7",
"Zayne.MarriageDialogue.Indoor_Day_3": "Ох, моя любовь! Ты выглядишь так же чарующе, как и всегда!$4#$b#Ты заставляешь меня ощущать бабочек и конфетти в животе.$h",
"Zayne.MarriageDialogue.Indoor_Day_4": "Ах, видеть тебя в хорошем настроении достаточно, чтобы пережить этот день, любовь моя.$h#$b#Я знаю, что мой день будет прекрасным.$h",
"Zayne.MarriageDialogue.Indoor_Day_Zayne": "Мне так нравится видеть твоё лицо утром.$4#$b#Это самое яркое событие в моей повседневной жизни.$h",

//Indoor Night
"Zayne.MarriageDialogue.Indoor_Night_0": "Вечером я часто чувствую себя измученным, потому что мои дни всегда тяжёлые из-за моих обязанностей перед семьёй.$7#$b#Но я рад, что именно с тобой я могу проводить свои ночи, потому что с тобой я чувствую себя в безопасности и умиротворении.$4",
"Zayne.MarriageDialogue.Indoor_Night_1": "Ночью я часто обдумываю то, что произошло в течении дня.#$b#Думаю, что сегодня мой день прошёл прекрасно, а как насчёт тебя, любовь моя?",
"Zayne.MarriageDialogue.Indoor_Night_2": "Любимый, есть ли вещи, которые ты хотел бы сделать раньше?^Любимая, есть ли вещи, которые ты хотела бы сделать раньше?#$b#Я не знаю, бывают времена, когда моя голова просто говорит: 'ты мог бы сделать гораздо больше сегодня'.",
"Zayne.MarriageDialogue.Indoor_Night_3": "%Зейн, похоже, не в себе.#$b#О, вот и ты, любовь моя.$h#$b#Я просто думал о работе за день и мысленно проверял свой контрольный список, чтобы убедиться, что я ничего не забыл.",
"Zayne.MarriageDialogue.Indoor_Night_4": "Как прошёл твой день, моя любовь?#$b#Тебе удалось сделать что-нибудь продуктивное?$6",
"Zayne.MarriageDialogue.Indoor_Night_Zayne": "Любовь моя? Могу я получить объятие от тебя?$7#$b#О, ничего особенного, я просто чувствую себя немного подавленным.$s#$b#Отец был разочарован, потому что грузовики, предназначенные для перевозки самоцветов Корпорации Аметин, застряли на границе.$7#$b#И из-за этого разозлилась бабушка.$s#$b#Потом все остальное было просто... *вздыхает*#$b#Я просто счастлив, что сейчас могу обнять тебя, моя любовь.$7",

///Outdoors
"Zayne.MarriageDialogue.Outdoor_0": "О, вот и ты, любовь моя!#$b#Я просто хотел проверить, как у тебя дела, и вручить тебе это! [337]#$b#Санни недавно доставил их к нам, так как мой отец настоял на том, чтобы использовать весь иридий, который обнаружили его рабочие в шахтах.",
"Zayne.MarriageDialogue.Outdoor_1": "Поступали сообщения о том, что противники губернатора разгуливают по городу в поисках неприятностей.$7#$b#Бабушка говорит, что мы должны быть бдительными и не ввязываться в неприятности.#$b#Пожалуйста, будь осторожен, любимый.$s^Пожалуйста, будь осторожна, любимая.$s#$e#Может быть, мне стоит нанять для тебя телохранителя...$7",
"Zayne.MarriageDialogue.Outdoor_2": "Не замечательный ли день сегодня, любовь моя?$6#$b#Я рад, что вижу тебя каждый день.$h#$b#Но мне пора уходить, ещё предстоит много работы. Увидимся позже, любовь.",
"Zayne.MarriageDialogue.Outdoor_3": "На улице всегда идеально встречаться с моей дорогой половинкой.$h#$b#Кроме спальни, конечно.$6#$e#Ой, ладно, я просто шутил, любовь моя.$6",
"Zayne.MarriageDialogue.Outdoor_4": "Я всегда любил бывать на природе.#$b#Можно сказать, что это ожидаемо, так как я часто путешествую. Однако не это является основной причиной.$#$b#На самом деле, это связано с ощущением, которое меня охватывает, когда я вижу открытое пространство. Я вижу бесконечные возможности.$h",

//Leaving
"Zayne.MarriageDialogue.funLeave_Zayne.1": "Прощай, любовь моя!$h#$b#Жажда проявить себя подавляется на краю моего существа! Я взволнован возможностью внести изменения в наш маленький мир.$h",
"Zayne.MarriageDialogue.funLeave_Zayne.2": "Прощай, любовь моя!#$b#Удачного тебе сегодня дня!$h",
"Zayne.MarriageDialogue.funLeave_Zayne.3": "А теперь я должен попрощаться с тобой, любовь моя. Бабушка ждёт меня.#$b#И я должен связаться с пилотом самолёта, потому что мы с ней, возможно, сегодня отправимся на соседний остров подписывать контракт.",
"Zayne.MarriageDialogue.funLeave_Zayne.4": "Прощай, любовь моя. Увидимся позже.#$b#Я опаздываю на встречу.$u",
"Zayne.MarriageDialogue.funLeave_Zayne.5": "Я буду скучать по тебе, мой @.$7^Я буду скучать по тебе, моя @.$7#$b#Но, боюсь, сейчас я должен уйти.$s#$e#Не забудь свои вещи, ладно?#$b#Убедись, что у тебя есть все, что тебе нужно, хорошо?",

//Returning
"Zayne.MarriageDialogue.funReturn_Zayne.1": "О, я просто обожаю возвращаться домой к тебе, любимый.$4^О, я просто обожаю возвращаться домой к тебе, любимая.$4#$b#С тобой вечера кажутся лёгким ветерком.$4",
"Zayne.MarriageDialogue.funReturn_Zayne.2": "День выдался довольно напряжённый.$7#$b#Но как же я рад, что сейчас я здесь, с тобой.$s#$e#Ты можешь обнять меня, любимый?$s^Ты можешь обнять меня, любимая?$s#$b#Ах, теперь я чувствую себя лучше. Спасибо, любовь моя, я ценю это.$4",
"Zayne.MarriageDialogue.funReturn_Zayne.3": "С тех самых пор, как мы поженились, самое замечательное то, что я каждый раз возвращаюсь к тебе, сюда.$h#$b#Иоба, как я рад тебя видеть, любовь моя!$4",
"Zayne.MarriageDialogue.funReturn_Zayne.4": "Есть две хорошие вещи, которых я с нетерпением жду в конце каждого дня.#$b#Во-первых, это время, когда я могу поразмыслить о том, что мне удалось сделать в течение дня.#$b#А во-вторых, я смогу увидеть тебя, когда вернусь домой.$6",
"Zayne.MarriageDialogue.funReturn_Zayne.5": "Здравствуй, любовь моя.$h#$b#Как прошёл твой день?#$b#Ты скучал по мне?$6^Ты скучала по мне?$6",

//One kid
"Zayne.MarriageDialogue.OneKid_0": "Ого, не правда ли %kid1 удивительный ребёнок.$h#$b#Малыш очень умный для своего возраста.$h",
"Zayne.MarriageDialogue.OneKid_1": "*Вздох* %kid1 слишком быстро растёт.$s#$b#Плохо ли, что я хочу, чтобы ребёнок оставался таким?$7#$b#Просто я хочу защитить %kid1 от ужасов реального мира.$7",
"Zayne.MarriageDialogue.OneKid_2": "Луи не перестаёт болтать о том, что хочет научить %kid1 быть таким же утонченным, как он.$h#$b#Просто восхитительно видеть, как он рад стать дядей.$h",
"Zayne.MarriageDialogue.OneKid_3": "Мне больше ничего не нужно в жизни, любовь моя.$4#$b#Ты и %kid1 - самое ценное для меня на свете.$4",

//Two kids
"Zayne.MarriageDialogue.TwoKids_0": "Любимый, бабушка спрашивала, какие языки собираются учить наши дети.^Любимая, бабушка спрашивала, какие языки собираются учить наши дети.#$b#Независимо от того, что думает бабушка, наши дети не должны испытывать на себе давление и заниматься тем, чем они не хотят.$7",
"Zayne.MarriageDialogue.TwoKids_1": "Спасибо тебе за жертвы, которые ты принёс ради нашей семьи, любимый.^Спасибо тебе за жертвы, которые ты принесла ради нашей семьи, любимая.#$b#Я знаю, что я не говорю об этом так часто. Но я хочу сказать тебе, что я очень ценю все, что ты делаешь для меня и детей.$4#$b#Я люблю тебя, @.$h",
"Zayne.MarriageDialogue.TwoKids_2": "Я и так раньше был счастлив. Но теперь я понимаю, что наше счастье заключается в том, чтобы быть большой и любящей семьёй$4#$b#Спасибо тебе за то, что дал мне возможность стать частью этой семьи.$h^Спасибо тебе за то, что дала мне возможность стать частью этой семьи.$h",
"Zayne.MarriageDialogue.TwoKids_3": "Надалин и Луи постоянно спорят о том, кто будет лучшим тётей и дядей.$h#$b#Это очаровательно, как они сражаются за звание лучшей няни для %kid1 и %kid2.$h#$b#Как будто мы бы позволили им присматривать за нашими маленькими ангелами.$u",

//Relationship-dependent
///Good
"Zayne.MarriageDialogue.Good_0": "О, как хорошо, что я нашёл тебя, любимый.$h^О, как хорошо, что я нашёл тебя, любимая.$h#$b#Я жаждал твоих объятий с тех пор, как мы расстались сегодня утром.$4",
"Zayne.MarriageDialogue.Good_1": "Разве не чудесно, что мы проводим всё это время вместе?$h#$e#Я имею в виду, что быть главой Аметин - это большая ответственность, однако её преимущества ещё лучше.#$b#Это означало, что я должен остаться здесь, с тобой!$4#$b#А также внести большие изменения в жизни людей, которые работают под моим началом.$6",
"Zayne.MarriageDialogue.Good_2": "Я когда-нибудь говорил тебе, что ты выглядишь так же прекрасно, как жемчужины на дне открытого моря?$4#$b#Я рад, что у меня есть ты в качестве спутника жизни, любовь моя.$h",
"Zayne.MarriageDialogue.Good_3": "С тех пор как мы поженились, не было ни дня, чтобы я сомневался в своём решении.#$b#@, ты тот человек, в котором я уверен на 100%.$4#$e#Я буду так же верен тебе и своим семейным обязанностям.$6",
"Zayne.MarriageDialogue.Good_4": "Любовь моя!$h#$b#Акции Корпорации Аметин стремительно растут!$h#$b#Может быть, ты действительно мой счастливый талисман, а?$6",
"Zayne.MarriageDialogue.Good_5": "Главное в выборе отличного спутника жизни - это знать, насколько вы оба подходите друг к другу.#$b#Кроме того, речь также идёт о том, чтобы знать, как относиться друг к другу, а также подстраиваться под настроение друг друга.#$b#Я благодарен тебе за то, что ты действительно понимаешь, как лучше всего вести себя со мной, а я - с тобой.$4#$e#Должно быть, мы созданы друг для друга.$h#$b#Как бы банально это ни звучало.$6",
"Zayne.MarriageDialogue.Good_6": "Бабушка пела тебе дифирамбы, любовь моя!$h#$b#Она очень впечатлена тем, как ты преобразил ферму своего дедушки, и она чувствует, что он гордился бы тем, как ты заботишься о ней прямо сейчас.$h^Она очень впечатлена тем, как ты преобразила ферму своего дедушки, и она чувствует, что он гордился бы тем, как ты заботишься о ней прямо сейчас.$h",
"Zayne.MarriageDialogue.Good_7": "Мы с Арией разговаривали на днях, и она упомянула, что считает тебя образцом для подражания.$6#$b#Я очень доволен этим.$h#$b#Спасибо тебе за то, что ты подаёшь хороший пример молодым в нашей семье, любовь моя.$4",
"Zayne.MarriageDialogue.Good_8": "Любовь моя, я знаю, что редко делюсь с тобой своими чувствами, а также нахожу время, чтобы выразить, как много ты для меня значишь.#$b#И я просто хотел бы сказать, что восхищаюсь тем, с каким пониманием ты относился ко мне с самой первой нашей встречи.$4^И я просто хотел бы сказать, что восхищаюсь тем, с каким пониманием ты относилась ко мне с самой первой нашей встречи.$4#$b#Я дорожу тобой, любимый. Никакие слова не смогли бы передать всю серьёзность моих чувств к тебе.$4^Я дорожу тобой, любимая. Никакие слова не смогли бы передать всю серьёзность моих чувств к тебе.$4",
"Zayne.MarriageDialogue.Good_9": "Быть с тобой было путешествием всей моей жизни, и я не хочу, чтобы это путешествие заканчивалось.$h#$b#Я люблю тебя, мой дорогой @.$4^Я люблю тебя, моя дорогая @.$4",

///Neutral
"Zayne.MarriageDialogue.Neutral_0": "Я немного беспокоюсь о нашем будущем, любовь моя...$s#$b#Что, если того, что я сделал и что я делаю сейчас, недостаточно?$7",
"Zayne.MarriageDialogue.Neutral_1": "Конечно, бывают дни, когда я временами верю, что я непобедим.$6#$b#Но подобные недуги напоминают мне, что это не так.$7",
"Zayne.MarriageDialogue.Neutral_2": "Отец поговаривал о расшАйринии сетей ресторанов здесь, в долине.#$b#Однако я считаю, что это неразумно, поскольку здесь довольно большая конкуренция.#$e#Я полагаю, тележка с едой была бы лучше, ты так не думаешь?",
"Zayne.MarriageDialogue.Neutral_3": "Недавно компания приобрела частный самолёт для перевозки аметистов с Шахт к ювелирам для ускорения производства.#$e#В прошлый раз я посетил ювелиров компании, и, надо сказать, работа у них не из лёгких.$u#$b#Установка камней на золотую фурнитуру, а также соблюдение эскизов - это очень кропотливая работа.$u",
"Zayne.MarriageDialogue.Neutral_4": "Мне больно видеть, как другие люди получают недостаточную оплату за выполнение своей работы.#$e#Недавно я просмотрел новостные статьи, в которых говорилось, как рабочие в городе протестуют из-за того, что им недоплачивают.$7#$b#И вот. Вот почему я усердно работаю. Чтобы гарантировать, что в Корпорации Аметин всё будет по-другому.#$b#Чтобы условия были лучше, чем у других.",
"Zayne.MarriageDialogue.Neutral_5": "Любовь моя, есть ли у тебя желание отправиться со мной в мою следующую рабочую поездку?#$b#Это будет наш второй медовый месяц.$h",
"Zayne.MarriageDialogue.Neutral_6": "$y 'Любовь моя, а что ты думаешь по поводу того, чтобы вступить в какую-нибудь организацию? Бабушка ищет товарища по благотворительности. Может быть, ты хочешь стать волонтёром?._Да, с удовольствием приму её предложение._Отлично! Я сообщу бабушке, как только она задумает создать новую организацию._Пожалуй, откажусь._Ах, я понимаю. Уверен, что бабушка тоже тебя поймёт.'",
"Zayne.MarriageDialogue.Neutral_7": "*Вздыхает* В последнее время у меня такой плотный график.$s#$b#В основном потому, что другие люди не могут придерживаться расписания.$a",
"Zayne.MarriageDialogue.Neutral_8": "Послушай, любовь моя, пожалуйста, составь список тех вещей, которые нам нужны, и передай его моему секретарю, как только сможешь.#$b#Я хочу, чтобы у нас не было недостатка в чём-либо.",
"Zayne.MarriageDialogue.Neutral_9": "Я думаю, может быть, нам стоит привезти несколько коров дорогих пород.#$b#Мне просто крайне ужасно хочется отличного стейка.$7#$b#Наверное, у меня стресс, ха.$s",

///Bad
"Zayne.MarriageDialogue.Bad_0": "У меня нет ни времени, ни сил спорить с тобой прямо сейчас. Я очень занят!$a#$b#Пожалуйста, оставь меня в покое.$7",
"Zayne.MarriageDialogue.Bad_1": "Прошу прощения, у меня сейчас нет на это времени.$7",
"Zayne.MarriageDialogue.Bad_2": "Я не думаю, что было бы разумно раздражать меня прямо сейчас.$7#$b#Тётя звонит мне без остановки, будь добр, беспокой кого-нибудь другого.$a^Тётя звонит мне без остановки, будь добра, беспокой кого-нибудь другого.$a",
"Zayne.MarriageDialogue.Bad_3": "Хмм...$7",
"Zayne.MarriageDialogue.Bad_4": "В данный момент меня не интересуют любезности. Пожалуйста, извините меня.$s",
"Zayne.MarriageDialogue.Bad_5": "Я очень сильно устал.$7#$b#Давай поговорим позже.$s",
"Zayne.MarriageDialogue.Bad_6": "У меня недостаточно времени, чтобы обсудить все, что ты желаешь.$a#$b#Прошу прощения.$7",
"Zayne.MarriageDialogue.Bad_7": "Что бы ты ни хотел обсудить, это больше не стоит моего времени.$a^Что бы ты ни хотела обсудить, это больше не стоит моего времени.$a",
"Zayne.MarriageDialogue.Bad_8": "Я не хочу говорить с тобой прямо сейчас.$s",
"Zayne.MarriageDialogue.Bad_9": "%Зейн предпочёл проигнорировать тебя.",

//Festivals
"Festivals.EggFest.Zayne_spouse": "Я помню, как в юности присутствовал на своём первом яичном фестивале.$h#$b#Тогда мне составляли неплохую конкуренцию.$h",
"Festivals.FlowerDance.Zayne_spouse": "Не забудь приберечь для меня свой первый и последний танец, любовь моя.$6#$b#Я специально репетировал вальс для тебя.$h",
"Festivals.Luau.Zayne_spouse": "Я очень надеюсь, что никто не получит пищевого отравления.$u#$b#Честно говоря, я всегда этого боюсь, потому что во время одного из своих путешествий я однажды видел, как коллегу-посла отвезли в больницу из-за пищевого отравления.$s#$b#Тем не менее, я попросил кое-кого из персонала следить за добавляемыми ингредиентами, просто на всякий случай.$7",
"Festivals.Jellies.Zayne_spouse": "Подойди ко мне, когда фестиваль вот-вот начнётся, хорошо, любовь моя?#$b#Я хочу, чтобы мы вместе посмотрели на медуз.$6#$b#О, конечно, если ты тоже не против.$4",
"Festivals.StardewFair.Zayne_spouse": "Бабушка присматривается к потенциальным сотрудникам.#$b#Она говорит, что ярмарка может выявить чьё-то остроумие и настойчивость, поэтому она пользуется этой возможностью, чтобы понаблюдать за поведением других людей.",
"Festivals.SpiritEve.Zayne_spouse": "В этом году собралось довольно много людей на День всех духов.#$b#Интересно, сможем ли мы пригласить того, кто это организовал, на вечеринку по случаю годовщины нашей компании?",
"Festivals.IceFest.Zayne_spouse": "На самом деле я не очень хороший рыбак.$s#$b#Может быть, в следующий раз ты научишь меня, любовь моя?$4",
"Festivals.WinterStar.Zayne_spouse": "Я очень надеюсь, что моему тайному другу понравится мой подарок.$7#$b#Я подумывал о том, чтобы включить в подарок поездку на частном самолёте, но, думаю, это будет уже чересчур.$4",
"Festivals.Gathering.Zayne_spouse": "Этот фестиваль пробуждает во мне соревновательную сторону.$h#$b#Я надеюсь, что мужчины выиграют в этом матче!$h#$e#Но независимо от того, кто победит, если я смогу обняться с тобой сегодня вечером, я уже буду победителем.$h",
"Festivals.EoR.Zayne_spouse": "Я вне себя от радости при мысли о том, что проведу с тобой ещё один год, любовь моя.$4#$b#Выпьем за то, чтобы так продолжалось каждый год!$h",


//Romantic GF/BF dialogue-----------------
"Zayne.Dialogue.Mon8.dating": "Приветствую тебя, любовь моя, я желаю тебе сегодня чудесного дня!$h",
"Zayne.Dialogue.Tue8.dating": "Здравствуй, любовь моя! Как ты себя чувствуешь?#$b#Почему бы нам не выпить вместе кофе попозже?$4#$b#Я ужасно по тебе скучаю.$4",
"Zayne.Dialogue.Wed8.dating": "Любимый, есть ли что-нибудь, чего бы ты хотел?^Любимая, есть ли что-нибудь, чего бы ты хотела?#$b#Мы могли бы пойти на свидание в мой выходной. Мне бы доставило это удовольствие.$4",
"Zayne.Dialogue.Thu8.dating": "Ты не можешь насытиться мной, не так ли?$6#$b#Ха-ха, я знаю, ты скучаешь по мне.$6#$e#Я не могу дождаться выходных, когда мы сможем устроить наше особое ночное свидание.$4",
"Zayne.Dialogue.Fri8.dating": "Работа последнее время какая-то напряжённая.$s#$b#Но я рад, что могу видеть тебя в своих маленьких окошках отдыха в течение дня.$4",
"Zayne.Dialogue.Sat8.dating": "Ты - моё спасение, любовь моя.#$b#Спасибо тебе за то, что заставляешь меня чувствовать себя довольным.$4",
"Zayne.Dialogue.Sun8.dating": "Любовь моя?$s#$b#Я боюсь, что на предстоящей неделе меня может не хватить.$7#$b#Бабушка приглашает меня поехать в командировку.#$e#Но я очень надеюсь, что это не затянется на долго.$7#$b#Я возьму наш семейный самолёт, чтобы вернуться как можно скорее.",

//10 Hearts
"Zayne.Dialogue.Mon10.dating": "В моей голове происходит так много случайных вещей.#$b#Но одно можно сказать наверняка...#$b#Ты всегда будешь тем, кто поможет мне разобраться в себе, потому что ты понимаешь меня так, как никто другой, @.$4^Ты всегда будешь той, кто поможет мне разобраться в себе, потому что ты понимаешь меня так, как никто другой, @.$4",
"Zayne.Dialogue.Tue10.dating": "Просто прекрасно думать о том, насколько мы выросли вместе как пара.$4#$b#Я имею в виду, мы только встречаемся, но я должен признать, что многому научился у тебя.",
"Zayne.Dialogue.Wed10.dating": "Что такое, любовь моя? Ты скучаешь по мне?$6#$b#Ха-ха, всё в порядке, я тоже скучаю по тебе.$h#$b#В следующий раз ты должен поехать со мной в одну из моих рабочих поездок.$h^В следующий раз ты должна поехать со мной в одну из моих рабочих поездок.$h",
"Zayne.Dialogue.Thu10.dating": "Любовь моя, вот немного черники, которую я собрал для тебя. [258]#$b#Я надеюсь, она тебе понравится.$4",
"Zayne.Dialogue.Fri10.dating": "Я никогда не был тем человеком, который часто ходит на свидания, и я рад, что у меня появился ты.$4^Я никогда не был тем человеком, который часто ходит на свидания, и я рад, что у меня появилась ты.$4#$b#Обязанности Аметина становятся легче, потому что я знаю, что ты здесь, чтобы поддержать меня.$h#$b#Спасибо тебе за то, что ты здесь, со мной, @.",
"Zayne.Dialogue.Sat10.dating": "Ах, сегодня выходные!$h#$e#Я не могу дождаться, когда проведу этот день с тобой!$h#$b#Я просто надеюсь, что на этот раз нам ничто не помешает.$7",
"Zayne.Dialogue.Sun10.dating": "Я не знаю, должен ли я радоваться тому, что сегодня воскресенье, или мне следует бояться этого, потому что завтра будет понедельник.$u#$e#Клянусь, я не ленивый, просто я хочу наверстать упущенное с тобой время.$7",


//Extra Dialogue-----------------
"Zayne.Dialogue.Resort_Entering": "О, как необычно.#$b#Это не может сравниться с частными курортами, которые посещает наша семья.#$b#Но в этом есть свой шарм, я думаю, мне здесь понравится.$h",
"Zayne.Dialogue.Resort_Leaving": "*Вздыхает* Снова возвращаемся в реальный мир.$s#$b#Ну что ж, по крайней мере, я могу помогать делать жизнь людей лучше. Особенно моей семьи.",
"Zayne.Dialogue.Resort_Shore": "Я всегда думаю о горизонте как о символе нового начинания и прекрасного конца.#$b#Это очень похоже на то, как солнце всходит и заходит за горизонт. Это просто так изысканно. Ты тоже так думаешь, @?",
"Zayne.Dialogue.Resort_Bar": "Что тебе взять, @?#$b#Я хотел бы что-то с небольшой долей алкоголя, но меня ждут деловые отчёты, которые нужно сделать дома.$7",
"Zayne.Dialogue.Resort": "Я совсем не хотел приходить сюда сегодня, так как у меня много дел дома.#$b#Но я рад, что я решил расставить правильные приоритеты.$4",
"Zayne.Dialogue.MovieInvitation": "Что ж, спасибо тебе за приглашение, @.$h#$b#Тогда я встречу тебя в театре. Просто позволь мне оставить дома некоторые контракты.",
"Zayne.Dialogue.breakUp": "Мне очень жаль, но я не хочу иметь с тобой ничего общего.$a",
"Zayne.Dialogue.danceRejection": "Приношу свои извинения, но я вынужден отклонить твоё предложение.$7#$b#Может быть, ты мог бы спросить кого-нибудь другого?^Может быть, ты могла бы спросить кого-нибудь другого?",
"Zayne.Dialogue.divorced": "Я скорблю о том, какими мы были раньше, @.$s#$b#Это такой позор, мы могли бы быть идеальной парой.$7",

"Romance.Engagement.Zayne0": "Не может быть? О, конечно же, я выйду за тебя замуж!$h",
"Romance.Engagement.Zayne1": "Ты совершенно уверен, что хотел бы провести со мной остаток своей жизни?$6^Ты совершенно уверена, что хотела бы провести со мной остаток своей жизни?$6#$b#Что ж, тогда я принимаю твоё предложение! Я люблю тебя!$4",
"Romance.give.flowersA.Zayne": "Я сделаю все, что в моих силах, чтобы быть достойным твоей любви, @.$4#$b#Я принимаю твой знак внимания.$h",
"Romance.give.flowersB.Zayne": "Это очень мило с твоей стороны.$4#$b#Не можешь дождаться, когда будешь держать меня только для себя, да?$6#$b#Хаха! Я тебя обожаю.",
"Romance.stardrop.gift.Zayne": "Любовь моя, вот маленький знак моей признательности тебе.$h#$b#Я надеюсь, что ты правильно используешь это, хорошо?$h",
"Romance.rejectNPCA.Zayne": "Я должен извиниться, но я не думаю, что смог бы принять это.$7#$b#Я тебя едва знаю.$u",
"Romance.rejectNPCB.Zayne": "Мои самые искренние извинения, @.$s#$b#Должно быть, я произвёл на вас неверное впечатление, но я не думаю, что мы ещё на таком уровне отношений.$7",
"Romance.MovieInvite.Spouse.Zayne": "Оу, ты скучаешь по мне, не так ли?$6#$b#Я рад, что ты пригласил меня! Я тоже жажду побыть с тобой наедине.$4^Я рад, что ты пригласила меня! Я тоже жажду побыть с тобой наедине.$4#$b#Скоро увидимся, любимый.$h^Скоро увидимся, любимая.$h",



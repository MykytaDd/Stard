"Festivals.FlowerDance.Aguar": "Да, я пришёл.#$b#Мэдди сказала, что здесь будет еда.$h",
"Festivals.FlowerDance.Bert": "Я не балерина, но, думаю, Ольга будет гордиться мной.#$e#По крайней мере, я не наступлю ей на ногу.$h",
"Festivals.FlowerDance.Ezekiel": "Здесь нет девушки красивее Корин.$h#$e#Если кто будет ей надоедать, лучше ему мне на глаза не попадаться.$a",
"Festivals.FlowerDance.Freddie": "Я всё ещё чертовски хорошо танцую, даже в таком-то возрасте!$h",
"Festivals.FlowerDance.Jio": "Несмотря на всю эту суету и шум, лес спокоен.$h",
"Festivals.FlowerDance.Keahi": "Смотри, смотри!#$e#Я так круто танцую!$h",
"Festivals.FlowerDance.Kiwi": "Киви наблюдать.#$e#Киви любить танцы.$h",
"Festivals.FlowerDance.Lenny": "Ты собираешься попросить кого-нибудь стать твоим партнёром?#$e#Действуй!$h",
"Festivals.FlowerDance.Lola": "Знаешь, нас учили танцевать вальс величайшие танцоры мира.#$b#Это место не бальный зал, но оно ничуть не хуже.$h",
"Festivals.FlowerDance.Olga": "Да я же буду как корова на льду...$4#$b#Он так хочет потанцевать со мной.$h",
"Festivals.FlowerDance.Pika": "Имя моей жены, Лейлани, означает «небесный цветок».#$b#Для меня она навсегда останется королевой цветов.$h#$e#Я уверен, что Кеяхи унаследовал своё обаяние от неё.$h",
"Festivals.FlowerDance.Richard": "Цветочные танцы занимают особое место в моём сердце.$s#$b#Моя жена Анжелика всегда просила меня стать её партнёром, и я не был настолько глуп, чтобы отказываться!$h#$b#Своим очарованием она завоевала немало цветочных корон.$4",
"Festivals.FlowerDance.Trinnie": "Я очень красивая, правда, @?$4#$e#Когда-нибудь я стану цветочной королевой!$h",
"Festivals.FlowerDance.Yuuma": "Широ хочет танцевать.#$b#Но я не думаю, что ему стоит это делать.$s#$e#Хм, хочу ли я?#$b#О, мне и так хорошо.$s",

	//Dateables
"Festivals.FlowerDance.Alissa": "Мне немного неловко танцевать на виду у всех.#$b#Конечно, все остальные тоже будут танцевать, но всё равно, я так волнуюсь!$h",
"Festivals.FlowerDance.Alissa_spouse": "Эти цветы повсюду, они такие прелестные, правда же, радость моя?$h#$b#Ты тоже очень красивый.$l^Ты тоже очень красивая.$l",
"Festivals.FlowerDance.Corine": "Это один из моих самых любимых дней в году!$h#$b#То, что все собрались вместе, уже само по себе прекрасно, но и в самой идее этого праздника есть что-то, что я всегда любила.",
"Festivals.FlowerDance.Corine_spouse": "Я очень хочу потанцевать с тобой.$l",
"Festivals.FlowerDance.Flor": "Я? Ох, я... я не танцую... #$b#Выглядит весело, но я откажусь... Я не знаю движений... $12",
"Festivals.FlowerDance.Flor_spouse": "Здесь в лесу так красиво.#$b#Мне тут очень нравится.$h",
"Festivals.FlowerDance.Ian": "Ты купил семена клубники у Пьера?^Ты купила семена клубники у Пьера? #$e#Обязательно дай мне знать, когда поспеют ягоды. Я их обожаю!$h",
"Festivals.FlowerDance.Ian_spouse": "Ты не против потанцевать со мной? Ты выглядишь таким... красивым среди всех этих цветов.$l^Ты не против потанцевать со мной? Ты выглядишь такой... красивой среди всех этих цветов.$l#$e#Может, нам стоит вырастить цветы и у нас дома.",
"Festivals.FlowerDance.Jeric": "Бли-и-и-ин, как же ты классно выглядишь!$h",
"Festivals.FlowerDance.Jeric_spouse": "Не переживай насчёт танцев, детка, просто повторяй движения за мной.",
"Festivals.FlowerDance.Kenneth": "Видеть, как все счастливы, для меня просто удовольствие.$h#$b#Такие праздники заряжают долину позитивной энергией.$h",
"Festivals.FlowerDance.Kenneth_spouse": "Чуть раньше я видел, как некоторые жители деревни репетируют танец.#$e#У всех, похоже, такое хорошее настроение!$h#$b#@, хочешь потанцевать?",
"Festivals.FlowerDance.Maddie": "Танцы - пустая трата энергии.#$b#У меня есть дела поважнее.$a",
"Festivals.FlowerDance.Maddie_spouse": "Я сказала мистеру Агуару, что здесь будет хорошая еда, и он пришёл. Неплохо хоть иногда принимать участие в праздниках. Ты ведь сам меня этому научил.^Я сказала мистеру Агуару, что здесь будет хорошая еда, и он пришёл. Неплохо хоть иногда принимать участие в праздниках. Ты ведь сама меня этому научила.",
"Festivals.FlowerDance.Philip": "%Кажется, Филипп чем-то встревожен.#$b#Хм-м?#$b#О, извини, я просто не могу понять, то ли это такое танцевальное движение, то ли он действительно хромает...$s",
"Festivals.FlowerDance.Philip_spouse": "Мы будем танцевать?#$e#Ну что ж, пожалуй, пойду выставлю себя дураком.#$b#Помни, ты сам решил вступить со мной в брак!$h^Помни, ты сама решила выйти за меня замуж!$h",
"Festivals.FlowerDance.Shiro": "Привет, @! Этот праздник всегда радует меня.$h#$b#Сложно пребывать в плохом настроении, когда тебя окружают счастливые люди, понимаешь?$h",
"Festivals.FlowerDance.Shiro_spouse": "Ты выглядишь так благородно.^Ты просто великолепна.$l",
"Festivals.FlowerDance.Shiro_spouse.GN": "Ты выглядишь потрясающе.$l",
"Festivals.FlowerDance.Ysabelle": "Танец простой, но, думаю, именно это и делает его классикой!$h",
"Festivals.FlowerDance.Ysabelle_spouse": "Давай, дорогой. Прямо как мы тренировались дома.^Давай, дорогая. Прямо как мы тренировались дома.#$b#Но на этот раз не наступай мне на ноги!$h",

//Luau

	//Non-Dateables
"Festivals.Luau.Aguar": "Морская вода бесполезна для моих исследований.$a#$b#Самоцветное море было загрязнено сбросами с морских судов и городскими сточными водами.$s",
"Festivals.Luau.Bert": "Кеяхи уже пытался бросить в котёл кораллы и пустые ракушки.$u#$e#Надо проследить и убедиться, что он не оказывает на Тринни дурного влияния!$a",
"Festivals.Luau.Ezekiel": "Губернатор всё такой же бесполезный, как и в прошлом году. Хех.$a",
"Festivals.Luau.Freddie": "Я знаю губернатора уже тридцать лет, и он ничуть не изменился.",
"Festivals.Luau.Jio": "Киви хочет супа.#$b#Прости, поговорим чуть позже.$h",
"Festivals.Luau.Keahi": "Ракушки были идеей Тринни, но накричали всё равно на меня!$a#$e#Несправедливо.$s#$e#А я оставил своего слайма дома!$u",
"Festivals.Luau.Kiwi": "Суп иметь хороший вкус?$u#$e#Киви попросить Джио приносить суп.$h",
"Festivals.Luau.Lenny": "Почему Льюис так нервничает, ведь суп пахнет просто отлично!$h",
"Festivals.Luau.Lola": "Фредди говорит, что губернатор не изменился, но я не согласна.#$b#Он определённо стал ещё толще.$h",
"Festivals.Luau.Olga": "Фредди говорит, что губернатор не изменился, но я не согласна.#$b#Он определённо стал ещё толще.$h",
"Festivals.Luau.Pika": "Когда я был помоложе, то обычно на праздниках крутил пои.$h#$b#В первый раз, когда я добавил огня, я чуть не сжёг себе брови!$u#$e#Лейлани никогда не давала мне об этом забыть, ха-ха!$h",
"Festivals.Luau.Richard": "Если задуматься о том, насколько стара традиция проведения Луау здесь в долине, то можно только склонить перед ней голову в знак уважения.#$b#Она была до меня и будет ещё долго после того, как я уйду.#$e#Каждый раз, когда мы можем собраться вместе, это действительно особенное время.$h",
"Festivals.Luau.Trinnie": "Я не знала, что ракушка была пустой...$s#$e#Папа всегда говорит, что из морепродуктов получается хороший суп.$h",
"Festivals.Luau.Yuuma": "Надеюсь, суп будет вкусным.$h#$b#Я совсем не хотел бы, чтобы оказалось, что мой брат проделал весь этот путь сюда вниз ради супа с ужасным вкусом.$s",

	//Dateables
"Festivals.Luau.Alissa": "Суп вот-вот будет готов!$h#$b#Я верю, что каждый положил свой самый лучший продукт.",
"Festivals.Luau.Alissa_spouse": "Я чувствую запах чего-то вкусного, помимо супа!$h#$b#Думаю, это то блюдо, которое готовит Линус.",
"Festivals.Luau.Corine": "Не знаю, что за овощ папа пытался добавить, но я от него избавилась.$a#$b#Пахло как от испортившегося бургера.$s#$e#Я люблю папу, но... Ни за что.",
"Festivals.Luau.Corine_spouse": "Я очень рада, что папа не пытается подбросить в суп какую-нибудь экзотичную репу со странным вкусом.#$e#Кстати, где он?$s",
"Festivals.Luau.Flor": "Интересно, почему никто никогда не пытается согласовать ингредиенты супа?#$b#Результат может получиться очень странным, так почему же все оставляют всё как есть?",
"Festivals.Luau.Flor_spouse": "Они никогда не согласовывают ингредиенты супа, и, тем не менее, Льюис каждый год идёт на риск и предлагает губернатору первым его попробовать... почему?$u",
"Festivals.Luau.Ian": "У меня нет денег, чтобы приправить суп чем-нибудь изысканным. Надеюсь, горные вишни, что я добавил, достаточно хороши...",
"Festivals.Luau.Ian_spouse": "Что ты положил в суп?^Что ты положила в суп?#$e#Я знаю, что бы ты в него ни добавил, вкус будет превосходным.$l^Я знаю, что бы ты в него ни добавила, вкус будет превосходным.$l#$b#Твои овощи - лучшие в этой долине!$h",
"Festivals.Luau.Jeric": "Сегодня ты выглядишь просто фан-тас-тически, @.$h#$e#Не возражаешь, если я составлю тебе компанию, пока суп не будет готов?",
"Festivals.Luau.Jeric_spouse": "Сегодня я положил в суп свою лучшую карамболу.#$e#Надеюсь, суп будет неплохим, можно сказать, кучу денег в него вбухал.",
"Festivals.Luau.Kenneth": "Кажется, один из динамиков выключился...#$b#Вероятно, это проделки либо Кеяхи, либо Винсента.$a",
"Festivals.Luau.Kenneth_spouse": "Я предложил свою помощь Йену, но похоже, ему нравится переносить сюда этот котёл самому.#$b#Крепкий парень получит и тренировку, и пир!$h#$e#Кто я такой, чтобы мешать человеку выполнять его работу?$h",
"Festivals.Luau.Maddie": "Мне кажется негигиеничным есть из общего котла.$a#$e#Я имею в виду, этот суп варится из множества неподходящих друг другу ингредиентов, вдобавок каждый запросто может добавить в него что угодно.#$b#Кто знает, что там плавает... $s",
"Festivals.Luau.Maddie_spouse": "Когда мы вернёмся домой, я приготовлю тебе настоящий суп, милый.^Когда мы вернёмся домой, я приготовлю тебе настоящий суп, милая.#$e#Этот же суп слишком... неоднородный... на мой вкус.$s#$b#Обещаю, мой получится хорошим!",
"Festivals.Luau.Philip": "Ты уже пробовал суп?^Ты уже пробовала суп?#$b#Я... немного боюсь, если честно.$s#$e#Питательная ценность, вероятно, превосходна, но запах... ",
"Festivals.Luau.Philip_spouse": "Каждый год я так беспокоюсь из-за этого супа, и каждый год он получается хорошим.#$b#Не знаю, как им это удаётся.",
"Festivals.Luau.Shiro": "Я рад, что смог спуститься сюда. #$b#Я не могу ходить на пляж так часто, как хочу... Надеюсь, Юма также рад этой возможности.$s",
"Festivals.Luau.Shiro_spouse": "Я видел как Ольга с Бертом поймали Кеяхи и Тринни, когда те пытались что-то бросить в суп.#$b#Словно сценку из комедии вживую посмотрел.$h",
"Festivals.Luau.Ysabelle": "Я собираюсь присоединиться к Эмили на танцплощадке.#$b#Ты обязательно должен потанцевать вместе с нами!$h^Ты обязательно должна потанцевать вместе с нами!$h",
"Festivals.Luau.Ysabelle_spouse": "Ты уже положил что-нибудь в суп?^Ты уже положила что-нибудь в суп?#$b#Я хочу танцевать!$h#$b#Но я не хочу танцевать без тебя.$s",

//Moonlight Jellies

	//Non-Dateables
"Festivals.Jellies.Aguar": "Реки Риджсайда впадают прямо в океан...#$b#Возможно, это и объясняет появление Луналу...$u#$e#%Мистер Агуар, кажется, глубоко задумался.",
"Festivals.Jellies.Bert": "Мы женаты двадцать лет, но я до сих пор нервничаю перед тем, как сделать ей подарок... $4",
"Festivals.Jellies.Ezekiel": "Это Корин притащила меня сюда.$s#$b#Когда-то Элен любила на них смотреть.$h#$b#А я и забыл... $4",
"Festivals.Jellies.Freddie": "Я никогда не устану от этого зрелища.#$b#Медузы светятся, Лола в лунном свете...#$b#Этого достаточно, чтобы у старика перехватило дыхание.$h",
"Festivals.Jellies.Jio": "Когда медузы движутся, лунный свет движется вместе с ними, и сила следует по их пути.",
"Festivals.Jellies.Keahi": "Медузы такие классные!$u#$b#Как ты думаешь, я смогу поймать одну?!$h",
"Festivals.Jellies.Kiwi": "Привет, друзья-медузы!$h",
"Festivals.Jellies.Lenny": "С каждым годом это зрелище становится всё красивее.$h#$e#Может быть, Льюис наконец-то расслабится хоть на секунду.$s",
"Festivals.Jellies.Lola": "Нет ничего более очаровательного.$h#$b#Храни это в воспоминаниях, @.$s#$b#Это одно из самых красивых событий, которое ты когда-либо увидишь.$4",
"Festivals.Jellies.Olga": "Почему Берт так нервничает?#$b#Он опять что-то натворил?$s",
"Festivals.Jellies.Pika": "Ты сияешь, словно жемчужина.#$b#Дрейфуешь по воле случая то туда, то сюда.$h#$b#Твои щупальца в волнах колышутся...#$b#...И ты призрачна, словно мечта.$s#$e#Прощай, маленькая медуза.$4",
"Festivals.Jellies.Richard": "Ещё десяток-другой медуз уплыл с отливом. Я сделал предложение в такую же ночь много лет тому назад.$h#$b#Не уверен, что светилось ярче той ночью, медузы или глаза моей дорогой жены.$4",
"Festivals.Jellies.Trinnie": "Я не сплю!$s#$e#Я буду не спать и смотреть на миграцию медуз!$h",
"Festivals.Jellies.Yuuma": "Когда я смотрю на медуз, то думаю о маме с папой.$s#$b#Возможно, медузы это почувствуют и смогу передать им моё сообщение...$h#$e#...Я так на это надеюсь.$s#$b#Я просто хочу, чтобы они знали, что я люблю их.$4",
"Festivals.Jellies.Yuuma.2": "Медузы такие красивые.$h#$b#Они кажутся полноценными, как семья. Однажды, я надеюсь, папа тоже вернётся, и мы наконец-то тоже сможем стать полноценной семьёй.",

	//Dateables
"Festivals.Jellies.Alissa": "Какой прекрасный вид, просто дух захватывает.#$b#Словно океан решил выступить перед нами.$h",
"Festivals.Jellies.Alissa_spouse": "Океан готовится исполнить свою песню.$h#$b#Интересно, он тоже нервничает?$s#$b#Я знаю, это звучит глупо, но не могу об этом не думать.$h",
"Festivals.Jellies.Corine": "Привет, @!$h#$b#В воздухе словно витает что-то таинственное, тебе же тоже так кажется?#$e#Каждый год этой ночью папа погружается в свои мысли. Интересно, о чём он думает?$s",
"Festivals.Jellies.Corine_spouse": "Забавно, но в эту ночь тени всегда кажутся не такими чёрными как обычно.$h#$e#Как будто всё вокруг выставлено напоказ, но подсвечивающий это всё свет такой нежный... $h",
"Festivals.Jellies.Flor": "Есть нечто такое в небе и океане, что пленяет людей неким потусторонним образом...$u#$b#От вида и того, и другого ночью особенно сильно захватывает дух.$h",
"Festivals.Jellies.Flor_spouse": "Я знаю, что воспоминания субъективны и несовершенны, но мне кажется, что с каждым годом эта ночь становится всё прекраснее.$h",
"Festivals.Jellies.Ian": "Медузам повезло. Им не приходится волноваться из-за работы или денег.$s#$b#Они просто плывут.#$e#Интересно, есть ли у них семьи?",
"Festivals.Jellies.Ian_spouse": "Когда-то я мечтал стать беспечной медузой и просто уплыть от всего этого.$s#$b#Впрочем, я рад, что я не медуза.#$e#Я счастлив, что родился тем человеком, что живёт здесь с тобой.$l",
"Festivals.Jellies.Jeric": "Привет, @, хочешь посмотреть со мной на медуз?#$e#Как можно винить парня за то, что он хочет быть окружённым со всех сторон такой красотой?$h",
"Festivals.Jellies.Jeric_spouse": "Привет, детка. Сядь со мной и просто побудь рядом немного.#$b#На одну-то ночь ты можешь завязать с беготнёй.$h",
"Festivals.Jellies.Kenneth": "Праздник словно даёт матушке-природе возможность отдохнуть от электричества.#$b#Приятно так отключаться, хотя бы и ненадолго!$h",
"Festivals.Jellies.Kenneth_spouse": "Раньше я хотел как-то скопировать то биолюминесцентное свечение, что есть у медуз, и создать на его основе лампу или что-то в этом роде.#$e#Теперь же я думаю, что будет лучше, если оно будет только у них. У них так светиться получается лучше всего.$h",
"Festivals.Jellies.Maddie": "Я должна либо уже спать, либо работать над своим исследованием.$s#$b#Но мистер Агуар захотел прийти сюда, и я не собираюсь позволить ему возвращаться домой одному.$a",
"Festivals.Jellies.Maddie_spouse": "Если честно, на 100% честно...$s#$b#Я очень люблю медуз. Очень.$l",
"Festivals.Jellies.Philip": "Эй, прости, что вчера утомил тебя своими разговорами о медузах.#$b#Они просто очаровательны!#$e#У них даже нет центральной нервной системы, но при этом они так экономно расходую свою энергию, почти лучше всех в океане.",
"Festivals.Jellies.Philip_spouse": "Время для ежегодного обновления информации о медузах!$h#$b#Вместо скелета у медуз имеется мезоглея, которая на 85% состоит из воды. Кроме того, в ней содержатся белки и амёбоциты, которые поглощают бактерии и взвесь из воды...#$b#%Филипп изо всех сил старается сохранить невозмутимое выражение лица.#$e#%Он, наверное, продолжит шутить таким образом ещё лет десять...",
"Festivals.Jellies.Shiro": "Знаешь, у нас с медузами намного больше общего, чем может показаться.#$e#Мы любим держаться рядом друг с другом, словно семья.#$b#И иногда потоки уносят нас в разные стороны...$s",
"Festivals.Jellies.Shiro_spouse": "Я словно медуза, что плывёт вместе с остальными.#$b#Это так просто.",
"Festivals.Jellies.Ysabelle": "Ради того, чтобы увидеть этих прекрасных медуз, стоит не спать допоздна.#$b#Надеюсь, что я не засну.$h",
"Festivals.Jellies.Ysabelle_spouse": "Я рада, что наслаждаюсь этой прекрасной ночью вместе с тобой, @.#$b#Мой переезд в долину действительно того стоил, ведь я нашла здесь тебя.$h",

//Stardew Valley Fair

	//Non-Dateables
"Festivals.StardewFair.Aguar": "Рыба, которую выставили Вилли и Кармен, явно была здоровой в момент поимки.#$b#Это говорит о хорошем качестве воды.",
"Festivals.StardewFair.Bert": "Пиво в Долине никогда не разочаровывает!$h#$b#Особенно когда пьёшь со своей хозяюшкой! Она меня опередила!",
"Festivals.StardewFair.Ezekiel": "Эти молоко и сыр протухнут на солнце и будут вонять на всю площадь.$a#$b#Ба! Я просто буду держаться от них подальше и спокойно пить.",
"Festivals.StardewFair.Freddie": "Моя жена подумывает о том, чтобы организовать небольшой ларёк, но мы не уверены, что именно будем продавать!$h#$b#Есть идеи, молодёжь?",
"Festivals.StardewFair.Jio": "Ты ничего не видел.$a^Ты ничего не видела.$a#$e#Меня здесь нет.$a#$b#Ты меня не видишь.$a#$b#Перестань со мной разговаривать, иначе ты меня раскроешь!$a",
"Festivals.StardewFair.Keahi": "У меня хватает только на 50 жетонов...  Но чтобы покататься на Турбо, мне нужно 100 жетонов!$h#$b#Рано или поздно мистер Джерик даст мне покататься на Турбо бесплатно!$h",
"Festivals.StardewFair.Kiwi": "Играть?#$b#Ши-и!$u#$e#Киви играть!$h",
"Festivals.StardewFair.Lenny": "Льюис всегда говорит, что судьи должны быть абсолютно нейтральными, однако, я не могу не похвалить твою работу, @.$h",
"Festivals.StardewFair.Lola": "У тебя уже всё готово для выставки?#$b#У тебя случайно не припрятаны где-нибудь тыквы?$h#$e#Фредди просто обожает мой тыквенный суп.$h",
"Festivals.StardewFair.Olga": "Я слышала, что у тебя на ферме всё отлично! Уверена, что твоя продукция получит много баллов!#$b#Независимо от их мнения, ты должен гордиться собой, @.$h^Независимо от их мнения, ты должна гордиться собой, @.$h",
"Festivals.StardewFair.Pika": "Здравствуй, @.#$b#Хочу узнать твоё мнение.#$b#Кто лучше в этом году - я или старина Гас?$h",
"Festivals.StardewFair.Richard": "Боже, какое прекрасное зрелище!$h#$b#Осмелюсь сказать, наша маленькая долина вполне соответствует своей репутации.",
"Festivals.StardewFair.Trinnie": "Я хочу пострелять из рогатки!#$e#Я буду лучше Кеяхи!$h#$b#После этого я хочу поиграть с милой лошадкой!$h",
"Festivals.StardewFair.Yuuma": "Старший брат сказал мне купить себе жетоны.#$b#Но вместо этого я купил ему сок! Ему это нужно больше, чем мне.$h",

	//Dateables
"Festivals.StardewFair.Alissa": "Мне очень хочется опробовать все игры и посмотреть на все лотки в округе!$h#$b#Ну, после того, как Льюис объявит победителя.#$b#Я много работала в этом году! Надеюсь, я выиграю!$h",
"Festivals.StardewFair.Alissa_spouse": "Дорогой, я хочу поиграть на ярмарке!$h^Дорогая, я хочу поиграть на ярмарке!$h#$b#Давай зайдём к ним после оценки выставки, ладно?",
"Festivals.StardewFair.Corine": "Интересно, когда у меня перерыв?$s#$b#Я собираюсь набрать больше всех очков в стрельбе из рогатки, вот увидишь!$a#$e#Я много тренировалась!",
"Festivals.StardewFair.Corine_spouse": "Привет, милый.$h^Привет, милая.$h#$b#Я просто отдыхаю - пыталась набрать как можно больше очков в стрельбе из рогатки.#$b#Так что я вернулась к работе!$h#$e#Теперь руки немного побаливают.$s",
"Festivals.StardewFair.Flor": "Тут так оживлённо. Я знала, что так и будет, но всё же...$u#$b#Здесь чересчур много людей.$s#$b#Извини.$l#$b#Дай мне минутку.$12",
"Festivals.StardewFair.Flor_spouse": "Здесь так много людей, так шумно и оживлённо...$s#$b#...но с тобой рядом не так страшно.$h",
"Festivals.StardewFair.Ian": "Я хотел бы получить приз в обмен на звёздные жетоны, но не хочу тратить деньги на все эти игры.$s#$e#Я хорош в силометре, но награда маленькая.$s",
"Festivals.StardewFair.Ian_spouse": "Эй, может, поиграем в рыбалку вместе, когда ты закончишь с выставкой?#$e#Победитель получает поцелуй от проигравшего!$h",
"Festivals.StardewFair.Jeric": "Я думаю, что после этого ребёнка я закроюсь.$s#$b#Кеяхи меня пугает! Кто знает, что он сделает, если я не дам ему покататься на Турбо!$u#$e#В любом случае, что же ты выставил на свой лоток, @?^В любом случае, что же ты выставила на свой лоток, @?#$e#О, правда? Недурно!",
"Festivals.StardewFair.Jeric_spouse": "Я дам Турбо отдохнуть после этого клиента, он выглядит довольно усталым.#$e#В общем, это мой самый любимый праздник.$h#$e#Все собираются вместе и демонстрируют плоды своего труда - и одного из всех официально объявляют самым лучшим или самой лучшей!$h",
"Festivals.StardewFair.Kenneth": "Я рад, что тебе нравится этот праздник, @!$h#$b#На самом деле, это мэр Льюис так усердно потрудился. Я просто помог с проводкой.$h",
"Festivals.StardewFair.Kenneth_spouse": "Ух ты... этот праздник не перестаёт меня удивлять.#$e#Он привлекает в долину столько туристов!#$b#Я уверен, что Ленни и Льюису это нравится.",
"Festivals.StardewFair.Maddie": "Кстати, где Гас и Пайк берут говядину для своих бургеров?#$b#Её ведь никто не продаёт тут в долине...#$e#Надеюсь, она из этичных источников...$a",
"Festivals.StardewFair.Maddie_spouse": "Ах, я хочу попробовать абсолютно всё! Как думаешь, Гас приготовил десерт?#$e#Давай возьмём по кусочку розового торта!$h",
"Festivals.StardewFair.Philip": "Мы с Алексом бросили друг другу вызов в силомере, и я победил!$h#$e#Скажу тебе по секрету, всё дело тут не столько в силе, сколько в правильной осанке и понимании эргономики.#$b#Потом на выигранные деньги я купил новый комикс! Разве это не здорово?$h",
"Festivals.StardewFair.Philip_spouse": "Привет, любовь моя! Я просто жду свой заказ. Тебе что-нибудь нужно?#$b#О! Кстати, посмотри на новый комикс, который я купил! Я в восторге!$h",
"Festivals.StardewFair.Shiro": "О, привет, @.#$b#Здесь на самом деле довольно весело.#$b#Я пришёл только потому, что иначе Юма не соглашался пойти, но теперь и мне самому тут интересно!$h",
"Festivals.StardewFair.Shiro_spouse": "Раньше я был лучше всех в силомере.#$b#Придёт время, и я верну свою прежнюю форму.$h",
"Festivals.StardewFair.Ysabelle": "Корин и Фэй уговорили меня помочь им сегодня обслужить клиентов.#$b#Я не против, так как смогу проводить больше времени с девочками, но...$s#$b#Я не нашла подходящий наряд для этого случая!$s",
"Festivals.StardewFair.Ysabelle_spouse": "Привет, любимый, давай обойдём площадь и посмотрим на лотки!^Привет, любимая, давай обойдём площадь и посмотрим на лотки!#$b#Только после того, как я помогу Корин с этим блюдом. Подожди немножко.$h",

//Spirit's Eve

	//Non-Dateables
"Festivals.SpiritEve.Aguar": "Не сейчас.$4#$e#Я не могу отвлекаться.$4",
"Festivals.SpiritEve.Bert": "Клянусь, пироги Эвелин с каждым годом становятся всё лучше!$h#$e#М-м-м-м, этого достаточно, чтобы взрослый мужчина заплакал!$s",
"Festivals.SpiritEve.Ezekiel": "Просто смешно. Эти скелеты - куклы!$a",
"Festivals.SpiritEve.Freddie": "Мы с Лолой познакомились в канун Дня всех духов несколько десятилетий назад.$h#$e#На ней был такой обтягивающий костюм кошки.$u#$b#Как только я увидел её, я понял, что женюсь на этой женщине.$h",
"Festivals.SpiritEve.Jio": "Ты чувствуешь присутствие чего-то потустороннего поблизости.$4#$e#Этой ночью есть чего опасаться.",
"Festivals.SpiritEve.Keahi": "Бу-у!$u#$e#Ха-ха, я напугал тебя?$h",
"Festivals.SpiritEve.Kiwi": "Хи-и хи-и.$h#$b#Ты видеть друзей?$u#$e#Друзья Киви здесь!$h",
"Festivals.SpiritEve.Lenny": "Моя спина будет болеть несколько недель, но я думаю, что мы неплохо поработали, устанавливая всё это!$h#$e#Имей в виду, я не имела никакого отношения к лабиринту.$u",
"Festivals.SpiritEve.Lola": "В этом году я не буду кошкой, дорогуша.$h#$b#Этот костюм я отложила в сторону много десятков лет тому назад.#$e#В конце концов, я уже поймала свою добычу.$h",
"Festivals.SpiritEve.Olga": "Она хочет съесть все эти конфеты, а потом её будет тошнить всю ночь... $s",
"Festivals.SpiritEve.Pika": "Не говори Кеяхи, но я каждый год украдкой беру немного конфет из его добычи.#$b#Тама-налог, как называл это мой отец, ха-ха!$h",
"Festivals.SpiritEve.Richard": "Я уже давно научился не расспрашивать Ленни о том, как она всё это делает. Теперь я просто наслаждаюсь праздником.$h#$e#Обязательно попробуй сидр, если ещё не пробовал.$4^Обязательно попробуй сидр, если ещё не пробовала.$4",
"Festivals.SpiritEve.Trinnie": "Кеяхи ничего не сказал про мой костюм...$s#$b#Глупый Кеяхи!$s#$e#Не буду делится с ним конфетами!$a",
"Festivals.SpiritEve.Yuuma": "Широ хотел сходить в лабиринт вместе со мной, но я отказался.#$b#Я сказал, что ему не стоит идти туда в одиночку, и теперь он расстроился.$s#$b#Думаю, мы скоро пойдём домой.$4",

	//Dateables
"Festivals.SpiritEve.Alissa": "В этом платье сложно ходить.#$b#Надеюсь, я не споткнусь и не насмешу тут всех.$s",
"Festivals.SpiritEve.Alissa_spouse": "Боюсь, я быстро заблужусь в этом лабиринте.$s#$b#Попытаешься найти меня, если так вдруг случится?$h",
"Festivals.SpiritEve.Corine": "БУ!#$e#Ха-ха, я знаю, что не напугала тебя!$h#$b#Тебе нравится этот праздник?",
"Festivals.SpiritEve.Corine_spouse": "Сегодня в воздухе витает что-то странное.#$e#Возможно, мне придётся незаметно уйти с праздника, но я вернусь сегодня вечером, обещаю.",
"Festivals.SpiritEve.Flor": "Я понимаю, теоретически, люди любят пугаться искусственно, потому что таким образом они могут почувствовать прилив страха, не попадая на самом деле в опасную ситуацию. Но я любви к подобному не испытываю.#$b#Я останусь там, где хорошо освещено.$h",
"Festivals.SpiritEve.Flor_spouse": "Ничего страшного, если ты хочешь пробежаться по лабиринту, правда!#$b#Со мной тут всё будет хорошо. Не беспокойся.$h",
"Festivals.SpiritEve.Ian": "Я благодарен всем за все праздники, что у нас есть.#$e#Если сегодня мне не нужно покупать еду, значит я могу сэкономить!$h#$b#К тому же, иногда Пайк с Гасом отдают мне остатки еды после праздника.",
"Festivals.SpiritEve.Ian_spouse": "Не хочешь взять меня с собой в лабиринт?#$e#Я никогда не мог пройти его полностью, поэтому буду идти за тобой по пятам!",
"Festivals.SpiritEve.Jeric": "Что скажешь? Как тебе мой костюм, а?#$b#Я заставлю всех милашек сбежаться ко мне!$h",
"Festivals.SpiritEve.Jeric_spouse": "Волшебник закрывает большую часть города на весь день, чтобы подготовить лабиринт ко Дню всех духов.#$e#Интересно, как он умудряется сделать всё в одиночку?",
"Festivals.SpiritEve.Kenneth": "Ленни и Йен, конечно, как следует постарались, чтобы всё здесь украсить!",
"Festivals.SpiritEve.Kenneth_spouse": "Ленни узнала о том, что мы с Мару сделали с фонарями, и заставила нас поменять всё обратно.#$e#Однако она посмеялась. Она всегда рада хорошей шутке.#$b#...Не говори ей, но мы с Мару всё же заменили лампочку на её крыльце на красную! $h",
"Festivals.SpiritEve.Maddie": "Почему всех так интересует лабиринт? Поговорим о пустой трате времени.$5#$b#Блуждаешь в темноте, не зная, куда идти, ждёшь, когда что-то выскочит на тебя из-за угла...$s#$b#Нет, я не боюсь!!!$a",
"Festivals.SpiritEve.Maddie_spouse": "Мне нужно было взять кое-что в лаборатории прямо перед тем, как прийти сюда.#$b#Мистер Агуар стал подшучивать надо мной из-за того, что я не купила костюм. Ворчливый старикан. Он-то сам разве в костюме?$a",
"Festivals.SpiritEve.Philip": "Я не могу оторвать взгляд от скелетов.#$e#Наверное, это какая-то уловка.#$b#Как они могут двигаться без мускулатуры?$s",
"Festivals.SpiritEve.Philip_spouse": "Поразительно, как они умудряются организовать всё это за один день.#$e#Держу пари, что спина Ленни будет мучить её какое-то время...",
"Festivals.SpiritEve.Shiro": "Они изумительно украсили это место!$h#$b#Раньше, когда я был моложе, я был для всех просто кошмаром на Дне всех духов.#$e#Я обожал пугать людей. И иногда заходил слишком далеко... ",
"Festivals.SpiritEve.Shiro_spouse": "Иди веселись, детка. Я останусь здесь.#$b#Это всё дым и зеркала, но какая-то часть моего мозга не всегда это понимает.$s",
"Festivals.SpiritEve.Ysabelle": "Ты уже доходил до конца лабиринта?^Ты уже доходила до конца лабиринта?#$b#Постарайся там не заблудиться, иначе потеряешься навсегда.$u#$b#У-у-у-у-у-у! Ха-ха!$h",
"Festivals.SpiritEve.Ysabelle_spouse": "Ну что, как тебе мой наряд?#$b#Très chic, да? (П.П.: Très chic - Очень шикарный или стильный - фр.)$h",

//Ice Festival

	//Non-Dateables
"Festivals.IceFest.Aguar": "Хм-м-м.#$e#%Мистер Агуар пристально смотрит на леденец.",
"Festivals.IceFest.Bert": "Помнишь мой совет?#$b#Держи ухо востро, стань единым целым с удочкой, слышишь?$h",
"Festivals.IceFest.Ezekiel": "Помяни моё слово, я бы наловил больше всех.$h",
"Festivals.IceFest.Freddie": "Привет, @!$h#$e#Не мёрзнешь?",
"Festivals.IceFest.Jio": "Вчера было тихо и спокойно.#$e#Сегодня же лёд скрипит от напряжения. Слишком много людей.$s",
"Festivals.IceFest.Keahi": "Из этого снега трудно что-то слепить.$s#$e#Папа говорит, что он недостаточно влажный! Как снег может быть... недостаточно влажным?$u",
"Festivals.IceFest.Kiwi": "Киви пытаться поймать рыбу.$h#$e#У Киви большая голова и маленькие ручки.$a#$b#Не поймать.$s",
"Festivals.IceFest.Lenny": "Льюису этот праздник всегда нравился больше, чем мне, поэтому я буду просто им наслаждаться, а он пусть руководит.",
"Festivals.IceFest.Lola": "Я понимаю, почему рыб ловят, а потом отпускают, но, скажу тебе по секрету...#$b#...Я бы лучше зажарила эту рыбу с щепоткой хорошей приправы, как научилась на Янтарном острове.$h",
"Festivals.IceFest.Olga": "Не говори Берту, но я притащила его сюда, потому что знаю, что Тринни хочет показать ему снеговика, которого скоро слепит.$h",
"Festivals.IceFest.Pika": "Я пришёл ради подлёдной рыбалки.#$b#Просто посмотреть.#$b#Тебе никогда не поймать меня на этом льду!$h",
"Festivals.IceFest.Richard": "Бр-р!$a#$b#Надо было одеваться теплее.#$b#Мои старые кости и холод плохо сочетаются друг с другом.$h#$e#Впрочем, прекрасные ледяные скульптуры, сотворённые Леей и Робин, стоят того, чтобы прийти только ради них.$4",
"Festivals.IceFest.Trinnie": "Я пытаюсь сделать крылья из снега для моего снежного пингвина, а они всё отваливаются...$s",
"Festivals.IceFest.Yuuma": "Хотел бы я, чтобы мой брат тоже поучаствовал в соревновании.#$b#Думаю, ему бы понравилось.$h#$b#Раньше он был заядлым рыбаком.$s",

	//Dateables
"Festivals.IceFest.Alissa": "Я тоже хочу слепить снеговика.#$b#Этот сверкающий белый снег - он словно волшебный!$h",
"Festivals.IceFest.Alissa_spouse": "Удачи тебе, дорогой!$h^Удачи тебе, дорогая!$h#$b#Я буду болеть за тебя! Иди и поймай этих рыбок!$h",
"Festivals.IceFest.Corine": "Ты заметил, что Вилли и Льюис ходят по льду и ни разу не поскользнулись?^Ты заметила, что Вилли и Льюис ходят по льду и ни разу не поскользнулись?#$b#Интересно, как им это удаётся?",
"Festivals.IceFest.Corine_spouse": "Ты видел это снежное... нечто, которое лепят дети?^Ты видела это снежное... нечто, которое лепят дети?#$e#Мне кажется, тот, что справа, наверное, Льюис... или Пэм... $s",
"Festivals.IceFest.Flor": "Я помогаю детям слепить снеговика!$h#$b#Мне нужно найти идеальные ветки для рук.$h",
"Festivals.IceFest.Flor_spouse": "Лёд выглядит очень крепким. Я хочу сказать, я не думаю, что кто-то стал бы делать в нём дырки, если бы он не был таким...$s#$e#Пожалуйста, всё равно будь осторожен, милый.$s^Пожалуйста, всё равно будь осторожна, милая.$s",
"Festivals.IceFest.Ian": "У меня дырявые перчатки. Это маленькая неприятность не доставляет мне проблем, так как холод меня не беспокоит.#$e#Может Эмили научит меня чинить их.",
"Festivals.IceFest.Ian_spouse": "Ты участвуешь в рыболовном состязании?#$e#Я буду болеть за тебя!$h#$b#Но потихоньку, чтобы не распугать всю рыбу.",
"Festivals.IceFest.Jeric": "Хорошо выглядишь, @.#$e#Не буду врать, мне нравится милый снежный кролик.$h",
"Festivals.IceFest.Jeric_spouse": "Привет, @. Обязательно поймай меня, если я поскользнусь и начну падать на лёд, хорошо?$h",
"Festivals.IceFest.Kenneth": "После праздника рыбу отпускают.#$b#Она попросту испортится, если мы этого не сделаем.",
"Festivals.IceFest.Kenneth_spouse": "Я ловил всякую рыбу, но мой лучший улов - ты.$h#$e#Что? Разве плохо хоть иногда задействовать такие ужасные комплименты?$h",
"Festivals.IceFest.Maddie": "Вы ведь все знаете, что от переохлаждения можно умереть, верно? ВЕРНО?#$b#Я просто не понимаю смысла всего этого.$a ",
"Festivals.IceFest.Maddie_spouse": "Иоба, как же здесь холодно.$a#$b#Ты удивительный человек и всё такое, но есть проблемы, с которыми даже любовь не поможет справиться, и холод - одна из них. Жду не дождусь, когда мы вернёмся домой.$a",
"Festivals.IceFest.Philip": "Желаю удачи!$h#$e#Не забывай, двигаться при забросе и подсечке надо всем телом. Вывихнутое плечо очень тяжело восстанавливается.",
"Festivals.IceFest.Philip_spouse": "Я видел, как ты ловишь рыбу, и знаю, что тебе не нужны предостережения о травмах. Так что просто пожелаю тебе удачи!",
"Festivals.IceFest.Shiro": "Надеюсь, Юма хоть немного поиграет сегодня.#$b#Скажу честно, это всё, чего я желаю.",
"Festivals.IceFest.Shiro_spouse": "Привет, любимый, сегодня так холодно...^Привет, любимая, сегодня так холодно...#$b#Давай обнимемся? $l",
"Festivals.IceFest.Ysabelle": "Ледяные скульптуры напоминают мне мраморные статуи, что украшают здание балетного театра в городе.$h#$b#Когда я была маленькой, я пыталась подражать их позам.",
"Festivals.IceFest.Ysabelle_spouse": "Ты умеешь делать скульптуры, мой милый?^Ты умеешь делать скульптуры, моя милая?#$b#Мы могли бы сотворить инсталляцию изо льда или из собственных...$l#$b#Ха-ха, я просто шучу!$h#$b#В конце концов, это определённо не самое подходящее для того место.$h",

//Feast of the WinterStar

	//Non-Dateables
"Festivals.WinterStar.Aguar": "Желаю весело провести Пир Зимней звезды, @.$h#$e#Не смотри на меня таким удивлённым взглядом.#$b#Мне не нравятся любезности, но это не значит, что я не понимаю их значения.",
"Festivals.WinterStar.Bert": "Я был прав, @.$h#$e#Её улыбка гораздо ценнее, чем этот кукольный домик.$h",
"Festivals.WinterStar.Ezekiel": "Я так и знал. Еда здесь хорошая, а пиво дрянное.$a#$b#Лучше пойду домой и хлебну настоящего алкоголя!$h",
"Festivals.WinterStar.Freddie": "Счастливой Зимней звезды, @!$h#$e#Надеюсь, ты получишь почти всё, что тебе хочется, и всё, что тебе нужно!$h",
"Festivals.WinterStar.Jio": "Киви нравятся такие дни.$h",
"Festivals.WinterStar.Keahi": "Подарки!$u#$e#Я люблю подарки!$h",
"Festivals.WinterStar.Kiwi": "Киви - подарочек!$4#$e#Ши-и!$h",
"Festivals.WinterStar.Lenny": "Как там в песне?#$b#Маленькой ёлочке холодно одной...$4#$b#Подожди, не так.$h",
"Festivals.WinterStar.Lola": "Поздравляю с праздником Зимней звезды, дорогуша!$h#$e#Завтра мы с Фредди отправляемся в небольшое путешествие.#$b#Я с нетерпением жду, когда наконец смогу побыть наедине со своим мужем.$h",
"Festivals.WinterStar.Olga": "Берт подарил Тринни кукольный домик!$a#$b#Осталось подождать, пока она не разбросает части домика, и он не наступит на одну из них босой ногой.$s",
"Festivals.WinterStar.Pika": "Пир Зимней звезды напоминает нам, что независимо от того, откуда ты родом, ты можешь найти свою собственную охану, свою семью, среди друзей.$4#$e#Я рад, что могу отпраздновать этот праздник вместе с тобой, @.$h",
"Festivals.WinterStar.Richard": "Раньше Иза верила в Деда Зимней звезды.$h#$b#Интересно, когда она догадалась, что это я был в его костюме?$4",
"Festivals.WinterStar.Trinnie": "%Тринни просто зачарована нарядным кукольным домиком, который только что развернула. Она вас даже не замечает.",
"Festivals.WinterStar.Yuuma": "Город сегодня очень красивый.$h#$e#Похоже, Широ замёрз?#$b#Да, здесь на самом деле холодновато...$u",

	//Dateables
"Festivals.WinterStar.Alissa": "Праздничные огни так красиво смотрятся на снегу и создают идеальную атмосферу.#$b#Надеюсь, тебе весело, @.$h",
"Festivals.WinterStar.Alissa_spouse": "С праздником, мой дорогой!$h^С праздником, моя дорогая!$h#$b#Ты - моё лучшее благословение, которое я получила за долгое время.#$b#Я тебя очень люблю.$l",
"Festivals.WinterStar.Corine": "Привет, @! Я больше всего люблю этот праздник, потому что еда здесь самая лучшая.$h#$b#Этого стоило ждать целый год!$h",
"Festivals.WinterStar.Corine_spouse": "Ещё один год, да?#$b#Не знаю почему, но думаю, что следующий год будет ещё лучше.$h#$e#Давай, поедим всласть!$h",
"Festivals.WinterStar.Flor": "Чем старше мы становимся, тем труднее удерживать это детское чувство удивления, но быть рядом с большим количеством людей, как сейчас, например, кажется особенным в более значимом смысле.$h",
"Festivals.WinterStar.Flor_spouse": "На подобных праздниках я раньше чувствовала себя такой одинокой, потому что не знала, как правильно завести разговор.$s#$b#Но теперь у меня есть ты, и ты всё изменил.$h^Но теперь у меня есть ты, и ты всё изменила.$h#$e#Спасибо за это.$h#$b#Я люблю тебя.$l",
"Festivals.WinterStar.Ian": "Я вырезал деревянную скульптуру в качестве подарка.#$e#Она простенькая, но, надеюсь, что тому, кому я её подарю, она понравится. Не зря же я столько заноз получил!",
"Festivals.WinterStar.Ian_spouse": "Ты то, за что я наиболее благодарен.$h#$e#Я вручу тебе подарок на Пир Зимней звезды, когда мы будем дома, хорошо?$l",
"Festivals.WinterStar.Jeric": "Вот что я тебе скажу: моему тайному другу не стоит дарить мне грубую ткань.$a#$b#Может она и хороша, например, для Эмили, но я шью одежду только из тканей высшего качества.",
"Festivals.WinterStar.Jeric_spouse": "Время определённо умеет внезапно ускориться.#$b#Наверное, оно просто летит, когда ты счастлив, или как там говорит Льюис.$h",
"Festivals.WinterStar.Kenneth": "Честно говоря, я стараюсь присматривать за этим деревом хоть одним глазком.$s#$b#Все эти огни...$u",
"Festivals.WinterStar.Kenneth_spouse": "Привет, @!#$b#Надеюсь, твой год был не менее замечательным, чем мой.#$e#Мой оказался просто потрясающим, с тобой вместе!#$b#Хм? Дерево? О, не волнуйся, с ним всё в поря-я-ядке...",
"Festivals.WinterStar.Maddie": "Привет, @. Получил сегодня хороший подарок?^Привет, @. Получила сегодня хороший подарок?#$b#Надеюсь, в следующем году твоя карьера достигнет новых высот.$h#$b#Я серьёзно!$a",
"Festivals.WinterStar.Maddie_spouse": "Мне не нужно думать о каких-то материальных подарках, когда рядом со мной есть ты.#$b#Я не могла просить лучшего!",
"Festivals.WinterStar.Philip": "Счастливого праздника! Надеюсь, ты получишь всё, чего хотел.$h^Счастливого праздника! Надеюсь, ты получишь всё, чего хотела.$h",
"Festivals.WinterStar.Philip_spouse": "О, Иоба, как же я люблю праздничную еду.#$b#Не обнимай меня, у меня в карманах печенье припрятано.$h",
"Festivals.WinterStar.Shiro": "Знаешь что, @? Цени каждый свой прожитый день.#$e#Живи полной жизнью, пока можешь.#$b#Никогда не знаешь, когда что-то потеряешь.$s",
"Festivals.WinterStar.Shiro_spouse": "Я люблю тебя, @. Счастливого Пира Зимней звезды.",
"Festivals.WinterStar.Ysabelle": "Надеюсь, кто-нибудь подарит мне новые легинсы.$s#$b#На моих самых лучших огромная стрелка пошла.$s",
"Festivals.WinterStar.Ysabelle_spouse": "Я так рада, что ты здесь со мной, любимый!$h^Я так рада, что ты здесь со мной, любимая!$h#$b#Ты - лучший подарок, который я когда-либо получала!$l#$e#Надеюсь, что следующие годы будут ещё чудеснее.$h",

//Ember of Resolutions

	//Non-Dateables
"Festivals.EoR.Aguar": "Ещё один год подходит к концу.#$e#Важно оценивать результаты своей годовой деятельности с целью их улучшения в следующем году.",
"Festivals.EoR.Bert": "С Новым годом, @!$h#$e#Я просто не могу поверить, что год прошёл так быстро.$s#$b#Это действительно заставляет меня дорожить каждой секундой, которую я провожу с Ольгой и Тринни.$h",
"Festivals.EoR.Ezekiel": "С каждым годом моё сердце тоскует по тебе всё сильнее...$s#$b#%Эзикиель смотрит в небо.#$b#С Новым годом, Элен.$4",
"Festivals.EoR.Freddie": "С Новым Годом, @!$h#$b#Ты можешь в это поверить? Через несколько часов мы будем в новом году, в новом сезоне.#$b#Как будто мы начинаем всё сначала.$h",
"Festivals.EoR.Jio": "Круговорот природы замыкается.#$b#Похоже, это событие стоит отметить.$h",
"Festivals.EoR.Keahi": "Эй, эй, эй!$h#$b#Я нашёл эту классную палку, когда мы поднимались сюда!#$b#Смотри! В ней даже есть гвоздь!$h#$e#А? Это не палка? Это доска?#$b#Ну ладно тогда... Я нашёл классную доску!$h",
"Festivals.EoR.Kiwi": "Киви нравится, когда очень светло.$h#$b#Но Киви не любить жаркий огонь.$s#$e#Огонь к-колется?$u",
"Festivals.EoR.Lenny": "С Новым годом, @!$h#$e#Знаешь... Раньше я устраивала массовые новогодние вечеринки в общежитиях университета Зузу.$4#$b#А сейчас я думаю только о бюджете, бумажной работе и благополучии жителей деревни.$h#$b#Время действительно меняет человека, верно?$s",
"Festivals.EoR.Lola": "С Новым годом, дорогуша.$h#$e#Фредди принёс запасные одеяла.#$b#Если тебе холодно, не стесняйся, спрашивай, хорошо?$h",
"Festivals.EoR.Olga": "С Новым Годом, @.$h#$b#Ещё один год прошёл...$s#$b#Извини за это.#$b#Я просто думала о Тринни.$h#$b#Однажды она вырастет и съедет от нас...$s#$e#Как бы мы ни боялись и избегали этой мысли, судьба сделает по-своему.$s",
"Festivals.EoR.Pika": "Мануйа ле Таусага Фоу, @. С Новым годом!#$e#Новый год, новые люди, новые рецепты, новые возможности.$h#$e#Попробуй-ка вот это! Мы с Гасом испекли особое печенье.$h",
"Festivals.EoR.Richard": "@! Желаю тебе и твоей семье крепкого здоровья, счастья, успехов и процветания в наступающем году.$h#$b#Сегодняшний вечер особенный, не так ли?#$e#Мы с Анжеликой обычно встречали Новый год на балконе «Бревенчатого домика»...$s#$b#Только мы, лунный свет и несколько бутылок вина.$h",
"Festivals.EoR.Trinnie": "Папа дал мне это полено. Он сказал, что нам нужно присмотреть за ним, пока не зажгут костёр.#$b#Итак... Знакомься, Бревнита!#$e#Она деревянная леди и моя новая лучшая подруга!$h#$e#Что такое, Бревнита?$u#$b#Кеяхи признается мне в следующем году?!$4",
"Festivals.EoR.Yuuma": "С Новым годом, @.$h#$b#Есть традиция - загадывать желание, после того как положишь полено в костёр.#$e#Я не могу сказать тебе, что загадал, ведь тогда желание не сбудется...$s",

	//Dateables
"Festivals.EoR.Alissa": "С Новым годом, @!$h#$e#Есть что-то особенное в сегодняшнем вечере.$h#$b#Особенно когда горит огонь...#$b#От этого мне хочется петь от всего сердца.$h#$e#Э-э-э! Я имею в виду, я просто счастлива, что все здесь собрались.$l",
"Festivals.EoR.Alissa_spouse": "С Новым годом тебя, дорогой.$l^С Новым годом тебя, дорогая.$l#$b#Это было словно вчера, когда ты услышал, как я пою в саду, а потом...^Это было словно вчера, когда ты услышала, как я пою в саду, а потом...#$b#...Я убежала от тебя.$h#$b#Я так смутилась тогда, ха-ха!$l",
"Festivals.EoR.Corine": "С Новым годом, @!#$e#Держу пари, я смогу спуститься с этой скалы. Хм-м-м...#$b#Извини. Я просто думала, чем весёлым тут можно заняться.$h#$e#Хочешь спуститься со скалы вместе со мной?$h#$e#Хм-м-м... Может, мне стоит спросить Изу или Абигейл?",
"Festivals.EoR.Corine_spouse": "С Новым годом тебя, любимый!$h^С Новым годом тебя, любимая!$h#$b#Я рада, что проведу эту ночь с тобой, @.#$b#Я прошла через многое, прежде чем встретила тебя, и временами чувствовала себя одинокой...$s#$b#Но теперь я знаю, что кое-кто всегда будет рядом со мной.$h",
"Festivals.EoR.Flor": "С Новым годом.$h#e#Холодно...$s#$b#Здесь довольно холодно.#$e#Какая интересная традиция, этот костёр.#$b#Интересно, откуда она пришла?#$e#Есть ли у тебя какие-либо идеи, @? Может быть, придумаем какую-нибудь теорию.$h#$e#Я считаю, что основатель этого праздника был скрытым пироманьяком и ему нужен был только предлог, чтобы развести гигантский костёр.$h#$b#Было бы интересно исследовать психику этого человека.$h",
"Festivals.EoR.Flor_spouse": "С Новым годом, любовь моя.#$e#Эй, любимый... Тут холодно!$s^Эй, любимая... Тут холодно!$s#$b#Обними меня крепче, пожалуйста... $l#$b#Вот, так хорошо.$h#$e#Я так счастлива, когда понимаю, что сегодня вечером, когда я пойду домой спать... #$b#... я буду идти рядом с тобой.$l#$b#Лучшего начала года просто не может быть.$h",
"Festivals.EoR.Ian": "С Новым годом, @.#$e#Фух. Было немного тяжело принести сюда все эти столы.$h#$b#Ну что ж, оно того стоило, ведь всем теперь весело.$h#$e#Надеюсь, в следующем году я получу больше заказов...$s",
"Festivals.EoR.Ian_spouse": "С Новым годом, дорогой.$h^С Новым годом, дорогая.$h#$e##Я просто очень рад тому, что ты вошёл в мою жизнь.$l^Я просто очень рад тому, что ты вошла в мою жизнь.$l#$b#Жизнь у меня была несладкой, до того как встретил тебя.$s#$b#Ленни изредка помогала мне, но в основном я всегда был сам по себе.$6#$b#Теперь у меня есть ты...$7#$b#... И, как я понимаю, у тебя теперь есть я.$7#$b#Спасибо тебе за всё, @.$7",
"Festivals.EoR.Jeric": "С Новым годом, @.#$e#Ну что ж - Новый год, новые хлопоты.$h#$b#Надеюсь, в следующем году дела у тебя пойдут в гору!#$e#У меня? У меня в следующем году дела точно наладятся.#$e#Почему? Потому что я буду работать ещё усерднее, чтобы превзойти тебя.$h",
"Festivals.EoR.Jeric_spouse": "С Новым годом, детка.#$e#Подойди ко мне и поцелуй своего муженька.$l#$b#Ну а если серьёзно, @. Я благодарен тебе.$h#$b#Спасибо, что был со мной рядом.^Спасибо, что была со мной рядом.#$b#Ты - моя первая настоящая семья после губернатора.$s#$b#Я тебя очень люблю.$7",
"Festivals.EoR.Kenneth": "С Новым годом, @.#$e#Мне нравится, когда Пайк и Гас сотрудничают.$h#$b#Они, наверное, лучшие повара в этой долине!$h#$b#И весь следующий год они будут радовать нас каждый праздник.$h",
"Festivals.EoR.Kenneth_spouse": "С Новым годом, милый!$h^С Новым годом, милая!$h#$e#Знаешь... раньше новогодний костёр каждый раз напоминал мне о горе.$s#$b#А теперь?$8#$b#Теперь я с нетерпением жду его каждый год.$7#$b#Потому что я буду с тобой из года в год.$7#$b#Я люблю тебя, @.$7",
"Festivals.EoR.Maddie": "С Новым годом, наверное.#$b#Зачем нужно сжигать все эти дрова?$a#$b#Надеюсь, они не срубили для этой цели живые деревья.$s#$e#С другой стороны, это выглядит так умиротворяюще...$h",
"Festivals.EoR.Maddie_spouse": "Привет...#$b#С Новым годом, глупышка.$l#$b#Знаешь, я очень рада, что встретила тебя.$9#$b#Благодаря тебе я снова научилась открываться людям.$7#$b#Я научилась быть честной сама с собой.$6#$b#Я снова научилась любить.$8#$e#Я люблю тебя, @.$h",
"Festivals.EoR.Philip": "С Новым годом, @!#$e#%Филипп, судя по всему, дрожит.#$e#Надеюсь, снег не пойдёт. Переохлаждение - не шутка.$s#$b#Пойду-ка я лучше проведаю стариков.#$e#Тебе тоже стоит согреться, @.$h",
"Festivals.EoR.Philip_spouse": "С Новым годом, милый!$h^С Новым годом, милая!$h#$e#Ой-ой-ой, как же холодно!$u#$b#Почему ты позволил мне вот так выйти из дома, ха-ха?$h^Почему ты позволила мне вот так выйти из дома, ха-ха?$h#$e#Давай выпьем за ещё один наш совместный год! А ещё за нас, покорителей Вселенной.$l",
"Festivals.EoR.Shiro": "С Новым годом, @.$h#$e#Рассказывать кому-то о своих желаниях - плохая примета, но... #$b#Я так хочу, чтобы у Юмы было правильное детство...$s",
"Festivals.EoR.Shiro_spouse": "С Новым годом, @!$h#$e#Знаешь, до того, как я встретил тебя, я чувствовал себя... неполноценным?$s#$b#Я намного меньше ощущал себя человеком из-за своих... недостатков.$s#$b#Когда я встретил тебя, то почувствовал, что ты словно дополняешь меня, но...#$b#Теперь, с тобой рядом, я чувствую себя вполне полноценным.$h",
"Festivals.EoR.Ysabelle": "С Новым годом, @!$h#$e#Корин сегодня явно хочется приключений.$6#$b#Надеюсь, ей больше не придут в голову какие-нибудь странные идеи, и она не позовёт меня куда-то взбираться, как в прошлом году!$6#$e#Хотя, втайне я надеюсь, что она попросит меня.$h#$b#Мне нужна встряска.$h",
"Festivals.EoR.Ysabelle_spouse": "Эй, крошка, с Новым годом!$l#$b#Дедушка рассказывал мне, как постояльцы гостиницы встречали Новый год на балконе «Бревенчатого домика».#$b#Звучит довольно романтично, не правда ли?$l#$b#Возможно, нам стоит потихоньку улизнуть с бутылочкой вина.$h",

//EmberNight Dialogue - Adds dialogue to vanilla characters

	//Spouses
"EmberNightDialogue.Abigail.spouse": "С Новым годом, дорогой!^С Новым годом, дорогая!#$e#Помнишь, как мы давным-давно играли вместе в «Короля Прерий»?$h#$b#Год пролетел быстро, но я рада, что провела его вместе с тобой, @.$4",
"EmberNightDialogue.Leah.spouse": "С Новым годом, милый!^С Новым годом, милая!#$e#Я помню, когда ты приехал в долину...$7^Я помню, когда ты приехала в долину...$7#$b#Мне приснилось, что мы с тобой когда-нибудь будем вместе.$4#$b#Выпьем же за ещё один год, проведённый вместе, любовь моя. [348]$h",
"EmberNightDialogue.Maru.spouse": "С Новым годом, милый!^С Новым годом, милая!#$e#На этот год я дала себе обещание... есть пирог с ревенем каждый день.#$b#Ха-ха! Я шучу!$h#$b#Моё обещание - провести с тобой каждый день своей жизни.$4",
"EmberNightDialogue.Penny.spouse": "С Новым годом, милый!^С Новым годом, милая!#$e#Я очень стеснялась тебя, когда мы впервые встретились.#$b#Забавно теперь думать об этом, когда мы с тобой уже так далеко зашли.$4#$b#Давай пойдём ещё дальше в следующем году!$h",
"EmberNightDialogue.Haley.spouse": "Счастливого Нового года, милый!^Счастливого Нового года, милая!#$e#Я вспоминала тот день, когда мы с тобой сделали несколько снимков на ферме Марни.#$b#Как я почувствовала себя в безопасности, когда ты подхватил меня во время падения.$4^Как я почувствовала себя в безопасности, когда ты подхватила меня во время падения.$4#$b#С тех пор мы с тобой прошли долгий путь.$l",
"EmberNightDialogue.Sebastian.spouse": "С Новым годом, @!#$e#Может быть это прозвучит странно, но я очень счастлив, что ты снова и снова заваливался в мою комнату, когда я был занят.$h^Может быть это прозвучит странно, но я очень счастлив, что ты снова и снова заваливалась в мою комнату, когда я был занят.$h#$b#Создать с тобой семью было лучшим решением из тех, которые я когда-либо принимал.$4#$b#Это был замечательный год, нам стоит его отпраздновать.[346]$h",
"EmberNightDialogue.Sam.spouse": "С Новым годом, малыш!^С Новым годом, малышка!#$e#Знаешь, я понял, что ты - моя половинка, когда ты пришёл на наше выступление.$h^Знаешь, я понял, что ты - моя половинка, когда ты пришла на наше выступление.$h#$b#Ты поддерживал меня и мои мечты, как бы нереально они ни выглядели.$2^Ты поддерживала меня и мои мечты, как бы нереально они ни выглядели.$2#$b#Обожаю тебя.$4",
"EmberNightDialogue.Alex.spouse": "С Новым годом, @!$1#$e#Этот год был великолепным, но я уверен, что следующий будет ещё великолепнее.#$b#Почему? Потому что я проведу его вместе с тобой.$4",
"EmberNightDialogue.Harvey.spouse": "С Новым годом, дорогой!^С Новым годом, дорогая!$1#$e#Сегодня очень сухо и холодно.#$b#К счастью, я захватил с собой бутылочку нашего замечательного трюфельного масла, чтобы смазать кожу.$4#$b#За невероятный год, что ожидает нас!$1",
"EmberNightDialogue.Elliott.spouse": "С Новым годом, любовь моя!$1#$e#Я написал поэму, посвящённую этому события...$4#$b#«Миллионы звёзд горят в ночной вышине.#$b#Одна светит ярче, освещая мой путь к тебе...#$b#Это истинная любовь, что нас с тобой#$b#Объединила под этой луной.»$l#$b#Люблю тебя.$4",
"EmberNightDialogue.Emily.spouse": "С Новым годом, @!$h#$e#Знаешь, что этой ночью луна будет ярче обычного?$h#$b#Она излучает положительную ауру, даря мне счастье!$h#$b#Или, может, эта аура исходит от тебя?$l",
"EmberNightDialogue.Shane.spouse": "Счастливого Нового года.$l#$b#Спасибо за то, что ты со мной, @.#$b#Наконец-то я встречаю Новый год трезвым, и всё благодаря тебе.$h#$b#Слушай... Я...$3#$b#Я люблю тебя.$l",

"EmberNightDialogue.Abigail": "Хм-м-м... Готова поспорить, что это гора идеально подходит для катания на лыжах.#$b#Уверена, что Корин и Иза катаются здесь каждую зиму!$h",
"EmberNightDialogue.Robin": "Я принесла целую охапку бракованных поленьев для праздника.#$b#Значит ли это, что у меня сотни желаний?$h",
"EmberNightDialogue.Demetrius": "Мне стоит чаще приходить сюда, в Риджсайд.#$b#Будет интересно изучить местную флору и фауну.$h",
"EmberNightDialogue.Maru": "Флор, по-моему, холод совершенно не беспокоит.$2#$b#Не удивлюсь, если окажется, что у всех жителей Риджсайда выработалось что-то вроде невосприимчивости к нему.$1",
"EmberNightDialogue.Sebastian": "Очень холодно.$s#$b#Эй, не смотри на меня так!#$b#Здесь наверху холоднее, чем в Пеликане.$s",
"EmberNightDialogue.Pierre": "Пришло время поприветствовать Новый год.#$b#Эй, @!#$b#Загляни ко мне в магазин в первый же день нового года, ладно?$h#$b#У меня есть новые семена на продажу!$h",
"EmberNightDialogue.Caroline": "С Новым годом, @!#$e#Так приятно поболтать с Ольгой время от времени.$h#$b#Она так смешно рассказывает о шутках Берта. Ха-ха!$h",
"EmberNightDialogue.Linus": "Ох, не обращай на меня внимания, @. Я просто стою здесь и жду костра.$1#$e#А что это за загадочный домик вон там?$0",
"EmberNightDialogue.Alex": "Подъём сюда - хорошая тренировка.#$b#Нужно почаще выбираться сюда!$1",
"EmberNightDialogue.George": "Зачем нам взбираться холодной ночью на эту гору, да ещё так поздно?#$b#Я же должен уже быть в тёплой постели в это время!$2",
"EmberNightDialogue.Evelyn": "Джордж, похоже, не очень доволен.#$b#Пойду принесу ему кусок горячего пирога.$h",
"EmberNightDialogue.Lewis": "Я надеюсь, тебе весело, @!$h",
"EmberNightDialogue.Clint": "Когда Пайк и Гас готовят вместе, у них получаются изумительные блюда!$h",
"EmberNightDialogue.Emily": "Это гора обладает огромным запасом энергии.#$b#Она излучает сильную духовную ауру.$h#$b#Мне стоит чаще приходить сюда, для медитации.$h",
"EmberNightDialogue.Penny": "С Новым годом.#$b#Несмотря на холод, мне здесь очень весело.$1",
"EmberNightDialogue.Pam": "Ух! Светлый эль намного вкуснее на морозе!$h#$b#Я живу ради таких ночей!$h" ,
"EmberNightDialogue.Haley": "Подъём сюда был утомителен, но прокатиться на канатной дороге было приятно.#$b#Из вагонетки открывается изумительный вид на всю долину!$h#$e#Пойду узнаю у Изы и Корин, не хотят ли они выпить горячего какао.$h",
"EmberNightDialogue.Jodi": "Вся еда была невероятно вкусной! Мне очень нравятся блюда, что готовит Пайк.$h#$b#Интересно, куда подевались Винсент и Кеяхи...$3#$b#Надеюсь, что они не попадут опять в неприятности!$s" ,
"EmberNightDialogue.Kent": "Хм-м... О, привет.#$b#С Новым годом.$1",
"EmberNightDialogue.Sam": "Концерт на вершине этой горы вышел бы легендарным!$h#$b#Я прямо-таки покрываюсь мурашками, в хорошем смысле, когда думаю об этом.$h",
"EmberNightDialogue.Leah": "Это прекрасная гора дарит мне вдохновение.#$b#Думаю, я назову свою следующую картину: «Зима в Риджсайде».$h",
"EmberNightDialogue.Shane": "Нет ничего вкуснее холодного пива.#$b#Но я надеюсь, этот праздник скоро закончится.#$b#С каждой минутой становится холоднее.$s",
"EmberNightDialogue.Marnie": "Ленни устраивает «Костёр обещаний» каждый год.$h#$b#У неё гораздо больше организаторского таланта, чем можно подумать по её внешнему виду.$1#$e#Надеюсь, моё обещание на Новый год сбудется, и Льюис...$2#$b#Эй, ты же ничего не слышал, да?!$4^Эй, ты же ничего не слышала, да?!$4#$b#...$4" ,
"EmberNightDialogue.Elliott": "С Новым годом, @!$1#$e#«Когда меня несут плохие времена...$2#$b#Когда сквозь пальцы утекают все мои года...$2#$b#Жизнь выглядит наполненной возможностями.#$b#Коль в новый год ступаю с осторожностью.»$1#$b#Прекрасная поэма, согласись?$1",
"EmberNightDialogue.Gus": "С Новым годом, @!$1#$e#У Пайка несколько необычные блюда, этого не отнять...$2#$b#Но, похоже, людям они нравятся.#$b#Возможно, мне стоит готовить их и у себя в салуне?$1",
"EmberNightDialogue.Harvey": "С Новым годом, @!$1#$e#Прошёл ещё один год...#$b#Я начинаю ощущать себя старым.$2#$b#Но какой смысл жаловаться на это!$1",
"EmberNightDialogue.Jas": "С Новым годом, мистер @.^С Новым годом, мисс @!$1#$e#Тринни дала имя своему полену.#$b#Интересно, помнит ли она о том, что нам нужно будет сжечь их?$2",
"EmberNightDialogue.Jas.GN": "С Новым годом, {{Title}} @!$1#$e#Тринни дала имя своему полену.#$b#Интересно, помнит ли она о том, что нам нужно будет сжечь их.$2",
"EmberNightDialogue.Vincent": "С Новым годом, мистер!^С Новым годом, мисс!$1#$e#Я потерял полено, которое принёс!$3#$b#Теперь мои желания не сбудутся.$2",
"EmberNightDialogue.Vincent.GN": "С Новым годом, фермер!$1#$e#Я потерял полено, которое принёс!$3#$b#Теперь мои желания не сбудутся.$2",
"EmberNightDialogue.Willy": "С Новым годом, парень!^С Новым годом, девчуля!$1#$e#Не обращай внимания на запах. Я весь день рыбачил у пруда Риджсайда, прежде чем подняться в гору.$3",
"EmberNightDialogue.Willy.GN": "С Новым годом, фермер!$1#$e#Не обращай внимания на запах. Я весь день рыбачил у пруда Риджсайда, прежде чем подняться в гору.$3",

//Ridgeside Gathering

	//Non-Dateables
"Festivals.Gathering.Aguar": "Я не возражаю против подобных мероприятий в Риджсайде.#$b#Я предпочитаю ходить сюда, а не в город Пеликан.",
"Festivals.Gathering.Bert": "Гас и Пайк превзошли сами себя, меню очень разнообразное!#$b#Мой живот в восторге!$h",
"Festivals.Gathering.Ezekiel": "Не нравится мне, когда вокруг Корин крутится столько парней.$a#$b#Или я слишком сильно тревожусь?$s",
"Festivals.Gathering.Freddie": "Приятно видеть знакомые лица.$h",
"Festivals.Gathering.Jio": "Местные жители, похоже, очень любят праздники.#$b#Но боюсь, у Киви скоро закружится голова...$h",
"Festivals.Gathering.Keahi": "Я продаю дикие фрукты, которые собрал вчера!$h#$b#Пацаны рулят! У-О-О-У!$h",
"Festivals.Gathering.Kiwi": "Хоп-хоп#$b#Киви может делать сальто целый день.$h",
"Festivals.Gathering.Lenny": "Я рада, что всем весело!$h#$b#Тем не менее, я надеюсь, что соперничество не приведёт к обкидыванию друг друга едой.$u#$b#Льюис до сих пор не простил меня за то, что я затеяла тогда...$s ",
"Festivals.Gathering.Lola": "Нам с Эвелин есть о чём поболтать!$h#$b#Мы так редко видимся.$s",
"Festivals.Gathering.Olga": "Я надеюсь, что детям весело.#$b#Я рада, что они ладят друг с другом.$h",
"Festivals.Gathering.Pika": "О, привет, @! Рад тебя видеть!$h#$b#Если хочешь сделать заказ, только крикни!",
"Festivals.Gathering.Richard": "Собрание Риджсайда - отличная возможность для «Бревенчатого домика» немного заработать.#$b#Некоторые жители города Пеликан будут слишком уставшими, чтобы возвращаться домой, поэтому они могут остаться здесь на ночь.$h",
"Festivals.Gathering.Trinnie": "Я абсолютно уверена, что мои растения будут продаваться как горячие пирожки!$h#$b#ДЕВОЧКИ РУЛЯТ! ЙЕ-Е-Е!$h",
"Festivals.Gathering.Yuuma": "Каждый принёс что-то на продажу.#$b#Интересно, кто начал это соревнование между мальчиками и девочками.",

	//Dateables
"Festivals.Gathering.Alissa": "Подходи и покупай наши товары, @!$h#$b#Обещаю, что ты не пожалеешь!#$e#Прости, Джерик, но мы победим.$a",
"Festivals.Gathering.Alissa_spouse": "Дорогой! Помоги нам выиграть!$h^Дорогая! Помоги нам выиграть!$h#$b#Смотри! Этого растения у нас дома нет, так ведь?$h",
"Festivals.Gathering.Corine": "Посмотри на их прилавок! Выглядит вяленько!$h#$b#Простите, мальчики, но мы выиграем.$h#$e#Эй, Абби! Хочешь взглянуть на то, что они продают?$h",
"Festivals.Gathering.Corine_spouse": "Я буду любить тебя, независимо от того, кому ты поможешь победить в этом году, любовь моя.#$b#Но, разумеется, я не буду разговаривать с тобой весь следующий год, если они выиграют.$h",
"Festivals.Gathering.Flor": "Мне интересно, что продают за прилавком на другой стороне.#$b#Но девушки говорят мне, чтобы я оставалась здесь.#$e#Хм-м-м... Я совсем запуталась.$s",
"Festivals.Gathering.Flor_spouse": "Эм-м... Я принесла несколько своих старых книг на продажу.#$b#Интересно, купит ли их кто-нибудь.#$e#Привет, Эллиот, вот эскиз скульптуры, о котором я тебе рассказывала!$h",
"Festivals.Gathering.Ian": "Фух, эта деревянная скульптура почти готова.$h#$b#Но она не так хороша, как у Леи.#$b#Ну что ж. Я всё же надеюсь, что кто-нибудь купит её.$h",
"Festivals.Gathering.Ian_spouse": "Тебе весело, дорогой?^Тебе весело, дорогая?#$b#Извини, но сначала мне нужно закончить эту скульптуру. Я присоединюсь к тебе через некоторое время.",
"Festivals.Gathering.Jeric": "Подойди и посмотри на лучший прилавок в долине!$h#$b#Я сделал его через кровь, пот и слёзы!$h#$e#Эй, Шейн! Почему ты забыл про украшения?$a",
"Festivals.Gathering.Jeric_spouse": "Эй, детка, сделай мне одолжение и проследи за товарами конкуренток, а?$h#$b#Ха-ха! Я просто шучу. Мне вообще всё нипочём... Ха-ха.$h",
"Festivals.Gathering.Kenneth": "Мне интересно посмотреть на маленького робота Мару.#$b#Я пойду взгляну позже.#$e#О! Надо будет показать Сэму новый усилитель, над которым я работал!$h",
"Festivals.Gathering.Kenneth_spouse": "Ты был у прилавка Пайка и Гаса, дорогой? Они продают много еды!$h^Ты была у прилавка Пайка и Гаса, дорогая? Они продают много еды!$h#$b#Я пойду наверстать упущенное, как только продам здесь что-нибудь.$h",
"Festivals.Gathering.Maddie": "Этот медвежонок с часами та-а-а-акой милый!$9#$b#Я хочу купить его!$h#$e#Привет, Лея! Это ты его сделала?$h",
"Festivals.Gathering.Maddie_spouse": "Дорогой, здесь столько всего можно купить!$h^Дорогая, здесь столько всего можно купить!$h#$b#Позже я покажу тебе свой список желаний, хорошо?$6#$b#Просто шучу, ха-ха. Я уже купила то, что хотела.$h",
"Festivals.Gathering.Philip": "На прилавках продают интересные товары!$h#$e#Э, ой! Я забыл напомнить Шейну об украшениях для прилавка!$u",
"Festivals.Gathering.Philip_spouse": "Интересно, смогу ли я купить тут штангу и принести домой?#$b#Ты не против, дорогой?$h^Ты не против, дорогая?$h",
"Festivals.Gathering.Shiro": "Мне любопытно, что продают девушки.#$b#Но думаю, ребята меня осудят, если я приду и куплю у них что-нибудь.$h#$e#Интересно, с чем Себастиан там возится?",
"Festivals.Gathering.Shiro_spouse": "Я надеюсь, тебе нравится наш общий сбор, @.#$b#Должен сказать, я с нетерпением жду концерт, обещаю, буду танцевать только потихоньку.$h",
"Festivals.Gathering.Ysabelle": "Улыбнись на камеру!$h#$b#Ещё один снимок!$h#$e#Эй, Хэйли, мне нравится твоя новая камера!$h#$b#Покажешь мне фотографии, когда они будут готовы, хорошо?$h",
"Festivals.Gathering.Ysabelle_spouse": "Тебе весело, детка?#$b#Иди-ка сюда! Сфотографируйся с нами!$h#$e#Вот ещё один снимок! Можно поцеловать тебя в щёчку для классной позы?$h",

//Gathering Dialogue - Adds dialogue to vanilla characters

	//Spouses
"GatheringDialogue.Abigail.spouse": "Обязательно посмотри, как я сегодня буду играть на барабанах!#$b#Я буду стараться изо всех сил, так что подбадривай меня погромче, хорошо?$h",
"GatheringDialogue.Leah.spouse": "Как тебе эта картина?#$b#Последняя осталась.#$b#Я уже продала все остальные!$h",
"GatheringDialogue.Maru.spouse": "Я так горжусь этим маленьким роботом! Я сама его смастерила.$h",
"GatheringDialogue.Penny.spouse": "Привет, милый. Надеюсь, тебе нравится праздник.$h^Привет, милая. Надеюсь, тебе нравится праздник.$h#$b#Я смотрю, что тут продают, хочу найти что-нибудь симпатичное для нашего дома.$h",
"GatheringDialogue.Haley.spouse": "Иди сюда, дорогой! Давай сфотографируемся вместе!$h^Иди сюда, дорогая! Давай сфотографируемся вместе!$h#$b#Это так весело!$h",
"GatheringDialogue.Sebastian.spouse": "Я решил помочь Джеррику с ремонтом его мотоцикла.#$b#Поговорим позже, хорошо?$h",
"GatheringDialogue.Sam.spouse": "Пожелай мне удачи, @!$h#$b#Я собираюсь продемонстрировать свои таланты всей долине!$h",
"GatheringDialogue.Alex.spouse": "Я купил у Гаса и Пайка парочку бургеров! Они такие вкусные!$h#$b#Хочешь, я тебе тоже куплю?$h",
"GatheringDialogue.Harvey.spouse": "Давай после концерта погуляем по деревне.#$b#Я так давно сюда не заглядывал.$s",
"GatheringDialogue.Elliott.spouse": "Я с нетерпением жду выступления наших музыкантов!$h#$b#Давай танцевать до упада!$h",
"GatheringDialogue.Emily.spouse": "Эй, милый!$1^Эй, милая!$1#$b#Давай потанцуем на концерте сегодня.$h",
"GatheringDialogue.Shane.spouse": "Мне так не терпится отведать перечных бомбочек Пайка!$h#$b#Я слышал, многие их хвалят!$h",

"GatheringDialogue.Abigail": "Мне так хочется подпортить им киоск!$h#$b#Oй, @... Ты ничего не слышал!$h^Oй, @... Ты ничего не слышала!$h#$e#Эй, Корин! Пойдём посмотрим!$h",
"GatheringDialogue.Robin": "Ах! Наша сцена выглядит просто замечательно!#$b#Горжусь своей работой!$h",
"GatheringDialogue.Demetrius": "Эти бургеры просто восхитительны!$h#$b#Пайк и Гас хорошо срабатываются, когда не пытаются соревноваться.$h",
"GatheringDialogue.Maru": "Мой маленький «Музыкатрон 2000» выставлен на продажу!$h#$b#Он что-то вроде крошечного музыкального автомата.$h#$e#Эй, Флор! Взгляни-ка на него!$h",
"GatheringDialogue.Sebastian": "Интересно, почему Джерик не занимается своим мотоциклом?#$b#Как можно вот так вот бросить его ржаветь...$s#$e#Эй, Джерик! Иди сюда, поможешь мне, ладно?$a",
"GatheringDialogue.Pierre": "Я тоже хотел поставить киоск, но Абигейл убедила меня, что на собрании предполагается развлекаться, а не получать прибыль.$s#$b#Ну что ж, тогда поем как следует!$h" ,
"GatheringDialogue.Caroline": "Я рада, что дети веселятся.#$b#И мне было приятно поболтать с Алиссой! Интересно, споёт ли она нам сегодня?$h",
"GatheringDialogue.Linus": "Ленни попросила меня принести любую лесную еду, которую я смогу найти.#$b#Я рад, что смог помочь.$h",
"GatheringDialogue.Alex": "О, привет! Давай поиграем сегодня в гридбол!$h#$e#Эй, Филипп! Ты всё ещё играешь?$h",
"GatheringDialogue.George": "Нам с Фредди нужно сходить на Хребет. Лола и Эвелин могут остаться здесь и поболтать.#$e#Пошли, Фред!#$b#Как в старые добрые времена!$h",
"GatheringDialogue.Evelyn": "О, да, давненько я не была в Риджсайде.#$b#Как всегда, вид отсюда просто чудесный.$h",
"GatheringDialogue.Lewis": "Я надеюсь, тебе весело, @!$h",
"GatheringDialogue.Clint": "Интересно, согласится ли Эмили потанцевать со мной на концерте?$h#$e#Не стоит мне даже пытаться её спрашивать, она, скорее всего, откажется.$s",
"GatheringDialogue.Emily": "Хочется потанцевать на концерте, но я не хочу танцевать одна!$h",
"GatheringDialogue.Penny": "У Флор есть несколько интересных книг на продажу. Надо бы посмотреть их.#$e#Интересно, что задумала Мэдди? Я давно с ней не разговаривала.$s",
"GatheringDialogue.Pam": "Что? Позже будет концерт?#$b#Значит, появилась ещё одна причина выпить!$h" ,
"GatheringDialogue.Haley": "Можешь нас сфотографировать?#$b#У нас с Изой фотосессия.$h#$e#Иза! Замри!$h#$b#Интересно, какие фотографии в итоге получатся.$h",
"GatheringDialogue.Jodi": "Я немного беспокоюсь, что Винсент и Кеяхи могут снова начать дразнить Тринни.$s#$b#Она возмущается громче, чем Джас, поэтому они провоцируют её чаще.$h" ,
"GatheringDialogue.Kent": "Блюда Пайка просто высший класс!#$b#Надо бы почаще заглядывать в эту деревушку.$h",
"GatheringDialogue.Sam": "Я слегка нервничаю из-за предстоящего концерта.$s#$b#Но я готов как никогда!$h#$e#Эй, Алисса! Уверена, что не хочешь выступать с нами?$h",
"GatheringDialogue.Leah": "Джерик... такой симметричный, правда?#$b#Я хочу сказать, что его лицо идеально подходит для портрета.$h#$e#Эй, Джерик, остановись на секунду!$h",
"GatheringDialogue.Shane": "Хм... Кажется, я забыл принести украшения для киоска.$u#$e#Эй, Филипп! Ты же должен был мне напомнить!$a",
"GatheringDialogue.Marnie": "Я так давно не была в деревне!$h#$b#Надеюсь, коровок Ольги вся эта музыка не очень сильно побеспокоит.$s",
"GatheringDialogue.Elliott": "Я принёс на продажу несколько своих стихотворений.#$b#Возможно, сейчас это просто слова на бумаге, но, быть может, они станут весьма популярными!$h",
"GatheringDialogue.Gus": "Атмосфера здесь великолепная!$h#$b#Надеюсь, ты наслаждаешься праздником, @.",
"GatheringDialogue.Harvey": "Я принёс энергетические тоники, это мой вклад в киоск.$h#$e#Надо попросить Йена помочь, эти коробки с тониками очень тяжёлые.$s",
"GatheringDialogue.Jas": "Это часы в виде медвежонка! Выглядят очаровательно!$h#$b#Ой-ой! Совсем забыла! Я должна присматривать за Тринни!$4#$b#Она может начать бросаться вещами в мальчиков, если они сильно разозлят её!$h",
"GatheringDialogue.Vincent": "Эй, зацени!#$b#Мы с Кеяхи нашли всё это в коробке для потерянных вещей у мэра Льюиса.#$b#Теперь мы это продаём!$h",
"GatheringDialogue.Willy": "Шум водопадов, он так успокаивает.#$b#Надо бы спланировать следующую рыбалку в этих краях.",
"GatheringDialogue.Marlon": "Еда очень вкусная!$h#$b#Этим поварам следует почаще сотрудничать.",
"GatheringDialogue.Wizard": "Местные жители, похоже, наслаждаются празднеством.#$b#Мне тоже очень любопытно посмотреть, что продаётся в киосках.#$b#В руки продавцов каким-то образом попали редкие и ценные вещицы.",

//Romance Dialogue

//Alissa
"Romance.Engagement.Alissa0": "Погоди, @? Что делаешь?$l#$b#Ты же не хочешь сказать... Неужели!$l#$b#Конечно ДА, @! Я тебя люблю!$l",
"Romance.Engagement.Alissa1": "Не могу дождаться, чтобы рассказать Ольге и Берту! Я так счастлива, @!$h",
"Romance.FemaleWeddingFix.MaleFarmer1.Alissa": "Когда @ впервые приехал в город Пеликан, никто не знал, впишется ли он в наше сообщество...#$b#Но с этого дня @ станет такой же частью этого города, как и любой из нас!$h#$b#Сегодня {1}, день {0}.#$b#В такой чудесный день для меня большая честь соединить @ и Алиссу узами брака.",
"Romance.FemaleWeddingFix.MaleFarmer2.Alissa": "@... Алисса... #$b#Как мэр города Пеликан и региональный носитель супружеской печати, я объявляю вас мужем и женой!$h",
"Romance.FemaleWeddingFix.FemaleFarmer1.Alissa": "Когда @ впервые приехала в город Пеликан, никто не знал, впишется ли она в наше сообщество...#$b#Но с этого дня @ станет такой же частью этого города, как и любой из нас!$h#$b#Сегодня {1}, день {0}.#$b#В такой чудесный день для меня большая честь соединить @ и Алиссу узами брака.",
"Romance.FemaleWeddingFix.FemaleFarmer2.Alissa": "@... Алисса... #$b#Как мэр города Пеликан и региональный носитель супружеской печати, я объявляю вас женой и... женой!$h",
"Romance.give.flowersA.Alissa": "Эй, что это, @?#$b#Подожди, ты серьёзно?$u#$b#Ты хочешь, чтобы я была твоей девушкой?$l#$b#Конечно да!$l#$b#По-другому бы и не было!$l#$e#Я так счастлива, я не могу перестать улыбаться!$l#$b#Я люблю тебя!$l",
"Romance.give.flowersB.Alissa": "Эй, что это, @?#$b#Подожди, ты серьёзно?$u#$b#Ты хочешь, чтобы я была твоей девушкой?$l#$b#Конечно да!$l#$b#По-другому бы и не было!$l#$e#Я так счастлива, я не могу перестать улыбаться!$l#$b#Я люблю тебя!$l",
"Romance.stardrop.gift.Alissa": "Пусть наша любовь будет вечным дуэтом, @.$l#$b#Ни одна песня не сможет описать, насколько я ценю и люблю тебя, @.$s#$b#Надеюсь, этот маленький подарок покажет тебе, насколько ты особенный для меня.$l^Надеюсь, этот маленький подарок покажет тебе, насколько ты особенная для меня.$l",
"Romance.rejectNPCA.Alissa": "Мне жаль, но... ты мне не на столько нравишься, @.$s#$b#Я думаю, ты ошибся. Извини, но я скажу нет.$s",
"Romance.rejectNPCB.Alissa": "Мне жаль, но... ты мне не на столько нравишься, @.$s#$b#Я думаю, ты ошибся. Извини, но я скажу нет.$s",
"Romance.MovieInvite.Spouse.Alissa": "Это отличная идея для свидания, дорогой! Я так взволнована!$h^Это отличная идея для свидания, дорогая! Я так взволнована!$h#$b#Я встречу тебя там, ладно? Я должна сначала привести себя в порядок!",

//Corine
"Romance.Engagement.Corine0": "Привет, эм... @? Это то, о чём я думаю?$l#$b#О мой Иоба, @...$l#$b#Конечно! Конечно да! Я правда-правда люблю тебя.$l",
"Romance.Engagement.Corine1": "Расскажу папе попозже. Он так удивится!$h",
"Romance.FemaleWeddingFix.MaleFarmer1.Corine": "Когда @ впервые приехал в город Пеликан, никто не знал, впишется ли он в наше сообщество...#$b#Но с этого дня @ станет такой же частью этого города, как и любой из нас!$h#$b#Сегодня {1}, день {0}.#$b#В такой чудесный день для меня большая честь соединить @ и Корин узами брака.",
"Romance.FemaleWeddingFix.MaleFarmer2.Corine": "@... Корин... #$b#Как мэр города Пеликан и региональный носитель супружеской печати, я объявляю вас мужем и женой!$h",
"Romance.FemaleWeddingFix.FemaleFarmer1.Corine": "Когда @ впервые приехала в город Пеликан, никто не знал, впишется ли она в наше сообщество...#$b#Но с этого дня @ станет такой же частью этого города, как и любой из нас!$h#$b#Сегодня {1}, день {0}.#$b#В такой чудесный день для меня большая честь соединить @ и Корин узами брака.",
"Romance.FemaleWeddingFix.FemaleFarmer2.Corine": "@... Корин... #$b#Как мэр города Пеликан и региональный носитель супружеской печати, я объявляю вас женой и... женой!$h",
"Romance.give.flowersA.Corine": "Ого, ничего себе.$u#$b#Ты уверен насчёт этого?$l^Ты уверена насчёт этого?$l#$b#Ты действительно хочешь, чтобы я была твоей девушкой?$l#$b#Ну конечно я буду рада стать твоей девушкой!#$e#Теперь мы действительно вместе!$h#$b#Я очень-очень счастлива!$l#$e#Люблю тебя, @!$h",

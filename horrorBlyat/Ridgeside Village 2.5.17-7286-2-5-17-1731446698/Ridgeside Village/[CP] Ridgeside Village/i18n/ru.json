//BELINDA DIALOGUE
"keahiprank.Belinda": "Дорогуша?#$b#Ты же уже умеешь принимать ванную? Никак не могу запомнить, в каком возрасте люди этому учатся.$h",

//Randomized
"Belinda.Dialogue.random.1" : "Приветствую тебя, дорогуша.$h#$b#У тебя выходной, я полагаю?",
"Belinda.Dialogue.random.2" : "Интересно, что такого видит Рэрияла в этой горе.#$b#Я никогда не пойму её.",
"Belinda.Dialogue.random.3" : "Твой дедушка был очень интересным человек, дорогуша.#$b#Душой, ты на него очень ${похож^похожа}$.$h",
"Belinda.Dialogue.random.4" : "Твоя бабушка всегда любила заплетать мне волосы в косы.#$b#Хотя она так и не смогла ничего сделать с мехом Рэи.$h",
"Belinda.Dialogue.random.5" : "Подношения, которые вы, смертные, приносите Рэрияле, скучные.#$b#Вместо этого лучше бы вы присоединились к моим последователям.$h",
"Belinda.Dialogue.random.6" : "Дайя - моя талантливая девочка.#$b#Она довольно хитра и обманчива, так что не слишком привязывайся к ней.$4",
"Belinda.Dialogue.random.7" : "Джио - интересный эльф.#$b#Похоже, его беспокоит какое-то событие из прошлого.#$b#Но я тебе ничего не говорила.$4",
"Belinda.Dialogue.random.8" : "Ты ${виделся^виделась}$ с Дэниелсами?#$b#О, ничего особенного.$h#$b#Их дочь просто интересная, вот и всё.$4",
"Belinda.Dialogue.random.9" : "Интересно, где моя драгоценная маленькая Киви.$4#$b#У меня есть новые задания для этой Джунимо.$h",
"Belinda.Dialogue.random.10" : "Я дух, хотя и не уверена, чего именно.$s#$b#Всё, что я знаю, это то, что я счастлива, что меня спасли от самой себя.$h",
"Belinda.Dialogue.random.11" : "Почва этой долины богата магией.#$b#В частности, от магии Рэриялы и её связи с сущностью жизни.$h#$b#Вы, люди, так же называете сущность жизни - Иоба.",
"Belinda.Dialogue.random.12" : "Никогда не недооценивай слуг Габриэллы, дорогуша.#$b#У некоторых больше одного сердца.$a#$b#И некоторые из них являются видными фигурами в вашем обществе.$a",
"Belinda.Dialogue.random.13" : "Заботься о своём доме, дорогуша.#$b#Твоя бабушка очень любила это место.$h",
"Belinda.Dialogue.random.14" : "Я помню, как Рэрияла ревновала к твоему дедушке, когда он впервые встретил твою бабушку.$h#$b#Это всё равно, что видеть, как родитель слишком заботится о своём ребёнке.$h",
"Belinda.Dialogue.random.15" : "Сальвадор и Эсмеральда... Интересно, как поживают эти двое...#$b#О? Кто они такие?$4#$b#Скажем так, старые знакомые, не из этих мест.$h",
"Belinda.Dialogue.random.16" : "Осторожнее с созданием по имени Ки, дорогуша.$a#$b#Эта сущность - аномалия.$a",
"Belinda.Dialogue.random.17" : "Меня очень интересуют леса к югу от твоего дома.#$b#В частности, одно скрытое озеро.$h",
"Belinda.Dialogue.random.18" : "Интересно, где прячется этот теневик...?$4#$b#Что ж, думаю, Гильдия искателей приключений надёжно спрятала его.$h",
"Belinda.Dialogue.random.19" : "Когда-то, я была верховным випериалом, опасным злым духом, вызванным Габриэллой.$s#$b#Я рада, что меня спасли.$4",
"Belinda.Dialogue.random.20" : "Это скучное место!$a#$b#Я требую развлечений!$h",

//Before Festivals
"Belinda.Dialogue.spring_12": "Фестиваль благодарения превратился в фестиваль яиц.#$b#Люди довольно странные существа.#$e#Ну да ладно. Главное, что местные жители веселятся.$h#$b#Насладись завтрашним днём, дорогуша.",
"Belinda.Dialogue.spring_23": "Рэрияла в восторге от завтрашних празднеств.#$b#Я никогда не понимала почему они ей так нравятся.$h",
"Belinda.Dialogue.summer_10": "На протяжении веков, я не понимала причины вашего завтрашнего фестиваля.#$b#Удачи всем вам, если когда-нибудь озорной дух бросит в общий котёл мухомор.$h",
"Belinda.Dialogue.summer_27": "Завтра ночью, мы придём посмотреть на Луналу.$4#$b#С ними можно о многом поговорить.$h",
"Belinda.Dialogue.fall_15": "Боги мои, какая ярмарка!$h#$b#Твоя бабушка часто таскала нас на этот шумный фестиваль.#$b#Ах, она была ангелом, хоть и с шилом, в известном месте.$4#$e#Насладись завтрашним днём, дорогуша.$h",
"Belinda.Dialogue.fall_19": "Эта гора любит энергию, которую местные жители отдают вместе с завтрашними празднествами.#$b#По крайней мере, так говорила Рэрияла.$h",
"Belinda.Dialogue.fall_26": "Будь осторожен завтрашней ночью, дорогуша.$a^Будь осторожна завтрашней ночью, дорогуша.$a#$b#Габриэлла любит посещать города людей, во это время.$a",
"Belinda.Dialogue.winter_7": "Рыба? Меня интересует только рыбы с этой горы.#$b#Та, которая напоминает некоторых местных жителей.#$e#Интересно, как она вообще связанна с ними?$4",
"Belinda.Dialogue.winter_24": "Дух мороза посетит нас завтра.#$b#Он большой весельчак.$h",
"Belinda.Dialogue.winter_27": "Дух решимости родилась из надежд и мечтаний смертных.#$b#Она довольно странная, всегда спит, но при этом мотивирована делать больше.#$b#Любопытно, как это сказывается на людях?$4",

//BLISS DIALOGUE
"keahiprank.Bliss": "Тебе следует уделять больше внимания своему окружению. На тебя посадили клопа-вонючку.",

//Randomized
"Bliss.Dialogue.random.1" : "У тебя здесь дела?",
"Bliss.Dialogue.random.2" : "Леди отправила меня на миссию.#$b#Нет времени на беседу.",
"Bliss.Dialogue.random.3" : "%Блисс зевает.#$e#Нет, я не хочу спать.$s",
"Bliss.Dialogue.random.4" : "Интересно, эта зеленоволосая девочка и шумный мальчик поиграли бы со мной, если бы я показала себя.#$e#Ты ничего не ${слышал^слышала}$!$a",
"Bliss.Dialogue.random.5" : "Царство Духов?#$b#Всё, чего я хочу - встретиться с ними, если когда-нибудь туда попаду...$s#$e#Но... Нет. Ещё рано.",
"Bliss.Dialogue.random.6" : "Меня здесь нет. Я всего лишь плод твоего воображения.#$e#И теперь, когда ты ${подумал^подумала}$ об этом, не было бы странно представлять маленького ребёнка ни с того ни с сего?$h",
"Bliss.Dialogue.random.7" : "Пожалуйста, не отвлекайся на меня.",
"Bliss.Dialogue.random.8" : "Спокойна ли жизнь на ферме?#$b#Интересно.",
"Bliss.Dialogue.random.9" : "Я следую за своей госпожой и защищаю её.#$b#Но на данный момент, она в защите не нуждается.$h",
"Bliss.Dialogue.random.10" : "Дайя, похоже, многое знает...#$b#Упс! Неважно!$h#$e#Главное ей это не говори, иначе она тебя до ночи будет мучить самовосхвалением.",
"Bliss.Dialogue.random.11" : "Не трогай мой бант.#$b#Не. Трогай. Мой. Бант.$a",
"Bliss.Dialogue.random.12" : "Мои руки?#$b#Поверь мне, ты не захочешь их видеть.$h",
"Bliss.Dialogue.random.13" : "Сюрикены заканчиваются, нужны новые.#$b#Интересно, та бабушка всё ещё продаёт их?",
"Bliss.Dialogue.random.14" : "Я видела, как этот тихий мальчик кормил черепаху в деревне.#$e#Он довольно милый. Думаю, мы прекрасно поладим, если я когда-нибудь решу заговорить с ним.$h",
"Bliss.Dialogue.random.15" : "На днях я прогуливалась по отелю, когда этот шумный мальчик появился из ниоткуда и поприветствовал меня.#$b#Затем он похлопал меня по спине.$a#$b#Вот только, я поменяла клопа-вонючку у него в руке, на конфету в его кармане.$4#$b#Надо было видеть, как он выливал себе в рот вёдра воды.$h",
"Bliss.Dialogue.random.16" : "Я чувствую потенциального бойца среди жителей горы.#$b#Её аура напоминает мне кого-то.",
"Bliss.Dialogue.random.17" : "Интересно, где сейчас мастер Элен.#$e#Она обычно посещает этот дом глубокой ночью.#$b#Может быть, это её миссия?",
"Bliss.Dialogue.random.18" : "Где Киви!?$a#$b#Я скучаю по Киви!$s#$e#О, вот же она!$h#$e#Иди сюда, Киви! Давай тренироваться!$4",
"Bliss.Dialogue.random.19" : "Я всегда верна и послушна нашей Леди.#$b#Но я боюсь тех дней, когда у неё возникает желание наряжать меня в эти жуткие, кукольные платья.$u#$b#*дрожит*$u",
"Bliss.Dialogue.random.20" : "В деревенском ресторане, похоже, потрясающий шеф-повар.#$b#Даже отсюда моё обоняние улавливает этот дивный аромат!$h#$b#Это просто блаженство!$h",

"keahiprank.Sari": "Во имя Арани Варэ, что это за запах?!$u",

//Randomized
"Sari.Dialogue.random.1" : "Я надеюсь, что Стефи не попадёт дома в неприятности.$4#$b#...$u#$b#Эй, не подслушивай!$a",
"Sari.Dialogue.random.2" : "Мой долг защитить Аранель!$a ",
"Sari.Dialogue.random.3" : "Враги Верде будут страдать!$a",
"Sari.Dialogue.random.4" : "Почему она не хочет слушать...$s",
"Sari.Dialogue.random.5" : "Властью, данной мне Арой и Рис, Я буду защищать Аранель.$a#$b#Что такое Аранель? Это переводится как - «член королевской семьи». Разве люди в Фернгилле не изучают эльфийский?$u#$b#Ого, я и не знала, что наш язык считается таким сложным.$h",
"Sari.Dialogue.random.6" : "Фернгилл означает Свет Пляжного Дерева.#$b#Говорят, что древний волшебный лес был сожжён огненными элементалями.$s#$b#Столетия спустя, из пепла восстала республика.$4",
"Sari.Dialogue.random.7" : "Гил Мид Тум, место, которое вы называете Долиной Стардью, излучает странную магическую ауру.$4#$b#Ты излучаешь тот же вид энергии.#$b#Да, эльфы чувствуют магию.$h",
"Sari.Dialogue.random.8" : "Не отвлекай меня.$4#$b#Я имею в виду...Тьфу! Не отвлекай меня от дел.$a",
"Sari.Dialogue.random.9" : "Пахнешь лесом. Тебя поили зельем из карамельных поганок и мха, верно?$h",
"Sari.Dialogue.random.10" : "Иногда я беспокоюсь о Пипо.$s#$b#Его интеллект и харизма обычно вытаскивают его из неприятностей...$4#$b#Но что, если однажды этого будет недостаточно?$s",
"Sari.Dialogue.random.11" : "Ты выглядишь ${уставшим^уставшей}$. ${Уверен^Уверена}$, что достаточно отдыхаешь?$s",
"Sari.Dialogue.random.12" : "Я не понимаю, почему фермеры в Фернгилле не используют волшебные культуры.$4#$b#Всё, что делают фермеры в Верде - собирают урожай.$h",
"Sari.Dialogue.random.13" : "Чтобы защитить принцессу, мы должны уйти и укрыться в сумерках до рассвета. ",
"Sari.Dialogue.random.14" : "Тот, кто стоит на пути Арани Варэ...$4#$b#ТЫ. НЕ. ПРОЙДЕШЬ!$a",
"Sari.Dialogue.random.15" : "Эльфы не часто бывают в Фернгилле.#$b#Люди здесь настороженно относятся ко всему, что не понимают.$4#$b#И постоянно пялятся на наши уши!$s",
"Sari.Dialogue.random.16" : "Жёлудь и Пипо словно одно целое.#$b#Мне хотелось бы верить, что этот маленький джунимо убережёт Пипо от неприятностей, ха-ха!$h.",
"Sari.Dialogue.random.17" : "Должно быть, она была так напугана, совсем одна, и никто не мог её защитить.$s",
"Sari.Dialogue.random.18" : "Достаточно ли она ест? Достаточно ли она спит? Ара и Рис, так беспокоятся...$s",
"Sari.Dialogue.random.19" : "Разве она не скучает по дому?$s",
"Sari.Dialogue.random.20" : "Пожалуйста, Аранель, услышь меня!$s",

//PIPO DIALOGUE (Obamoose da mvp)
"keahiprank.Pipo": "Пахнет тем, что мы, алхимики, называем «могильным смрадом».$u#$b#Обычно его выделяют жуки-вонючки. Настоятельно рекомендую проверить свою одежду, жук должен быть где-то на ней.$4",

//Randomized
"Pipo.Dialogue.random.1" : "В настоящее время я изучаю, как проводить хризопоэзию.#$b#То есть, превращение свинца в золото.$4",
"Pipo.Dialogue.random.2" : "Некоторые волшебники обращаются к алхимии, когда заклинания не помогают.$s#$b#Некоторые учёные используют алхимию, чтобы выйти за рамки науки.#$b#Я? Мне нравится алхимия, потому она весёлая.#4",
"Pipo.Dialogue.random.3" : "Почему её так трудно найти!?$a",
"Pipo.Dialogue.random.4" : "Хм, «глаз тритона и лапка лягушки, шерсть летучей мыши и язык собаки...»#$b#Почему они не могли просто написать «горчичное семя», «лютик», «листья остролиста» и «чернокорень»?$a#$b#Никогда не полагайся на колдунов, чтоб узнать список ингредиентов.$4",
"Pipo.Dialogue.random.5" : "Однажды я изобрету эликсир бессмертия, а потом уничтожу его!$h#$b#Было бы опасно, если бы кто-нибудь недобрый завладел им.$s#$b#Зачем тогда его делать? Веселья ради.$4",
"Pipo.Dialogue.random.6" : "Я оставил свой перегонный куб в Верде.$s#$b#Может быть, я смогу... одолжить... один у Магистра Расмодиуса или Магистра Теналианы, пока они не смотрят.$4",
"Pipo.Dialogue.random.7" : "Я слышала, что жители долины наряжаются во время Сине Фейра.#$b#Твой народ называет это Днём всех духов.$4#$e#Я должен заставить Жёлудя нарядиться.$h",
"Pipo.Dialogue.random.8" : "Поскольку мои родители были Арани Варэ, королевскими гвардейцами, естественно, я тоже стал одним из них.#$b#А поскольку опасностей в Верде не так много, я могу потратить всё свободное время на изучение алхимии.$h ",
"Pipo.Dialogue.random.9" : "Однажды она захочет вернуться домой, я надеюсь.$s",
"Pipo.Dialogue.random.10" : "Я скучаю по Верде.$s.",
"Pipo.Dialogue.random.11" : "Почему она не хочет слушать!?$a",
"Pipo.Dialogue.random.12" : "Я просто хочу, чтобы она была в безопасности.$s",
"Pipo.Dialogue.random.13" : "Мои родители весьма влиятельны, оба принадлежат к Арани Варэ.#$b#Мой отец даже является членом Оре Корин, Внутреннего круга. ",
"Pipo.Dialogue.random.14" : "Я познакомился с Жёлудем во время поездки из Верде в Ферне-Нгиле.#$b#Джунимо говорят на древней форме эльфийского языка, поэтому я могу понять большую часть того, что он говорит.$h#$b#Ты говоришь на языке джунимо?! Круто!$4",
"Pipo.Dialogue.random.15" : "Прости, мне нельзя терять время. Я должен защищать Аранель. Она снова от нас ускользнула.$a",
"Pipo.Dialogue.random.16" : "Я не могу сейчас говорить. Я должен защитить принцессу.$a",
"Pipo.Dialogue.random.17" : "Приветствую.#$e# Продолжай в том же духе, Жёлудь!$h",
"Pipo.Dialogue.random.18" : "Салют.#$e#Жёлудь! Ты уже проголодался?$h",
"Pipo.Dialogue.random.19" : "Знаешь ли ты, что алхимия зародилась в Калико?#$b#Тебе обязательно стоит посетить деревню Касл!$4",
"Pipo.Dialogue.random.20" : "Интересно, являются ли Джунимо результатом алхимии...$u#$b#Эй, Жёлудь, подойди на секунду.$h",

